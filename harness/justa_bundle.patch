index 0000000..0a094b6
--- /dev/null
+++ b/ARC3-Inference/inference/utils/ours_perception_sandbox.py
@@ -0,0 +1,174 @@
+"""Ours (OURS_PERCEPTION), the sandbox side: spliced verbatim into the python sandbox's bootstrap only when the flag
+is on (python_tool_sandbox.py), like search_helper.py. Standard library only, no imports at all, no ``from
+__future__`` import; every top-level name starts with ``_ours``, ``ours_`` or ``OursLogicalGrid``, so nothing can
+shadow a bootstrap name. The bootstrap's hook passes in its ``FrameView``, ``segment_layer`` and ``COLOR_CHARS``.
+inference/utils/ours_perception.py is the host side and documents the view offset and left_view that this binds.
+
+``logical_grid(frame=None, cell=None, origin=None)``: the frame on its cell lattice, one character per cell. Without
+``cell`` the lattice is found from the colour edges outside the 4-cell edge band, per axis: for each period p from 2
+to 16 the residue (row or column mod p) holding the most edges must hold at least 60% of them, at least 3 times the
+next residue, on at least 3 distinct lines, from at least 12 edges. Cells are square: p must pass on both axes, and
+the largest such p is taken unless a passing divisor q of p puts more than 1.25 times as many edges on its lines on
+either axis (then the coarser lattice would hide a finer structure, and the next p down is tried). Returns None when
+no p passes. A uniform cell shows its colour character; a cell holding several colours shows ``*`` and is listed in
+``.mixed`` with its colour counts. Pixels outside the whole cells (strips before the origin and after the last whole
+cell) are not shown.
+
+``frame.segmentation8``: ``segment_layer(frame, COLOR_CHARS, connectivity=8)``, cached per frame.
+"""
+
+_OURS_MIN_EDGES = 12
+_OURS_MIN_LINES = 3
+_OURS_SHARE = 0.6
+_OURS_LEAD = 3.0
+_OURS_KEEP = 0.8
+_OURS_MAX_CELL = 16
+_OURS_BAND = 4
+
+
+def _ours_axis(counts):
+    """{p: (passes, residue, edges on that residue)} for one axis' edge counts by position."""
+    total = sum(counts.values())
+    out = {}
+    for p in range(2, _OURS_MAX_CELL + 1):
+        mass, lines = {}, {}
+        for pos, n in counts.items():
+            mass[pos % p] = mass.get(pos % p, 0) + n
+            lines.setdefault(pos % p, set()).add(pos)
+        ranked = sorted(mass.items(), key=lambda kv: (-kv[1], kv[0]))
+        if not ranked:
+            continue
+        residue, n = ranked[0]
+        second = ranked[1][1] if len(ranked) > 1 else 0
+        passes = (total >= _OURS_MIN_EDGES and n >= _OURS_SHARE * total and n >= _OURS_LEAD * second
+                  and len(lines[residue]) >= _OURS_MIN_LINES)
+        out[p] = (passes, residue, n)
+    return out
+
+
+def ours_find_lattice(grid):
+    """(cell, (origin_row, origin_col)) of the frame's square cell lattice, or None (rules in the module doc)."""
+    h = len(grid)
+    w = len(grid[0]) if h else 0
+    rows, cols = {}, {}
+    for r in range(_OURS_BAND, h - _OURS_BAND):
+        row = grid[r]
+        for c in range(max(1, _OURS_BAND), w - _OURS_BAND):
+            if row[c - 1] != row[c]:
+                cols[c] = cols.get(c, 0) + 1
+    for r in range(max(1, _OURS_BAND), h - _OURS_BAND):
+        up, row = grid[r - 1], grid[r]
+        for c in range(_OURS_BAND, w - _OURS_BAND):
+            if up[c] != row[c]:
+                rows[r] = rows.get(r, 0) + 1
+    by_row, by_col = _ours_axis(rows), _ours_axis(cols)
+    valid = [p for p in by_row if p in by_col and by_row[p][0] and by_col[p][0]]
+    for p in sorted(valid, reverse=True):
+        finer = [q for q in valid if q < p and p % q == 0]
+        if all(by_row[q][2] <= by_row[p][2] / _OURS_KEEP and by_col[q][2] <= by_col[p][2] / _OURS_KEEP
+               for q in finer):
+            return p, (by_row[p][1] % p, by_col[p][1] % p)
+    return None
+
+
+class OursLogicalGrid:
+    """A frame read on a lattice: `rows` (one string per cell row), `cell` (h, w) pixels, `origin` (row, col) of
+    cell (0, 0)'s top-left pixel, `mixed` {(i, j): colour counts} for the cells shown as '*', `shape`."""
+
+    def __init__(self, cell, origin, rows, mixed):
+        self.cell, self.origin, self.rows, self.mixed = cell, origin, rows, mixed
+        self.shape = (len(rows), len(rows[0]) if rows else 0)
+
+    def box(self, i, j):
+        """(row0, col0, row1, col1), inclusive, of cell (i, j) in frame pixels."""
+        r0, c0 = self.origin[0] + i * self.cell[0], self.origin[1] + j * self.cell[1]
+        return r0, c0, r0 + self.cell[0] - 1, c0 + self.cell[1] - 1
+
+    def cell_of(self, row, col):
+        """(i, j) of the cell holding frame pixel (row, col), or None outside the whole cells."""
+        i, j = (row - self.origin[0]) // self.cell[0], (col - self.origin[1]) // self.cell[1]
+        if row < self.origin[0] or col < self.origin[1] or i >= self.shape[0] or j >= self.shape[1]:
+            return None
+        return i, j
+
+    def __str__(self):
+        head = (f"cells {self.cell[0]}x{self.cell[1]} px from ({self.origin[0]},{self.origin[1]}): {self.shape[0]} "
+                f"rows x {self.shape[1]} cols; '*' = mixed ({len(self.mixed)}, see .mixed)")
+        return "\n".join([head] + [f"{i:3d} {row}" for i, row in enumerate(self.rows)])
+
+    __repr__ = __str__
+
+
+def _ours_grid_of(frame):
+    grid = getattr(frame, "_grid", frame)
+    return [list(row) for row in grid or ()]
+
+
+def ours_logical_grid(frame, cell, origin, colors):
+    grid = _ours_grid_of(frame)
+    if not grid or not grid[0]:
+        return None
+    if cell is None:
+        found = ours_find_lattice(grid)
+        if found is None:
+            return None
+        p, origin = found
+        cell = (p, p)
+    else:
+        cell = (int(cell), int(cell)) if isinstance(cell, int) else (int(cell[0]), int(cell[1]))
+        origin = (0, 0) if origin is None else (int(origin[0]), int(origin[1]))
+        if cell[0] < 1 or cell[1] < 1 or origin[0] < 0 or origin[1] < 0:
+            raise ValueError("cell must be positive and origin non-negative")
+    h, w = len(grid), len(grid[0])
+    rows, mixed = [], {}
+    for i, top in enumerate(range(origin[0], h - cell[0] + 1, cell[0])):
+        line = []
+        for j, left in enumerate(range(origin[1], w - cell[1] + 1, cell[1])):
+            counts = {}
+            for r in range(top, top + cell[0]):
+                for v in grid[r][left:left + cell[1]]:
+                    counts[v] = counts.get(v, 0) + 1
+            if len(counts) == 1:
+                line.append(colors[max(0, min(15, next(iter(counts))))])
+            else:
+                line.append("*")
+                mixed[(i, j)] = " ".join(f"{colors[max(0, min(15, v))]}{n}" for v, n in
+                                         sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])))
+        rows.append("".join(line))
+    if not rows or not rows[0]:
+        return None
+    return OursLogicalGrid(cell, origin, rows, mixed)
+
+
+def ours_perception_install(runtime_globals, frame_class, segment_layer, colors):
+    """Bind the helpers for one snippet (the bootstrap's hook, with its FrameView, segment_layer and COLOR_CHARS)."""
+
+    def segmentation8(self):
+        if getattr(self, "_ours_seg8", None) is None:
+            self._ours_seg8 = segment_layer(self._grid, colors, connectivity=8)
+        return self._ours_seg8
+
+    frame_class.segmentation8 = property(segmentation8)
+
+    def logical_grid(frame=None, cell=None, origin=None):
+        # the frame on its cell lattice (found if `cell` is None), one character per cell; None if no lattice
+        frame = runtime_globals.get("current_frame") if frame is None else frame
+        return ours_logical_grid(frame, cell, origin, colors)
+
+    runtime_globals["logical_grid"] = logical_grid
+    runtime_globals["view_offset"] = None
+    runtime_globals["left_view"] = []
+
+
+def _ours_view_bind(runtime_globals, payload):
+    """Bind the host's view state: `view_offset`, `left_view` and every frame's `.view_offset`."""
+    offsets = payload.get("offsets") or []
+    for entry, offset in zip(runtime_globals.get("history") or [], offsets):
+        if entry.frame is not None:
+            entry.frame.view_offset = None if offset is None else tuple(offset)
+    current = payload.get("current")
+    current = None if current is None else tuple(current)
+    runtime_globals["view_offset"] = current
+    if runtime_globals.get("current_frame") is not None:
+        runtime_globals["current_frame"].view_offset = current
+    runtime_globals["left_view"] = [dict(item) for item in payload.get("left") or []]
diff --git a/ARC3-Inference/inference/utils/search_helper.py b/ARC3-Inference/inference/utils/search_helper.py
new file mode 100644
index 0000000..ac3333a
--- /dev/null
+++ b/ARC3-Inference/inference/utils/search_helper.py
@@ -0,0 +1,258 @@
+"""ours (OURS_SEARCH_HELPER): `search` and `run_plan` for the analyzer's python sandbox.
+
+Spliced verbatim into the sandbox bootstrap when the flag is on (python_tool_sandbox.py), like segmentation.py:
+stdlib only, no ``from __future__`` import, and apart from four stdlib imports every name it defines at the top
+starts with ``_search``, ``_Search`` or ``search_helper``, so it cannot shadow a bootstrap name.
+``search_helper_globals`` builds the two functions for one snippet.
+
+- ``search`` runs the model's own ``step``/``is_goal``/``heuristic`` in this process: BFS by default, A* with a
+  heuristic, beam search with ``beam=N``. States are deduplicated by ``key(state)``; ``step`` returning None means
+  illegal and ``'dead'`` fatal (both skipped). Its time limit (at most 60 s) is also clamped to what is left of the
+  call's own hard limit minus a reserve, so a search that runs out of time returns ``best_partial`` and the snippet
+  keeps its stdout instead of being killed. A SIGALRM backs up the cooperative clock check for a slow ``step``.
+- ``run_plan`` executes a plan one real action at a time through the snippet's ``action()`` and stops at the first
+  observation that differs from the prediction, before an action the model's own ``step`` calls illegal or fatal
+  from the observed state, at a level end or game over, when an action is not executed (``stop`` names the reason;
+  the harness's stale-state refusal is reported as ``stale_state``, its other refusals still end the snippet), and
+  before the call runs out of time. It goes through the harness's guards like any loop of ``action()`` calls.
+"""
+import heapq
+import signal
+import time
+from collections import deque
+
+_SEARCH_STARTED = time.monotonic()  # the sandbox process started here; the call's hard limit counts from about now
+_SEARCH_TIME_CAP = 60.0
+_SEARCH_NODE_CAP = 300_000
+_SEARCH_RESERVE = 5.0  # seconds a search leaves of the call for the rest of the snippet and the final message
+_SEARCH_PLAN_RESERVE = 3.0  # run_plan starts no action with less than this left of the call
+
+
+class _SearchTimeout(BaseException):
+    """Raised by the alarm while the model's own code runs inside search(); search() catches it."""
+
+
+def _search_no_action(*args, **kwargs):
+    raise RuntimeError("action() cannot run inside search(): search() only explores your own model of the game.")
+
+
+def _search_freeze(value):
+    if isinstance(value, (list, tuple)):
+        return tuple(_search_freeze(item) for item in value)
+    if isinstance(value, (set, frozenset)):
+        return frozenset(_search_freeze(item) for item in value)
+    if isinstance(value, dict):
+        return tuple(sorted(((k, _search_freeze(v)) for k, v in value.items()), key=lambda kv: repr(kv[0])))
+    return value
+
+
+def _search_auto_key(state):
+    try:
+        hash(state)
+        return state
+    except TypeError:
+        return _search_freeze(state)
+
+
+def _search_plan(parents, key):
+    """Actions from the start to KEY along the parent links (each link is (parent key, action))."""
+    plan = []
+    for _ in range(len(parents) + 1):
+        link = parents.get(key)
+        if link is None:
+            break
+        key, action = link
+        plan.append(action)
+    plan.reverse()
+    return plan
+
+
+def _search_loop(start, step, is_goal, actions, keyf, heuristic, beam, max_nodes, end, out, parents, best):
+    """Run the search; record the outcome in OUT['status'] / OUT['goal'] before returning."""
+    acts = actions if callable(actions) else (lambda state, _fixed=list(actions): _fixed)
+    calls = [0]
+
+    def successors(state):
+        for action in acts(state):
+            calls[0] += 1
+            if not calls[0] & 15 and time.monotonic() > end:
+                raise _SearchTimeout()
+            nxt = step(state, action)
+            if nxt is None or (isinstance(nxt, str) and nxt == "dead"):
+                continue
+            yield action, nxt
+
+    def note(key, state, depth, h):
+        score = (h, depth) if heuristic is not None else (-depth,)
+        if best[0] is None or score < best[0]:
+            best[:] = [score, key, state, depth, h]
+
+    def finish(status, goal=None):
+        out["status"], out["goal"] = status, goal
+
+    k0 = keyf(start)
+    parents[k0] = None
+    h0 = heuristic(start) if heuristic is not None else None
+    note(k0, start, 0, h0)
+    if is_goal(start):
+        return finish("found", k0)
+    if beam is None and heuristic is None:  # breadth-first: the first goal generated is a shortest plan
+        queue = deque([(start, k0, 0)])
+        while queue:
+            state, key, depth = queue.popleft()
+            out["expanded"] += 1
+            for action, nxt in successors(state):
+                nk = keyf(nxt)
+                if nk in parents:
+                    continue
+                parents[nk] = (key, action)
+                note(nk, nxt, depth + 1, None)
+                if is_goal(nxt):
+                    return finish("found", nk)
+                if len(parents) >= max_nodes:
+                    return finish("max_nodes")
+                queue.append((nxt, nk, depth + 1))
+        return finish("exhausted")
+    if beam is None:  # A*: goal test when a state is taken from the queue
+        cost = {k0: 0}
+        tie = 0
+        heap = [(h0, 0, tie, k0, start)]
+        while heap:
+            _, neg_g, _, key, state = heapq.heappop(heap)
+            g = -neg_g
+            if g > cost[key]:
+                continue
+            if is_goal(state):
+                return finish("found", key)
+            out["expanded"] += 1
+            for action, nxt in successors(state):
+                nk = keyf(nxt)
+                if g + 1 >= cost.get(nk, g + 2):
+                    continue
+                fresh = nk not in cost
+                cost[nk] = g + 1
+                parents[nk] = (key, action)
+                h = heuristic(nxt)
+                note(nk, nxt, g + 1, h)
+                if fresh and len(parents) >= max_nodes:
+                    return finish("max_nodes")
+                tie += 1
+                heapq.heappush(heap, (g + 1 + h, -(g + 1), tie, nk, nxt))
+        return finish("exhausted")
+    layer, depth = [(start, k0)], 0  # beam: the BEAM best new states of each depth go on
+    while layer:
+        ranked = []
+        for state, key in layer:
+            out["expanded"] += 1
+            for action, nxt in successors(state):
+                nk = keyf(nxt)
+                if nk in parents:
+                    continue
+                parents[nk] = (key, action)
+                h = heuristic(nxt) if heuristic is not None else None
+                note(nk, nxt, depth + 1, h)
+                if is_goal(nxt):
+                    return finish("found", nk)
+                if len(parents) >= max_nodes:
+                    return finish("max_nodes")
+                ranked.append((0 if h is None else h, len(ranked), nxt, nk))
+        ranked.sort(key=lambda item: (item[0], item[1]))
+        layer, depth = [(nxt, nk) for _, _, nxt, nk in ranked[:beam]], depth + 1
+    return finish("exhausted")
+
+
+def search_helper_globals(runtime_globals, timeout_seconds, started=None):
+    """{'search': ..., 'run_plan': ...} for one snippet whose call may run TIMEOUT_SECONDS from STARTED."""
+    call_end = (_SEARCH_STARTED if started is None else started) + max(1, int(timeout_seconds))
+    active = [False]
+
+    def search(start, step, is_goal, actions, key=None, heuristic=None, beam=None, max_nodes=300_000,
+               time_limit=60):
+        t0 = time.monotonic()
+        end = min(t0 + max(0.0, min(float(time_limit), _SEARCH_TIME_CAP)), call_end - _SEARCH_RESERVE)
+        nodes = max(1, min(int(max_nodes), _SEARCH_NODE_CAP))
+        width = None if beam is None else max(1, int(beam))
+        out = {"expanded": 0}
+        parents, best = {}, [None, None, None, 0, None]
+        nested = active[0]
+        saved_action = runtime_globals.get("action")
+        armed, old_handler = [False], None
+
+        def alarm(signum, frame):
+            if armed[0]:
+                armed[0] = False
+                raise _SearchTimeout()
+
+        try:
+            active[0] = True
+            runtime_globals["action"] = _search_no_action
+            remaining = end - time.monotonic()
+            if remaining > 0:
+                if not nested:
+                    try:  # the sandbox runs snippets in its main thread; elsewhere only the clock check applies
+                        old_handler = signal.signal(signal.SIGALRM, alarm)
+                    except ValueError:
+                        old_handler = None
+                    if old_handler is not None:
+                        armed[0] = True
+                        signal.setitimer(signal.ITIMER_REAL, remaining + 1.0)
+                _search_loop(start, step, is_goal, actions, key if key is not None else _search_auto_key,
+                             heuristic, width, nodes, end, out, parents, best)
+        except _SearchTimeout:
+            pass
+        finally:
+            armed[0] = False
+            if old_handler is not None:
+                signal.setitimer(signal.ITIMER_REAL, 0)
+                signal.signal(signal.SIGALRM, old_handler)
+            runtime_globals["action"] = saved_action
+            active[0] = nested
+        status = out.get("status", "timeout")
+        partial = None
+        if status != "found" and best[1] is not None:
+            partial = {"plan": _search_plan(parents, best[1]), "state": best[2], "depth": best[3], "h": best[4]}
+        return {"status": status, "plan": _search_plan(parents, out["goal"]) if status == "found" else None,
+                "expanded": out["expanded"], "best_partial": partial, "seen": len(parents),
+                "seconds": round(time.monotonic() - t0, 2), "time_limit": round(max(0.0, end - t0), 1)}
+
+    def run_plan(plan, observe, predicted, key=None):
+        same = (lambda a, b: a == b) if key is None else (lambda a, b: key(a) == key(b))
+        out = {"executed": 0, "mismatch_at": None, "predicted": None, "observed": None, "stop": "done"}
+        for index, action in enumerate(list(plan)):
+            if call_end - time.monotonic() < _SEARCH_PLAN_RESERVE:
+                out["stop"] = "time"
+                break
+            if callable(predicted):
+                before = observe(runtime_globals.get("current_frame"))
+                expect = predicted(before, action)
+                if expect is None or (isinstance(expect, str) and expect == "dead"):
+                    out.update(mismatch_at=index, predicted=expect, observed=before,
+                               stop="illegal" if expect is None else "dead")
+                    break
+            else:
+                expect = predicted[index] if index < len(predicted) else None
+            try:
+                result = runtime_globals["action"]([action]) or {}
+            except Exception as exc:  # the harness's catchable stale-state refusal: the last action changed nothing
+                stale = runtime_globals.get("StaleStateActionError")
+                if stale is None or not isinstance(exc, stale):
+                    raise
+                out["stop"] = "stale_state"
+                break
+            if not result.get("executed"):
+                out["stop"] = str(result.get("stop_reason") or "not_executed")
+                break
+            out["executed"] += 1
+            ended = next((flag for flag in ("level_completed", "game_over", "run_complete", "done")
+                          if result.get(flag)), None)
+            if ended is not None:
+                out.update(predicted=expect, observed=None, stop="run_complete" if ended == "done" else ended)
+                break
+            observed = observe(runtime_globals.get("current_frame"))
+            out.update(predicted=expect, observed=observed)
+            if expect is not None and not same(observed, expect):
+                out.update(mismatch_at=index, stop="mismatch")
+                break
+        return out
+
+    return {"search": search, "run_plan": run_plan}
