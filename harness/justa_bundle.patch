         if not self._drop_oldest_history_block(history, preserve_recent=max(0, preserve_recent)):
             return list(messages)
         self._note_history_evicted()
         return [system_message, *history]
 
+    # --- ours (M4): the win ledger ----------------------------------------------------------------------------------
+
+    def _ours_ledger_state(self) -> dict[str, Any]:
+        state = getattr(self, "_ours_ledger", None)
+        session = getattr(self, "_session_runtime_dir", None)
+        if state is None or state.get("session") != session:
+            state = {"session": session, "wins": {}, "step": 0, "current": "", "message": None, "head": None}
+            self._ours_ledger = state
+        return state
+
+    def _ours_ledger_observe(self, history_entries: list[HistoryEntry]) -> dict[str, Any] | None:
+        """Record the wins in history not yet recorded and the current level's game overs and resets.
+
+        Returns the record of the level whose winning action is the last history entry (the level-up the opener
+        announces), else None. Only that action's animation chain can still be read, so only its own changes are
+        reported; earlier wins found here (a game resumed mid-way) get records without them."""
+        state = self._ours_ledger_state()
+        entries = list(history_entries or [])
+        if not entries:
+            return None
+        border = max(0, _get_env_int("ARC3_NOOP_GUARD_BORDER", 4))
+        spans = _ours_level_spans(entries)
+        latest = None
+        for span in spans:
+            if span["end"] is None:
+                continue
+            is_last = span["end"] == len(entries) - 1
+            if span["level"] not in state["wins"]:
+                chain = getattr(self, "_last_animation_chain", None) if is_last and _animation_enabled() else None
+                state["wins"][span["level"]] = _ours_win_record(entries, span, chain, border)
+            if is_last:
+                latest = state["wins"][span["level"]]
+        state["step"] = entries[-1].frame.step
+        current = spans[-1]
+        if current["end"] is None:
+            start_step = entries[current["start"]].frame.step
+            so_far = entries[-1].frame.step - start_step
+            manual = [entries[i].frame.step for i in current["resets"]
+                      if not (entries[i].result or {}).get("automatic")]
+            text = (f"- Level {current['level']} (current, since step {start_step}): {so_far} "
+                    f"action{'s' if so_far != 1 else ''} so far, "
+                    f"{_ours_game_over_text(entries, current['game_overs'])}")
+            if manual:
+                text += f"; RESET by you at step{'s' if len(manual) > 1 else ''} " + ", ".join(map(str, manual))
+            state["current"] = text + "."
+        else:
+            state["current"] = ""
+        return latest
+
+    def _ours_ledger_text(self) -> str:
+        state = self._ours_ledger_state()
+        records = [state["wins"][level] for level in sorted(state["wins"])]
+        head = [f"Ledger of exact facts from the recorded boards, as of step {state['step']} (placed here because "
+                "older messages of this conversation were trimmed):"]
+        tail = [state["current"]] if state["current"] else []
+        if _persistent_functions() and getattr(self, "_kept_functions", None):
+            tail.append("- Retained functions: " + ", ".join(sorted(self._kept_functions)) + ".")
+        if records:
+            tail.append("`level_wins` in python holds the win records with their boards.")
+        body = [record["ledger_line"] for record in records]
+        for index, record in enumerate(records):  # oldest first, shortened to fit
+            if len("\n".join([*head, *body, *tail])) <= _OURS_LEDGER_MAX_CHARS:
+                break
+            body[index] = record["ledger_short"]
+        return "\n".join([*head, *body, *tail]) if (body or tail) else ""
+
+    def _ours_level_wins_payload(self) -> list[dict[str, Any]]:
+        """`level_wins` for the sandbox: the records, with history indices for the attempt's first board and the
+        board before the winning action, and the finished board when the animation showed it."""
+        state = self._ours_ledger_state()
+        wins = []
+        for level in sorted(state["wins"]):
+            record = state["wins"][level]
+            terminal = record["terminal"]
+            wins.append({
+                "level": level, "first_step": record["first_step"], "win_step": record["win_step"],
+                "actions": record["actions"], "game_overs": record["game_overs"],
+                "attempt_actions": record["attempt_actions"], "start_index": record["attempt_index"],
+                "prewin_index": record["prewin_index"], "record": "\n".join(record["opener_lines"][:-1]),
+                "win_frame": None if terminal is None else _ascii_frame_view_payload(
+                    Frame(grid=terminal, step=record["win_step"], level=level)),
+            })
+        return wins
+
+    def _ours_ledger_message(self) -> dict[str, Any] | None:
+        text = self._ours_ledger_text()
+        if not text:
+            return None
+        return _mark_control_message({"role": "user", "content": text}, _OURS_LEDGER_KIND)
+
+    def _ours_ledger_tokens(self, message: dict[str, Any] | None) -> int:
+        if message is None:
+            return 0
+        return max(0, self._estimate_request_input_tokens([message]) - self._estimate_request_input_tokens([]))
+
+    def _ours_ledger_reserve(self) -> int:
+        """Room for the ledger in the trimmer's budget: the larger of the pinned one and one built now."""
+        state = self._ours_ledger_state()
+        return max(self._ours_ledger_tokens(state["message"]), self._ours_ledger_tokens(self._ours_ledger_message()))
+
+    def _ours_ledger_pin(self, system_message: dict[str, Any], history: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Messages for the trimmed history, with the ledger right after the system prompt once a trim happened.
+
+        The ledger is rebuilt only when the first history message differs from the one it was last pinned above
+        (history was dropped from the front, or that message itself changed): the request then differs from the
+        previous one right after the system prompt anyway, so a new ledger moves no cached prefix. Otherwise the same
+        message object goes back in the same place, so the prefix the server has cached is unchanged."""
+        state = self._ours_ledger_state()
+        if not history:
+            return [system_message]
+        head = history[0]
+        if state["head"] is None:
+            state["head"] = head  # the first request of the game: nothing trimmed yet
+        elif head is not state["head"] and head != state["head"]:
+            state["message"], state["head"] = self._ours_ledger_message(), head
+        if state["message"] is None:
+            return [system_message, *history]
+        return [system_message, state["message"], *history]
+
     def analyze(
         self,
         state_path: Path,
