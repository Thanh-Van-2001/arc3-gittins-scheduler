+def _ours_grid_change_count(grid_a: Any, grid_b: Any) -> int:
+    count = 0
+    for row_a, row_b in zip(grid_a, grid_b):
+        if row_a != row_b:
+            count += sum(1 for a, b in zip(row_a, row_b) if a != b)
