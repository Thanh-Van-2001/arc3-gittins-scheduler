+def _ours_node_cells(grid: Any, node: dict[str, Any]) -> set[tuple[int, int]]:
+    """A segment's cells: every boundary corner is a cell of it, so flood-fill its colour from the first one."""
+    start = (int(node["boundary"][0][0]), int(node["boundary"][0][1]))
+    value = grid[start[0]][start[1]]
+    rows = len(grid)
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):
+            if 0 <= nr < rows and 0 <= nc < len(grid[nr]) and (nr, nc) not in seen and grid[nr][nc] == value:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return seen
