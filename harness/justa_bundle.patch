+SEARCH_HELPER_ADDENDUM = (
+    "- In every `python` call, `search(start, step, is_goal, actions, key=None, heuristic=None, beam=None, "
+    "max_nodes=300_000, time_limit=60)` searches a model of the game that you write; it never acts.\n"
+    "- `step(state, action)` returns the next state, `None` if the action is illegal there, or `'dead'` if it is "
+    "fatal. `actions` is a list, or a function of the state.\n"
+    "- Breadth-first by default (fewest actions); A* with `heuristic(state)` (lower is closer to the goal); with "
+    "`beam=N`, a beam search keeping the N best states of each depth.\n"
+    "- Repeated states are skipped by `key(state)`, by default the state itself with lists, sets and dicts made "
+    "hashable.\n"
+    "- It returns `status` ('found', 'exhausted': no goal reachable in your model, 'timeout' or 'max_nodes'), `plan`, "
+    "`expanded` and `best_partial` (plan to and state of the closest state by heuristic, else the deepest).\n"
+    "- `time_limit` is at most 60 s and `max_nodes` (distinct states) at most 300,000. A `python` call that calls "
+    "`search(` may run its largest time_limit + 15 s if that exceeds the usual limit.\n"
+    "- `run_plan(plan, observe, predicted, key=None)` executes `plan` one real action at a time through `action(...)` "
+    "and compares `observe(current_frame)` after each action with the prediction (by `key`, if given).\n"
+    "- `predicted` is a list with one expected state per action, or your `step` function, which then predicts each "
+    "state from the observed one.\n"
+    "- `run_plan` stops at the first mismatch, before an action `step` calls illegal or fatal, when an action is not "
+    "executed or ends the level or the attempt, and before the call runs out of time.\n"
+    "- It returns `executed`, `mismatch_at` (plan index, or None), `predicted`, `observed` and `stop` (the reason).\n"
+)
+_SEARCH_TIME_CAP_SECONDS = 60
+_SEARCH_EXTRA_SECONDS = 15
+
+
+def _search_helper_enabled() -> bool:
+    return _get_env_bool("OURS_SEARCH_HELPER", False)
+
+
+@lru_cache(maxsize=1024)
+def _search_calls_in(source: str) -> tuple[tuple[float, ...], frozenset[str]]:
+    """The time_limit of each call to a bare `search(...)` in SOURCE (60 unless a number literal says otherwise,
+    clamped to 0..60), and the names of everything SOURCE calls."""
+    import ast
+
+    try:
+        tree = ast.parse(source)
+    except (SyntaxError, ValueError):
+        return (), frozenset()
+    limits, called = [], set()
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
+            continue
+        called.add(node.func.id)
+        if node.func.id != "search":
+            continue
+        given = [kw.value for kw in node.keywords if kw.arg == "time_limit"]
+        if not given and not any(isinstance(arg, ast.Starred) for arg in node.args) and all(
+                kw.arg is not None for kw in node.keywords):
+            given = node.args[8:9]
+        limit = float(_SEARCH_TIME_CAP_SECONDS)
+        if given:
+            try:
+                value = ast.literal_eval(given[0])
+            except (ValueError, TypeError, SyntaxError, MemoryError, RecursionError):
+                value = None
+            if isinstance(value, (int, float)) and not isinstance(value, bool) and value == value:
+                limit = float(value)
+        limits.append(min(float(_SEARCH_TIME_CAP_SECONDS), max(0.0, limit)))
+    return tuple(limits), frozenset(called)
+
+
+def _search_call_timeout(code: str, retained: dict[str, str] | None, base: int) -> int:
+    """The tool time limit for CODE: BASE, or the largest time_limit of the search( calls it makes (itself or through
+    the retained functions it calls, transitively) plus 15 s when that is longer."""
+    limits, called = _search_calls_in(code)
+    limits, sources = list(limits), dict(retained or {})
+    todo, done = list(called), set()
+    while todo:
+        name = todo.pop()
+        if name in done or name not in sources:
+            continue
+        done.add(name)
+        more, calls = _search_calls_in(sources[name])
+        limits.extend(more)
+        todo.extend(calls)
+    if not limits:
+        return base
+    return max(base, int(-(-max(limits) // 1)) + _SEARCH_EXTRA_SECONDS)
+# --- ours (M4): an exact win ledger, re-pinned at every context trim ----------------------------------------------
+# OURS_WIN_LEDGER=1, read at call time; unset or off leaves every prompt, trim and tool result byte-identical.
