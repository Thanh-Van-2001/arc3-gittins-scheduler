+        used_new.add(match)
+        (turned if new[match]["hash"] == node["hash"] else recolored).append((node, new[match]))
+    rest_new = [node for j, node in enumerate(new) if j not in used_new]
+
+    # Leave out what only follows from the moves: carried parts, covered or uncovered cells, reshaped regions.
+    movers = []
+    for node_a, node_b in moved:
+        (ra, ca), (rb, cb) = place(node_a), place(node_b)
+        movers.append((
+            (rb - ra, cb - ca), _node_bbox(node_a), _node_bbox(node_b),
+            _ours_node_cells(grid_a, node_a), _ours_node_cells(grid_b, node_b),
+        ))
+    covered_after = set().union(*(m[4] for m in movers)) if movers else set()
+    covered_before = set().union(*(m[3] for m in movers)) if movers else set()
+    drop_gone: set[int] = set()
+    drop_new: set[int] = set()
+
+    def inside(box: Any, other: Any) -> bool:
+        return box[0] <= other[0] and box[1] <= other[1] and other[2] <= box[2] and other[3] <= box[3]
+
+    for i, node in enumerate(rest_gone):
+        for shift, box_a, box_b, _, _ in movers:
+            if not inside(box_a, _node_bbox(node)):
+                continue
+            target = (place(node)[0] + shift[0], place(node)[1] + shift[1])
+            hit = next((j for j, other in enumerate(rest_new) if j not in drop_new and other["hash"] == node["hash"]
+                        and place(other) == target and inside(box_b, _node_bbox(other))), None)
+            if hit is not None:
+                drop_gone.add(i)
+                drop_new.add(hit)
+                break
+    cells_gone = {i: _ours_node_cells(grid_a, node) for i, node in enumerate(rest_gone) if i not in drop_gone}
+    cells_new = {j: _ours_node_cells(grid_b, node) for j, node in enumerate(rest_new) if j not in drop_new}
+    for i, cells in cells_gone.items():
+        if movers and cells <= covered_after:
+            drop_gone.add(i)
+    for j, cells in cells_new.items():
+        if movers and cells <= covered_before:
+            drop_new.add(j)
+    for i, cells in cells_gone.items():
+        for j, other in cells_new.items():
+            if rest_new[j]["color"] == rest_gone[i]["color"] and 2 * len(cells & other) >= min(len(cells), len(other)):
+                drop_gone.add(i)
+                drop_new.add(j)
+
+    lines: list[str] = []
+    for node_a, node_b in sorted(moved, key=lambda pair: (-int(pair[0].get("pixels") or 0), place(pair[0]))):
+        rotation = ""
+        rot_a, rot_b = node_a.get("rotation"), node_b.get("rotation")
+        if node_a.get("pose_hash") != node_b.get("pose_hash") and rot_a is not None and rot_b is not None:
+            modulus = 180 if node_a.get("rotational_symmetry") == 2 else 360
+            if (rot_b - rot_a) % modulus:
+                rotation = f" rotated_by {(rot_b - rot_a) % modulus}"
+        if place(node_a) != place(node_b):
+            lines.append(f"moved: color {node_a['color']} {node_a['pixels']}px "
+                         f"{list(place(node_a))}->{list(place(node_b))}{rotation}")
+        elif rotation:
+            lines.append(f"rotated: color {node_a['color']} {node_a['pixels']}px by {rotation.split()[-1]} "
+                         f"at {list(place(node_a))}")
+    for node, _ in turned:
+        lines.append(f"rotated: color {node['color']} {node['pixels']}px at {list(place(node))}")
+
+    def spots(places: list[tuple[int, int]]) -> str:
+        shown = ", ".join(str(list(p)) for p in places[:3])
+        return shown + (", among other places" if len(places) > 3 else "")
+
+    groups: dict[tuple, list[tuple[int, int]]] = {}
+    for node_a, node_b in recolored:
+        groups.setdefault((node_a["color"], node_b["color"], node_a["pixels"]), []).append(place(node_a))
+    for (before, after, pixels), places in sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])):
+        lines.append(f"recolored {before}->{after} ({pixels}px) at {spots(sorted(places))}")
+    for verb, nodes, dropped in (("disappeared", rest_gone, drop_gone), ("appeared", rest_new, drop_new)):
+        by_key: dict[str, list[dict[str, Any]]] = {}
+        for i, node in enumerate(nodes):
+            if i not in dropped:
+                by_key.setdefault(node["hash"], []).append(node)
+        for key, members in sorted(by_key.items(), key=lambda kv: (-int(kv[1][0].get("pixels") or 0), kv[0])):
+            first = members[0]
+            count_a, count_b = len(by_a.get(key, [])), len(by_b.get(key, []))
+            alike = f" ({count_a} alike before, {count_b} after)" if max(count_a, count_b) > 1 else ""
+            lines.append(f"{verb}: color {first['color']} {first['pixels']}px at "
+                         f"{spots(sorted(place(n) for n in members))}{alike}")
+    return lines
+
+
+def _ours_shown_changes(lines: list[str], limit: int) -> str:
+    return "; ".join(lines[:limit]) + ("; more not listed" if len(lines) > limit else "")
+
+
+def _ours_rle(actions: list[str], max_chars: int = 200) -> str:
+    runs: list[list[Any]] = []
+    for action in actions:
+        if runs and runs[-1][0] == action:
+            runs[-1][1] += 1
+        else:
+            runs.append([action, 1])
+    parts = [f"{name} x{count}" if count > 1 else str(name) for name, count in runs]
+    text = ", ".join(parts)
+    if len(text) <= max_chars or len(parts) < 3:
+        return text
+    head: list[str] = []
+    for part in parts[:-1]:
+        if len(", ".join([*head, part])) > max_chars - len(parts[-1]) - 30:
+            break
+        head.append(part)
+    skipped = sum(count for _, count in runs[len(head):-1])
+    return ", ".join(head) + f", ... {skipped} more actions ..., " + parts[-1]
+
+
+def _ours_level_spans(entries: list[HistoryEntry]) -> list[dict[str, Any]]:
+    """History split into levels: entry indices of the level's first board, of its RESETs, of its game overs and
+    of the winning action (None while the level is being played)."""
+    spans: list[dict[str, Any]] = []
+    if not entries:
+        return spans
+    current: dict[str, Any] = {"level": entries[0].frame.level, "start": 0, "resets": [], "game_overs": [],
+                               "end": None}
+    for index in range(1, len(entries)):
+        entry, before = entries[index], entries[index - 1]
+        result = entry.result or {}
+        if str(entry.action or "").strip().upper() == "RESET":
+            current["resets"].append(index)
+        if result.get("game_over"):
+            current["game_overs"].append(index)
+        if (result.get("level_completed") or result.get("run_complete")
+                or entry.frame.level > before.frame.level):
+            current["end"] = index
+            spans.append(current)
+            if result.get("run_complete"):
+                return spans  # the last level is won: there is no current level
+            current = {"level": entry.frame.level, "start": index, "resets": [], "game_overs": [], "end": None}
+    spans.append(current)
+    return spans
+
+
+def _ours_terminal_grid(chain: Any, before_grid: Any, after_grid: Any) -> Any:
+    """The finished board of a level-completing action, from its collapsed animation chain, or None.
+
+    The engine renders the finished board and then, in the same action, the next level's start: the chain's last
+    change is then a jump of at least 20 cells and at least twice every earlier change (the rule checked against the
+    engine's exact winning board on 43 dev levels). Anything else is left unanswered."""
+    if not chain or len(chain) < 3 or chain[0] != before_grid or chain[-1] != after_grid:
+        return None
+    changes = [_ours_grid_change_count(a, b) for a, b in zip(chain, chain[1:])]
+    if changes[-1] >= 20 and changes[-1] >= 2 * max(changes[:-1]):
+        return chain[-2]
+    return None
+
+
+def _ours_game_over_text(entries: list[HistoryEntry], indices: list[int]) -> str:
+    if not indices:
+        return "no game over"
+    parts = [f"step {entries[i].frame.step} (after {entries[i].action})" for i in indices[:4]]
+    more = f" and {len(indices) - 4} more" if len(indices) > 4 else ""
+    return f"{len(indices)} game over{'s' if len(indices) > 1 else ''}: " + ", ".join(parts) + more
+
+
+def _ours_win_record(entries: list[HistoryEntry], span: dict[str, Any], chain: Any, border: int) -> dict[str, Any]:
+    start, end = span["start"], span["end"]
+    level = span["level"]
+    first_step, win_step = entries[start].frame.step, entries[end].frame.step
+    attempt = max([start, *[i for i in span["resets"] if i < end]])
+    prewin = end - 1
+    attempt_actions = [str(entries[i].action) for i in range(attempt + 1, end + 1)]
+    actions = win_step - first_step
+    header = (f"won in {actions} action{'s' if actions != 1 else ''} (steps {first_step + 1}-{win_step}), "
+              + _ours_game_over_text(entries, span["game_overs"]))
+    since = "the level's first board"
+    if attempt != start:
+        header += f"; the winning attempt began after the RESET at step {entries[attempt].frame.step}"
+        since = "that RESET"
+    actions_label = "Actions" if attempt == start else "Actions after that RESET"
+    net_text = ""
+    if prewin != attempt:
+        net = _ours_board_changes(entries[attempt].frame.grid, entries[prewin].frame.grid, border)
+        if net:
+            net_text = (f"Before the winning action, changes since {since} include: "
+                        f"{_ours_shown_changes(net, _OURS_CHANGES_SHOWN)}.")
+        elif entries[attempt].frame.grid == entries[prewin].frame.grid:
+            net_text = f"Before the winning action, the board was the same as at {since}."
+    terminal = _ours_terminal_grid(chain, entries[prewin].frame.grid, entries[end].frame.grid)
+    effect_text = ""
+    if terminal is not None:
+        effect = _ours_board_changes(entries[prewin].frame.grid, terminal, border)
+        if effect:
+            effect_text = ("The winning action itself, before the level ended, made changes including: "
+                           f"{_ours_shown_changes(effect, _OURS_CHANGES_SHOWN - 1)}.")
+        elif terminal == entries[prewin].frame.grid:
+            effect_text = "When the level ended, the board was the same as before the winning action."
+    details = " ".join(text for text in (net_text, effect_text) if text)
+    opener = [f"Level {level} record (exact facts from the recorded boards): {header}.",
+              f"{actions_label}: {_ours_rle(attempt_actions, 120)}."]
+    opener += [text for text in (net_text, effect_text) if text]
+    opener.append(f"({border}-cell edge band not compared; `level_wins` in python has the boards.)")
+    return {
+        "level": level, "first_step": first_step, "win_step": win_step, "actions": actions,
+        "game_overs": [[entries[i].frame.step, str(entries[i].action)] for i in span["game_overs"]],
+        "attempt_index": attempt, "prewin_index": prewin, "attempt_actions": attempt_actions,
+        "terminal": terminal, "opener_lines": opener,
+        "ledger_line": (f"- Level {level}: {header}. {actions_label}: {_ours_rle(attempt_actions, 100)}."
+                        + (" " + details if details else "")),
+        "ledger_short": f"- Level {level}: {header}.",
+    }
+
