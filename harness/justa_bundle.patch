@@ -0,0 +1,607 @@
+"""Ours (OURS_PERCEPTION): exact perception helpers, computed by the harness from the frames it already holds.
+
+On top of Daniel Franzen's harness (Apache-2.0). In exp-073b the model lost calls to views that scroll (bp35 confused
+positions across camera moves; lf52's cart left the view and was hunted with single actions), to lattices read by
+hand (ls20, cn04) and to a diagonal sprite that 4-connected segmentation splits into pixels (su15).
+With OURS_PERCEPTION=1 (read at call time; anything else is off and the harness is byte-identical) this module adds
+the host side; inference/utils/ours_perception_sandbox.py is the sandbox side (logical_grid(), .segmentation8, and
+the binding of what this module sends). No model calls, no actions: everything is computed from the frames.
+
+View shift. For each action whose frame before (A) and frame after (B) are on the same level (not a RESET), the
+harness looks for a whole-view shift s = (dr, dc): the content of A reappears in B moved by s. Candidates: pure
+vertical shifts under which the most board rows of A reappear unchanged in B (at least half of the overlapping rows),
+pure horizontal ones likewise by columns, and shifts voted for by 4x4 blocks of A found at most BLOCK_CAP times in B;
+lines and blocks of one colour do not count. A candidate is checked on the cells p where A differs from itself moved
+by s (A(p) != A(p+s)), the only cells where "the view moved" and "nothing moved" predict different things: p supports
+s if B(p+s) == A(p) and contradicts it if B(p+s) == A(p+s). The ratio is supporting / (supporting + contradicting);
+the explained share is supporting / all the cells p+s that changed or should have changed (a sprite's new cells count
+against s). This is counted over the whole overlap and again without the BORDER-cell edge band, where status bars
+stay put while the view moves. With at least MIN_CHANGED changed cells, s is claimed (CLAIM) if at least MIN_SUPPORT
+cells support it, spread over at least MIN_EXTENT rows and columns, and either over the whole overlap the ratio is at
+least 0.8, the explained share at least 0.75 and the supporting cells span at least half of the overlap in both
+directions, or, when at least BAND_ZERO cells of the band contradict s (a status bar that stays put), without the
+band the ratio is at least 0.9 with the same explained share and a span of a quarter. A sprite moving over a uniform
+floor looks like the view moving the other way: it spans little, and its new cells are not explained (a lone large
+sprite on an empty floor is pixel for pixel a scroll; it is not claimed, but may make the offset unknown). Once a
+game's view has moved under CLAIM, the looser CLAIM_AFTER_SCROLL applies: a camera that follows the player or a cart
+leaves more of the frame in place. If no candidate is claimed but one passes the weaker UNSURE (or
+UNSURE_AFTER_SCROLL once the game has scrolled) with at least UNSURE_SUPPORT supporting cells, the offset becomes
+unknown (None) until the next RESET or level, rather than possibly wrong; the [view] line says so only in a game that
+has scrolled. Measured on every recorded run: docs/research/beat-tufa/patch-perception.md.
+
+The offset: world (row, col) = frame (row, col) + offset; (0, 0) on the first frame of a level and after every RESET
+(a RESET restores the level start); each claimed shift s subtracts s. The action's echo gets a `[view]` line when
+the view moved during that call, one when the offset became unknown in a game that has scrolled, and one when objects
+left the view; the sandbox gets `view_offset` and every history frame's `.view_offset`.
+
+Left the view. When a step leaves no cell of colour C in view (same level, no RESET), an object of colour C in the
+frame before (4-connected, under AREA_PX cells, not lying inside the BORDER-cell edge band) is recorded if the view
+shift moved all of it into the band or past the edge, or if it touched an edge it was moving toward: one step earlier
+an object of colour C overlapped it across the move, lay further from that edge and was at least as long along the
+move. An object that vanishes in place (a blinking marker) or stays in place in a new colour is not recorded. The
+record holds that frame's step and the box in frame and world coordinates. It stays in `left_view` while its colour
+is out of view on that level; it is dropped when the colour is seen again, at a RESET and at a level change.
+
+Stdlib only. Each history entry is processed once; a rewritten history is processed again from the start. Nothing
+here may stop a game: an error turns the helpers off for that game (view_offset None) and is logged.
+"""
+from __future__ import annotations
+
+import logging
+import os
+from collections import Counter
+
+log = logging.getLogger(__name__)
+
+COLOR_CHARS = "WwgGcBMPRbSYOrNp"  # inference.utils.grid_utils.ARC_COLOR_CHARS
+BLOCK = 4
+BLOCK_CAP = 3  # a row, column or block of A found more often than this in B does not vote
+CANDIDATES = 4  # block-voted candidates
+LINE_CANDIDATES = 2  # row-matched and column-matched candidates, each
+MIN_CHANGED = 32
+MIN_SUPPORT = 64
+BAND_ZERO = 16
+# (ratio, explained, span) over the whole overlap, or (ratio, explained, span, contradicting cells needed in the edge
+# band) over the overlap without the band: the band is left out only when something there stays put (a status bar)
+CLAIM = ((0.8, 0.75, 0.5), (0.9, 0.75, 0.25, BAND_ZERO))
+CLAIM_AFTER_SCROLL = ((0.7, 0.65, 0.5), (0.8, 0.65, 0.25, BAND_ZERO))  # the same, once the game has scrolled
+UNSURE = ((0.75, 0.65, 0.5), (0.8, 0.65, 0.25, 0))  # with UNSURE_SUPPORT: the offset becomes unknown, silently
+UNSURE_AFTER_SCROLL = ((0.6, 0.5, 0.5), (0.6, 0.5, 0.25, 0))  # once the game has scrolled; the [view] line says so
+UNSURE_SUPPORT = 32
+MIN_EXTENT = 8  # the supporting cells span at least this many rows and columns
+AREA_PX = 512
+BORDER = 4
+SHOWN = 3
+
+PROMPT_LINES = (
+    "- `view_offset` is (dr, dc) with world (row, col) = frame (row, col) + view_offset on this level: (0, 0) at "
+    "the level start and after a RESET, None if the harness could not tell. Each frame has `.view_offset`; when the "
+    "whole view scrolls, `action()` prints a `[view]` line.\n"
+    "- `left_view` lists objects that left the view (a scroll moved them out, or they moved out at an edge): "
+    "colour, pixels, last step seen, frame box and world box; an entry goes when that colour is in view again.\n"
+    "- `logical_grid(frame=None, cell=None, origin=None)` finds the frame's cell lattice and returns one character "
+    "per cell (its colour, `*` for a cell holding several; `.mixed` lists them), or None if there is none; pass "
+    "`cell=(h, w), origin=(row, col)` to set it.\n"
+    "- `frame.segmentation8` is `frame.segmentation` with 8-connected objects (cells touching at a corner join).\n"
+)
+
+
+def enabled() -> bool:
+    """OURS_PERCEPTION, read at call time."""
+    return os.environ.get("OURS_PERCEPTION", "").strip().lower() in ("1", "on", "true", "yes")
+
+
+def system_prompt_lines() -> str:
+    """The system-prompt documentation; empty when the flag is off."""
+    return PROMPT_LINES if enabled() else ""
+
+
+# --- the view shift ------------------------------------------------------------------------------------------------
+
+
+def as_rows(grid) -> tuple | None:
+    """A frame as a tuple of bytes rows (values 0-15), or None if it is not a rectangular grid of such values."""
+    try:
+        rows = tuple(bytes(row) for row in grid or ())
+    except (TypeError, ValueError):
+        return None
+    if not rows or not rows[0] or any(len(row) != len(rows[0]) for row in rows) or max(map(max, rows)) > 15:
+        return None
+    return rows
+
+
+def _changed(a: tuple, b: tuple) -> int:
+    return sum(1 for ra, rb in zip(a, b) if ra != rb for x, y in zip(ra, rb) if x != y)
+
+
+def _line_votes(a: tuple, b: tuple) -> list:
+    """Pure vertical shifts ranked by the number of overlapping board rows of `a` (not of one colour) found
+    unchanged in `b` at the shifted place, and pure horizontal ones likewise by columns (the board leaves out the edge
+    band); LINE_CANDIDATES of each at most, best first, each with at least 3 matching lines and at least half of the
+    overlapping lines matching."""
+    h, w = len(a), len(a[0])
+    out = []
+    for lines_a, lines_b, as_shift in (
+            ([row[BORDER:w - BORDER] for row in a], [row[BORDER:w - BORDER] for row in b], lambda d: (d, 0)),
+            ([bytes(col) for col in zip(*a[BORDER:h - BORDER])], [bytes(col) for col in zip(*b[BORDER:h - BORDER])],
+             lambda d: (0, d))):
+        n = len(lines_a)
+        plain = [not line or line.count(line[0]) == len(line) for line in lines_a]
+        ranked = []
+        for d in range(1 - n, n):
+            if d == 0:
+                continue
+            lo, hi = max(0, -d), min(n, n - d)
+            tried = matched = 0
+            for i in range(lo, hi):
+                if not plain[i]:
+                    tried += 1
+                    matched += lines_a[i] == lines_b[i + d]
+            if matched >= 3 and 2 * matched >= tried:
+                ranked.append((matched, -abs(d), d))
+        ranked.sort(reverse=True)
+        out += [as_shift(d) for *_, d in ranked[:LINE_CANDIDATES]]
+    return out
+
+
+def _block_votes(a: tuple, b: tuple) -> list:
+    """Shifts voted for by 4x4 blocks of `a` (every second row and column, not one colour) that occur at most
+    BLOCK_CAP times in `b`, most votes first."""
+    h, w = len(a), len(a[0])
+    k = BLOCK
+    if h < k or w < k:
+        return []
+    grams_b = [[row[c:c + k] for c in range(w - k + 1)] for row in b]
+    where: dict = {}
+    for r in range(h - k + 1):
+        g0, g1, g2, g3 = grams_b[r], grams_b[r + 1], grams_b[r + 2], grams_b[r + 3]
+        for c in range(w - k + 1):
+            key = (g0[c], g1[c], g2[c], g3[c])
+            seen = where.get(key)
+            if seen is None:
+                where[key] = [(r, c)]
+            elif len(seen) <= BLOCK_CAP:
+                seen.append((r, c))
+    votes: Counter = Counter()
+    for r in range(0, h - k + 1, 2):
+        rows = a[r:r + k]
+        for c in range(0, w - k + 1, 2):
+            key = tuple(row[c:c + k] for row in rows)
+            if key[0] == key[1] == key[2] == key[3] and key[0].count(key[0][0]) == k:
+                continue
+            seen = where.get(key)
+            if not seen or len(seen) > BLOCK_CAP:
+                continue
+            for rb, cb in seen:
+                if rb != r or cb != c:
+                    votes[(rb - r, cb - c)] += 1
+    return [s for s, _ in votes.most_common(CANDIDATES)]
+
+
+def candidates(a: tuple, b: tuple) -> list:
+    """The shifts worth checking: row- and column-voted first, then block-voted, without repeats."""
+    out = []
+    for s in _line_votes(a, b) + _block_votes(a, b):
+        if s not in out and s != (0, 0):
+            out.append(s)
+    return out
+
+
+def _tally() -> dict:
+    return {"shift": 0, "zero": 0, "other": 0, "new": 0, "rows": [], "cmin": 1 << 30, "cmax": -1, "overlap": (0, 0)}
+
+
+def _finish(t: dict) -> dict:
+    tried = t["shift"] + t["zero"]
+    rows_over, cols_over = t["overlap"]
+    rext = t["rows"][-1] - t["rows"][0] + 1 if t["rows"] else 0
+    cext = t["cmax"] - t["cmin"] + 1 if t["rows"] else 0
+    span = min(rext / rows_over, cext / cols_over) if rext and rows_over and cols_over else 0.0
+    seen = tried + t["other"] + t["new"]
+    return {"shift": t["shift"], "zero": t["zero"], "other": t["other"], "new": t["new"],
+            "ratio": t["shift"] / tried if tried else 0.0, "explained": t["shift"] / seen if seen else 0.0,
+            "span": span, "extent": min(rext, cext)}
+
+
+def support(a: tuple, b: tuple, s: tuple) -> tuple:
+    """The evidence for shift s, over the whole overlap and over the overlap without the edge band. Over the cells p
+    with A(p) != A(p+s): `shift` support s (B(p+s) == A(p)), `zero` contradict it (B(p+s) == A(p+s)), `other` do
+    neither; `new` counts the cells p+s that changed (B(p+s) != A(p+s)) although A(p) == A(p+s), which s cannot
+    explain. `ratio` = shift / (shift + zero); `explained` = shift / (shift + zero + other + new), the share of the
+    cells that changed or should have changed that s explains; `span` the smaller of the row and column extents of
+    the supporting cells relative to the overlap, `extent` the smaller of the two in cells."""
+    dr, dc = s
+    h, w = len(a), len(a[0])
+    r0, r1 = max(0, -dr), min(h, h - dr)
+    c0, c1 = max(0, -dc), min(w, w - dc)
+    rb0, rb1 = max(BORDER, BORDER - dr), min(h - BORDER, h - BORDER - dr)  # rows with p and p+s off the band
+    cb0, cb1 = max(BORDER, BORDER - dc) - c0, min(w - BORDER, w - BORDER - dc) - c0  # the same, as slice indices
+    whole, board = _tally(), _tally()
+    whole["overlap"] = (max(0, r1 - r0), max(0, c1 - c0))
+    board["overlap"] = (max(0, rb1 - rb0), max(0, cb1 - cb0))
+    for r in range(r0, r1):
+        xa = a[r][c0:c1]
+        ya = a[r + dr][c0 + dc:c1 + dc]
+        zb = b[r + dr][c0 + dc:c1 + dc]
+        if xa == ya and zb == ya:
+            continue
+        in_rows = rb0 <= r < rb1
+        hit = hit_board = False
+        for i, (x, y, z) in enumerate(zip(xa, ya, zb)):
+            if x == y:
+                if z != y:
+                    whole["new"] += 1
+                    if in_rows and cb0 <= i < cb1:
+                        board["new"] += 1
+                continue
+            on_board = in_rows and cb0 <= i < cb1
+            if z == x:
+                whole["shift"] += 1
+                whole["cmin"], whole["cmax"], hit = min(whole["cmin"], i), max(whole["cmax"], i), True
+                if on_board:
+                    board["shift"] += 1
+                    board["cmin"], board["cmax"], hit_board = min(board["cmin"], i), max(board["cmax"], i), True
+            else:
+                kind = "zero" if z == y else "other"
+                whole[kind] += 1
+                if on_board:
+                    board[kind] += 1
+        if hit:
+            whole["rows"].append(r)
+        if hit_board:
+            board["rows"].append(r)
+    return _finish(whole), _finish(board)
+
+
+def _passes(evidence: dict, ratio: float, explained: float, span: float, support: int) -> bool:
+    return (evidence["shift"] >= support and evidence["ratio"] >= ratio and evidence["explained"] >= explained
+            and evidence["span"] >= span and evidence["extent"] >= MIN_EXTENT)
+
+
+def _claimed(whole: dict, board: dict, rule: tuple, support: int = MIN_SUPPORT) -> bool:
+    (ratio, explained, span, band) = rule[1]
+    return _passes(whole, *rule[0], support) or (whole["zero"] - board["zero"] >= band
+                                                  and _passes(board, ratio, explained, span, support))
+
+
+def measure(a, b, scrolled: bool = False) -> dict:
+    """The verdict for frames a and b ("shift", "unsure" or "none"), the chosen candidate and its evidence.
+
+    `scrolled`: this game's view has moved before under the CLAIM rule, so the looser CLAIM_AFTER_SCROLL and
+    UNSURE_AFTER_SCROLL apply (a game whose camera follows its objects leaves more of the frame in place)."""
+    a, b = as_rows(a), as_rows(b)
+    if a is None or b is None or len(a) != len(b) or len(a[0]) != len(b[0]):
+        return {"verdict": "none", "why": "not two frames of one shape"}
+    changed = _changed(a, b)
+    if changed < MIN_CHANGED:
+        return {"verdict": "none", "changed": changed}
+    best = None
+    unsure = None
+    doubt = UNSURE_AFTER_SCROLL if scrolled else UNSURE
+    for s in candidates(a, b):
+        whole, board = support(a, b, s)
+        strict = _claimed(whole, board, CLAIM)
+        claimed = strict or (scrolled and _claimed(whole, board, CLAIM_AFTER_SCROLL))
+        key = (claimed, whole["shift"] - whole["zero"])
+        if best is None or key > best[0]:
+            best = (key, s, whole, board, strict)
+        if unsure is None and _claimed(whole, board, doubt, UNSURE_SUPPORT):
+            unsure = s
+    if best is None:
+        return {"verdict": "none", "changed": changed}
+    (claimed, _), s, whole, board, strict = best
+    out = {"changed": changed, "candidate": s, "whole": whole, "board": board, "strict": strict}
+    if claimed:
+        return {**out, "verdict": "shift"}
+    if unsure is not None:
+        return {**out, "verdict": "unsure", "unsure_candidate": unsure}
+    return {**out, "verdict": "none"}
+
+
+def view_shift(a, b, scrolled: bool = False):
+    """(dr, dc) by which the whole view of frame a moved in frame b, "unsure", or None."""
+    m = measure(a, b, scrolled)
+    if m["verdict"] == "shift":
+        return tuple(m["candidate"])
+    return "unsure" if m["verdict"] == "unsure" else None
+
+
+# --- objects that left the view --------------------------------------------------------------------------------------
+
+
+def _components(rows: tuple, colour: int) -> list:
+    """4-connected components of one colour: (pixels, (r0, c0, r1, c1)); pixels capped at AREA_PX."""
+    h, w = len(rows), len(rows[0])
+    seen = set()
+    out = []
+    for r in range(h):
+        row = rows[r]
+        start = row.find(colour)
+        while start != -1:
+            if (r, start) not in seen:
+                seen.add((r, start))
+                stack = [(r, start)]
+                n, r0, c0, r1, c1 = 0, r, start, r, start
+                while stack:
+                    y, x = stack.pop()
+                    n += 1
+                    r0, r1, c0, c1 = min(r0, y), max(r1, y), min(c0, x), max(c1, x)
+                    for yy, xx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
+                        if 0 <= yy < h and 0 <= xx < w and (yy, xx) not in seen and rows[yy][xx] == colour:
+                            seen.add((yy, xx))
+                            stack.append((yy, xx))
+                out.append((min(n, AREA_PX), (r0, c0, r1, c1)))
+            start = row.find(colour, start + 1)
+    return out
+
+
+def _pushed(box: tuple, s: tuple, h: int, w: int) -> list:
+    """The frame edges past which the view shift s moves the whole box (into the edge band or beyond)."""
+    r0, c0, r1, c1 = box
+    dr, dc = s
+    sides = []
+    if r1 + dr < BORDER:
+        sides.append("top")
+    if r0 + dr >= h - BORDER:
+        sides.append("bottom")
+    if c1 + dc < BORDER:
+        sides.append("left")
+    if c0 + dc >= w - BORDER:
+        sides.append("right")
+    return sides
+
+
+def _toward(box: tuple, earlier: tuple, side: str) -> bool:
+    """`earlier` (a box one step before, in this frame's coordinates) is the object moving toward `side`: it overlaps
+    `box` across the move, lies further from that edge and is at least as long along the move (an object leaving the
+    view only gets cut by the edge)."""
+    r0, c0, r1, c1 = box
+    q0, d0, q1, d1 = earlier
+    if side in ("left", "right"):
+        if q0 > r1 or r0 > q1 or d1 - d0 < c1 - c0:
+            return False
+        return d0 < c0 if side == "right" else d1 > c1
+    if d0 > c1 or c0 > d1 or q1 - q0 < r1 - r0:
+        return False
+    return q0 < r0 if side == "bottom" else q1 > r1
+
+
+def _recoloured(a: tuple, b: tuple, colour: int, box: tuple) -> bool:
+    """The object of `colour` in `box` is still in place in `b` in a new colour: its cells there hold one colour that
+    no cell around them (in the box or one cell out) holds."""
+    r0, c0, r1, c1 = box
+    inside, around = set(), set()
+    for r in range(max(0, r0 - 1), min(len(a), r1 + 2)):
+        for c in range(max(0, c0 - 1), min(len(a[0]), c1 + 2)):
+            (inside if r0 <= r <= r1 and c0 <= c <= c1 and a[r][c] == colour else around).add(b[r][c])
+    return len(inside) == 1 and not inside & around
+
+
+def exits(a: tuple, b: tuple, s: tuple, step: int, offset, before=None) -> list:
+    """Records of the objects of `a` whose colour is nowhere in `b` and that left the view: the view shift s moved
+    them past the frame edge, or they touched an edge that they were moving toward in the frame before `a`; not an
+    object that is still in place in a new colour. `before` is (that frame, the shift from it to `a`), or None."""
+    gone = set().union(*map(set, a)) - set().union(*map(set, b))
+    h, w = len(a), len(a[0])
+    records = []
+    for colour in sorted(gone):
+        earlier = None
+        for px, box in _components(a, colour):
+            r0, c0, r1, c1 = box
+            if px >= AREA_PX or r1 < BORDER or r0 >= h - BORDER or c1 < BORDER or c0 >= w - BORDER:
+                continue
+            sides = _pushed(box, s, h, w)
+            if not sides and before is not None:
+                if earlier is None:
+                    (dr, dc) = before[1]
+                    earlier = [(q0 + dr, d0 + dc, q1 + dr, d1 + dc)
+                               for _, (q0, d0, q1, d1) in _components(before[0], colour)]
+                touching = [side for side, hit in (("top", r0 == 0), ("bottom", r1 == h - 1), ("left", c0 == 0),
+                                                    ("right", c1 == w - 1)) if hit]
+                sides = [side for side in touching if any(_toward(box, e, side) for e in earlier)]
+            if not sides or _recoloured(a, b, colour, box):
+                continue
+            world = None if offset is None else [r0 + offset[0], c0 + offset[1], r1 + offset[0], c1 + offset[1]]
+            records.append({"colour": COLOR_CHARS[colour], "pixels": px, "step": step, "box": [r0, c0, r1, c1],
+                            "world_box": world, "edge": "/".join(sides)})
+    return records
+
+
+# --- the tracker -----------------------------------------------------------------------------------------------------
+
+
+def _parts(entry) -> tuple:
+    """(action, rows, step, level) of a history payload dict or a HistoryEntry-like object."""
+    if isinstance(entry, dict):
+        frame = entry.get("frame") or {}
+        grid, step, level = frame.get("grid"), frame.get("step"), frame.get("level")
+        action = entry.get("action")
+    else:
+        frame = getattr(entry, "frame", None)
+        grid, step, level = getattr(frame, "grid", None), getattr(frame, "step", 0), getattr(frame, "level", 1)
+        action = getattr(entry, "action", "")
+    return str(action or "").strip(), as_rows(grid), int(step or 0), int(level or 1)
+
+
+class ViewTracker:
+    """A game's history, processed incrementally into per-entry view offsets, shifts and left-view records."""
+
+    def __init__(self):
+        self.error = ""
+        self._reset()
+
+    def _reset(self) -> None:
+        self.offsets: list = []  # per entry: (dr, dc), world = frame + offset; None when unknown
+        self.shifts: list = []  # per entry: (step, (dr, dc)) when its action moved the view, else None
+        self.exits: list = []  # per entry: records of objects that left the view on its action
+        self.resets: list = []  # per entry: True for a RESET or a level start
+        self.unsure: list = []  # per entry: True when its action made the offset unknown
+        self.steps: list = []  # per entry: its frame's step
+        self.announce: list = []  # per entry: an unknown offset there is said in the [view] line
+        self.scrolled = False  # the view has moved under the CLAIM rule in this game
+        self.left: list = []  # the current level's records whose colour is still out of view
+        self.count = 0
+        self._key = None
+        self._prev = None  # (rows, level, step) of the last entry
+        self._before = None  # (rows of the entry before the last, shift from it to the last), when both are known
+        self._current = None  # rows of the last entry, for the current frame
+
+    def update(self, history: list) -> int:
+        """Process the entries not seen yet (all of them if the history was rewritten); returns how many."""
+        if len(history) < self.count or (self.count and self._entry_key(history[self.count - 1]) != self._key):
+            self._reset()
+        start = self.count
+        for entry in history[start:]:
+            action, rows, step, level = _parts(entry)
+            self._add(action, rows, step, level)
+            self.count += 1
+            self._key = (step, action, hash(rows))
+        return self.count - start
+
+    @staticmethod
+    def _entry_key(entry) -> tuple:
+        action, rows, step, _ = _parts(entry)
+        return step, action, hash(rows)
+
+    def _add(self, action: str, rows, step: int, level: int) -> None:
+        prev, self._prev = self._prev, (rows, level, step)
+        before, self._before = self._before, None
+        self._current = rows
+        restart = prev is None or not action or level != prev[1] or action.upper() == "RESET"
+        if restart:
+            self._append(step, (0, 0) if rows is not None else None, None, [], True, False, False)
+            self.left = []
+            return
+        a_rows, _, a_step = prev
+        offset = self.offsets[-1]
+        if rows is None or a_rows is None or len(rows) != len(a_rows) or len(rows[0]) != len(a_rows[0]):
+            self._append(step, None, None, [], False, offset is not None, self.scrolled)
+            return
+        if before is not None and (len(before[0]) != len(a_rows) or len(before[0][0]) != len(a_rows[0])):
+            before = None
+        m = measure(a_rows, rows, self.scrolled)
+        announce = self.scrolled
+        moved = None
+        s = (0, 0)
+        if m["verdict"] == "unsure":
+            self._append(step, None, None, exits(a_rows, rows, s, a_step, offset, before), False, offset is not None,
+                         announce)
+        else:
+            if m["verdict"] == "shift":
+                s = tuple(m["candidate"])
+                moved = (step, s)
+                self.scrolled = self.scrolled or m["strict"]
+                if offset is not None:
+                    offset = (offset[0] - s[0], offset[1] - s[1])
+            self._append(step, offset, moved, exits(a_rows, rows, s, a_step, self.offsets[-1], before), False,
+                         False, False)
+            self._before = (a_rows, s)
+        here = set().union(*map(set, rows))
+        self.left = [x for x in self.left if COLOR_CHARS.index(x["colour"]) not in here] + self.exits[-1]
+
+    def _append(self, step: int, offset, moved, out: list, reset: bool, unsure: bool, announce: bool) -> None:
+        self.announce.append(unsure and announce)
+        self.steps.append(step)
+        self.offsets.append(offset)
+        self.shifts.append(moved)
+        self.exits.append(out)
+        self.resets.append(reset)
+        self.unsure.append(unsure)
+
+    def payload(self, current_grid=None) -> dict:
+        """What the sandbox binds: the offset of every history entry, of the current frame, and `left_view`."""
+        if self.error:
+            return {"error": self.error, "offsets": [None] * self.count, "current": None, "left": []}
+        current = self.offsets[-1] if self.offsets else None
+        if current_grid is not None and as_rows(current_grid) != self._current:
+            current = None
+        return {"offsets": [None if o is None else list(o) for o in self.offsets],
+                "current": None if current is None else list(current), "left": [dict(x) for x in self.left]}
+
+    def line(self, start: int) -> str:
+        """The `[view]` line for the entries from `start` on (one action() call), or ""."""
+        if self.error or start >= self.count or start < 0:
+            return ""
+        parts = []
+        moves = [m for m in self.shifts[start:] if m is not None]
+        if moves:
+            shown = moves[:SHOWN]
+            more = f" +{len(moves) - SHOWN} more" if len(moves) > SHOWN else ""
+            steps = ", ".join(str(st) for st, _ in shown)
+            deltas = ", ".join(f"({dr:+d},{dc:+d})" for _, (dr, dc) in shown)
+            head = (f"scrolled at step {steps}: content moved {deltas}" if len(moves) == 1 else
+                    f"scrolled {len(moves)} times (steps {steps}{more}): content moved {deltas}{more}")
+            offset = self.offsets[-1]
+            reset = " after the RESET" if self.resets[-1] else ""
+            parts.append(head + "; view_offset now " + ("unknown" if offset is None else
+                                                        f"({offset[0]:+d},{offset[1]:+d}){reset}"))
+        lost = [i for i in range(start, self.count) if self.announce[i]]
+        if lost:
+            parts.append(f"the frame changed at step {self.steps[lost[0]]} in a way that may be a scroll; "
+                         "view_offset is unknown until the next RESET or level")
+        gone = [x for items in self.exits[start:] for x in items]
+        if gone:
+            shown = "; ".join(f"{x['colour']} {x['pixels']}px at the {x['edge']} edge (last seen step {x['step']}, "
+                              f"rows {x['box'][0]}-{x['box'][2]}, cols {x['box'][1]}-{x['box'][3]})"
+                              for x in gone[:2])
+            more = f"; +{len(gone) - 2} more" if len(gone) > 2 else ""
+            parts.append(f"left the view: {shown}{more}; see left_view")
+        return "\n".join("[view] " + p for p in parts)
+
+
+# --- harness glue (tool_agent.py calls these; each is a no-op with the flag off) --------------------------------------
+
+
+def _tracker(agent) -> ViewTracker:
+    tracker = getattr(agent, "_ours_view_tracker", None)
+    if tracker is None:
+        tracker = agent._ours_view_tracker = ViewTracker()
+    return tracker
+
+
+def attach(agent, serialize, on: bool):
+    """Wrap `_run_python_tool`'s state serializer so the state carries "ours_view"; `serialize` itself when off."""
+    if not on:
+        return serialize
+    tracker = _tracker(agent)
+
+    def serialize_with_view(**kwargs):
+        state = serialize(**kwargs)
+        if not tracker.error:
+            try:
+                tracker.update(state.get("history") or [])
+            except Exception as exc:
+                tracker.error = f"internal error ({type(exc).__name__}); view tracking is off for this game"
+                log.warning("ours view tracking disabled for this game", exc_info=True)
+        try:
+            state["ours_view"] = tracker.payload((state.get("current_frame") or {}).get("grid"))
+        except Exception as exc:
+            tracker.error = f"internal error ({type(exc).__name__}); view tracking is off for this game"
+            log.warning("ours view tracking disabled for this game", exc_info=True)
+            state["ours_view"] = tracker.payload()
+        return state
+
+    return serialize_with_view
+
+
+def wrap_actions(agent, handle_action, on: bool):
+    """Wrap `_run_python_tool`'s action handler so an action() call that moved the view, or after which an object
+    left it, prints its `[view]` lines with its echo; `handle_action` itself when off."""
+    if not on:
+        return handle_action
+    tracker = _tracker(agent)
+
+    def handle_with_view(actions, **kwargs):
+        start = tracker.count
+        reply = handle_action(actions, **kwargs)
+        try:
+            line = tracker.line(start)
+            result = reply.get("action_result") if isinstance(reply, dict) else None
+            if line and isinstance(result, dict):
+                echo = result.get("action_echo")
+                result["action_echo"] = f"{echo}\n{line}" if echo else line
+        except Exception:
+            log.warning("ours view line failed", exc_info=True)
+        return reply
+
+    return handle_with_view
diff --git a/ARC3-Inference/inference/utils/ours_perception_sandbox.py b/ARC3-Inference/inference/utils/ours_perception_sandbox.py
