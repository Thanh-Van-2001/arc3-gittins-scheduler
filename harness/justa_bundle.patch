@@ -0,0 +1,84 @@
+"""ours (M1c, patch ours-05-level-mem): the host side of `mem`, a per-level data store for the python sandbox.
+
+OURS_LEVEL_MEM=1 turns it on (read at call time; off by default, and then nothing here runs). The sandbox starts
+every python call with fresh variables, on purpose: data computed from an earlier board goes stale. So models
+rebuild the same structures call after call, or lose them to a NameError. `mem` keeps plain JSON data across calls,
+but only on the level it was written on, and every tool result lists its keys with the `current_frame.step` at which
+each was last written, so the age of a value is visible.
+
+A store is {"scope": [game session, level], "values": {...}, "steps": {key: step}, "bytes": n, "note": text}. It
+goes to the sandbox with a call's initial state and comes back in the call's final message, checked there
+(python_tool_sandbox.py: plain JSON within CAP_BYTES, or a refusal with the reason). The host keeps the store as it
+was when nothing comes back (a timeout, a crashed sandbox) or when the sandbox refused it, and empties it when the
+game or the level is not the one it was written on, including a level that changed during the call itself: what
+that call wrote may describe the old board.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+CAP_BYTES = 200 * 1024
+SHOWN_KEYS = 40
+
+
+def _empty(session: str, level: Any, note: str = "") -> dict[str, Any]:
+    return {"scope": [session, level], "values": {}, "steps": {}, "bytes": 2, "note": note}
+
+
+def open_store(store: dict[str, Any] | None, session: Any, level: Any) -> dict[str, Any]:
+    """The store for a call in game SESSION on LEVEL: STORE itself, or an empty one if STORE was written elsewhere."""
+    session = str(session)
+    if store is not None and store["scope"] == [session, level]:
+        return store
+    note = ""
+    if store is not None and store["values"] and store["scope"][0] == session:
+        note = f"mem was emptied because the level changed (level {store['scope'][1]} -> {level})."
+    return _empty(session, level, note)
+
+
+def sandbox_payload(store: dict[str, Any]) -> dict[str, Any]:
+    """What the sandbox gets with the call's initial state (it builds `mem` from this)."""
+    return {"values": store["values"], "steps": store["steps"], "cap": CAP_BYTES}
+
+
+def close_store(store: dict[str, Any], returned: Any, level: Any, step: Any) -> tuple[dict[str, Any], str]:
+    """(the store to keep, the text of the tool result's "mem" field, "" for none) after a call that ended on LEVEL
+    at STEP; RETURNED is what the sandbox sent back (None when the call timed out or the sandbox died)."""
+    session, start_level = store["scope"]
+    if level != start_level:
+        wrote = isinstance(returned, dict) and bool(returned.get("values"))
+        if not (store["values"] or wrote):
+            return _empty(session, level), ""
+        return _empty(session, level), (f"mem was emptied because the level changed during this call (level "
+                                        f"{start_level} -> {level}); nothing this call wrote to it was kept.")
+    notes = [store["note"]] if store.get("note") else []
+    kept = dict(store, note="")
+    if not isinstance(returned, dict):
+        if store["values"]:
+            notes.append("This call did not finish, so mem keeps its contents from before it.")
+    elif "refused" in returned:
+        notes.append(f"NOT SAVED: {returned['refused']}. mem keeps its contents from before this call.")
+    else:
+        values, steps = returned.get("values") or {}, returned.get("steps") or {}
+        kept.update(values=values, steps={key: step if steps.get(key) is None else steps[key] for key in values},
+                    bytes=int(returned.get("bytes") or 2))
+        if store["values"] and not values:
+            notes.append("mem is empty now.")
+    listing = describe(kept, step)
+    if notes and listing:
+        return kept, " ".join(notes) + " Keys: " + listing
+    return kept, " ".join(notes) or listing
+
+
+def describe(store: dict[str, Any], step: Any) -> str:
+    """mem's keys with the step each was last written at, the step now and the size; "" when mem is empty."""
+    keys = list(store["values"])
+    if not keys:
+        return ""
+    shown = ", ".join(f"{key if len(key) <= 40 else key[:37] + '...'} (step {store['steps'].get(key)})"
+                      for key in keys[:SHOWN_KEYS])
+    if len(keys) > SHOWN_KEYS:
+        shown += f", and {len(keys) - SHOWN_KEYS} more keys"
+    size = store["bytes"]
+    used = f"{size} bytes" if size < 1024 else f"{size / 1024:.1f} KB"
+    return f"{shown}; now step {step}, {used} of {CAP_BYTES // 1024} KB"
