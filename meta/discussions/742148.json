s.com/kaggle-avatars/thumbnails/13918144-kg.jpg", "url": "/ruichardliu", "userName": "ruichardliu", "tier": "MASTER", "id": 13918144, "profileUrl": "/ruichardliu", "performanceTier": "MASTER", "userId": 13918144, "progressionOptOut": false}, "intro": ""}}, {"id": 3526525, "postDate": "2026-09-21T16:55:18.840Z", "rawMarkdown": "", "attachments": [{"fileType": ".png", "id": 51444, "name": "draw.chat_dc2f42wame2i0h1bb8qcnacccvosye_p1.png", "totalBytes": 13184, "url": "https://storage.googleapis.com/kaggle-forum-message-attachments/3526525/51444/draw.chat_dc2f42wame2i0h1bb8qcnacccvosye_p1.png"}], "parent": {}, "author": {"thumbnailUrl": "https://storage.googleapis.com/kaggle-avatars/thumbnails/default-thumb.png", "url": "/"}, "authorType": "COMMENT", "votes": {}, "canDelete": true, "isUserAuthor": true, "isDeleted": true, "kernelVersion": 0, "feedbackTrackingData": {}, "isThankYou": false}], "commentSort": "COMMENT_LIST_SORT_BY_HOT", "firstMessage": {"id": 3526089, "postDate": "2026-09-20T09:41:10.343Z", "rawMarkdown": "The Long Queue for RTX Pro 6000 usage has been getting serious day by day especially between 2 am UTC to 9 am UTC. Beside legitimate usage, the problem is partly made serious by abusive used of RTX Pro 6000 GPU for non ARC AGI-3 tasks.\n\nI propose 2 methods below to mitigate the problems: @herbison \n\n1. Decrease the number of allowed concurrent GPU usage for RTX Pro 6000 from 2 to 1 per user. This will limit the abusive usage for Training of non ARC-AGI-3 tasks while free up resources for iteration. (At least 50% can be free up)\n\n2. Make a clear warning pop-up when user chose RTX Pro 6000 as the GPU, currently there is no warning, some novice user might not read the rules and use it ignorantly for non ARC-AGI-3 tasks.\n\nOther participants can also propose better way to mitigate if you had any ideas.\n\nSome example of abuse:  \nhttps://www.kaggle.com/code/thinam3/notebook-colbert-beir-5-rebutal-update-metrics  \nhttps://www.kaggle.com/code/leehien12/t2-sinh-qwen3-5-2b?scriptVersionId=349694546       \n       \n![](https://www.googleapis.com/download/storage/v1/b/kaggle-forum-message-attachments/o/inbox%2F3967558%2F52a97efacfa4ead5266da166971f1294%2F8h%20-%20Copy.png?generation=1789897065886693&alt=media)\n", "content": "<p>The Long Queue for RTX Pro 6000 usage has been getting serious day by day especially between 2 am UTC to 9 am UTC. Beside legitimate usage, the problem is partly made serious by abusive used of RTX Pro 6000 GPU for non ARC AGI-3 tasks.</p>\n<p>I propose 2 methods below to mitigate the problems: <a href=\"/herbison\" target=\"_blank\">@herbison</a> </p>\n<ol>\n<li><p>Decrease the number of allowed concurrent GPU usage for RTX Pro 6000 from 2 to 1 per user. This will limit the abusive usage for Training of non ARC-AGI-3 tasks while free up resources for iteration. (At least 50% can be free up)</p></li>\n<li><p>Make a clear warning pop-up when user chose RTX Pro 6000 as the GPU, currently there is no warning, some novice user might not read the rules and use it ignorantly for non ARC-AGI-3 tasks.</p></li>\n</ol>\n<p>Other participants can also propose better way to mitigate if you had any ideas.</p>\n<p>Some example of abuse:<br>\n<a href=\"https://www.kaggle.com/code/thinam3/notebook-colbert-beir-5-rebutal-update-metrics\" target=\"_blank\">https://www.kaggle.com/code/thinam3/notebook-colbert-beir-5-rebutal-update-metrics</a><br>\n<a href=\"https://www.kaggle.com/code/leehien12/t2-sinh-qwen3-5-2b?scriptVersionId=349694546\" target=\"_blank\">https://www.kaggle.com/code/leehien12/t2-sinh-qwen3-5-2b?scriptVersionId=349694546</a>       </p>\n<p><img src=\"https://www.googleapis.com/download/storage/v1/b/kaggle-forum-message-attachments/o/inbox%2F3967558%2F52a97efacfa4ead5266da166971f1294%2F8h%20-%20Copy.png?generation=1789897065886693&amp;alt=media\" alt=\"\"></p>", "parent": {}, "author": {"displayName": "Chew Kok Wah", "thumbnailUrl": "https://storage.googleapis.com/kaggle-avatars/thumbnails/default-thumb.png", "url": "/chewkokwahibrainai", "tier": "EXPERT", "id": 3967558, "progressionOptOut": false}, "authorType": "TOPIC", "votes": {"totalVotes": 20, "canUpvote": true, "totalUpvotes": 20}, "kernelVersion": 0, "competitionRanking": 592, "feedbackTrackingData": {}, "isThankYou": false, "teamUpInfo": {"teamLeader": {"displayName": "Chew Kok Wah", "thumbnailUrl": "https://storage.googleapis.com/kaggle-avatars/thumbnails/default-thumb.png", "url": "/chewkokwahibrainai", "userName": "chewkokwahibrainai", "tier": "EXPERT", "id": 3967558, "profileUrl": "/chewkokwahibrainai", "performanceTier": "EXPERT", "userId": 3967558, "progressionOptOut": false}, "intro": ""}}, "firstMessageId": 3526089, "forumId": 10403401, "forumName": "ARC Prize 2026 - ARC-AGI-3", "id": 742148, "name": "Long Queue for RTX Pro 6000 (8 hours) partially due to abusive used for non ARC-AGI-3 tasks, Proposal to mitigate", "parentName": "arc-prize-2026-arc-agi-3", "parentUrl": "/competitions/arc-prize-2026-arc-agi-3", "postDate": "2026-09-20T09:41:10.344306800Z", "totalVotes": 20, "url": "/competitions/arc-prize-2026-arc-agi-3/discussion/742148", "totalMessages": 22, "authorPerformanceTier": "EXPERT", "authorProgressionOptOut": false}}