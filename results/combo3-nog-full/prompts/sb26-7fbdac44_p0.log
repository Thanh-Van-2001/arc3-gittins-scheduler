def board_state(a, slots):
    d = {}
    for (r,c) in slots:
        ring = a[r-1][c-1]
        center = a[r+1][c+1]
        if ring == 'c':
            d[(r,c)] = None
        else:
            d[(r,c)] = (ring, center != ring)
    return d
