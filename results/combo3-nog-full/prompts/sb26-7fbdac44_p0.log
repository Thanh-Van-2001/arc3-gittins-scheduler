def pal_slots(a):
    """Return dict slot_leftcol -> (color, is_frame) for non-empty palette slots."""
    out = {}
    for c in (5,12,19,26,33,40,47,54):
        cells = [a[r][c: c+4] for r in range(57,61)]
        ring = cells[0][0]
        if ring == 'c':
            continue
        center = cells[1][1]
        out[c] = (ring, center != ring)
    return out

SLOTS = [(26,c) for c in (22,28,34,40)] + [(40,c) for c in (22,28,34,40)]
def board_state(a):
    d = {}
    for (r,c) in SLOTS:
        # tile occupies rows r-2..r+1, cols c-2..c+1
        ring = a[r-2][c-2]
        center = a[r][c]
        if ring == 'c' and center == 'c':
            d[(r,c)] = None
        else:
            d[(r,c)] = (ring, center != ring)
    return d

print('pal', pal_slots(grid(current_frame)))
print('brd', board_state(grid(current_frame)))
