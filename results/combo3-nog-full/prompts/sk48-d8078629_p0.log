def plan2(st0):
    step,goal,_=sim()
    def G(st): return {'N':(st[2],st[3]),'b':(st[4],st[5]),'O':(st[6],st[7]),'R':(st[8],st[9])}
    def retract(st):
        out=[]
        while st[1]>10: st=step(st,'LEFT'); out.append('LEFT')
        return st,out
    def travel(st,lvl):
        st,out=retract(st)
        while st[0]>lvl: st=step(st,'UP'); out.append('UP')
        while st[0]<lvl: st=step(st,'DOWN'); out.append('DOWN')
        return st,out
    def set_tip(st,t):
        out=[]
        while st[1]<t: st=step(st,'RIGHT'); out.append('RIGHT')
        while st[1]>t: st=step(st,'LEFT'); out.append('LEFT')
        return st,out
    def engage(st,color):
        out=[]
        while True:
            r,c=G(st)[color]
            if st[0]==r-1 and st[1]==c+4: return st,out
            if st[1]>=52: raise Exception('cannot engage '+color)
            st=step(st,'RIGHT'); out.append('RIGHT')
    def hook_drag(st,color,target_col):
        r,c=G(st)[color]
        st,out=travel(st,r-1)
        st,o=engage(st,color); out+=o
        r,c=G(st)[color]
        for i in range((c-target_col)//6): st=step(st,'LEFT'); out.append('LEFT')
        assert G(st)[color]==(r,target_col),('drag fail',G(st)[color])
        return st,out
    def push_right(st,color,target_col):
        r,c=G(st)[color]
        st,out=travel(st,r-1)
        for i in range((target_col-c)//6): st=step(st,'RIGHT'); out.append('RIGHT')
        assert G(st)[color]==(r,target_col),('push fail',G(st)[color])
        return st,out
    def lower(st,color,nb):
        r,c=G(st)[color]; out=[]
        st,o=travel(st,r-1-6); out+=o
        st,o=set_tip(st,c+4); out+=o
        for i in range(nb):
            st=step(st,'DOWN'); out.append('DOWN')
            assert G(st)[color][0]==r+6*(i+1),('lower fail',G(st)[color])
        return st,out
    st=list(st0); log=[]
    def rec(f,*a):
        nonlocal st
        st,o=f(st,*a); log.extend(o); print(f.__name__,a,G(tuple(st)),len(log))
    rec(lower,'O',1)
    rec(push_right,'O',36)
    rec(hook_drag,'R',12)
    rec(lower,'R',1)
    # lift all four at once: travel to 36, extend to 52, UP
    st,o=travel(st,36); log+=o; print('travel36',G(tuple(st)),len(log))
