def icons(fr):
    out=[]
    for x in fr.segmentation['nodes']:
        b=x['boundary']; r0=min(p[0] for p in b)
        if r0>=54 and x['pixels'] in (4,16,18) and x['color'] in 'MRONbpYS':
            out.append((x['color'],min(p[1] for p in b)))
    out.sort(key=lambda t:t[1])
    return ''.join(c for c,_ in out)
def arr(fr):
    d={}
    for x in fr.segmentation['nodes']:
        b=x['boundary']; r0=min(p[0] for p in b); c0=min(p[1] for p in b)
        if x['pixels']==16 and r0<53: d[x['color']]=(r0,c0)
    return d
