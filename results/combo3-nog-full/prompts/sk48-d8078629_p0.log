    for i in range(3): st=step(st,'RIGHT'); log.append('RIGHT')
    print('pushR',G(st),len(log))
    for i in range(7): st=step(st,'RIGHT'); log.append('RIGHT')
    print('FINAL',G(st),'head',st[0],'tip',st[1],'GOAL?',goal(st),'len',len(log))
    return log
