def execute2(plan):
    D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    F={'UP':'U','DOWN':'D','LEFT':'L','RIGHT':'R'}
    DD={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
    inb=lambda q: 6<=q[0]<=10 and 6<=q[1]<=10
    rel=lambda q: 6<=q[0]<=10 and 6<=q[1]<=10
    p,carry,obs=realstate2()
    f,_=face_of(p)
    off=None
    boxes={b for b in obs if inb(b)}
    if carry: off=(carry[0]-p[0],carry[1]-p[1])
    for i,a in enumerate(plan):
        if a in D:
            d=D[a]; np_=(p[0]+d[0],p[1]+d[1])
            if not inb(np_) or (np_ in boxes): print(i,a,'SIMBLOCK'); return False
            if carry:
                nb=(np_[0]+off[0],np_[1]+off[1])
                if nb in boxes: print(i,a,'CLASH',nb); return False
                carry=nb
            p=np_; f=F[a]
        else:
            if carry:
                if inb(carry): boxes.add(carry)
                carry=None; off=None
            else:
                fp=(p[0]+DD[f][0],p[1]+DD[f][1])
                if fp in boxes: carry=fp; off=DD[f]; boxes.discard(fp)
                else: print(i,'SPACE nothing at',fp,'face',f); return False
        try: r=action([a])
        except Exception:
            try: r=action([a])
            except Exception: print(i,'ACTIONFAIL'); return False
        rp,rc,ro=realstate2()
        ro={b for b in ro if rel(b)}
        if rp!=p or rc!=carry or boxes!=ro:
            print(i,a,'MISMATCH sim',p,carry,sorted(boxes),'real',rp,rc,sorted(ro)); return False
        if r.get('level_completed'): print(i,'LEVEL COMPLETE'); return True
        if r.get('game_over'): print(i,'GAME OVER'); return False
    print('chunk ok; player',p,f,'carry',carry,'interior boxes',sorted(boxes))
    return True
