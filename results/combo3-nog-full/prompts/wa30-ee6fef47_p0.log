def solve_plan2(boxes, play, facing):
    from collections import deque
    border=[(5,c) for c in range(5,12)]+[(11,c) for c in range(5,12)]+[(r,5) for r in range(6,11)]+[(r,11) for r in range(6,11)]
    D={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
    NAME={'U':'UP','D':'DOWN','L':'LEFT','R':'RIGHT'}
    inb=lambda p: 6<=p[0]<=10 and 6<=p[1]<=10
    def appr(start,face,obst,target,tf):
        q=deque([((start,face),[])]); seen={(start,face)}
        while q:
            (p,f),path=q.popleft()
            if p==target and f==tf: return path
            for nf in D:
                np_=(p[0]+D[nf][0],p[1]+D[nf][1])
                if not inb(np_) or np_ in obst: continue
                ns=(np_,nf)
                if ns in seen: continue
                seen.add(ns); q.append((ns,path+[nf]))
        return None
    plan=[]; bx=list(boxes); p=play; f=facing
    while bx:
        best=None
        for bi,b in enumerate(bx):
            others=[x for x in bx if x!=b]
            for nf in D:
                d=D[nf]; k=0; cur=b; ok=True
                while True:
                    nxt=(cur[0]+d[0],cur[1]+d[1])
                    if nxt in border: k+=1; break
                    if not inb(nxt) or nxt in others or k>6: ok=False; break
                    k+=1; cur=nxt
                if not ok: continue
                stand=(b[0]-d[0],b[1]-d[1])
                if not inb(stand) or stand in others: continue
                pre=appr(p,f,others+[b],stand,nf)
                if pre is None: continue
                cost=len(pre)+1+k+1
