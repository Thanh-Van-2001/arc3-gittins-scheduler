        if best is None: break
        cost,bi,b,nf,k,pre=best
        plan+= [NAME[x] for x in pre]+['SPACE']+[NAME[nf]]*k+['SPACE']
        d=D[nf]; p=(b[0]+(k-1)*d[0], b[1]+(k-1)*d[1]); f=nf; bx.pop(bi)
    return plan,bx
