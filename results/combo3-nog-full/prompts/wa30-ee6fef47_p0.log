    boxes=set((b[0]//4,b[2]//4) for b in s['boxes'])
    return p,boxes
def execute(plan):
    D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    F={'UP':'U','DOWN':'D','LEFT':'L','RIGHT':'R'}
    border=set([(5,c) for c in range(5,12)]+[(11,c) for c in range(5,12)]+[(r,5) for r in range(6,11)]+[(r,11) for r in range(6,11)])
    inb=lambda q: 6<=q[0]<=10 and 6<=q[1]<=10
    p,boxes=realstate()
    # infer facing from player ascii (white nose pixel)
    fr=current_frame.ascii.split('\n')
    r0,c0=p[0]*4,p[1]*4
    sub=[fr[r0+i][c0:c0+4] for i in range(4)]
    f=None
    if 'W' in sub[0]: f='U'
    elif 'W' in sub[3]: f='D'
    elif any(row[0]=='W' for row in sub): f='L'
    elif any(row[3]=='W' for row in sub): f='R'
    print('start',p,f,'boxes',sorted(boxes))
    carry=None; off=None
    for i,a in enumerate(plan):
        if a in D:
            d=D[a]
            np_=(p[0]+d[0],p[1]+d[1])
            if not inb(np_) or (np_ in boxes and np_!=carry): 
                print(i,a,'SIMBLOCK'); break
            if carry:
                nb=(np_[0]+off[0],np_[1]+off[1])
                if nb in boxes and nb!=carry: print(i,a,'SIMBOXCLASH'); break
                carry=nb
            p=np_; f=F[a]
        else:
            if carry:
                boxes.add(carry); carry=None; off=None
            else:
                fp=(p[0]+D[F[f]][0],p[1]+D[F[f]][1])
                if fp in boxes:
                    carry=fp; off=D[F[f]]; boxes.discard(fp)
                else: print(i,'SPACE nothing to pick at',fp); break
        try: r=action([a])
        except Exception:
            try: r=action([a])
            except Exception as e: print(i,'ACTIONFAIL'); return False
        rp,rb=realstate()
        exp=set(boxes)|(set([carry]) if carry else set())
        if rp!=p or rb!=exp:
            print(i,a,'MISMATCH sim',p,sorted(exp),'real',rp,sorted(rb))
            return False
        if r.get('level_completed'): print(i,'LEVEL COMPLETE'); return True
        if r.get('game_over'): print(i,'GAME OVER'); return False
    print('plan done, boxes',sorted(boxes|({carry} if carry else set())))
    return True
