import re
def md(click, bb):
    dr=max(0, bb[0]-click[0], click[0]-bb[2]); dc=max(0, bb[1]-click[1], click[1]-bb[3])
    return dr+dc

def simc2(pieces, click):
    TSIZE={1:1,2:2,3:3,4:4}; OFF={1:0,2:1,3:1,4:2}
    mset=[p for p in pieces if md(click,p['bb'])<=10]
    mvt=[p for p in pieces if click_bb(click,p['bb'])<=7]
    byt={}
    for p in mset: byt.setdefault(p['t'],[]).append(p)
    multi={t:v for t,v in byt.items() if len(v)>=2}
    if multi:
        if len(multi)!=1 or sum(len(v) for v in multi.values())!=2: return None,None
        if any(p not in mset for p in mvt): return None,None
        t=list(multi)[0]; srcs=multi[t]; nt=t+1
        if nt>4: return None,None
        k=TSIZE[nt]; o=OFF[nt]; tl=(click[0]-o, click[1]-o)
