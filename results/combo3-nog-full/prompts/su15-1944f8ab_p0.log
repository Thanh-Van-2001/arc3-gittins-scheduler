def best_click(pieces, inv, ball, spd=8, debug=False):
    cands=set()
    for p in pieces:
        for dr in range(-8,9):
            for dc in range(-8,9):
                cands.add((p['bb'][0]+dr, p['bb'][1]+dc))
    best=None
    base=len(pieces)
    for c in cands:
        if c[0]<11 or c[0]>62 or c[1]<0 or c[1]>63: continue
        kind,new=simc(pieces,c)
        if kind is None: continue
        ip=adv_inv(inv, nearest_piece(new,inv), spd) if inv else None
        s=safety(new,ip)
        sc=min(s,22)*10
        if kind=='merge': sc+=60
        sc+=(base-len(new))*12
        # mobility of most threatened piece
        mt=min(new, key=lambda p: cheb_bb(p['bb'],ip) if ip else 99)
        mob=0
        for dr in range(-8,9):
            for dc in range(-8,9):
                cc=(mt['bb'][0]+dr, mt['bb'][1]+dc)
                k2,n2=simc(new,cc)
                if k2 and safety(n2,ip)>=s+2: mob+=1
        sc+=min(mob,20)
        # deliverables near ball
        for p in new:
            if p['t']>=3:
                sc+= max(0, 12-cheb_bb(p['bb'],ball))*3
                if overlap(p['bb'],ball):
                    sc += 100000 if p['t']==4 else -400
        if best is None or sc>best[0]: best=(sc,c,kind,s)
    return best

