def best3(pieces, inv, ball, spd=8):
    cands=set()
    for p in pieces:
        for dr in range(-8,9):
            for dc in range(-8,9):
                cands.add((p['bb'][0]+dr, p['bb'][1]+dc))
    DIRS=[(dr,dc) for dr in (-7,-4,0,4,7) for dc in (-7,-4,0,4,7)]
    best=None; base=len(pieces)
    for c in cands:
        if c[0]<11 or c[0]>62 or c[1]<0 or c[1]>63: continue
        kind,new=simc(pieces,c)
        if not kind: continue
        npc=nearest_piece(new,inv)
        ip=adv_inv(inv, npc['bb'], spd) if (inv and npc) else inv
        s=safety(new,ip)
        sc=min(s,22)*10 + (55 if kind=='merge' else 0) + (base-len(new))*12
        mt=min(new, key=lambda p: cheb_bb(p['bb'],ip))
        mob=0
        for (dr,dc) in DIRS:
            cc=(mt['bb'][0]+dr, mt['bb'][1]+dc)
            k2,n2=simc(new,cc)
            if k2 and safety(n2,ip)>=s+2: mob+=1
        sc+=min(mob,20)
        for p in new:
            if p['t']>=3:
                sc+=max(0,12-cheb_bb(p['bb'],ball))*3
                if overlap(p['bb'],ball): sc += 100000 if p['t']==4 else -400
        if best is None or sc>best[0]: best=(sc,c,kind,s)
    return best

def runctl(n=8, spd=8):
    log=[]
    for i in range(n):
        ps=gp(); inv=get_inv(); ball=get_ball()
        mat=material(ps)
        b=best3(ps,inv,ball,spd)
        if b is None:
            log.append((i,'NOCAND',mat)); break
        sc,c,kind,s=b
        r=click(c[0],c[1])
        ps2=gp(); inv2=get_inv(); hdr=[nn['color'] for nn in current_frame.segmentation['nodes'] if nn['pixels']==16 and nn['boundary'][0][0]<10]
        log.append((i,c,kind,'s=%d'%s,'mat=%d'%material(ps2),'inv=%s'%(inv2,),'hdr=%s'%(hdr[0] if hdr else '?'),'noop' if r.get('no_op') else 'ok'))
        if r.get('game_over') or r.get('run_complete') or r.get('level_completed'):
            log.append(('END',{k:v for k,v in r.items() if k in ('game_over','level_completed','run_complete','done')})); break
        if hdr and hdr[0]!='Y':
            log.append(('GRAY',i)); break
    return log

