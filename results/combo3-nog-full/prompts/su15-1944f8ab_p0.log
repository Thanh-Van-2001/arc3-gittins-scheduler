def gp(fr=None):
    TIER={'S':1,'M':2,'p':3,'Y':4}
    fr = fr or current_frame
    out=[]
    for n in fr.segmentation['nodes']:
        if n['color'] in TIER and 0<n['pixels']<=20:
            b=n['boundary']; tl=(min(p[0] for p in b), min(p[1] for p in b))
