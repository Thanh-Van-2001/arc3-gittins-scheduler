import collections
BOUNDS={'TL':(8,29),'TM':(8,55),'TR':(8,26),'BL':(32,55),'BR':(32,55)}
MOVES=[('TL','TM',(8,20)),('TM','TL',(8,24)),('TM','TR',(8,38)),('TR','TM',(8,42)),('BL','TM',(32,20)),('TM','BL',(32,24)),('TM','BR',(32,38)),('BR','TM',(32,42))]
def bfs(start, target_pred, blocked=None, maxd=30):
    # start: dict name->edge ; target_pred: fn(dict)->bool ; blocked: set of container names holding handles (extra bound edge+1<=bottom)
    blocked=blocked or set()
    def ok(s):
        for k,(lo,hi) in BOUNDS.items():
            if not (lo<=s[k]<=hi): return False
        if blocked:
            extra={'TL':28,'TR':25,'TM':55,'BL':55,'BR':55}
            for k in blocked:
                if s[k]>extra[k]: return False
        return True
    if target_pred(start): return []
    seen={tuple(sorted(start.items()))}
    q=collections.deque([(start,[])])
    while q:
        s,path=q.popleft()
        if len(path)>=maxd: continue
        for a,b,(r,c) in MOVES:
            ns=dict(s); ns[a]+=2; ns[b]-=2
            if not ok(ns): continue
            key=tuple(sorted(ns.items()))
            if key in seen: continue
            np_=path+[(r,c)]
            if target_pred(ns): return np_
            seen.add(key); q.append((ns,np_))
    return None
cur={'TL':9,'TM':17,'TR':25,'BL':49,'BR':35}
blocked={'TM','BL','TR'}   # G in TM, Y in BL, P in TR
p=bfs(cur, lambda s: s['TM']==37 and s['BL']==37, blocked)
print('stage2 len',len(p) if p is not None else None, p)
