from collections import deque
def AR8(): return {'B':(57,32),'Bg':(57,36),'A1':(24,50),'A1i':(24,53),'A2':(29,50),'A2i':(29,53),'A3':(34,50),'A3i':(34,53)}
def solve8c(ys):
    L=lanes8(); pos=[L['S1'],L['S2'],L['S3']]
    M,_,_=moves8()
    start=[None]*3
    for p in ys:
        for i,s in enumerate(pos):
            if p in s: start[i]=s.index(p)
    start=tuple(start)
    goals=(pos[0].index((51,24)),pos[1].index((51,30)),pos[2].index((51,36)))
    def step(st,nm):
        m=M[nm]; out=[]
        for l in range(3):
            c=pos[l][st[l]]; nc=m.get(c,c); out.append(pos[l].index(nc))
        return tuple(out)
    q=deque([(start,[])]); seen={start}; sol=None
    while q:
        st,path=q.popleft()
        if st==goals: sol=path; break
        for nm in M:
            ns=step(st,nm)
            if ns not in seen: seen.add(ns); q.append((ns,path+[nm]))
    return sol,start,goals,len(seen)
sol,start,goals,nst=solve8c([(12,12),(21,12),(51,36)])
print('start',start,'goals',goals,'sol',sol,len(sol) if sol else None,'states',nst)
</parameter>
</function>
