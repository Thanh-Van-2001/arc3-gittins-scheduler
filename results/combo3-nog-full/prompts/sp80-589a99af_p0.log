def sim3(solid, src, grav=(-1,0), maxsteps=40, spread=4):
    dr,dc=grav; lat=[(0,-1),(0,1)]
    ink=set(src)
    free=lambda r,c: (0<=r<64 and 0<=c<64 and (r,c) not in solid)
    for _ in range(maxsteps):
        new=set(ink)
        for (r,c) in ink:
            nr,nc=r+dr,c+dc
            if free(nr,nc): new.add((nr,nc))
            elif (nr,nc) in ink or not free(nr,nc):
                # blocked above: spread laterally along underside, then 4 past obstacle end
                for (lr,lc) in lat:
                    rr,cc=r+lr,c+lc; past=0
                    while free(rr,cc):
                        ar,ac=rr+dr,cc+dc
                        if (ar,ac) in solid or (ar,ac) in ink or (ar,ac) in new:
                            new.add((rr,cc)); rr+=lr; cc+=lc; past=0
                        elif past<spread:
                            new.add((rr,cc)); past+=1; rr+=lr; cc+=lc
                        else: break
                    # continue while underside exists
        if new==ink: break
        ink=new
    return ink
