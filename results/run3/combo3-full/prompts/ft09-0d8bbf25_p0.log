def lvl6_state(f):
    A=f.ascii.split('\n'); R=[6,14,22,30,38,46,54]; C=[4,12,20,28,36,44,52]
    cells={}; tiles={}
    for r in range(7):
        for c in range(7):
            if R[r]+11>=63 or C[c]+11>=64: continue
            s=set(A[R[r]+2*i][C[c]+2*j] for i in range(3) for j in range(3))
            if s=={'c'}: continue
            pat='/'.join(''.join(A[R[r]+2*i][C[c]+2*j] for j in range(3)) for i in range(3))
            if s <= {'Y','N','M'}: cells[(r,c)]='N' if 'N' in s else 'Y'
            else: tiles[(r,c)]=pat
    return cells,tiles
def target6(cells,tiles):
    other={'Y':'N','N':'Y'}; tgt={}
    for k,p in sorted(tiles.items()):
        m=p.split('/'); tr,tc=k; c0=m[1][1]
        sym={'W':c0,'g':other[c0],'G':None}
        for a in (-1,0,1):
            for b in (-1,0,1):
                if (a,b)==(0,0): continue
                cell=(tr+a,tc+b)
                if cell not in cells: continue
                col=sym[m[a+1][b+1]]
                if col is None: continue
                assert tgt.get(cell,col)==col,(cell,tgt.get(cell),col,k)
                tgt[cell]=col
    return tgt
