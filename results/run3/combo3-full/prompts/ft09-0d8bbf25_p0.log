    for k,p in sorted(alltiles.items()):
        m=p.split('/'); tr,tc=k; c0=m[1][1]
        if 'M' in p:
            if modes=='lit': sym={'N':c0,'M':other[c0]}
            elif modes=='inv': sym={'N':other[c0],'M':c0}
            else: continue
        else: sym={'W':c0,'g':other[c0],'G':None}
        for a,b in dirs:
            cell=(tr+a,tc+b)
            if cell not in paint: continue
            col=sym[m[a+1][b+1]]
            if col is None: continue
            if cell in cons and cons[cell]!=col: conf.append((cell,cons[cell],col,k))
            else: cons[cell]=col
    return cons,conf
