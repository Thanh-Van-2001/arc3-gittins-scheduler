def lvl6_state(f):
    A=f.ascii.split('\n'); R=[6,14,22,30,38,46,54]; C=[4,12,20,28,36,44,52]
    cells={}; tiles={}
    for r in range(7):
        for c in range(7):
            if R[r]+11>=63 or C[c]+11>=64: continue
            s=set(A[R[r]+2*i][C[c]+2*j] for i in range(3) for j in range(3))
            if s=={'c'}: continue
            pat='/'.join(''.join(A[R[r]+2*i][C[c]+2*j] for j in range(3)) for i in range(3))
            if len(s)==1 or s<={'Y','M'}: cells[(r,c)]='N' if 'N' in s else 'Y'
            else: tiles[(r,c)]=pat
    return cells,tiles
def target6(cells,tiles):
    other={'Y':'N','N':'Y'}; tgt={}
    for k,p in sorted(tiles.items()):
        m=p.split('/'); tr,tc=k; c0=m[1][1]
        sym={'W':c0,'g':other[c0],'G':None}
        for a in (-1,0,1):
            for b in (-1,0,1):
                if (a,b)==(0,0): continue
                cell=(tr+a,tc+b)
                if cell not in cells: continue
                col=sym[m[a+1][b+1]]
                if col is None: continue
                assert tgt.get(cell,col)==col, (cell,tgt.get(cell),col,k)
                tgt[cell]=col
    return tgt
def solve6(cells,tgt):
    import itertools
    cl=sorted(cells); idx={k:i for i,k in enumerate(cl)}
    # effect of clicking v: v and up-neighbor if it is a cell
    eff=[]
    for v in cl:
        e=1<<idx[v]
        up=(v[0]-1,v[1])
        if up in cells: e|=1<<idx[up]
        eff.append(e)
    need=0
    for v in cl:
        if cells[v]!=tgt.get(v,cells[v]): need|=1<<idx[v]
    # gaussian elimination GF(2)
    rows=[(eff[i],i) for i in range(len(cl))]
    piv={}
    for m,bm in rows:
        cur=m; used=[bm]
        for bit in range(len(cl)):
            if cur>>bit & 1:
                if bit in piv:
                    cur^=piv[bit][0]; used^=1<<piv[bit][1]
                else:
                    piv[bit]=(cur,used); break
        else:
            if cur!=0: return None,None
    # back-substitute for need
    x=0; rhs=need
    for bit in sorted(piv, reverse=True):
        m,used=piv[bit]
        if rhs>>bit & 1:
            rhs^=m; x^=used
    if rhs!=0: return None,None
    sol=[cl[i] for i in range(len(cl)) if x>>i&1]
    null=len(cl)-len(piv)
    return sol,null
cells,tiles=lvl6_state(current_frame)
tgt=target6(cells,tiles)
sol,null=solve6(cells,tgt)
print('cells',len(cells),'need clicks',sol,'nullspace dim',null)
def click(r,c): return {'action':'MOUSE','row':9+8*r,'col':9+8*c}
acts=[click(*v) for v in sorted(sol)]
print('n acts',len(acts),acts)
res=action(acts)
print({k:v for k,v in res.items() if k in ('executed','skipped','stop_reason','level_completed','game_over','done','run_complete','level')})
