def analyze(f):
    A=f.ascii.split('\n')
    seg=f.segmentation
    rs=set(); cs=set()
    for n in seg['nodes']:
        b=n['boundary']
        r0=min(p[0] for p in b); r1=max(p[0] for p in b); c0=min(p[1] for p in b); c1=max(p[1] for p in b)
        if r1-r0==5 and c1-c0==5: rs.add(r0); cs.add(c0)
    return sorted(rs),sorted(cs)
