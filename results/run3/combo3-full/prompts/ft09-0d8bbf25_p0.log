def parse(f):
    A=f.ascii.split('\n')
    def sb(r,c,i,j): return A[4+8*r+2*i][6+8*c+2*j]
    cells={}; tiles={}
    for r in range(7):
        for c in range(7):
            try: cols=set(sb(r,c,i,j) for i in range(3) for j in range(3))
            except IndexError: continue
            if cols=={'c'}: continue
            pat='/'.join(''.join(sb(r,c,i,j) for j in range(3)) for i in range(3))
            if len(cols)==1: cells[(r,c)]=pat[4]
            else: tiles[(r,c)]=pat
    return cells,tiles
f=lv4[-1].frame
