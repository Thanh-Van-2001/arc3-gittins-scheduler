def gf2_solve(cl, cells, tgt):
    idx={k:i for i,k in enumerate(cl)}; n=len(cl)
    eff=[]
    for v in cl:
        e=1<<idx[v]
        up=(v[0]-1,v[1])
        if up in cells: e|=1<<idx[up]
        eff.append(e)
    need=0
    for v in cl:
        if cells[v]!=tgt[v]: need |= (1<<idx[v])
    piv={}
    for i in range(n):
        cur=eff[i]; used=1<<i
        for bit in range(n):
            if (cur>>bit)&1:
                if bit in piv:
                    pm,pu=piv[bit]; cur^=pm; used^=pu
                else:
                    piv[bit]=(cur,used); break
        else:
            if cur: return None,None
    x=0; rhs=need
    for bit in sorted(piv, reverse=True):
        if (rhs>>bit)&1:
            pm,pu=piv[bit]; rhs^=pm; x^=pu
    if rhs: return None,None
    return [cl[i] for i in range(n) if (x>>i)&1], n-len(piv)
