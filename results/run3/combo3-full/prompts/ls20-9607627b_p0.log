def L5SP():
    return {(-4,4):'DOWN',(-1,4):'RIGHT',(0,1):'LEFT',(0,7):'UP',(0,5):'UP',(1,8):'LEFT',(3,6):'RIGHT',(5,8):'UP'}
def p5(s,g,allow=(),block=()):
    import collections
    FL=L5F(); SPR=L5SP(); MV={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    allow=set(allow); block=set(block)
    def ok(p): return p[0] in FL and p[1] in FL[p[0]] and (p not in SPR or p in allow) and p not in block
    q=collections.deque([(s,[])]); seen={s}
    while q:
        u,path=q.popleft()
        if u==g: return path
        for a,(dr,dc) in MV.items():
            v=(u[0]+dr,u[1]+dc)
            if ok(v) and v not in seen: seen.add(v); q.append((v,path+[a]))
    return None
