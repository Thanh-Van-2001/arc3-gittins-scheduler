def catch_seq(puck, plus_pos, plus_dir, maxd=14):
    import collections
    FL=L5F(); SPR={(-4,4),(1,7),(3,6),(1,8),(0,5),(-1,4),(0,1),(-4,4),(5,8)}
    MV={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    Z=[(2,0),(2,1),(2,2)]
    def plus_next(pp,pd):
        i=Z.index(pp)+pd
        if i<0: i=1; pd=1
        elif i>2: i=1; pd=-1
        return Z[i],pd
    def ok(p): return p[0] in FL and p[1] in FL[p[0]] and p not in SPR
    start=(puck,plus_pos,plus_dir)
    q=collections.deque([(start,[])]); seen={start}
    while q:
        (pk,pp,pd),path=q.popleft()
        if len(path)>=maxd: continue
        for a,(dr,dc) in MV.items():
            np_=(pk[0]+dr,pk[1]+dc)
            if not ok(np_): continue
            npp,npd=plus_next(pp,pd)
            if np_==npp: return path+[a]
            st=(np_,npp,npd)
            if st not in seen: seen.add(st); q.append((st,path+[a]))
    return None
print('plus at (2,1) dir+1:',catch_seq((-3,1),(2,1),1))
print('plus at (2,1) dir-1:',catch_seq((-3,1),(2,1),-1))
