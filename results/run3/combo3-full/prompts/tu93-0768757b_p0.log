def snap9(fr):
    L=fr.ascii.split('\n'); r0,c0,sz=10,9,3
    out={}
    for r in range(13):
        for c in range(15):
            ch=L[r0+sz*r+1][c0+sz*c+1]
            if ch in 'brRNO': out.setdefault(ch,[]).append((r,c))
    # dots
    dots=[]
    for (pr,pc),ch in [((r,c),L[r][c]) for r in range(9,49) for c in range(8,54)]:
        if ch in 'pYc':
            cr=(pr-r0)/sz; cc=(pc-c0)/sz
            dots.append((ch,round(cr,2),round(cc,2)))
    return out,dots
