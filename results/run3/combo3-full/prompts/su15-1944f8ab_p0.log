import math
def sim_search(start, depth=16, beam=200, DISC=(15.0,32.0,4.6), KILL={0:1.5,1:2.0,2:2.5,3:3.0}):
    def in_disc(r,c,pad=0.0): return math.hypot(r-DISC[0],c-DISC[1])<=DISC[2]+pad
    def shape(tip):
        r,c=tip; return [(r,c),(r+1,c-1),(r+1,c+1),(r+2,c-2),(r+2,c+2),(r+3,c-1),(r+3,c),(r+3,c+1)]
    def blocked(tip): return any(in_disc(rr,cc,-0.4) for rr,cc in shape(tip))
    def step_st(st,click):
        toks=[list(t) for t in st[0]]; ars=[list(a) for a in st[1]]; win=False
        S=[(i,t) for i,t in enumerate(toks) if math.hypot(t[1]-click[0],t[2]-click[1])<=8.0]
        g={}
        for i,t in S: g.setdefault(t[0],[]).append((math.hypot(t[1]-click[0],t[2]-click[1]),i))
        best=None
        for tier,lst in g.items():
            if len(lst)>=2:
                lst.sort()
                if best is None or (len(lst),tier)>(len(g[best[0]]),best[0]): best=(tier,lst[:2])
        if best:
            tier,pair=best
            for _,i in sorted(pair,key=lambda z:-z[1]): toks.pop(i)
            toks.append([tier+1,float(click[0]),float(click[1])])
            if tier+1==3 and in_disc(click[0],click[1]): win=True
        elif len(S)==1:
            i=S[0][0]; toks[i][1]=float(click[0]); toks[i][2]=float(click[1])
            if toks[i][0]==3 and in_disc(click[0],click[1]): win=True
        if win: return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),True
        for a in ars:
            if not toks: break
            d,tg=min(((math.hypot(a[0]-t[1],a[1]-t[2]),t) for t in toks))
            if d<1e-6: continue
            sp=min(4.0 if tg[0]==0 else 5.5,d)
            nr=a[0]+sp*(tg[1]-a[0])/d; nc=a[1]+sp*(tg[2]-a[1])/d
            for cand in [(nr,nc),(nr,a[1]),(a[0],nc)]:
                if not blocked(cand): a[0],a[1]=cand; break
        dead=[]
        for t in toks:
            for a in ars:
                if math.hypot(a[0]-t[1],a[1]-t[2])<=KILL[t[0]]+0.4: dead.append((t,a)); break
        for t,a in dead:
            toks.remove(t)
            if t[0]>0:
                dd=math.hypot(t[1]-a[0],t[2]-a[1]) or 1.0
                toks.append([t[0]-1,min(61.0,max(1.0,t[1]+10*(t[1]-a[0])/dd)),min(61.0,max(1.0,t[2]+10*(t[2]-a[1])/dd))])
        return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),False
    def heur(st,win=False):
        if win: return 1e9
        tk=list(st[0]); mass=sum(2**t[0] for t in tk)
        if mass<8: return -1e6
        h=40.0*mass
        for t in tk:
            x=min([math.hypot(a[0]-t[1],a[1]-t[2]) for a in st[1]]+[99.0])
            d=math.hypot(t[1]-DISC[0],t[2]-DISC[1])
            h+=4.0*min(9.0,x)-(150.0 if x<3.4 else 0.0)
            if in_disc(t[1],t[2]): h+=140.0+30.0*t[0]
            elif t[0]>=1: h+=25.0-1.6*d
        for i in range(len(tk)):
            for j in range(i+1,len(tk)):
                if tk[i][0]==tk[j][0] and math.hypot(tk[i][1]-tk[j][1],tk[i][2]-tk[j][2])<=16.0: h+=25.0
        return h
    def cands(st):
        out=[]; tk=list(st[0])
        for i in range(len(tk)):
            for j in range(i+1,len(tk)):
                if tk[i][0]!=tk[j][0]: continue
                a,b=tk[i],tk[j]; d=math.hypot(a[1]-b[1],a[2]-b[2])
                if d>16.0 or d<1e-6: continue
                mr,mc=(a[1]+b[1])/2,(a[2]+b[2])/2
                pts=[(mr,mc)]
                dr,dc=DISC[0]-mr,DISC[1]-mc; dl=math.hypot(dr,dc) or 1
                for s in (2.0,4.0,6.0): pts.append((mr+dr/dl*s,mc+dc/dl*s))
                for p in pts:
                    if all(math.hypot(p[0]-t[1],p[1]-t[2])<=8.0 for t in [a,b]): out.append((round(p[0]),round(p[1])))
        for t in tk:
            if t[0]>=1:
                for k in range(10):
                    ang=2*math.pi*k/10
                    out.append((round(t[1]+8*math.cos(ang)),round(t[2]+8*math.sin(ang))))
            dr,dc=DISC[0]-t[1],DISC[1]-t[2]; dl=math.hypot(dr,dc) or 1
            out.append((round(t[1]+8*dr/dl),round(t[2]+8*dc/dl)))
            near=min(st[1],key=lambda a:math.hypot(a[0]-t[1],a[1]-t[2]))
            dr,dc=t[1]-near[0],t[2]-near[1]; dl=math.hypot(dr,dc) or 1
            out.append((round(t[1]+8*dr/dl),round(t[2]+8*dc/dl)))
        out.append((15,32))
        res=[]
        for (r,c) in out:
            if 1<=r<=61 and 1<=c<=61 and (r,c) not in res: res.append((r,c))
        return res
    frontier=[(0.0,[],start)]; seen={start:0.0}; bestsol=None
    for d in range(depth):
        nxt=[]
        for g,plan,st in frontier:
            for c in cands(st):
                ns,w=step_st(st,c)
                h=heur(ns,w)
                if h<=-1e5: continue
                np_=plan+[c]
                if w: return ('WIN',np_,ns)
                if bestsol is None or h>bestsol[0]: bestsol=(h,np_,ns)
                nxt.append((h,np_,ns))
        nxt.sort(key=lambda z:-z[0])
        frontier=[]
        for h,p,ns in nxt:
            if ns in seen and seen[ns]>=h: continue
            seen[ns]=h; frontier.append((h,p,ns))
            if len(frontier)>=beam: break
    return ('BEST',bestsol[1],bestsol[2])
START=(( (1,25.5,6.5),(1,26.5,42.5),(1,26.5,53.5),(1,28.5,14.5),
         (0,53.0,44.0),(0,54.0,14.0),(0,59.0,58.0),(0,60.0,3.0) ),
       ( (37.0,6.0),(37.0,48.0) ))
