import math
def sim_plan(start, clicks, DISC=(15.0,32.0,4.6), KILL={0:1.5,1:2.0,2:2.5,3:3.0}):
    def in_disc(r,c,pad=0.0): return math.hypot(r-DISC[0],c-DISC[1])<=DISC[2]+pad
    def shape(tip):
        r,c=tip; return [(r,c),(r+1,c-1),(r+1,c+1),(r+2,c-2),(r+2,c+2),(r+3,c-1),(r+3,c),(r+3,c+1)]
    def blocked(tip): return any(in_disc(rr,cc,-0.4) for rr,cc in shape(tip))
    st=start; out=[]
    for cl in clicks:
        toks=[list(t) for t in st[0]]; ars=[list(a) for a in st[1]]; ev=[]
        S=[(i,t) for i,t in enumerate(toks) if math.hypot(t[1]-cl[0],t[2]-cl[1])<=8.0]
        g={}
        for i,t in S: g.setdefault(t[0],[]).append((math.hypot(t[1]-cl[0],t[2]-cl[1]),i))
        best=None
        for tier,lst in g.items():
            if len(lst)>=2:
                lst.sort()
                if best is None or (len(lst),tier)>(len(g[best[0]]),best[0]): best=(tier,lst[:2])
        if best:
            tier,pair=best
            for _,i in sorted(pair,key=lambda z:-z[1]): toks.pop(i)
            toks.append([tier+1,float(cl[0]),float(cl[1])]); ev.append('MERGE t%d'%(tier+1))
            if tier+1==3 and in_disc(cl[0],cl[1]): out.append((cl,'WIN',ev)); return out
        elif len(S)==1:
            i=S[0][0]; toks[i][1]=float(cl[0]); toks[i][2]=float(cl[1]); ev.append('move t%d@%d,%d'%(toks[i][0],cl[0],cl[1]))
            if toks[i][0]==3 and in_disc(cl[0],cl[1]): out.append((cl,'WIN',ev)); return out
        elif len(S)==0: ev.append('NOOP')
        else: ev.append('MIXED!%d'%len(S))
        for a in ars:
            if not toks: break
            d,tg=min(((math.hypot(a[0]-t[1],a[1]-t[2]),t) for t in toks))
            sp=min(4.0 if tg[0]==0 else 5.5,d)
            nr=a[0]+sp*(tg[1]-a[0])/d; nc=a[1]+sp*(tg[2]-a[1])/d
            for cand in [(nr,nc),(nr,a[1]),(a[0],nc)]:
                if not blocked(cand): a[0],a[1]=cand; break
        for t in list(toks):
            for a in ars:
                if math.hypot(a[0]-t[1],a[1]-t[2])<=KILL[t[0]]+0.4:
                    toks.remove(t); ev.append('DEAD t%d@%.0f,%.0f'%(t[0],t[1],t[2]))
                    if t[0]>0:
                        dd=math.hypot(t[1]-a[0],t[2]-a[1]) or 1.0
                        toks.append([t[0]-1,min(61.0,max(1.0,t[1]+10*(t[1]-a[0])/dd)),min(61.0,max(1.0,t[2]+10*(t[2]-a[1])/dd))])
                    break
        st=(tuple(map(tuple,toks)),tuple(map(tuple,ars)))
        gaps=[min(math.hypot(a[0]-t[1],a[1]-t[2]) for a in st[1]) for t in st[0]]
        out.append((cl,'; '.join(ev),'minGap=%.1f'%min(gaps) if gaps else '-'))
    return out
CUR=(( (2,14.5,26.5),(0,53.0,44.0),(0,54.0,14.0),(0,59.0,58.0),(0,60.0,3.0) ),
     ( (18.0,6.0),(19.0,53.0) ))
