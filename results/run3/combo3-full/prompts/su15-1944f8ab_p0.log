import math
def fortress_plan(start, DISC=(15.0,32.0,4.6), KILL={0:1.5,1:2.0,2:2.5,3:3.0}):
    def in_disc(r,c,pad=0.0): return math.hypot(r-DISC[0],c-DISC[1])<=DISC[2]+pad
    def shape(tip):
        r,c=tip; return [(r,c),(r+1,c-1),(r+1,c+1),(r+2,c-2),(r+2,c+2),(r+3,c-1),(r+3,c),(r+3,c+1)]
    def blocked(tip): return any(in_disc(rr,cc,-0.4) for rr,cc in shape(tip))
    def step_st(st,click):
        toks=[list(t) for t in st[0]]; ars=[list(a) for a in st[1]]; ev=[]
        S=[(i,t) for i,t in enumerate(toks) if math.hypot(t[1]-click[0],t[2]-click[1])<=8.0]
        g={}
        for i,t in S: g.setdefault(t[0],[]).append((math.hypot(t[1]-click[0],t[2]-click[1]),i))
        best=None
        for tier,lst in g.items():
            if len(lst)>=2:
                lst.sort()
                if best is None or (len(lst),tier)>(len(g[best[0]]),best[0]): best=(tier,lst[:2])
        if best:
            tier,pair=best
            for _,i in sorted(pair,key=lambda z:-z[1]): toks.pop(i)
            toks.append([tier+1,float(click[0]),float(click[1])]); ev.append('merge->t%d'%(tier+1))
            if tier+1==3 and in_disc(click[0],click[1]): return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),'WIN',ev
        elif len(S)==1:
            i=S[0][0]; toks[i][1]=float(click[0]); toks[i][2]=float(click[1]); ev.append('move t%d'%toks[i][0])
            if toks[i][0]==3 and in_disc(click[0],click[1]): return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),'WIN',ev
        elif len(S)==0: ev.append('noop')
        else: ev.append('MIXED%d'%len(S))
        for a in ars:
            if not toks: break
            d,tg=min(((math.hypot(a[0]-t[1],a[1]-t[2]),t) for t in toks))
            if d<1e-6: continue
            sp=min(4.0 if tg[0]==0 else 5.5,d)
            nr=a[0]+sp*(tg[1]-a[0])/d; nc=a[1]+sp*(tg[2]-a[1])/d
            for cand in [(nr,nc),(nr,a[1]),(a[0],nc)]:
                if not blocked(cand): a[0],a[1]=cand; break
        dead=[]
        for t in toks:
            for a in ars:
                if math.hypot(a[0]-t[1],a[1]-t[2])<=KILL[t[0]]+0.4: dead.append((t,a)); break
        for t,a in dead:
            toks.remove(t); ev.append('DEAD t%d@%.0f,%.0f'%(t[0],t[1],t[2]))
            if t[0]>0:
                dd=math.hypot(t[1]-a[0],t[2]-a[1]) or 1.0
                toks.append([t[0]-1,min(61.0,max(1.0,t[1]+10*(t[1]-a[0])/dd)),min(61.0,max(1.0,t[2]+10*(t[2]-a[1])/dd))])
        return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),'',ev
    def walk(st,tier,target,avoid=8.0,maxn=8):
        # greedily move the tier-token nearest 'target' toward it in steps of 8
        for _ in range(maxn):
            tk=[t for t in st[0] if t[0]==tier]
            if not tk: return st,None
            t=min(tk,key=lambda z:math.hypot(z[1]-target[0],z[2]-target[1]))
            d=math.hypot(t[1]-target[0],t[2]-target[1])
            if d<=0.6: return st,t
            best=None
            for k in range(24):
                ang=2*math.pi*k/24
                for rad in (8.0,6.0):
                    nr=t[1]+rad*math.cos(ang); nc=t[2]+rad*math.sin(ang)
                    if not(1<=nr<=61 and 1<=nc<=61): continue
                    nd=math.hypot(nr-target[0],nc-target[1])
                    others=[x for x in st[0] if x is not t]
                    if any(math.hypot(x[1]-nr,x[2]-nc)<=avoid for x in others): continue
                    near=min([math.hypot(a[0]-nr,a[1]-nc) for a in st[1]]+[99.0])
                    sc=-nd+1.2*min(10.0,near)
                    if best is None or sc>best[0]: best=(sc,(round(nr),round(nc)))
            if best is None: return st,t
            st,fl,ev=step_st(st,best[1])
            if fl=='WIN': return st,'WIN'
        return st,t
    st=start; log=[]
    C=(15,32); C2=(18,32); OUT=(24,32)
    for phase,(tier,tgt) in enumerate([(1,C),(1,C2)]):
        st,t=walk(st,tier,tgt)
        if t=='WIN': return log,'WIN'
        log.append(('park%d'%phase,tgt))
        st,fl,ev=step_st(st,tgt)   # merge/park click
        log.append((tgt,ev))
        if fl=='WIN': return log,'WIN'
    return log,st
START=(( (1,25.5,6.5),(1,26.5,42.5),(1,26.5,53.5),(1,28.5,14.5),
         (0,53.0,44.0),(0,54.0,14.0),(0,59.0,58.0),(0,60.0,3.0) ),
       ( (37.0,6.0),(37.0,48.0) ))
log,st=fortress_plan(START)
for x in log: print(x)
print('tok',st[0]); print('ar',[tuple(round(v,1) for v in a) for a in st[1]])
