import math
# corrected model: no disc blocking; kill radius ~5 for all tiers; arrow speed 4.5
DISC=(15.0,32.0); DR=4.6
def step2(st,click,KILL=5.0,SPD=4.5):
    toks=[list(t) for t in st[0]]; ars=[list(a) for a in st[1]]; ev=[]; win=False
    S=[(i,t) for i,t in enumerate(toks) if math.hypot(t[1]-click[0],t[2]-click[1])<=8.0]
    g={}
    for i,t in S: g.setdefault(t[0],[]).append((math.hypot(t[1]-click[0],t[2]-click[1]),i))
    best=None
    for tier,lst in g.items():
        if len(lst)>=2:
            lst.sort()
            if best is None or (len(lst),tier)>(len(g[best[0]]),best[0]): best=(tier,lst[:2])
    def ind(r,c): return math.hypot(r-DISC[0],c-DISC[1])<=DR
    if best:
        tier,pair=best
        for _,i in sorted(pair,key=lambda z:-z[1]): toks.pop(i)
        toks.append([tier+1,float(click[0]),float(click[1])]); ev.append('MERGE t%d'%(tier+1))
        if tier+1==3 and ind(click[0],click[1]): win=True
    elif len(S)==1:
        i=S[0][0]; toks[i][1]=float(click[0]); toks[i][2]=float(click[1]); ev.append('move t%d'%toks[i][0])
        if toks[i][0]==3 and ind(click[0],click[1]): win=True
    elif len(S)==0: ev.append('noop')
    else: ev.append('MIXED')
    if win: return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),True,ev
    for a in ars:
        if not toks: break
        d,tg=min(((math.hypot(a[0]-t[1],a[1]-t[2]),t) for t in toks))
        sp=min(SPD,d)
        a[0]+=sp*(tg[1]-a[0])/d; a[1]+=sp*(tg[2]-a[1])/d
    for t in list(toks):
        for a in ars:
