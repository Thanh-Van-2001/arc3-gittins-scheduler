                    toks.append([t[0]-1,min(61.0,max(1.0,t[1]+10*(t[1]-a[0])/dd)),min(61.0,max(1.0,t[2]+10*(t[2]-a[1])/dd))])
                break
    return (tuple(map(tuple,toks)),tuple(map(tuple,ars))),False,ev
