def FLD(mover, obstacles, maxsteps=40):
    notches=[{(1,b0),(1,b0+1),(1,b0+2),(2,b0),(2,b0+2)} for b0 in (3,7,11)]
    ymap={}
    for i,n in enumerate(notches):
        for p in n: ymap[p]=i
    ceil={(0,c) for c in range(16)}
    solid=set(ceil)
    for (r,c,w) in list(obstacles)+[mover]:
        for k in range(w): solid.add((r,c+k))
    F={(14,10)}; conv={}
    for step in range(1,maxsteps+1):
        add=set(); died=False; ev=[]
        for (r,c) in list(F):
            up=(r-1,c)
            if up in F: continue
            if up in ceil: died=True; ev.append('DIE@%d'%c); continue
            if up in ymap:
                i=ymap[up]
                if i not in conv:
                    conv[i]=step; ev.append('conv%d@%d'%(i,step))
                    for p in notches[i]: solid.add(p); ymap.pop(p,None)
                continue
            if up in solid:
                for dc in (-1,1):
                    p=(r,c+dc)
                    if 0<=p[1]<16 and p not in solid and p not in F and p not in ymap and p not in ceil: add.add(p)
                continue
            add.add(up)
        F |= add
        rows={}
        for (r,c) in F: rows.setdefault(r,[]).append(c)
        s=';'.join(f'{r}:'+','.join(f'{min(v)}-{max(v)}' if len(v)>1 else str(v[0]) for v in [sorted(set(x))]) for r,x in [(k,sorted(set(v))) for k,v in sorted(rows.items())] for v in [x] if r<=15)
        print(step, ' '.join(ev), 'DIED' if died else '', s)
        if len(conv)==3: break
