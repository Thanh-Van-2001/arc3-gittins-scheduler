def FL4(bars, maxsteps=90, notches_start=(1,6,12), sources=((14,1),(14,9),(14,14))):
    notches=[{(1,b0),(1,b0+1),(1,b0+2),(2,b0),(2,b0+2)} for b0 in notches_start]
    valleys={(2,b0+1) for b0 in notches_start}
    ceil={(0,c) for c in range(16)}
    solid=set(ceil)|{p for n in notches for p in n}
    for (r,c,w) in bars:
        for k in range(w): solid.add((r,c+k))
    F=set(sources); vfill={}; dead=None
    for step in range(1,maxsteps+1):
        add=set(); died=False
        for (r,c) in F:
            up=(r-1,c)
            if up in F or up in solid: 
                if up in solid and up in ceil: died=True; continue
                if up in solid and up not in ceil:
                    for dc in (-1,1):
                        p=(r,c+dc)
                        if 0<=p[1]<16 and p not in solid and p not in F: add.add(p)
                continue
            add.add(up)
        F|=add
        for v in valleys:
            if v in F and v not in vfill: vfill[v]=step
        if died and dead is None: dead=step
        if len(vfill)==3 or (dead and step>dead): break
        if not add: break
    last=max(vfill.values()) if vfill else 0
    margin = (dead-last) if dead else (99 if len(vfill)==3 else -99)
    return dict(n=len(vfill), vfill=vfill, dead=dead, margin=margin)
print('init cfg:',FL4([(5,2,4),(7,10,5),(8,2,6),(10,9,6)]))
print('L2 win cfg (adapt):', FL4([(4,5,3),(9,7,5)], notches_start=(3,7,11), sources=((14,10),)))
