def FL2(mover, obstacles, maxsteps=60):
    # same as FL but continues after 3rd conversion to confirm no leak
    notches=[{(1,b0),(1,b0+1),(1,b0+2),(2,b0),(2,b0+2)} for b0 in (3,7,11)]
    ymap={}
    for i,n in enumerate(notches):
        for p in n: ymap[p]=i
    ceil={(0,c) for c in range(16)}
    solid=set(ceil)
    for (r,c,w) in list(obstacles)+[mover]:
        for k in range(w): solid.add((r,c+k))
    F={(14,10)}; conv={}; dead=None
    for step in range(1,maxsteps+1):
        add=set(); died=False
        for (r,c) in list(F):
            up=(r-1,c)
            if up in F: continue
            if up in ceil: died=True; continue
            if up in ymap:
                i=ymap[up]
                if i not in conv:
                    conv[i]=step
                    for p in notches[i]: solid.add(p); ymap.pop(p,None)
                continue
            if up in solid:
                for dc in (-1,1):
                    p=(r,c+dc)
                    if 0<=p[1]<16 and p not in solid and p not in F and p not in ymap and p not in ceil: add.add(p)
                continue
            add.add(up)
        if died and dead is None: dead=step
        F|=add
        if not add and not died: break
    return dict(conv=conv,dead=dead,all3=len(conv)==3,margin=(dead-max(conv.values())) if (dead and conv) else None)
