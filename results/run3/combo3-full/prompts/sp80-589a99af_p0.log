def FL3(bars, maxsteps=80):
    # bars: list of (row, col, width)
    notches=[{(1,b0),(1,b0+1),(1,b0+2),(2,b0),(2,b0+2)} for b0 in (1,6,12)]
    valleys={(2,2),(2,7),(2,13)}
    ymap={}
    for i,n in enumerate(notches):
        for p in n: ymap[p]=i
    ceil={(0,c) for c in range(16)}
    solid=set(ceil)
    for (r,c,w) in bars:
        for k in range(w): solid.add((r,c+k))
    F={(14,1),(14,9),(14,14)}; vfill={}; dead=None
    for step in range(1,maxsteps+1):
        add=set(); died=False
        for (r,c) in list(F):
            up=(r-1,c)
            if up in F: continue
            if up in ceil: died=True; continue
            if up in ymap:
                i=ymap[up]
                if i not in vfill and False: pass
                if i not in vfill and False: pass
                # convert notch
                if i not in vfill or True:
                    pass
                for p in notches[i]: solid.add(p); ymap.pop(p,None)
                continue
            if up in solid:
                for dc in (-1,1):
                    p=(r,c+dc)
                    if 0<=p[1]<16 and p not in solid and p not in F and p not in ymap and p not in ceil: add.add(p)
                continue
            add.add(up)
        F|=add
        for v in valleys:
            if v in F and v not in vfill: vfill[v]=step
        if died and dead is None: dead=step
        if len(vfill)==3: break
        if not add and not died: break
    return dict(vfill=vfill, dead=dead, all3=len(vfill)==3, margin=(dead-max(vfill.values())) if (dead and len(vfill)==3) else (None if len(vfill)<3 else 99))
print(FL3([(5,2,4),(7,10,5),(8,2,6),(10,9,6)]))
