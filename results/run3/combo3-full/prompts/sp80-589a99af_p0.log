def snap(f):
    out=[]
    for n in f.segmentation['nodes']:
        if n['color'] in 'bR' and n['pixels']<400:
            b=n['boundary']; rs=[p[0] for p in b]; cs=[p[1] for p in b]
            out.append((n['color'],(max(rs)-min(rs)+1)//4,(max(cs)-min(cs)+1)//4,min(rs)//4,min(cs)//4))
    return sorted(out,reverse=True)
