def A2():
    g = current_frame.ascii.split('\n')
    assert all(len(r)==64 for r in g)
    return g
def clusters(g, pred):
    S = {(i,j) for i in range(63) for j in range(64) if pred(g[i][j])}
    seen=set(); out=[]
    for p in sorted(S):
        if p in seen: continue
        st=[p]; seen.add(p); cl=[]
        while st:
            a,b=st.pop(); cl.append((a,b))
            for d in ((1,0),(-1,0),(0,1),(0,-1)):
                q=(a+d[0],b+d[1])
                if q in S and q not in seen: seen.add(q); st.append(q)
        out.append(sorted(cl))
    return out
g = A2()
boat = [c for c in clusters(g, lambda ch: ch in 'bY')]
