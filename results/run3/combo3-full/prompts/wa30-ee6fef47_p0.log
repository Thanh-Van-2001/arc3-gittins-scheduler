def boxes(fr):
    a = fr.ascii.split('\n')
    seg = fr.segmentation
    out=[]
    for n in seg['nodes']:
        if n['color'] in ('c','G','W','B','w') and n['children']:
            b=n['boundary']; r0=min(p[0] for p in b); c0=min(p[1] for p in b); r1=max(p[0] for p in b); c1=max(p[1] for p in b)
            out.append((n['color'],r0,c0,r1,c1))
    return out
def slots(fr):
    seg = fr.segmentation; out=[]
    for n in seg['nodes']:
        if n['color']=='b':
            b=n['boundary']; r0=min(p[0] for p in b); c0=min(p[1] for p in b); r1=max(p[0] for p in b); c1=max(p[1] for p in b)
            if (r1-r0+1)*(c1-c0+1) >= 12: out.append((r0,r1,c0,c1,'full' if n['children'] else 'EMPTY'))
    return out
