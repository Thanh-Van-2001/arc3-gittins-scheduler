def pl(fr):
    a = fr.ascii.split('\n')
    n = w = None
    for i,row in enumerate(a):
        for j,ch in enumerate(row):
            if ch=='N': n = (n or (i,j)) and (min(n[0],i), min(n[1],j), max(n[0],i), max(n[1],j)) if n else (i,j,i,j)
            if ch=='W': w = (w or (min(w[0],i),min(w[1],j),max(w[0],i),max(w[1],j))) if w else (i,j,i,j)
    return n, w
seq = ['UP','UP','RIGHT','RIGHT','RIGHT','DOWN','LEFT','SPACE','LEFT','LEFT','LEFT','SPACE',
       'DOWN','RIGHT','RIGHT','SPACE','RIGHT','SPACE']
for i,act in enumerate(seq):
    try:
        r = action([act])
    except Exception as e:
        print(i+1, act, 'ERR', type(e).__name__); break
    n,w = pl(current_frame)
    f = full(current_frame)
    print(i+1, act, 'lvl=', r.get('level_completed'), 'ov=', r.get('game_over'), 'body=', n, 'cap=', w, 'O=', f['O'])
    if r.get('level_completed') or r.get('game_over'): print('END'); break
