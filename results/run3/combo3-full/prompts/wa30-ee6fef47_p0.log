def full(fr):
    a = fr.ascii.split('\n')
    seg = fr.segmentation
    out = {'O':[], 'boxes':[], 'player':None}
    for n in seg['nodes']:
        b=n['boundary']; r0=min(p[0] for p in b); c0=min(p[1] for p in b); r1=max(p[0] for p in b); c1=max(p[1] for p in b)
        if n['color']=='O': out['O'].append((r0,c0))
        if n['color'] in ('c','G') and n['children']: out['boxes'].append((n['color'],r0,c0,r1,c1))
        if n['color']=='N': out['player']=(r0-1,c0 if a[r0-1][c0]=='W' else c0+1)
    return out
