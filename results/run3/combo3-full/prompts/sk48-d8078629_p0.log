def dashpix(fr):
    a=fr.ascii.split('\n')
    hs=[i for i,row in enumerate(a) if 'MMMMMM' in row and i<52]
    hr=min(hs)
    row=a[hr+2]
    return hr, [(j,c) for j,c in enumerate(row) if c in 'wg' and 15<=j<=47]
