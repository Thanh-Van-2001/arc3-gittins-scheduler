def boxes(fr,cols='RNb'):
    a=fr.ascii.split('\n')
    out={}
    for ch in cols:
        pts=[(i,j) for i,row in enumerate(a) for j,c in enumerate(row) if c==ch and i<52]
        if pts:
            rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
            out[ch]=(min(rs),max(rs),min(cs),max(cs),len(pts))
    return out
print('blocks r0,r1,c0,c1,n:',boxes(current_frame))
