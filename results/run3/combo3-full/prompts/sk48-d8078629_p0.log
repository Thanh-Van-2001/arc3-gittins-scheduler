def succ2(st,act):
    b,m,R,N,Bl=st
    blk={'R':R,'N':N,'b':Bl}
    if act in ('UP','DOWN'):
        d=-1 if act=='UP' else 1
        nb=b+d
        if not (0<=nb<=4): return None
        hooked=[c for c in 'RNb' if blk[c][0]==b and blk[c][1]<=m]
        newpos=dict(blk); moved=set()
        for c in hooked:
            if c in moved: continue
            band,slot=blk[c]; chain=[c]; k=band+d; ok=True
            while True:
                occ=[x for x in 'RNb' if x not in chain and blk[x]==(k,slot)]
                if not occ: break
                chain.append(occ[0]); k+=d
                if not (0<=k<=4): ok=False; break
            if not ok: return None
            for x in chain: newpos[x]=(blk[x][0]+d,slot); moved.add(x)
        return (nb,m,newpos['R'],newpos['N'],newpos['b'])
    if act in ('LEFT','RIGHT'):
        if act=='LEFT':
            if m==0: return None
            nm=m-1; lim=m; order=sorted([c for c in 'RNb' if blk[c][0]==b],key=lambda c:blk[c][1])
        else:
            if m==5: return None
            nm=m+1; lim=m+1; order=sorted([c for c in 'RNb' if blk[c][0]==b],key=lambda c:-blk[c][1])
        newpos=dict(blk); occ=set(newpos[c] for c in 'RNb')
        for c in order:
            band,s=blk[c]
            if s>lim: continue
            ts=s+(1 if act=='RIGHT' else -1)
            if not (1<=ts<=5): continue
            if (band,ts) in occ: continue
            occ.discard((band,s)); occ.add((band,ts)); newpos[c]=(band,ts)
        return (b,nm,newpos['R'],newpos['N'],newpos['b'])
    return None

