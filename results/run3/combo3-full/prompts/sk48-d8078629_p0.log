from collections import deque
def bfs(start,goal,maxd=14):
    q=deque([(start,())]); seen={start}
    while q:
        st,path=q.popleft()
        if len(path)>maxd: break
        if goal(st): return path
        for a in ('UP','DOWN','LEFT','RIGHT'):
            ns=succ(st,a)
            if ns and ns not in seen:
                seen.add(ns); q.add if False else q.append((ns,path+(a,)))
    return None
