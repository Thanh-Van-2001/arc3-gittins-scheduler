def bfs7b(start, maxstates=400000):
    from collections import deque
    # state: (L1,L2,L3,L4,L5, n,y,p) panels index 0..4 = P1..P5 ; handles 'n','y','k'(pink)
    MIN=[8,8,8,32,32]; MAX=[30,56,30,56,56]
    DOFS=[((8,20),(8,24),0,1),((8,38),(8,42),1,2),((32,20),(32,24),3,1),((32,38),(32,42),1,4)]
    WINS=[((20,40),1,2,16),((41,40),1,4,38),((41,22),3,1,38)]
    def moves(st):
        L=list(st[:5]); h={'n':st[5],'y':st[6],'k':st[7]}
        out=[]
        for (bu,bd,i,j) in DOFS:
            if L[i]+2<=MAX[i] and L[j]-2>=MIN[j]:
                nl=list(L); nl[i]+=2; nl[j]-=2; out.append((bu,tuple(nl)+st[5:]))
            if L[j]+2<=MAX[j] and L[i]-2>=MIN[i]:
                nl=list(L); nl[j]+=2; nl[i]-=2; out.append((bd,tuple(nl)+st[5:]))
        for (clk,i,j,req) in WINS:
            if L[i]==req and L[j]==req:
                for kk in 'nyk':
                    if h[kk]==i:
                        nh=dict(h); nh[kk]=j; out.append((clk,st[:5]+(nh['n'],nh['y'],nh['k'])))
                    elif h[kk]==j:
                        nh=dict(h); nh[kk]=i; out.append((clk,st[:5]+(nh['n'],nh['y'],nh['k'])))
        return out
    def goal(st): return st[st[5]]==18 and st[st[6]]==26 and st[st[7]]==50
    seen={start:None}; dq=deque([start]); found=None
    while dq:
        s=dq.popleft()
        if goal(s): found=s; break
        for act,ns in moves(s):
            if ns not in seen:
                seen[ns]=(s,act); dq.append(ns)
                if len(seen)>maxstates: return ('LIMIT',len(seen))
    if found is None: return ('NONE',len(seen))
    path=[]; cur=found
    while seen[cur] is not None:
        prev,act=seen[cur]; path.append(act); cur=prev
    path.reverse(); return path
