def solve7e(start, maxstates=1500000):
    from collections import deque
    MIN=[8,8,8,32,32]; MAX=[30,56,30,56,56]
    DOFS=[((8,20),(8,24),0,1),((8,38),(8,42),1,2),((32,20),(32,24),3,1),((32,38),(32,42),1,4)]
    WINS=[((20,40),1,2,16),((41,40),1,4,38),((41,22),3,1,38)]
    def goal(s): return s[5]==1 and s[1]==18 and s[6]==2 and s[2]==26 and s[7]==3 and s[3]==50
    seen={start:None}; dq=deque([start]); found=None
    while dq:
        s=dq.popleft()
        if goal(s): found=s; break
        L=s[:5]; hs=s[5:]
        for (bu,bd,i,j) in DOFS:
            if L[i]+2<=MAX[i] and L[j]-2>=MIN[j]:
                nl=list(L); nl[i]+=2; nl[j]-=2; ns=tuple(nl)+hs
                if ns not in seen: seen[ns]=(s,bu); dq.append(ns)
            if L[j]+2<=MAX[j] and L[i]-2>=MIN[i]:
                nl=list(L); nl[j]+=2; nl[i]-=2; ns=tuple(nl)+hs
                if ns not in seen: seen[ns]=(s,bd); dq.append(ns)
        for (clk,i,j,req) in WINS:
            if L[i]==req and L[j]==req:
                nh=list(hs); any_=False
                for k in range(3):
                    if nh[k]==i: nh[k]=j; any_=True
                    elif nh[k]==j: nh[k]=i; any_=True
                if any_:
                    ns=s[:5]+tuple(nh)
                    if ns not in seen: seen[ns]=(s,clk); dq.append(ns)
        if len(seen)>maxstates: return ('LIMIT',len(seen))
    if found is None: return ('NONE',len(seen))
    path=[]; cur=found
    while seen[cur] is not None:
        prev,act=seen[cur]; path.append(act); cur=prev
    path.reverse(); return path
