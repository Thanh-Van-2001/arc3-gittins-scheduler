import itertools
CYC=[4,3,2,5,0,1,6]   # pink cycle order: succ(CYC[i]) = CYC[i+1]
pos={l:i for i,l in enumerate(CYC)}
def d(a,b): return (pos[b]-pos[a])%7   # presses from letter a to letter b
cur={'P1':4,'P2':3,'P3':5,'Q1':2,'Q2':3,'Q3':6}
curY={'Y1':3,'Y2':0,'Y3':2}
roleY={'A':4,'B':1,'C':0}
best=[]
for px in range(7):
    x=CYC[px]; b=CYC[(px+5)%7]
    for pv in range(7):
        v=CYC[pv]
        roles={'A':x,'B':b,'C':v}
        for perm in itertools.permutations(['A','B','C']):
            # perm[i] = role assigned to tile i (1,2,3)
            cost=0; detail={}
            cost+=d(cur['P1'],x); detail['P1']=d(cur['P1'],x)
            cost+=d(cur['P2'],b); detail['P2']=d(cur['P2'],b)
            cost+=d(cur['P3'],v); detail['P3']=d(cur['P3'],v)
            ycost=0
            for i,role in enumerate(perm,start=1):
                dq=d(cur['Q%d'%i],roles[role]); cost+=dq
                dy=(0 if curY['Y%d'%i]==roleY[role] else 3)
                ycost+=dy
                detail['Q%d'%i]=dq
            best.append((cost+ycost,cost,ycost,x,b,v,perm,detail))
best.sort()
for r in best[:6]:
    print('tot',r[0],'pink',r[1],'y~',r[2],'A',r[3],'B',r[4],'C',r[5],'roles(t1,t2,t3)',r[6],r[7])
