def pos6(gr, POS=(('B1',2,12),('P1',2,25),('Q1',2,41),('Y1',2,51),('B2',14,12),('P2',14,25),('Q2',14,41),('Y2',14,51),('B3',26,12),('P3',26,25),('Q3',26,41),('Y3',26,51))):
