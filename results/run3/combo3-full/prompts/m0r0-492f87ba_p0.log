def lv4(fr):
    a=fr.ascii.split('\n'); free=set(); haz=set(); big=set(); sml=set()
    for i in range(15):
        for j in range(15):
            cnt={}
            for r in range(2+4*i,6+4*i):
                for c in range(2+4*j,6+4*j):
                    if r<64 and c<64: cnt[a[r][c]]=cnt.get(a[r][c],0)+1
            tot=sum(cnt.values()); B=cnt.get('B',0)
            if cnt.get('S',0)>=8 or cnt.get('w',0)>=8: big.add((i,j)); free.add((i,j))
            elif (cnt.get('b',0)>=2 or (cnt.get('Y',0)>=2 and B>=4)) and B>=4: sml.add((i,j)); free.add((i,j))
            elif cnt.get('R',0)>=2: haz.add((i,j))
            elif B>=tot*0.5: free.add((i,j))
    return free,haz,big,sml
