def path_moves(fr_free,start,goal,blocked):
    import collections
    prev={start:None}; q=collections.deque([start])
    while q:
        c=q.popleft()
        if c==goal: break
        for a,(dx,dy) in [('UP',(-1,0)),('DOWN',(1,0)),('LEFT',(0,-1)),('RIGHT',(0,1))]:
            y=(c[0]+dx,c[1]+dy)
            if y in fr_free and y not in blocked and y not in prev:
                prev[y]=(c,a); q.append(y)
    if goal not in prev: return None
    out=[]; c=goal
    while prev[c] is not None:
        p,a=prev[c]; out.append(a); c=p
    return list(reversed(out))
