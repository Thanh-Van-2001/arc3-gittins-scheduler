def lv4c(fr,off=4,sz=5,n=12):
    a=fr.ascii.split('\n'); free=set(); haz=set(); big=set(); sml=set()
    for i in range(n):
        for j in range(n):
            cnt={}
            for r in range(off+sz*i,off+sz*i+sz):
                for c in range(off+sz*j,off+sz*j+sz):
                    if r<64 and c<64: cnt[a[r][c]]=cnt.get(a[r][c],0)+1
            tot=sum(cnt.values()); B=cnt.get('B',0); R=cnt.get('R',0)
            if cnt.get('S',0)>=8 or cnt.get('w',0)>=8: big.add((i,j)); free.add((i,j))
            elif cnt.get('b',0)>=2 or (cnt.get('Y',0)>=4 and B>=4): sml.add((i,j)); free.add((i,j))
            elif R>=3: haz.add((i,j))
            elif B>=tot*0.5: free.add((i,j))
    return free,haz,big,sml
