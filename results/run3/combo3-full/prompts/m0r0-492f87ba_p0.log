def bfsDsafe(start,free,haz):
    import collections
    D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    def step(s,a):
        (pr,pc),(mr,mc)=s; dr,dc=D[a]
        np_=(pr+dr,pc+dc); nm=(mr+dr,mc-dc)
        if np_ in haz or nm in haz: return None   # fatal
        if np_ not in free: np_=(pr,pc)
        if nm not in free: nm=(mr,mc)
        return (np_,nm)
    if start[0]==start[1]: return ([],start[0])
    dist={start:None}; q=collections.deque([start])
    while q:
        s=q.popleft()
        for a in D:
            n=step(s,a)
            if n is None or n in dist: continue
            if n[0]==n[1]:
                path=[a]; t=s
                while dist[t] is not None: path.append(dist[t][0]); t=dist[t][1]
                return list(reversed(path)),n[0]
            dist[n]=(s,a); q.append(n)
    return None
