def build_grid(fr):
    return [list(r) for r in fr.ascii.split('\n')]
CLAW=[(0,3),(0,4),(0,5),(0,6),(0,7),(1,3),(1,7),(2,0),(2,1),(2,2),(2,3),(3,0),(3,1),(3,2),(3,3),
      (4,0),(4,1),(4,2),(4,3),(5,1),(5,2),(5,3),(6,3),(6,7),(7,3),(7,4),(7,5),(7,6),(7,7)]
PAY=[(0,1),(0,2),(1,1),(1,2)]
def clawgrid(g,rr,cc,clawwalk=True):
    h=[[row[:] for row in g] for g in [g]][0]
    h=[row[:] for row in g]
    for dr in range(8):
        for dc in range(8):
            r,c=rr+dr,cc+dc
            if not(0<=r<64 and 0<=c<64): continue
            if (dr,dc) in CLAW: h[r][c]='R' if clawwalk else 'c'
            elif (dr,dc) in PAY: h[r][c]='W'
    return h
def comp(h,sr,sc,block=('c','B')):
    seen={(sr,sc)}; st=[(sr,sc)]; cells=[(sr,sc)]
    while st:
        r,c=st.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<64 and 0<=nc<64 and (nr,nc) not in seen and h[nr][nc] not in block:
                seen.add((nr,nc)); st.append((nr,nc)); cells.append((nr,nc))
    return cells
