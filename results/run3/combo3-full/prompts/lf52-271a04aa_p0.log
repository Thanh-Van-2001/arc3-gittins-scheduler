                m=(p[0]+dr,p[1]+dc); l=(p[0]+2*dr,p[1]+2*dc)
                if m in pl and l in pl and m in pegs and l not in pegs: out.append((p,m,l))
        return out
    start=(frozenset(pegs0),lk0)
    from collections import deque
    prev={start:None}
    q=deque([start])
    goals=[]
    while q:
        st=q.popleft()
        pegs,s=st
        if len(pegs)==1:
            goals.append(st); break
        # lock moves
        for d in DIR:
            s2=sl(s,d)
