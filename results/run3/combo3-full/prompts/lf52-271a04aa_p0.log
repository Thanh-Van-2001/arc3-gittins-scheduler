    return B1,B2,BIG,C1,C2
def solve(pegs0, lk0, maxdepth=200):
    B1,B2,BIG,C1,C2=MODEL(); BOARD=B1|B2|BIG
    DIR={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    def lm(path,i,d):
        dr,dc=DIR[d]
        for ni in (i+1,i-1):
            if 0<=ni<len(path) and (path[ni][0]-path[i][0],path[ni][1]-path[i][1])==(dr,dc): return ni
        return i
    def sl(s,d): return (lm(C1,s[0],d), lm(C2,s[1],d))
    def js(s,pegs):
        pl=BOARD|{C1[s[0]],C2[s[1]]}; out=[]
        for p in pegs:
