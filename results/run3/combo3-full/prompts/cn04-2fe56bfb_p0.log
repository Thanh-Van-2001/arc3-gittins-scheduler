def models6(P, GRID=20):
    M={}
    for k,(b,t) in P.items():
        rs=[]
        for i in range(4):
            Bs=set((r,c) for r,c in b); Ts=set((r,c) for r,c in t)
            for _ in range(i):
                Bs=set((c,-r) for r,c in Bs); Ts=set((c,-r) for r,c in Ts)
            U=Bs|Ts; mr=min(r for r,c in U); mc=min(c for r,c in U)
            rs.append((frozenset((r-mr,c-mc) for r,c in Bs),frozenset((r-mr,c-mc) for r,c in Ts)))
        M[k]=rs
    return M
