def rec(color, click):
    action([{'action':'MOUSE','row':3*click[0]+3,'col':3*click[1]+3}])
    body=set(); reds=set()
    for ch,s in comps_of(current_frame):
        if ch==color and s: body|=set(s)
        if ch=='R' and s: reds|=set(s)
    adj=set()
    for r,c in body:
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            if (r+dr,c+dc) in reds: adj.add((r+dr,c+dc))
    return color, sorted(body), sorted(adj)
