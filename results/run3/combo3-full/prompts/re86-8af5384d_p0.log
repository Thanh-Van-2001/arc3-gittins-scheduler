    return set((r,c) for r in range(64) for c in range(64) if rows[r][c]==col)
for col in 'SOP':
    C=cells(col)
    rs=sorted(set(r for r,c in C)); cs=sorted(set(c for r,c in C))
    print(col,len(C),'rows',rs[0],rs[-1],'cols',cs[0],cs[-1])
    # find full rows / cols (bars)
    for r in rs:
        cc=sorted(c for (rr,c) in C if rr==r)
        if len(cc)>6: print('   hbar row',r,'cols',cc[0],cc[-1],len(cc))
    for c in cs:
        rr=sorted(r for (r,cc) in C if cc==c)
        if len(rr)>6: print('   vbar col',c,'rows',rr[0],rr[-1],len(rr))
