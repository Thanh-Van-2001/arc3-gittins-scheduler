def sqgeom(fr):
    rows=fr.ascii.split('\n'); p=yprof(rows)
    sq={rr:v for rr,v in p.items() if not (len(v)==2 and v in ([(45,45),(54,54)],[(45,45),(54,54)]) )}
    # identify square rows: rows with a span of width>=4
    hrows={rr:v for rr,v in p.items() if any(b-a>=4 for (a,b) in v)}
    ys=sorted(hrows)
    top=hrows[ys[0]]; bot=hrows[ys[-1]]
    l=min(a for (a,b) in top); r=max(b for (a,b) in top)
    # vertical edges from a middle row
    return (ys[0],ys[-1],l,r)
