def GRAY(): return set((r,c) for r in range(28,36) for c in range(28,36))
def hcells9(hr,W,ah=9): return set((hr,c) for c in range(W-ah,W+ah+1) if 0<=c<64)
def vcells9(V,vr,av=9): return set((r,V) for r in range(vr-av,vr+av+1) if 0<=r<64)
def pstep(st,act,obs,ah=9,av=9):
    hr,W,V,vr=st; nh,nW,nV,nv=st
    if act in ('LEFT','RIGHT'):
        d=-3 if act=='LEFT' else 3
        if not blocked(hcells9(hr,W+d,ah),obs): nW=W+d
        if not blocked(vcells9(V+d,vr,av),obs): nV=V+d
    else:
        d=-3 if act=='UP' else 3
        if not blocked(hcells9(hr+d,W,ah),obs): nh=hr+d
        if not blocked(vcells9(V,vr+d,av),obs): nv=vr+d
    return (nh,nW,nV,nv)
from collections import deque
def bfs(start,goaltest,obs,ah=9,av=9,conn=True):
    prev={start:None}; q=deque([start]); g=None
    while q:
        s=q.popleft()
        if goaltest(s): g=s; break
        for a in ('UP','DOWN','LEFT','RIGHT'):
            t=pstep(s,a,obs,ah,av)
            if t in prev or t==s: continue
            if conn:
                hr,W,V,vr=t
                if not (W-ah<=V<=W+ah and vr-av<=hr<=vr+av): continue
            prev[t]=(s,a); q.append(t)
    if g is None: return None
    path=[]; s=g
    while prev[s] is not None:
        p,a=prev[s]; path.append(a); s=p
    path.reverse(); return (g,path)
