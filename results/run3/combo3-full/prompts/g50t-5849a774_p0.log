def fits2(G,r,c,walls):
    if r-2<0 or c-2<0 or r+2>=len(G) or c+2>=len(G[0]): return False
    return all(G[r+dr][c+dc] not in 'W'+walls for dr in range(-2,3) for dc in range(-2,3))
def reach4(G,start,walls):
    from collections import deque
    f=lambda r,c: fits2(G,r,c,walls)
    seen={start}; q=deque([start]); par={start:None}
    while q:
        y,x=q.popleft()
        for dy,dx in((6,0),(-6,0),(0,6),(0,-6)):
            uy,ux=dy//6,dx//6
            if not all(f(y+uy*i,x+ux*i) for i in range(1,7)): continue
            ny,nx=y+dy,x+dx
            if (ny,nx) not in seen: seen.add((ny,nx)); par[(ny,nx)]=(y,x); q.append((ny,nx))
    return seen,par
