def solve(card, extra_patches=(), maxd=6):
    T = {}
    for r in range(10):
        for c in range(10): T[(r,c)] = card[r][c]
    cells = set(T)
    F = {
     'N':{(r,c) for r in range(10) for c in range(10) if r<=4},
     'S':{(r,c) for r in range(10) for c in range(10) if r>=5},
     'E':{(r,c) for r in range(10) for c in range(10) if c>=5},
     'W':{(r,c) for r in range(10) for c in range(10) if c<=4},
     'NW':{(r,c) for r in range(10) for c in range(10) if r+c<=9},
     'NE':{(r,c) for r in range(10) for c in range(10) if c>=r},
     'SE':{(r,c) for r in range(10) for c in range(10) if r+c>=9},
     'SW':{(r,c) for r in range(10) for c in range(10) if c<=r},
    }
    F.update({k:set(v) for k,v in extra_patches})
    colors = sorted({v for v in T.values() if v!='W'})
    target_cov = {p for p in cells if T[p]!='W'}
    best=None
    # reverse peel DFS with memo on U
    seen={}
    def dfs(U, path):
        nonlocal best
        if len(path) >= maxd: return
        if U == target_cov:
            if best is None or len(path)<len(best): best = list(path)
            return
        # prune: remaining cells must be coverable
        rem = target_cov - U
        for name,fp_ in F.items():
            for col in colors:
                add = fp_ - U
                if not add: continue
                if not add <= {p for p in cells if T[p]==col}: continue
                # progress heuristic: prefer large add
                dfs(U|fp_, path+[(name,col,len(add))])
                if best is not None and len(best)<=len(path)+1: return
    dfs(frozenset(), [])
    return best
