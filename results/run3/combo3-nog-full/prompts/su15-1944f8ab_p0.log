def cmove(s, prefix, prefer, r=8):
    objs=allobjects(s); tgt=[o for o in objs if o[0].startswith(prefix)]
    if not tgt: return None
    tb=tgt[0][1]; best=None
    for rr in range(max(2,tb[0]-r), min(60,tb[2]+r)+1):
        for cc in range(max(1,tb[1]-r), min(62,tb[3]+r)+1):
            t=(rr,cc)
            if dbox(tb,t)>r: continue
            if any(nm!=tgt[0][0] and dbox(b,t)<=r for nm,b,k in objs): continue
            if s['arch'] and dbox(archbox(s),t)<=r: continue
            sc=abs(rr-prefer[0])*3+abs(cc-prefer[1])*3-dbox(archbox(s),t) if s['arch'] else 0
            if best is None or sc<best[0]: best=(sc,t)
    return best[1] if best else None
def cmerge(s, p1, p2, prefer, r=8):
    objs=allobjects(s)
    a=[o for o in objs if o[0].startswith(p1)]; b=[o for o in objs if o[0].startswith(p2)]
    if not a or not b: return None
    a=a[0]; b=b[0]; best=None
    for rr in range(max(2,min(a[1][0],b[1][0])-r), min(60,max(a[1][2],b[1][2])+r)+1):
        for cc in range(max(1,min(a[1][1],b[1][1])-r), min(62,max(a[1][3],b[1][3])+r)+1):
            t=(rr,cc)
            if dbox(a[1],t)>r or dbox(b[1],t)>r: continue
            if any(nm not in (a[0],b[0]) and dbox(bb,t)<=r for nm,bb,k in objs): continue
            if s['arch'] and dbox(archbox(s),t)<=r: continue
            sc=abs(rr-prefer[0])*3+abs(cc-prefer[1])*3-(dbox(archbox(s),t) if s['arch'] else 0)
            if best is None or sc<best[0]: best=(sc,t)
    return best[1] if best else None
