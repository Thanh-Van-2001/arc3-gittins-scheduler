def allobjects(s):
    o=[]
    for col,lst in s['pieces'].items():
        for px in lst: o.append((col+str(px[1]),(px[1][0],px[1][1],px[2][0],px[2][1]),col))
    for d in s['dotpos']: o.append(('dot'+str(d),(d[0],d[1],d[0],d[1]),'S'))
    ab=archbox(s)
    if ab: o.append(('ARCH',ab,'ARCH'))
    return o
def inrange(s,t,r=8):
    return [(nm,dbox(b,t),kind) for nm,b,kind in allobjects(s) if dbox(b,t)<=r]
def kind_of(nm):
    return nm[0]
def choose_move(s, prefix, prefer=None, r=8):
    # find click within r of the object starting with prefix, no other object within r, arch>r
    best=None
    objs=[o for o in allobjects(s)]
    tgt=[o for o in objs if o[0].startswith(prefix)]
    if not tgt: return None
    tb=tgt[0][1]
    for rr in range(max(2,tb[0]-r), min(60,tb[2]+r)+1):
        for cc in range(max(1,tb[1]-r), min(62,tb[3]+r)+1):
            t=(rr,cc)
            if dbox(tb,t)>r: continue
            others=[(nm,d) for nm,b,k in objs if nm!=tgt[0][0] and dbox(b,t)<=r]
            if others: continue
            ad=dbox(archbox(s),t) if s['arch'] else 99
            if ad<=r: continue
            score=ad
            if prefer: score-=abs(rr-prefer[0])*2+abs(cc-prefer[1])*2
            if best is None or score>best[0]: best=(score,t)
    return best[1] if best else None
def choose_merge(s, p1, p2, r=8):
    objs=allobjects(s)
    t1=[o for o in objs if o[0].startswith(p1)][0]; t2=[o for o in objs if o[0].startswith(p2)][0]
    best=None
    r0=max(2,min(t1[1][0],t2[1][0])-r); r1=min(60,max(t1[1][2],t2[1][2])+r)
    c0=max(1,min(t1[1][1],t2[1][1])-r); c1=min(62,max(t1[1][3],t2[1][3])+r)
    for rr in range(r0,r1+1):
        for cc in range(c0,c1+1):
            t=(rr,cc)
            if dbox(t1[1],t)>r or dbox(t2[1],t)>r: continue
            others=[nm for nm,b,k in objs if nm not in (t1[0],t2[0]) and dbox(b,t)<=r]
            if others: continue
            ad=dbox(archbox(s),t) if s['arch'] else 99
            if ad<=r: continue
            if best is None or ad>best[0]: best=(ad,t)
    return best[1] if best else None
