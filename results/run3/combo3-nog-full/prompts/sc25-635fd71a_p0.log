    for s in tl.get('steps',[]):
        out.append('st%s bb=%s n=%s %s' % (s.get('step'), s.get('bbox'), s.get('changed'), str(s.get('changes') or s.get('transitions'))[:400]))
    return '\n'.join(out)[:maxchars]
