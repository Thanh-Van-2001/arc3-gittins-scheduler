from collections import deque
L=[16,14,15]; H=[6,7,None]
def act(s,name):
    i1,i2,i3=s
    if name=='BL': return (i1-1)%16,(i2-1)%14,(i3-1)%15
    if name=='BR': return (i1+1)%16,(i2+1)%14,(i3+1)%15
    if name=='PB': return ((i1-1)%6 if i1<6 else i1),i2,i3
    if name=='pB': return ((i1+1)%6 if i1<6 else i1),i2,i3
    if name=='PC': return i1,((i2-1)%7 if i2<7 else i2),i3
    if name=='pC': return i1,((i2+1)%7 if i2<7 else i2),i3
start=(1,3,14); goal=(15,13,14)
names=['BL','BR','PB','pB','PC','pC']
par={start:None}; q=deque([start]); found=None
while q:
    s=q.popleft()
    if s==goal: found=s; break
    for nm in names:
        t=act(s,nm)
        if t not in par: par[t]=(s,nm); q.append(t)
seq=[]; s=found
while par[s]: s,nm=par[s]; seq.append(nm)
seq.reverse()
print('len',len(seq),seq)
# also check reachability/solution count
print('states visited',len(par))
</parameter>
</function>
</tool_call>

