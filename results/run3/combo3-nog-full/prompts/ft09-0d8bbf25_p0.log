def solve_flips(cells, up, curN, tgtN):
    cs=set(cells); idx={c:i for i,c in enumerate(cells)}; n=len(cells)
    need = set(curN) ^ set(tgtN)
    # rows: for each cell c, sum of clicks affecting c = need
    A=[]
    for c in cells:
        row=0
        for v in cells:
            aff={v}
            if up.get(v) in cs: aff.add(up[v])
            if c in aff: row |= 1<<idx[v]
        A.append([row, 1 if c in need else 0])
    # RREF over columns
    pivots=[]
    r=0
    for col in range(n):
        bit=1<<col
        sel=None
        for i in range(r,len(A)):
            if A[i][0] & bit: sel=i; break
        if sel is None: continue
        A[r],A[sel]=A[sel],A[r]
        for i in range(len(A)):
            if i!=r and (A[i][0] & bit):
                A[i][0]^=A[r][0]; A[i][1]^=A[r][1]
        pivots.append(col); r+=1
    if any(x[0]==0 and x[1] for x in A): return None,'INCONSISTENT'
    free=[i for i in range(n) if i not in pivots]
    best=None
    import itertools
    for bits in itertools.product([0,1],repeat=len(free)) if free else [((),)]:
        x=[0]*n
        for k,i in enumerate(free): x[i]=bits[k]
        for ri,col in enumerate(pivots):
            x[col]=A[ri][1]
            t=A[ri][0] & ~bit if False else A[ri][0] & ~(1<<col)
            s=A[ri][1]
            while t:
                l=t&-t; t^=l; s^=x[l.bit_length()-1]
            x[col]=s
        w=sum(x)
        if best is None or w<best[0]: best=(w,[cells[i] for i in range(n) if x[i]])
    clicks=best[1]
    sim=set(curN)
    for v in clicks:
        sim ^= {v}
        if up.get(v) in cs: sim ^= {up[v]}
    return (clicks, sim==set(tgtN)), None

