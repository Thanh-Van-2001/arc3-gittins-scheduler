dials = [(0,1),(1,2),(1,4),(3,0),(3,2),(3,4),(3,6),(4,2),(5,2),(5,4),(6,5)]
def subcells(fr, r, c):
    R = 4+8*r; C = 6+8*c
    lines = fr.ascii.split('\n')
    grid = []
    for dr in range(3):
        row = []
        for dc in range(3):
            row.append(lines[R+2*dr][C+2*dc])
        grid.append(row)
    return grid
cons = {}
for (r,c) in dials:
    g3 = subcells(f,r,c)
    dot = g3[1][1]
    print((r,c),'dot',dot, [''.join(x) for x in g3])
    for dr in range(3):
        for dc in range(3):
            if dr==1 and dc==1: continue
            cell = (r+dr-1, c+dc-1)
            cons.setdefault(cell, []).append(((r,c), dot, g3[dr][dc]))
print('--- constraints per cell ---')
for cell in sorted(cons):
    print(cell, [(d, m) for (d,dot,m) in cons[cell]])
