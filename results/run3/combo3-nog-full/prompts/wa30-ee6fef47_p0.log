    blocked=set(other_boxes)|(set(B)&set())  # placed slots handled by slots_left
    blocked |= (set(S)-set(slots_left))
    st=(start,face0,None,None)
    dist={st:0}; pq=[(0,st)]
    best=None
    while pq:
        d,(b,f,car,bx)=heapq.heappop(pq)
        if dist.get((b,f,car,bx),1e9)!=d: continue
        for nf in 'UDLR':
            # move attempt
            nb=(b[0]+DIRS[nf][0], b[1]+DIRS[nf][1])
            ok = nb not in walls and nb not in blocked
            if ok and car and nb==bx: ok=False
            if ok:
                ncar=car; nbx=bx
                if car: nbx=b
                ns=(nb,nf,ncar,nbx)
                if d+1<dist.get(ns,1e9): dist[ns]=d+1; heapq.heappush(pq,(d+1,ns))
            ns2=(b,nf,car,bx)
            if d+1<dist.get(ns2,1e9): dist[ns2]=d+1; heapq.heappush(pq,(d+1,ns2))  # turn (blocked move)
            if not car:
                front=(b[0]+DIRS[f][0], b[1]+DIRS[f][1])
                if front==target:
                    ns3=(b,f,True,target)
                    if d+1<dist.get(ns3,1e9): dist[ns3]=d+1; heapq.heappush(pq,(d+1,ns3))
            else:
                if bx not in walls and bx not in blocked and bx!=target:
                    ns4=(b,f,False,None)
                    if d+1<dist.get(ns4,1e9): dist[ns4]=d+1; heapq.heappush(pq,(d+1,ns4))
                    elif d+1<dist.get(ns4,1e9): pass
        # goal check
        if car and bx==slot:
            return d, dist
    return None, dist
