import collections
def go_to2(target, extra=(), maxsteps=25, lvl=3):
    DEL={(-5,0):'UP',(5,0):'DOWN',(0,-5):'LEFT',(0,5):'RIGHT'}
    tot=0
    while True:
        fr=current_frame
        if fr.level!=lvl: return tot,'levelchange'
        pp=set(passpos(fr,allow_black=False)); pp.update(extra)
        b=obbox(fr); s=(b[0],b[1])
        if s==target: return tot,'reached'
        prev={s:None}; q=collections.deque([s]); found=False
        while q:
            u=q.popleft()
            if u==target: found=True; break
            for (dr,dc) in DEL:
                v=(u[0]+dr,u[1]+dc)
                if v in pp and v not in prev: prev[v]=u; q.append(v)
        if not found: return tot,'unreachable'
        acts=[]; cur=target
        while prev[cur] is not None:
