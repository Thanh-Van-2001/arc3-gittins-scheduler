def act7(st,a,P):
    TMIN,TMAX,CMIN,CMAX,WS,tpmin,tpmax,BMIN,BMAX=P
    T,tip,bl=st; hb=T+1
    bl=[(b[0],b[1]) for b in bl]
    def att(i,tp): return bl[i][0]==hb and bl[i][1]<=tp and bl[i][1]+3>=WS
    if a in ('LEFT','RIGHT'):
        d=6 if a=='RIGHT' else -6
        nt=max(tpmin,min(tpmax,tip+d))
        if nt==tip: return st,'noop'
        nb=list(bl)
        if d<0:
            idx=[i for i in range(len(bl)) if att(i,tip)]
            idx.sort(key=lambda i:nb[i][1])
            moved=set()
            def tm(i):
                c=nb[i][1]+d
                if c<CMIN: return False
                for j in range(len(nb)):
                    if j!=i and nb[j][0]==nb[i][0] and nb[j][1]==c and j not in moved:
                        if not tm(j): return False
                nb[i]=(nb[i][0],c); moved.add(i); return True
            for i in idx: tm(i)
        return (T,nt,tuple(nb)),'ok'
    d=-6 if a=='UP' else 6
    nT=max(TMIN,min(TMAX,T+d))
    if nT==T: return st,'noop'
    ab=nT+1; nb=list(bl); moved=set()
    def vm(i):
        nbd=nb[i][0]+d
        if nbd<BMIN or nbd>BMAX: return False
        for j in range(len(nb)):
            if j!=i and nb[j][0]==nbd and nb[j][1]==nb[i][1] and j not in moved:
                if not vm(j): return False
        nb[i]=(nbd,nb[i][1]); moved.add(i); return True
    for i in range(len(bl)):
        if bl[i][0]==ab and bl[i][1]<=tip and bl[i][1]+3>=WS and i not in moved:
            if not vm(i): return None,'blocked'
    for i in range(len(bl)):
        if bl[i][0]==hb and bl[i][1]<=tip and bl[i][1]+3>=WS and i not in moved:
            if not vm(i): return None,'blocked'
    return (nT,tip,tuple(nb)),'ok'

def state_of(fr,P):
    TMIN,TMAX,CMIN,CMAX,WS,tpmin,tpmax,BMIN,BMAX=P
    T,tip,bl=st_of(fr)
    return T,tip,tuple((v[0],v[1]) for k,v in sorted(bl.items()))
