        b0=ibb(V[k][v]['solid'])
        sh=(base0[0]-b0[0], base0[2]-b0[2])
        out[k]=frozenset((r+sh[0]+d[0])*64+(c+sh[1]+d[1]) for r,c in ((x//64,x%64) for x in cells))
