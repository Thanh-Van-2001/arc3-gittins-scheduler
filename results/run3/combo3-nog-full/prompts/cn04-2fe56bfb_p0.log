def rot90_cw(cells, bb):
    r0,c0,r1,c1=bb; R=r1-r0+1
    out=set()
    for x in cells:
        r,c=divmod(x,64)
        rr,cc=r-r0,c-c0
        out.add((r0+cc)*64+(c0+(R-1-rr)))
    return frozenset(out)
def get_pieces(frame, V, order):
    B,R,O=build_model2(frame)
    out={}
    for k in order:
        full=B[k]|frozenset().union(*[r for r in R if O[r]==k]) if any(O[r]==k for r in R) else B[k]
        out[k]=frozenset(full)
    return out
def bfs_piece(V, k, start_cells, others, target_cells, maxn=4000):
    # state: frozenset cells; moves: 4 arrows (3-cell), SPACE (rot cw if bbox square-ish handled)
    from collections import deque
    tgt=ibb(target_cells)
    st=start_cells
    seen={st}; q=deque([(st,[])])
    while q:
        cur,path=q.popleft()
        if ibb(cur)==tgt and len(cur)==len(target_cells):
            # exact match of cells?
            if cur==target_cells: return path
        if len(path)>18 or len(seen)>maxn: continue
        for name,mv in (('UP',(-3,0)),('DOWN',(3,0)),('LEFT',(0,-3)),('RIGHT',(0,3))):
            d=mv[0]*64+mv[1]
            nw=frozenset(x+d for x in cur)
            if any(x//64<2 or x//64>62 or x%64<0 or x%64>63 for x in nw): continue
            if nw&others: continue
            if nw not in seen: seen.add(nw); q.popleft() if False else None; q.append((nw,path+[name]))
        bb=ibb(cur)
        nw=rot90_cw(cur,bb)
        if not (nw&others) and all(2<=x//64<=62 and 0<=x%64<=63 for x in nw) and nw not in seen:
            seen.add(nw); q.append((nw,path+['SPACE']))
    return None
P=get_pieces(current_frame, V, ('W','Y','N','b'))
print({k:(len(v),ibb(v)) for k,v in P.items()})
