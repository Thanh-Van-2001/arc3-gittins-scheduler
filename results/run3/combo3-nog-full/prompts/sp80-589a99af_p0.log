        nb=frozenset(set(bars)-{b} | {(r,c,w)})
        ns=(nb,bw,br,bc)
        if d+1<dist.get(ns,99): dist[ns]=d+1; heapq.heappush(pq,(d+1,ns))
    # moves (free position)
