    for (r0,c0,w0) in bs: s|=rect3(r0,c0,4,w0)
    return s
def scan(bars,w,r,c,srcs):
    wt,s=flowF(cups3()|bset_to_rects(bars)|rect3(r,c,4,w),srcs)
    f=filled_of(wt,(8,28,52))
