def flowX(solid, srcs, maxit=60):
    sol=set(solid); open_=lambda r,c: 0<=r<60 and 0<=c<64 and (r,c) not in sol
    wet=set(); esc=[]
    risers=[(c0,c1,55) for (c0,c1) in srcs]; seen=set(risers)
    for _ in range(maxit):
        nxt=[]
        for (c0,c1,r0) in risers:
            h=r0
            while h-1>=0 and all(open_(h-1,c) for c in range(c0,c1+1)): h-=1
            if h<=0: esc.append((c0,c1)); continue
            for r in range(h,r0+1):
                for c in range(c0,c1+1): wet.add((r,c))
            s0=c0
            while s0-1>=0 and (h-1,s0-1) in sol: s0-=1
            s1=c1
            while s1+1<64 and (h-1,s1+1) in sol: s1+=1
            l=c0
            while l-1>=0 and open_(h,l-1): l-=1
            rg=c1
            while rg+1<64 and open_(h,rg+1): rg+=1
            l=max(l,s0-4); rg=min(rg,s1+4)
            for c in range(l,rg+1): wet.add((h,c))
            for a,b in ((l,s0-1),(s1+1,rg)):
                c=a
                while c<=b:
                    if open_(h-1,c):
                        t=c
                        while c<=b and open_(h-1,c): c+=1
                        nt=(t,c-1,h-1)
                        if nt not in seen: seen.add(nt); nxt.append(nt)
                    else: c+=1
        if not nxt: break
        risers=nxt
    return wet,esc
