def flowG(solid, srcs, notches, top=8, maxit=400):
    sol=set(solid)
    ok=lambda r,c: 0<=r<60 and 0<=c<64 and (r,c) not in sol
    risers=[(c0,c1,55) for (c0,c1) in srcs]; wet=set(); spill=False; seen=set(risers)
    for _ in range(maxit):
        nxt=[]
        for (c0,c1,r0) in risers:
            h=r0
            while h-1>=0 and all(ok(h-1,c) for c in range(c0,c1+1)): h-=1
            if h<=0: spill=True; continue
            for r in range(h,r0+1):
                for c in range(c0,c1+1): wet.add((r,c))
            l=c0
            while l-1>=0 and ok(h,l-1): l-=1
            rg=c1
            while rg+1<64 and ok(h,rg+1): rg+=1
            for c in range(l,rg+1): wet.add((h,c))
            if h<=top: spill=True
            c=l
            while c<=rg:
                if ok(h-1,c):
                    s0=c
                    while c<=rg and ok(h-1,c): c+=1
                    t=(s0,c-1,h-1)
                    if t not in seen: seen.add(t); nxt.append(t)
                else: c+=1
        if not nxt: break
        risers=nxt
    filled=[i for i,(c0,rr) in enumerate(notches,1) if all((r,c) in wet for r in rr for c in range(c0,c0+4))]
    return filled, spill, wet
