    nr,nc=r+DR,c+DC
    if nr<4 or nr>55 or nc<0 or nc+w>64: return None
    pad=rect3(r,c,4,w); newpad=rect3(nr,nc,4,w)
    if newpad & cups3(): return None
    rows=list(range(r,r+4)); red2=set(red); red2-=newpad
    if DR:
