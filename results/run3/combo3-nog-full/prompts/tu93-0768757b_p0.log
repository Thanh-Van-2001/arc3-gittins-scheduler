    ADJ={p:[q for q in ((p[0]+1,p[1]),(p[0]-1,p[1]),(p[0],p[1]+1),(p[0],p[1]-1)) if q in Cs] for p in Cs}
    DIRS={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    def paths2(c,p):
        # all cells reachable by taking first up-to-2 steps of a shortest path from c to p
        pr={c:0}; q=deque([c])
        while q:
            x=q.popleft()
            for m in ADJ[x]:
                if m not in pr: pr[m]=pr[x]+1; q.append(m)
        d=pr[p]
        if d is None: return set()
        out=set()
        # walk back from p: predecessors on shortest paths
        # find cells x with dist(c,x)=k (k=1..min(2,d)) that lie on a shortest path (dist(x,p)=d-k)
        for x in Cs:
            k=pr[x]
            if 1<=k<=min(2,d):
                pr2={x:0}; q=deque([x])
                while q:
                    y=q.popleft()
                    for m in ADJ[y]:
                        if m not in pr2: pr2[m]=pr2[y]+1; q.append(m)
                if pr2[p]==d-k: out.add(x)
        return out if d>2 else set()   # if d<=2 chaser catches player -> death
    init=(p0,frozenset([ch]))
    prev={init:None}; q=deque([init]); res=None
    while q:
        stt=q.popleft(); p,b=stt
        if p==tgt: res=stt; break
        dep=0; cur=stt
        while prev.get(cur) is not None: dep+=1; cur=prev[cur][0]
        if dep>=T: continue
        for name,d in DIRS.items():
            cur=p; lands=[]
            for k in range(2):
                nx=(cur[0]+d[0],cur[1]+d[1])
                if nx not in Cs: break
                lands.append(nx); cur=nx
            if not lands: continue
            m=lands[-1]
            if m==tgt:
                ns=(m,b)
                if ns not in prev: prev[ns]=(stt,name); q.append(ns); continue
            nb=set()
            dead=False
            for c in b:
                opts=paths2(c,m)
                if not opts: dead=True; break
                nb|=opts
            if dead: continue
            ns=(m,frozenset(nb))
            if ns not in prev: prev[ns]=(stt,name); q.append(ns)
    if not res: return None
    ch2=[]; cur=res
    while prev.get(cur): ch2.append(prev[cur][1]); cur=prev[cur][0]
    return ch2[::-1]
s=solve8robust()
print('robust:',s,len(s) if s else '')
