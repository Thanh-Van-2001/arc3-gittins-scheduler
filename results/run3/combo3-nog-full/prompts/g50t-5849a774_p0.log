def scan(fr):
    g=fr.ascii.split('\n')
    ec=[(r,c) for r in range(7,60) for c in range(3,61) if g[r][c] in 'gwG']
    rs=[p[0] for p in ec]; cs=[p[1] for p in ec]
    echo=(min(rs),min(cs),max(rs),max(cs)) if ec else None
    b=set((r,c) for r in range(36,44) for c in range(12,32) if g[r][c]=='R')
    plug=[j for j in range(6) if (38,14+6*j) in b]
    return echo,plug,len([p for p in ec])
