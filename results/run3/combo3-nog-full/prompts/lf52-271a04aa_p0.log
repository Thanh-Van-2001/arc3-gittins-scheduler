def dijk1(s0,cap=500000):
    pq=[(0,0,s0,())]; best={s0:0}; n=0; bp=len(s0[0]); bst=s0; win=None
    while pq:
        c,_,st,path=heapq.heappop(pq)
        if c>best.get(st,1e9): continue
        n+=1
        if n>cap: break
        if len(st[0])<bp: bp=len(st[0]); bst=st
        if len(st[0])<=1 and win is None: win=path
