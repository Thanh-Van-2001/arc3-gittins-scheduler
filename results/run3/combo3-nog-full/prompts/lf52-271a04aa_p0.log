def exec_move(st,d,verbose=True):
    ROOMS,T1,T2=L3D()
    D={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}[d]
    pegs,g1,g2=st
    a=(g1[0]+D[0],g1[1]+D[1]); b=(g2[0]+D[0],g2[1]+D[1])
    n1=a if (a in T1 and a not in pegs) else g1
    n2=b if (b in T2 and b not in pegs) else g2
    try: res=action([{'action':d}])
    except Exception as e: return False,'stale:'+str(e)[:40],st
    if res.get('no_op'): return False,'noop',st
    np_=set(pegs)
    if g1 in np_ and n1!=g1: np_.discard(g1); np_.add(n1)
    if g2 in np_ and n2!=g2: np_.discard(g2); np_.add(n2)
    ns=(frozenset(np_),n1,n2)
    if not match_off(*ns): return False,'postmismatch',ns
    if res.get('level_completed') or res.get('run_complete') or res.get('done'): return True,'WIN',ns
    return True,'ok',ns
