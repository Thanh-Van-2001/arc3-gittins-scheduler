def ghost_groups(ox=0,oy=0):
    g,s=ghosts_and_sel()
    pts=[q[3] for q in g]
    groups=[]
    for p in pts:
        placed=False
        for gr in groups:
            if any(abs(p[0]-q[0])<=3 and abs(p[1]-q[1])<=3 for q in gr): gr.append(p); placed=True; break
        if not placed: groups.append([p])
    merged=True
    while merged:
        merged=False
        for i in range(len(groups)):
            for j in range(i+1,len(groups)):
                if any(abs(a[0]-b[0])<=3 and abs(a[1]-b[1])<=3 for a in groups[i] for b in groups[j]):
                    groups[i]+=groups[j]; groups.pop(j); merged=True; break
            if merged: break
    out={}
    for gr in groups:
        rs=[p[0] for p in gr]; cs=[p[1] for p in gr]
        r0,c0=min(rs),min(cs)
        cell=((r0-6-oy)//6,(c0-6-ox)//6)
        out[cell]=((min(rs)+max(rs))//2,(min(cs)+max(cs))//2)
    return out,s
def jump_cell(src,dst,ox=0,oy=0):
    r=6+6*src[0]+oy+2; c=6+6*src[1]+ox+2
    st=click(r,c)
    if st=='noop': return 'sel_noop'
    gs,s=ghost_groups(ox,oy)
    if dst not in gs: return 'nogh:'+str(sorted(gs))
    return click(*gs[dst])
