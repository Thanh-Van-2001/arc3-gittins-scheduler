def tipface(b):
    t=tip(b); out=[]
    if b['axis']=='H':
        p=t+b['dir']
        for r in range(b['cross0'],b['cross0']+3): out.append((r,p))
    else:
        p=t+b['dir']
        for c in range(b['cross0'],b['cross0']+3): out.append((p,c))
    return out
def do3(beams,color,extend):
    idxs=[i for i,b in enumerate(beams) if b['color']==color]
    if not extend:
        out=list(beams); deltas={}
        for i in idxs:
            if beams[i]['length']>2:
                nb=dict(beams[i]); nb['length']=beams[i]['length']-3; out[i]=nb
                d=(0,-beams[i]['dir']*3) if beams[i]['axis']=='H' else (-beams[i]['dir']*3,0)
                deltas[i]=d
        # resolve pulls: objects touching tip face of shrunk beams move by delta
        for i,d in deltas.items():
            m=occm(out)
            tgts=set()
            for c in tipface(beams[i]):
                for j in m.get(c,[]):
                    if j!=i: tgts.add(j)
            for j in tgts:
                if out[j]['color']==color: continue
                r=push2(out,j,d,color,{i})
                if r is None: return None
                out=r
        for b in out:
            for (rr,cc) in cells(b):
                if not(0<=rr<64 and 0<=cc<64): return None
        return out
    return do2(beams,color,True)
# validate blue retract pull
