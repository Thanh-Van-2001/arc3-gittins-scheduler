def derive(clk, npress=2):
    st=[blk(current_frame,4)]
    for i in range(npress):
        action([{'action':'MOUSE','row':clk[0],'col':clk[1]}])
        st.append(blk(current_frame,4))
    dom=set()
    for s in st: dom|=set(s)
    cands={}
    for p in dom:
        sets=[]
        for i in range(npress):
            b,a=st[i],st[i+1]
            if a.get(p)!=st[0].get(p) or True:
                sets.append(set(q for q in dom if b.get(q)==a.get(p)))
        c=set.intersection(*sets) if sets else set()
        cands[p]=c
    return st,cands
