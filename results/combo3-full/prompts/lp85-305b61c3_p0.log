ARMS={'E':(0,1),'NE':(-1,1),'N':(-1,0),'NW':(-1,-1),'W':(0,-1),'SW':(1,-1),'S':(1,0),'SE':(1,1)}
ORDER=['E','NE','N','NW','W','SW','S','SE']
def cell(cr,cc,arm,r):
    dr,dc=ARMS[arm]; return (cr+dr*3*r, cc+dc*3*r)
def asterisk(cr,cc):
    return {(arm,r):cell(cr,cc,arm,r) for arm in ORDER for r in (1,2,3)}
def perm_from_pairs(pairs):
    m=dict(pairs)
    return m
def radial_perm(cr,cc,d):   # content at (arm,r) -> (arm, r+d mod 3)
    m={}
    for arm in ORDER:
        for r in (1,2,3):
            m[cell(cr,cc,arm,r)]=cell(cr,cc,arm,(r+d)%3 or 3) if False else cell(cr,cc,arm,((r-1+d)%3)+1)
    return m
def ring_perm(cr,cc,d):     # content at (arm_k,r) -> (arm_{k+d},r)
    m={}
    for k,arm in enumerate(ORDER):
        for r in (1,2,3):
            m[cell(cr,cc,arm,r)]=cell(cr,cc,ORDER[(k+d)%8],r)
    return m
A6c=[(27,26),(24,23),(24,35),(27,32),(33,29),(36,29)]
def cyc_perm(c,d):
    n=len(c); return {c[j]:c[(j+d)%n] for j in range(n)}
def apply_perm(S,m):
    out={}
    for p,c in S.items(): out[m.get(p,p)]=c
    return out
def fit(clk, perms, tag):
    B=blk(current_frame,4)
    action([{'action':'MOUSE','row':clk[0],'col':clk[1]}])
    Aa=blk(current_frame,4)
    best=[]
    for nm,m in perms.items():
        pred=apply_perm(B,m)
        bad=[p for p in set(pred)|set(Aa) if pred.get(p)!=Aa.get(p)]
        best.append((len(bad),nm,bad[:3]))
    best.sort()
    print(tag,'bar',barlen(),'Y',sorted(p for p,c in Aa.items() if c=='Y'))
    for b in best[:3]: print('   ',b[0],b[1],b[2])
    return best
