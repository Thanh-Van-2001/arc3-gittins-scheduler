from collections import deque
def comps(fr,col):
    rows=fr.ascii.split('\n'); R=len(rows); C=len(rows[0])
    S={(r,c) for r in range(R) for c in range(C) if rows[r][c]==col}
    seen=set(); out=[]
    for s in S:
        if s in seen: continue
        q=deque([s]); seen.add(s); comp=set()
        while q:
            x=q.popleft(); comp.add(x)
            for d in ((1,0),(-1,0),(0,1),(0,-1)):
                y=(x[0]+d[0],x[1]+d[1])
                if y in S and y not in seen: seen.add(y); q.append(y)
        out.append(comp)
    return out
PLUS=[(0,3),(0,4),(0,5),(1,3),(1,4),(1,5),(2,3),(2,4),(2,5)]+[(3,c) for c in range(9)]+[(4,c) for c in range(9)]+[(5,c) for c in range(9)]+[(6,3),(6,4),(6,5),(7,3),(7,4),(7,5),(8,3),(8,4),(8,5)]
def pc(pos): return set((pos[0]+a,pos[1]+b) for a,b in PLUS)
