def reach9e(BD,P0,C0,f0,k0,thr=2,tie='all'):
    DS={'UP':(-2,0),'DOWN':(2,0),'LEFT':(0,-2),'RIGHT':(0,2)}
    dist={p:bfs9(BD,p) for p in BD if BD[p] in 'WNrOpRpbY'}
    def cho(C,P,f):
        if dist[C][P]>thr: return [(C,f)]
        cand=[(d,(C[0]+v[0],C[1]+v[1])) for d,v in DS.items() if (C[0]+v[0],C[1]+v[1]) in nb9(BD,C)]
        db={d:dist[n][P] for d,n in cand}
        m=min(db.values()); tied=[d for d in db if db[d]==m]
        if tie=='all': out=tied
        elif tie=='prefer': out=[f] if f in tied else tied
        else: out=[d for d in tied if d!=f] or tied
        return [((C[0]+DS[d][0],C[1]+DS[d][1]),d) for d in out]
    init=(P0,frozenset({(C0,f0)}),k0)
    seen={init}; q=collections.deque([init]); best={}
    while q:
        P,Cs,k=q.popleft(); best.setdefault(P,set()).add(k)
        for a,(dr,dc) in DS.items():
            nP=(P[0]+dr,P[1]+dc)
            if nP not in nb9(BD,P): continue
            nk=k+1
            if nP in occ9b(nk): continue
            if any(nP==C for C,f in Cs): continue
            nxt=set(); dead=False
            for (C,f) in Cs:
                for (nc,nf) in cho(C,P,f):
                    if nc==nP: dead=True
                    nxt.add((nc,nf))
            if dead: continue
            ns=(nP,frozenset(nxt),nk)
            if ns in seen: continue
            seen.add(ns); q.append(ns)
    return best
