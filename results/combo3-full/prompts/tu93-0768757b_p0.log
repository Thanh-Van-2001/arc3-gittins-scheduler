def reach9f(BD,P0,C0,f0,k0,thr=2,tie='prefer',goal=(10,8)):
    DS={'UP':(-2,0),'DOWN':(2,0),'LEFT':(0,-2),'RIGHT':(0,2)}
    nodes=[p for p in BD if BD[p] in 'WNrOpRpbY']
    dist={p:bfs9(BD,p) for p in nodes}
    nb={p:nb9(BD,p) for p in nodes}
    occ=[set(occ9b(m)) for m in range(8)]
    def cho(C,P,f):
        if dist[C][P]>thr: return [(C,f)]
        cand=[(d,n) for d,n in [((d,(C[0]+v[0],C[1]+v[1]))) for d,v in DS.items()] if n in nb[C]]
        db={d:dist[n][P] for d,n in cand}
        m=min(db.values()); tied=[d for d in db if db[d]==m]
        if tie=='all': out=tied
        elif tie=='prefer': out=[f] if f in tied else tied
        else: out=([d for d in tied if d!=f] or tied)
        return [((C[0]+DS[d][0],C[1]+DS[d][1]),d) for d in out]
    init=(P0,C0,f0,k0%8)
    seen={init:None}; q=collections.deque([init]); win=None
    while q:
        P,C,f,m=q.popleft()
        for a,(dr,dc) in DS.items():
            nP=(P[0]+dr,P[1]+dc)
            if nP not in nb[P]: continue
            nm=(m+1)%8
            if nP in occ[nm]: continue
            dead=False; nxt=[]
            for (nc,nf) in cho(C,P,f):
                if nc==nP: dead=True
                nxt.append((nc,nf))
            if dead: continue
            for (nc,nf) in nxt:
                ns=(nP,nc,nf if nf else f,nm)
                if ns in seen: continue
                seen[ns]=((P,C,f,m),a)
                if nP==goal:
                    out=[];cur=ns
                    while seen[cur]:
                        pst,act=seen[cur]; out.append(act); cur=pst
                    return list(reversed(out))
                q.append(ns)
    return None
