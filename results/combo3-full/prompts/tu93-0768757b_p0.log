def probe_search(BD,P0,C0,f0,k0,maxt=6,goal=(10,8)):
    DS={'UP':(-2,0),'DOWN':(2,0),'LEFT':(0,-2),'RIGHT':(0,2)}
    MS=models9()
    nodes=[p for p in BD if BD[p] in 'WNrOpRpbY']
    nb={p:nb9(BD,p) for p in nodes}
    D={p:bfs9(BD,p) for p in nodes}
    occ=[set(occ9b(m)) for m in range(8)]
    thr=2
    def step_all(B,P,m,a):
        dr,dc=DS[a]; nP=(P[0]+dr,P[1]+dc)
        if nP not in nb[P]: return None
        nm=(m+1)%8
        if nP in occ[nm]: return None
        groups={}
        for (mid,C,f) in B:
            if D[C][P]>thr: nxt=(C,f)
            else:
                cand=[(d,(C[0]+v[0],C[1]+v[1])) for d,v in DS.items() if (C[0]+v[0],C[1]+v[1]) in nb[C]]
                db={d:D[n][P] for d,n in cand}
                mn=min(db.values()); tied=[d for d in db if db[d]==mn]
                if len(tied)==1: d=tied[0]
                else:
                    kind,par=MS[mid]
                    if kind=='prio': d=[x for x in par if x in tied][0]
                    elif kind=='prefer': d=f if f in tied else tied[0]
                    else: d=([x for x in tied if x!=f] or tied)[0]
                nxt=((C[0]+DS[d][0],C[1]+DS[d][1]),d)
            if nxt[0]==nP: return ('DEAD',None)
            groups.setdefault(nxt,[]).append((mid,nxt[0],nxt[1]))
        return (nP,nm,groups)
    start=frozenset((mid,C0,f0) for mid in MS)
    found=[]
    def rec(P,B,m,path):
        if len(path)>=maxt: return
        for a in DS:
            r=step_all(B,P,m,a)
            if r is None: continue
            if r[0]=='DEAD': continue
            nP,nm,groups=r
