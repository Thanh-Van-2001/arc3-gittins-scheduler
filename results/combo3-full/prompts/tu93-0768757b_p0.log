def notches(frame):
    a=frame.ascii.split('\n')
    sg=frame.segmentation
    res={}
    for n in sg['nodes']:
        if n['color'] in 'rb':
            b=n['boundary']
            r0=min(p[0] for p in b); r1=max(p[0] for p in b); c0=min(p[1] for p in b); c1=max(p[1] for p in b)
            # find non-matching pixel inside bbox
            odd=[]
            for r in range(r0,r1+1):
                for c in range(c0,c1+1):
                    if a[r][c]!=n['color']: odd.append((a[r][c],r,c))
            res[n['color']]=((r0,c0,r1,c1),odd)
    return res
