def solve_win9(BD,goal=(10,8),maxn=40):
    DS={'UP':(-2,0),'DOWN':(2,0),'LEFT':(0,-2),'RIGHT':(0,2)}
    cells=[p for p in BD if BD[p] in 'WNrOpbY']
    chcells=[p for p in BD if BD[p] in 'WNrOpbY']
    dist={}
    for c in chcells: dist[c]=bfs9(BD,c)
    occ=[set(occ9b(m)) for m in range(8)]
    # precompute chaser options for (C,f,P)
    def chopts(C,P):
        if dist[C][P]>2: return [((C),None)]
        cand=[(d,(C[0]+v[0],C[1]+v[1])) for d,v in DS.items() if (C[0]+v[0],C[1]+v[1]) in nb9(BD,C)]
        if not cand: return [(C,None)]
        db={d:dist[n][P] for d,n in cand}
        m=min(db.values())
        return [((C[0]+DS[d][0],C[1]+DS[d][1]),d) for d in db if db[d]==m]
    states={}
    key=lambda s:(s[0],s[1],s[2],s[3]%8)
    W=set()
    for P in cells:
        for C in chcells:
            for f in ('U','D','L','R','N'):
                for m in range(8):
                    if P==goal and P!=C: W.add((P,C,f,m))
    prev=set(); W=set(W)
    for n in range(1,maxn+1):
        newW=set()
        for P in cells:
            for C in chcells:
                if P==C: continue
                for f in ('U','D','L','R','N'):
                    for m in range(8):
                        st=(P,C,f,m)
                        if st in W: continue
                        cho=chopts(C,P)
                        ok=False
                        for a,(dr,dc) in DS.items():
                            nP=(P[0]+dr,P[1]+dc)
                            if nP not in nb9(BD,P): continue
                            if nP in occ[(m+1)%8]: continue
                            good=True
                            for (nc,nf) in cho:
                                if nc==nP: good=False; break
                                if (nP,nc,nf if nf else f,(m+1)%8) not in W: good=False; break
                            if good: ok=True; break
                        if ok: newW.add(st)
        W|=newW
        if not newW: break
    return W
