def small(fr):
    out=[]
    for n in fr.segmentation['nodes']:
        if n['pixels']>200 or n['pixels']==1 and n['color']=='B': continue
        b=n['boundary']; bb=(min(p[0] for p in b),min(p[1] for p in b),max(p[0] for p in b),max(p[1] for p in b))
        if bb[0]<=9 and bb[2]<=9 and bb[1]<=45: out.append((n['color'],n['pixels'],bb)); continue
        out.append((n['color'],n['pixels'],bb))
    return out
