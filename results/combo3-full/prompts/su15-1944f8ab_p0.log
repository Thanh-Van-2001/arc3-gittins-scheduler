def sim_click4(st,click):
    SIZES,DA,DB=_consts()
    import copy
    st=copy.deepcopy(st); P=st['P']; H=st['H']; dl=dict(st['deliv']); blocked=dict(st.get('blocked',{})); log=[]
    for k in list(P.keys()):
        sz,cr,cc=P[k]
        d0,d1=click[0]-cr,click[1]-cc
        if d0*d0+d1*d1<=64.0 and (abs(d0)>=(sz-1)/2.0 or abs(d1)>=(sz-1)/2.0):
            P[k]=(sz,cr+max(-8,min(8,int(round(d0)))),cc+max(-8,min(8,int(round(d1)))))
    merged=True
    while merged:
        merged=False; ks=list(P.keys())
        for i in range(len(ks)):
            for j in range(i+1,len(ks)):
                a,b=ks[i],ks[j]
                if a in P and b in P and P[a][0]==P[b][0]:
                    sa,ra,ca=P[a]; _,rb,cb=P[b]
                    if abs(ra-rb)<=sa+0.5 and abs(ca-cb)<=sa+0.5:
                        ns=SIZES[SIZES.index(sa)+1]
                        P[a]=(ns,(ra+rb)/2.,(ca+cb)/2.); del P[b]; merged=True; log.append('merge->%d'%ns); break
            if merged: break
    for k in list(P.keys()):
        sz,cr,cc=P[k]
        for nm,D in (('A',DA),('B',DB)):
            if nm in dl or nm in blocked: continue
            if in_disc(sz,cr,cc,D):
                if sz==4: dl[nm]=sz; del P[k]; log.append('WIN-'+nm)
                else: blocked[nm]=sz; del P[k]; log.append('BLOCK-'+nm)
    def bite(h,sz,cr,cc): return abs(cr-h[0])<=(sz+3)/2.0 and abs(cc-h[1])<=(sz+5)/2.0
    for hk in list(H.keys()):
        h=H[hk]
        if not P: break
        tgt=min(P.values(), key=lambda p:(p[1]-h[0])**2+(p[2]-h[1])**2)
        dr,dc=tgt[1]-h[0],tgt[2]-h[1]; dd=(dr*dr+dc*dc)**0.5
        if dd<0.3: continue
        step=min(5.0,dd)
        H[hk]=(h[0]+dr/dd*step,h[1]+dc/dd*step)
        for k in list(P.keys()):
            sz,cr,cc=P[k]
            if bite(H[hk],sz,cr,cc):
                idx=SIZES.index(sz)-1
                if idx<0: del P[k]; log.append('%s eaten'%k); continue
                ns=SIZES[idx]; ux,uy=cr-H[hk][0],cc-H[hk][1]; uu=(ux*ux+uy*uy)**0.5 or 1.0
                P[k]=(ns,cr+ux/uu*10,cc+uy/uu*10); log.append('%s %d->%d'%(k,sz,ns))
    st['P']=P; st['H']=H; st['deliv']=dl; st['blocked']=blocked
    return st,log

def find_plan4(maxd=16, beam=200, simf=None):
    SIZES,DA,DB=_consts()
    simf = simf or sim_click4
    def feats(st):
        tot=sum(v[0] for v in st['P'].values())+sum(st['deliv'].values())
        saf=0
        for sz,cr,cc in st['P'].values():
            m=min(max(abs(cr-h[0])-(sz+3)/2.0,abs(cc-h[1])-(sz+5)/2.0) for h in st['H'].values())
            saf+=max(0.0,min(6.0,m))
        return 3000*len(st['deliv'])-6000*len(st['blocked'])+25*tot+4*saf
    def cands(st):
        out=[]
        for (sz,cr,cc) in st['P'].values():
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    if dr==dc==0: continue
                    for d in (4,6,8):
                        r=int(round(cr+dr*d)); c=int(round(cc+dc*d))
                        if 2<=r<=61 and 1<=c<=61: out.append((r,c))
        ks=list(st['P'])
        for i in range(len(ks)):
            for j in range(i+1,len(ks)):
                a,b=ks[i],ks[j]
                if st['P'][a][0]==st['P'][b][0]:
                    r=int(round((st['P'][a][1]+st['P'][b][1])/2)); c=int(round((st['P'][a][2]+st['P'][b][2])/2))
                    for dr in (-1,0,1):
                        for dc in (-1,0,1): out.append((r+dr*2,c+dc*2))
        for (br,bc) in ((17,23),(22,44)):
            for (sz,cr,cc) in st['P'].values():
                d=((br-cr)**2+(bc-cc)**2)**0.5
                if d>0:
                    for f in (0.5,0.8,1.0): out.append((int(round(cr+(br-cr)*f)),int(round(cc+(bc-cc)*f))))
        return sorted(set(out))
    start=sim_init(); start['blocked']={}
    frontier=[(start,[])]
    for d in range(1,maxd+1):
        nxt=[]
        for st,path in frontier:
            for cl in cands(st):
                ns,log=simf(st,cl)
                nxt.append((feats(ns)-len(path),ns,path+[cl],len(ns['deliv'])==2,len(ns['blocked'])>0))
        wins=[e for e in nxt if e[3]]
        if wins:
            wins.sort(key=lambda e:-e[0]); return wins[0][2]
        nxt=[e for e in nxt if not e[4]]
        nxt.sort(key=lambda e:-e[0])
        seen=set(); frontier=[]
        for sc,ns,path,w,bk in nxt:
            sig=tuple(sorted((v[0],round(v[1]),round(v[2])) for v in ns['P'].values()))+tuple(sorted(ns['deliv']))
            if sig in seen: continue
            seen.add(sig); frontier.append((ns,path))
            if len(frontier)>=beam: break
    return None
