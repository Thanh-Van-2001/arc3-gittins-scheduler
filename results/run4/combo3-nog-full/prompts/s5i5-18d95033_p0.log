def bfs_full(s0, keys='OSPR', ops='+-', maxd=34, cap=120000):
    from collections import deque
    q=deque([(s0,())])
    seen={key3(s0)}
    best=(dsum(s0),())
    n=0
    while q:
        s,path=q.popleft()
        if len(path)>=maxd: continue
        for k in keys:
            for op in ops:
                s2=(grow3 if op=='+' else short3)(s,k)
                if s2 is None: continue
                h=key3(s2)
                if h in seen: continue
                seen.add(h); n+=1
                p2=path+((k+op),)
                d=dsum(s2)
                if d<best[0]: best=(d,p2)
                if done3(s2): return p2,n,'SOLVED'
                q.append((s2,p2))
    return best[1],n,'best dsum '+str(best[0])

