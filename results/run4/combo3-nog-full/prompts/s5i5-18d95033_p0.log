def astar3(s0, goal, ops=(('+',),('-',)), maxexp=60000):
    import heapq
    h=goal
    start=key3(s0)
    cnt=0
    pq=[(h(s0),0,0,s0,())]
    best={start:0}
    exp=0
    while pq:
        f,g,_,s,path=heapq.heappop(pq)
        if best.get(key3(s),999)<g: continue
        exp+=1
        if exp>maxexp: return None,exp
        for (op,) in ops:
            for k in 'RSOBPG':
                s2=(grow3 if op=='+' else short3)(s,k)
                if s2 is None: continue
                g2=g+1; hk=key3(s2)
                if g2>=best.get(hk,999): continue
                best[hk]=g2
                hh=h(s2)
                if hh==0: return path+(k+op,),exp
                heapq.heappush(pq,(g2+hh,g2,cnt,s2,path+(k+op,))); cnt+=1
    return None,exp

s0=L3(); s0['K']['R']['L']=23
