def kcells3(s):
    out={}
    for k,v in s['K'].items():
        cs=set()
        if v['d']=='R':
            for c in range(v['x'],v['x']+v['L']+1):
                for r in range(v['y'],v['y']+3): cs.add((r,c))
        elif v['d']=='L':
            for c in range(v['x']-v['L'],v['x']+1):
                for r in range(v['y'],v['y']+3): cs.add((r,c))
        elif v['d']=='D':
            for r in range(v['y'],v['y']+v['L']+1):
                for c in range(v['x'],v['x']+3): cs.add((r,c))
        else:
            for r in range(v['y']-v['L'],v['y']+1):
                for c in range(v['x'],v['x']+3): cs.add((r,c))
        out[k]=cs
    return out
