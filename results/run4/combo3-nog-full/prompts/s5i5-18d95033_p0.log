def astar3b(s0, maxexp=80000, ops='+-', maxd=40):
    import heapq
    cnt=0
    best={key3(s0):0}
    pq=[(dsum(s0),0,0,s0,())]
    exp=0
    while pq:
        f,g,_,s,path=heapq.heappop(pq)
        if best.get(key3(s),999)<g: continue
        exp+=1
        if exp>maxexp or g>=maxd: continue
        for k in 'RSOBPG':
            for op in ops:
                s2=(grow3 if op=='+' else short3)(s,k)
                if s2 is None: continue
                g2=g+1; hk=key3(s2)
                if g2>=best.get(hk,999): continue
                best[hk]=g2
                if done3(s2): return path+(k+op,),exp
                hh=dsum(s2)
                heapq.heappush(pq,(g2+hh,g2,cnt,s2,path+(k+op,))); cnt+=1
    return None,exp

