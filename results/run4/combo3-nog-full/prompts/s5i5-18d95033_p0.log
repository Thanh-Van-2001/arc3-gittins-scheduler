def bfs_acts(s0, acts=('O-','R-','S+','S-','P+'), maxd=60, cap=150000):
    from collections import deque
    q=deque([(s0,())])
    seen={key3(s0)}
    best=(dsum(s0),())
    n=0
    while q:
        s,path=q.popleft()
        if len(path)>=maxd: continue
        for a in acts:
            s2=(grow3 if a[1]=='+' else short3)(s,a[0])
            if s2 is None: continue
            h=key3(s2)
            if h in seen: continue
            seen.add(h); n+=1
            p2=path+(a,)
            d=dsum(s2)
            if d<best[0]: best=(d,p2)
            if done3(s2): return p2,n,'SOLVED'
            q.append((s2,p2))
        if n>cap: return best[1],n,'CAP best dsum '+str(best[0])
    return best[1],n,'EXH best dsum '+str(best[0])

res,n,st=bfs_acts(L3b(),maxd=60,cap=90000)
print(len(res),''.join(res),n,st)
