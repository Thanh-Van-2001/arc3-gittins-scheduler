def astar_acts(s0, acts=('O-','R-','S+','S-','P+'), maxexp=120000, maxd=64):
    import heapq
    cnt=0
    best={key3(s0):0}
    pq=[(dsum(s0),0,0,s0,())]
    exp=0; bestd=(999,)
    while pq:
        f,g,_,s,path=heapq.heappop(pq)
        if best.get(key3(s),999)<g: continue
        exp+=1
        if exp>maxexp: return None,exp,'CAP'
        if g>=maxd: continue
        for a in acts:
            s2=(grow3 if a[1]=='+' else short3)(s,a[0])
            if s2 is None: continue
            g2=g+1; hk=key3(s2)
            if g2>=best.get(hk,999): continue
            best[hk]=g2
            hh=dsum(s2)
            if hh<bestd[0]: bestd=(hh,g2)
            if hh==0: return path+(a,),exp,'SOLVED'
            heapq.heappush(pq,(g2+hh,g2,cnt,s2,path+(a,))); cnt+=1
    return None,exp,'EMPTY '+str(bestd)

