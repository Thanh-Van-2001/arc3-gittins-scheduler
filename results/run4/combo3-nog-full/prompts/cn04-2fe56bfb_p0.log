def solve5c(pieces,names,maxsols=500):
    R={n:rots2(pieces[n]) for n in names}
    sols=[]
    def rec(placed,idx):
        if len(sols)>=maxsols: return
        if idx==len(names):
            from collections import Counter
            alltabs=[]
            for (nm,ri,dr,dc,bd,tb,wh) in placed:
                for t in tb: alltabs.append((t[0]+dr,t[1]+dc))
            cnt=Counter(alltabs)
            if len(alltabs)%2==0 and all(v==2 for v in cnt.values()):
                sols.append([(x[0],x[1],x[2],x[3]) for x in placed])
            return
        nm=names[idx]
        anchors=set()
        for (pn,ri,pdr,pdc,pbd,ptb,pwh) in placed:
            for t in ptb: anchors.add((t[0]+pdr,t[1]+pdc))
        for ri,p in enumerate(R[nm]):
            for (atr,atc) in anchors:
                for (btr,btc) in p['tabs']:
                    dr=atr-btr; dc=atc-btc
                    bd=set((r+dr,c+dc) for r,c in p['body'])|set((r+dr,c+dc) for r,c in p['white'])
                    tb=set((r+dr,c+dc) for r,c in p['tabs'])
                    ok=True
                    for (pn,ri2,pdr,pdc,pbd,ptb,pwh) in placed:
                        other=set(pbd)|set(pwh)
                        if bd&other: ok=False;break
                        if tb&other: ok=False;break
                    if not ok: continue
                    placed.append((nm,ri,dr,dc,tuple(bd),tuple(tb),()))
                    rec(placed,idx+1); placed.pop()
    first=names[0]
    for ri,p in enumerate(R[first]):
        rec([(first,ri,0,0,p['body'],p['tabs'],p['white'])],1)
        if len(sols)>=maxsols: break
    return sols
