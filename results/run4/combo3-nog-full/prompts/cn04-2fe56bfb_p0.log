def pairjoins3(R,a,b):
    res=[]
    for ra,pa in enumerate(R[a]):
        for rb,pb in enumerate(R[b]):
            ba=set(pa['body'])|set(pa['white']); bb=set(pb['body'])|set(pb['white'])
