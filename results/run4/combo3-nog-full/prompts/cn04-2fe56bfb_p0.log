def rots2(p):
    # rotate about origin, normalize ALL parts by BODY min (keeps tab-body relation)
    out=[]; b=list(p['body']); t=list(p['tabs']); w=list(p.get('white',[]))
    seen=set()
    for k in range(4):
        mr=min(r for r,c in b); mc=min(c for r,c in b)
        nb=tuple(sorted((r-mr,c-mc) for r,c in b))
        nt=tuple(sorted((r-mr,c-mc) for r,c in t))
        nw=tuple(sorted((r-mr,c-mc) for r,c in w))
        key=(nb,nt,nw)
        if key not in seen:
            seen.add(key); out.append({'body':nb,'tabs':nt,'white':nw})
        b=rot90(b); t=rot90(t); w=rot90(w)
    return out
