        for ri,p in enumerate(R[nm]):
            for (atr,atc) in anchors:
                for (btr,btc) in p['tabs']:
                    dr=atr-btr; dc=atc-btc
                    B=set((r+dr,c+dc) for r,c in p['body']); W=set((r+dr,c+dc) for r,c in p['white'])
                    T=set((r+dr,c+dc) for r,c in p['tabs'])
