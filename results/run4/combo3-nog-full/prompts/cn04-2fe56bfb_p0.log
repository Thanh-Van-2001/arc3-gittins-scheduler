import itertools
PIECES={
 'Y':{'body':[(0,3),(3,3),(6,3),(6,6),(9,3)],'white':[(9,3)],'tabs':[(0,6),(3,0),(6,9)]},
 'U':{'body':[(3,6),(6,0),(6,6),(9,0),(9,6),(12,0),(12,3),(12,6)],'tabs':[(0,6),(3,0)]},
 'E':{'body':[(0,0),(0,3),(3,0),(6,0),(6,3),(9,0),(12,0),(12,3)],'tabs':[(0,6),(6,6),(12,6)]},
 'L':{'body':[(3,0),(6,0),(6,3),(6,6)],'tabs':[(0,0),(3,6)]},
}
def rot90(cs): return [(c,-r) for r,c in cs]
def norm(cs):
    mr=min(r for r,c in cs); mc=min(c for r,c in cs)
    return tuple(sorted((r-mr,c-mc) for r,c in cs))
def rots(p):
    out=[];b=p['body'];t=p['tabs'];w=p.get('white',[])
    seen=set()
    for k in range(4):
        rb,rt,rw=norm(b),norm(t),norm(w) if w else ()
        key=(rb,rt,rw)
        if key not in seen:
            seen.add(key); out.append({'body':rb,'tabs':rt,'white':rw})
        b=rot90(b); t=rot90(t); w=rot90(w) if w else w
    return out
for k,v in PIECES.items():
    rs=rots(v)
    print(k,len(rs),'rots; sample bodies',[r['body'] for r in rs][:2])
