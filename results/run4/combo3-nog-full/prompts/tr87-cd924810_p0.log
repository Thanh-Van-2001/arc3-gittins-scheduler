def lvl6(f):
    spec=[('S',(5,9),1),('P',(5,19),2),('P',(5,38),1),('Y',(5,48),1),
          ('S',(17,9),1),('P',(17,19),2),('P',(17,38),1),('Y',(17,48),1),
          ('S',(29,9),1),('P',(29,19),2),('P',(29,38),1),('Y',(29,48),1)]
    T=[(c,[gkey(f,r+1,c0+1+7*j) for j in range(k)]) for c,(r,c0),k in spec]
    srow=[gkey(f,45,22+7*i) for i in range(3)]
    yrow=[gkey(f,54,12+7*i) for i in range(6)]
    return T,srow,yrow
