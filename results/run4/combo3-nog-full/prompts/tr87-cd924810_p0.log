    T,srow,yrow = lvl6(f)
    items={}
    for i,(c,gl) in enumerate(T):
        for j,g in enumerate(gl): items['T%d.%d'%(i,j)]=g
    for i,g in enumerate(srow): items['S%d'%i]=g
    for i,g in enumerate(yrow): items['Y%d'%i]=g
    ids=rotclasses(items); RM={}
    for k,g in items.items():
