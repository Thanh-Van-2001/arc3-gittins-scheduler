def kstate(fr):
    x=fr.ascii.split('\n')
    return {(r,c):x[r][c] for r in (50,55,60) for c in (25,30,35)}
def clearpad():
    st=kstate(current_frame)
    g=[(r,c) for (r,c),v in st.items() if v=='N']
    for (r,c) in g: action([{'action':'MOUSE','row':r,'col':c}])
    return len(g)
def kp(cells):
    h0=headnow(current_frame); b0=bar(current_frame)
    for (r,c) in cells:
        rr=action([{'action':'MOUSE','row':r,'col':c}])
        if rr.get('game_over'): return 'GAMEOVER'
    st=kstate(current_frame)
    return dict(before=h0,after=headnow(current_frame),bar0=b0,bar=bar(current_frame),pad={k:v for k,v in st.items() if v=='N'})
