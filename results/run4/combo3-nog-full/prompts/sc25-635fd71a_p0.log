def lampstat(fr):
    x=fr.ascii.split('\n')
    red = x[34][18]=='r' or x[34][19]=='r'
    org = x[38][38]=='O' or x[38][39]=='O'
    return ('r' if red else '-'),('O' if org else '-')
def rings(fr):
    yb=[q for n in fr.segmentation['nodes'] if n['color']=='Y' for q in n['boundary'] if 36<=q[0]<=41 and 52<=q[1]<=57]
    pc=[q for n in fr.segmentation['nodes'] if n['color']=='p' for q in n['boundary'] if 39<=q[0]<=44 and 11<=q[1]<=16]
    return len(yb),len(pc)
prev=None
for h in history:
    f=h.frame
    if f.level!=6: continue
    hd=headnow(f)
    if not hd: hs='?'
    else:
        r0=min(e[1] for e in hd); r1=max(e[2] for e in hd); c0=min(e[3] for e in hd); c1=max(e[4] for e in hd)
        hs='%dx%d@(%d,%d)'%(r1-r0+1,c1-c0+1,r0,c0)
    t=(hs,rings(f),lampstat(f),bar(f))
    if t!=prev:
        print(f.step,str(h.action)[:22],t)
        prev=t
