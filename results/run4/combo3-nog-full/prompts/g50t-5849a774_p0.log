def cmap(f,r0=8,c0=8,nr=8,nc=8):
    a=f.ascii.split('\n')
    def cell(i,j):
        rr,cc=r0+6*i,c0+6*j
        s=''.join(a[rr+k][cc:cc+5] for k in range(5))
        st=set(s)
        out=''
        for ch in 'WBRpbgY':
            if ch in st: out+=ch+str(s.count(ch))
        return out or '.'
    return [[cell(i,j) for j in range(nc)] for i in range(nr)]
