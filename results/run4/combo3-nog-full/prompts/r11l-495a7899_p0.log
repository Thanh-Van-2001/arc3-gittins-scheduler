    def D(a,b): return abs(a[0]-b[0])+abs(a[1]-b[1])
    if not rem: return float(D(m,ring))
    if len(rem)==1: return float(D(m,rem[0])+D(rem[0],ring))
    if len(rem)==2: return float(min(D(m,rem[0])+D(rem[0],rem[1]),D(m,rem[1])+D(rem[1],rem[0]))+D(rem[-1] if False else rem[0],ring) if False else min(D(m,rem[0])+D(rem[0],rem[1])+D(rem[1],ring), D(m,rem[1])+D(rem[1],rem[0])+D(rem[0],ring)))
    best=None
    for p in ((0,1,2),(0,2,1),(1,0,2),(1,2,0),(2,0,1),(2,1,0)):
