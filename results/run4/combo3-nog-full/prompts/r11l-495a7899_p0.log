def search6d(start,wayp,other_mean,other_cells,puckok,BL,B6=None,PUFF=None,beam=25,depth=12,slack=7.0):
    if B6 is None: B6={0:(5,39),1:(16,35),2:(23,56),3:(30,45),4:(33,10),5:(43,32),6:(44,16),7:(55,24),8:(56,37)}
    if PUFF is None: PUFF=frozenset((dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not(abs(dr)==2 and abs(dc)==2))
    ring=wayp[-1]; bps=list(wayp[:-1]); bpos=set(bps); allblob=set(B6.values())
    def hst(m,ab): return hst6(m,[x for i,x in enumerate(bps) if i not in ab],ring)
    ball,sets=start
    cur=[(hst(fm5(sets),frozenset()),(ball,sets,frozenset()),())]
    seen={cur[0][1]}
    BOX=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3)]
    for d in range(depth):
        nxt=[]
        for h,(ball,sets,ab),path in cur:
            m=fm5(sets)
            forb=set()
            for X in set(sets)|set(other_cells):
                for o in BOX: forb.add((X[0]+o[0],X[1]+o[1]))
            for o in PUFF:
                forb.add((m[0]+o[0],m[1]+o[1])); forb.add((other_mean[0]+o[0],other_mean[1]+o[1]))
            sr=sum(p[0] for p in sets)-ball[0]; sc=sum(p[1] for p in sets)-ball[1]
            for T in BL:
                if T in forb: continue
                nm=((sr+T[0])//3,(sc+T[1])//3)
                if not puckok.get(nm,False): continue
                if (T[0]-nm[0],T[1]-nm[1]) in PUFF: continue
                nab=ab
                if nm in bpos: nab=ab|{bps.index(nm)}
                elif nm in allblob: continue
                st2=(T,frozenset((sets-{ball})|{T}),nab)
                if st2 in seen: continue
                nh=hst(nm,nab)
                if nh>h+slack: continue
                seen.add(st2)
                nxt.append((nh,st2,path+(('m',T),)))
            for X in sorted(sets):
                if X==ball or abs(X[0]-ball[0])+abs(X[1]-ball[1])<=2: continue
                if inb5(X,m) or inb5(X,other_mean): continue
                st2=(X,sets,ab)
                if st2 in seen: continue
                seen.add(st2)
                nxt.append((hst(fm5(sets),ab),st2,path+(('c',X),)))
        if not nxt: return ('dead',d)
        nxt.sort(key=lambda x:x[0])
        g=[x for x in nxt if fm5(x[1][1])==ring and len(x[1][2])==len(bps)]
        if g: return g[0][2]
        cur=nxt[:beam]
    return ('nofound',depth,cur[0][0],fm5(cur[0][1][1]))
