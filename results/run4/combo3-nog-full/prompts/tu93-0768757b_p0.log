        if not cands: return [(cc,f)]
        best=min(dt.get(n,999) for n,_ in cands)
        if dt.get(cc,999)<=best: return [(cc,f)]
        bests=[(n,d) for n,d in cands if dt.get(n,999)==best]
        cont=[(n,d) for n,d in bests if d==f]
        if cont: return cont
        return bests if branch else bests[:1]
    def rthreat(al):
        s=set()
        for i,(gc,gd) in enumerate(G):
            if al>>i&1:
                for m in (1,2):
                    t=(gc[0]+gd[0]*m,gc[1]+gd[1]*m)
                    if t in F: s.add(t)
        return s
    start=(p0,k0,c0,f0,False,3); q=collections.deque([start]); par={start:None}
    while q:
