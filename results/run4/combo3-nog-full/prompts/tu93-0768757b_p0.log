def los(a,b,F):
    if a[0]==b[0]:
        lo,hi=sorted([a[1],b[1]])
        return all((a[0],c) in F for c in range(lo,hi+1))
    if a[1]==b[1]:
        lo,hi=sorted([a[0],b[0]])
        return all((r,a[1]) in F for r in range(lo,hi+1))
    return False
