def l9v3(p0=(8,8),c0=(4,6),k0=0,kmax=60,wake='los',use_pat=True,use_guard=True,mid_mids=True,mid_ch=True,pat_mid=False):
    import collections
    F=floor9(); DIRS={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}; GOAL=(10,8)
    G=[((10,6),(0,1)),((12,6),(-1,0))]
    Dcache={}
    def dist(x):
        if x not in Dcache: Dcache[x]=bfsd(x,F)
        return Dcache[x]
    def awake_now(c,p):
        if wake=='los': return los(c,p,F)
        if wake=='los4': return los(c,p,F) or dist(c).get(p,99)<=4
        return dist(c).get(p,99)<=4
    def rthreat(al):
        s=set()
        for i,(gc,gd) in enumerate(G):
            if al>>i&1:
                for m in (1,2):
                    t=(gc[0]+gd[0]*m,gc[1]+gd[1]*m)
                    if t in F: s.add(t)
        return s
    start=(p0,k0,c0,False,3); q=collections.deque([start]); par={start:None}
    while q:
        s=q.popleft(); pp,kk,cc,aw,al=s
        if pp==GOAL:
            path=[]
            while par[s] is not None: path.append(par[s][1]); s=par[s][0]
            path.reverse(); return path
        if kk>=kmax: continue
        nk=kk+1
        blkE=set(blk9c(nk,'end')) if use_pat else set()
        blkM=(set(blk9c(nk,'midend'))-blkE) if (use_pat and pat_mid) else set()
        rt=rthreat(al) if use_guard else set(); rc={G[i][0] for i in range(2) if al>>i&1} if use_guard else set()
        ends,mids=(step2(cc,pp,F) if aw else ({cc},set()))
        for a in ('UP','DOWN','LEFT','RIGHT'):
            dr,dc=DIRS[a]; mid=(pp[0]+dr,pp[1]+dc); land=(pp[0]+2*dr,pp[1]+2*dc)
            if mid not in F or land not in F: continue
            if land in blkE or land in blkM: continue
            if mid in blkM: continue
            if land in ends or land==cc: continue
            if mid_ch and (mid in ends or mid==cc): continue
            if mid_mids and aw and mid in mids: continue
            naw=aw or any(awake_now(n,land) for n in ends)
            if land in rc:
                if mid in rc or mid in rt: continue
                nal=al
                for i in range(2):
                    if G[i][0]==land: nal&=~(1<<i)
            else:
                if mid in rt or land in rt: continue
                nal=al
            for n in ends:
                ns=(land,nk,n,naw,nal)
                if ns not in par: par[ns]=(s,a); q.append(ns)
    return None
