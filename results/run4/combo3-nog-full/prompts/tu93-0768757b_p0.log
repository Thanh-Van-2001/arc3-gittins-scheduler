        if wake=='los': return los(c,p,F)
        if wake=='dist4': return dist(c).get(p,99)<=4
        if wake=='los4': return los(c,p,F) or dist(c).get(p,99)<=4
        return True
    def rthreat(al):
        s=set()
        for i,(gc,gd) in enumerate(G):
            if al>>i&1:
                for m in (1,2):
                    t=(gc[0]+gd[0]*m,gc[1]+gd[1]*m)
                    if t in F: s.add(t)
        return s
    start=(p0,k0,c0,False,3); q=collections.deque([start]); par={start:None}
    while q:
        s=q.popleft(); pp,kk,cc,aw,al=s
        if pp==GOAL:
            path=[]
            while par[s] is not None: path.append(par[s][1]); s=par[s][0]
            path.reverse(); return path
        if kk>=kmax: continue
        nk=kk+1; blk=blk9c(nk,pat_mode); rt=rthreat(al) if guard else set(); rc={G[i][0] for i in range(2) if al>>i&1} if guard else set()
        if aw:
