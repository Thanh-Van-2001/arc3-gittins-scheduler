    F=floor9(); DIRS={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}; GOAL=(10,8)
    Dcache={}
    def dist(x):
        if x not in Dcache: Dcache[x]=bfsd(x,F)
        return Dcache[x]
    def awake_now(c,p): return los(c,p,F) or dist(c).get(p,99)<=4
    start=(p0,0,c0,False); q=collections.deque([start]); par={start:None}
    while q:
        s=q.popleft(); pp,kk,cc,aw=s
        if pp==GOAL:
            path=[]
            while par[s] is not None: path.append((pp,cc,par[s][1],aw)); s=par[s][0]
            path.reverse(); return path
        if kk>=kmax: continue
        nk=kk+1
        ends,mids=(step2(cc,pp,F) if aw else ({cc},set()))
        for a in ('UP','DOWN','LEFT','RIGHT'):
            dr,dc=DIRS[a]; mid=(pp[0]+dr,pp[1]+dc); land=(pp[0]+2*dr,pp[1]+2*dc)
            if mid not in F or land not in F: continue
            if land in ends or land==cc: continue
            if mid in ends or mid==cc: continue
            if aw and mid in mids: continue
            naw=aw or any(awake_now(n,land) for n in ends)
            for n in ends:
                ns=(land,nk,n,naw)
                if ns not in par: par[ns]=(s,a); q.append(ns)
    return None
