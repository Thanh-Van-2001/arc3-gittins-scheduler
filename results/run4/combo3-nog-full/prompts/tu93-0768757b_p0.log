def step2(cc,tgt,F):
    dt=bfsd(tgt,F); d0=dt.get(cc,999)
    ends=set(); mids=set()
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        m=(cc[0]+dr,cc[1]+dc)
        if m in F and dt.get(m,999)==d0-1:
            mids.add(m)
            for dr2,dc2 in ((-1,0),(1,0),(0,-1),(0,1)):
                e=(m[0]+dr2,m[1]+dc2)
                if e in F and dt.get(e,999)==d0-2: ends.add(e)
    if not ends: ends={cc}
    return ends,mids
