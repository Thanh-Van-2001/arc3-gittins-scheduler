def l9sleep(p0=(8,8),c0=(4,6),aw0=False,k0=0,kmax=40,T=4,pat_mode='midend',mid_ch=True):
    import collections
    F=floor9(); DIRS={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}; GOAL=(10,8)
    G=[((10,6),(0,1)),((12,6),(-1,0))]
    Dcache={}
    def dist(x):
        if x not in Dcache: Dcache[x]=bfsd(x,F)
        return Dcache[x]
    def rthreat(al):
        s=set()
        for i,(gc,gd) in enumerate(G):
            if al>>i&1:
                for m in (1,2):
                    t=(gc[0]+gd[0]*m,gc[1]+gd[1]*m)
