            path.reverse(); return path
        if kk>=kmax: continue
        nk=kk+1; blk=blk9c(nk,pat_mode); rt=rthreat(al) if guard else set(); rc={G[i][0] for i in range(2) if al>>i&1} if guard else set()
        co=chaser_opts(cc,f,pp) if aw else [(cc,f)]
        for a in ('UP','DOWN','LEFT','RIGHT'):
            dr,dc=DIRS[a]; mid=(pp[0]+dr,pp[1]+dc); land=(pp[0]+2*dr,pp[1]+2*dc)
