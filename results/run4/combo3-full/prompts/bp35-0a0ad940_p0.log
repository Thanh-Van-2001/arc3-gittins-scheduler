def cellgrid(fr, rows=range(0,11), cols=range(0,7)):
    a = fr.ascii.split('\n')
    out=[]
    for i in rows:
        line=''
        for j in cols:
            r0,c0 = 1+6*i, 13+6*j
            if r0+5 > 63 or c0+5 > 63: line+='?'; continue
            cnt={}
            for r in range(r0,r0+5):
                for c in range(c0,c0+5):
                    ch=a[r][c]; cnt[ch]=cnt.get(ch,0)+1
            top = max(cnt.items(), key=lambda kv: (kv[1], kv[0]=='S'))[0]
            line += {'S':'S','N':'#','p':'P','P':'G','b':'@','B':'.','G':'.','Y':'y','W':'w'}.get(top,'?')
        out.append((i,line))
    return out
for i,l in cellgrid(current_frame): print(i, l)
