import itertools, functools
A_cells = set()
for r,c in [(0,0),(0,1),(0,3),(0,4),(1,0),(1,1),(1,3),(1,4),(2,0),(2,1),(2,2),(2,3),(3,0),(3,1),(3,2),(3,3)]:
    A_cells.add((r,c))
A_pegs = {(1,1),(1,4),(2,1),(2,3),(3,2)}
C_cells = {(0,0),(0,1),(0,2),(0,3),(1,0),(1,1),(1,2)}
C_pegs = {(0,1),(0,2)}

def moves(state, cells):
    out=[]
    for (r,c) in state:
        for dr,dc in ((0,1),(0,-1),(1,0),(-1,0)):
            m=(r+dr,c+dc); l=(r+2*dr,c+2*dc)
            if m in cells and l in cells and m in state and l not in state:
                out.append(((r,c),m,l))
    return out

@functools.lru_cache(None)
def best(state, cells_key, cells):
    ms = moves(state, cells)
    if not ms: return (len(state), None)
    res = (len(state), None)
    for mv in ms:
        s2 = frozenset((state - {mv[0], mv[1]}) | {mv[2]})
        n, path = best(s2, cells_key, cells)
        if n < res[0]: res = (n, (mv, s2, path))
    return res

def show(res):
    n = res[0]; path = res[1]; seq=[]
    while path:
        mv, s2, path = path
        seq.append(mv)
    return n, seq

for name, cells, pegs in [('A',A_cells,A_pegs), ('C',C_cells,C_pegs)]:
    r = best(frozenset(pegs), frozenset(cells), frozenset(cells))
    n, seq = show(r)
    print(name, 'min pegs', n, 'seq', seq)
