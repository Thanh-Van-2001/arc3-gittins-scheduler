def sock(frame=None):
    frame = frame or current_frame
    rows = frame.ascii.split('\n')
    ys = [(i,j) for i in range(64) for j,ch in enumerate(rows[i]) if ch in 'YO']
    if not ys: return None
    rs = [a for a,b in ys]; cs = [b for a,b in ys]
    o = [(i,j) for i in range(64) for j,ch in enumerate(rows[i]) if ch=='O']
    ors = [a for a,b in o]; ocs=[b for a,b in o]
    return {'bbox':(min(rs),max(rs),min(cs),max(cs)), 'orange':(min(ors),max(ors),min(ocs),max(ocs)), 'n':len(ys)}

