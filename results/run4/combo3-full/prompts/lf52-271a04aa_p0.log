def find_mark(frame=None):
    frame = frame or current_frame
    rows = frame.ascii.split('\n')
    pts = [(i,j) for i in range(64) for j,ch in enumerate(rows[i]) if ch=='g']
    if not pts: return None
    rs=[a for a,b in pts]; cs=[b for a,b in pts]
    return {'bbox':(min(rs),max(rs),min(cs),max(cs)),'n':len(pts)}

def sock1(frame=None):
    frame = frame or current_frame
    rows = frame.ascii.split('\n')
    pts = [(i,j) for i in range(64) for j,ch in enumerate(rows[i]) if ch=='O' and i<30]
    rs=[a for a,b in pts]; cs=[b for a,b in pts]
    return (min(rs),max(rs),min(cs),max(cs))

