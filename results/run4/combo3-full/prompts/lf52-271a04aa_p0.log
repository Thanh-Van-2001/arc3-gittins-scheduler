# Board A plus socket cell S at (1,5). Objective: minimize pegs left on A cells (socket peg can be carried away).
A = frozenset([(0,0),(0,1),(0,3),(0,4),(1,0),(1,1),(1,3),(1,4),(2,0),(2,1),(2,2),(2,3),(3,0),(3,1),(3,2),(3,3)])
S = (1,5)
cells = A | {S}
pegs0 = frozenset([(1,1),(1,4),(2,1),(2,3),(3,2)])

import functools
best = {}
def solve(state):
    if state in best: return best[state]
    ms = moves(state, cells)
    res = (sum(1 for p in state if p in A), None)
    for mv in ms:
        s2 = frozenset((state - {mv[0], mv[1]}) | {mv[2]})
        n = solve(s2)
        if n[0] < res[0]:
            res = (n[0], (mv, s2))
    best[state] = res
    return res
r = solve(pegs0)
print('min pegs on A (socket usable, peg in socket can be exported):', r[0])
seq=[]; st=pegs0
