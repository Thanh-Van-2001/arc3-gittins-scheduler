    def nbrs(s):
        A,B,C,D,g,y=s; w={'A':A,'B':B,'C':C,'D':D}
        out=[]
        for src,dst,r,c in PUMPS:
            if w[src]>=3 and w[dst]+3<=MAX[dst]:
                nw=dict(w); nw[src]-=3; nw[dst]+=3
                out.append(((nw['A'],nw['B'],nw['C'],nw['D'],g,y),(r,c,'p')))
