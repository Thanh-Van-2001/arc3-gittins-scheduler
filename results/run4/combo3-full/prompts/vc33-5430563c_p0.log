                    out.append(((A,B,C,D,oth if nm=='G' else g, oth if nm=='Y' else y),(r,c,'g')))
                elif len(mv)==2:
                    out.append(((A,B,C,D,Y if g==X else X, Y if y==X else X),(r,c,'g')))
        return out
    def goal(s):
