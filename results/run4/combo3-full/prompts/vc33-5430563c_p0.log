def pis7(f):
    a=f.ascii.split('\n'); out={}
    for col,name in (('N','green'),('Y','yellow'),('p','purple')):
        cells=[(r,c) for r in range(64) for c in range(64) if a[r][c]==col]
        rows=sorted(set(r for r,c in cells)); pist=gap=None
        for r in rows:
            cc=[c for rr,c in cells if rr==r]
            if len(cc)>=3: pist=(r,min(cc),max(cc))
            else: gap=(r,min(cc),max(cc))
        out[name]=(pist,gap)
    return out
