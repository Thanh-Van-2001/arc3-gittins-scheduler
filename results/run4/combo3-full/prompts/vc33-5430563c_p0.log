def m6b(fr=None):
    a=(fr or current_frame).ascii.split('\n')
    def maxw(r0,r1,c0,c1):
        m=-1
        for r in range(r0,r1+1):
            for c in range(c1,c0-1,-1):
                if a[r][c]=='W': m=max(m,c); break
        return m
    UL=maxw(1,26,0,20)+1
    UM=max(0,maxw(1,26,24,63)-23)
    LL=maxw(36,63,0,63)+1
    cap=[(r,c) for r in range(64) for c in range(64) if a[r][c]=='Y' and not (30<=r<=32)]
    if cap:
        rr=sum(r for r,c in cap)//len(cap); cc=max(c for r,c in cap)
        basin='UL' if rr<=29 and cc<=20 else 'UM' if rr<=29 else 'LL'
    else: basin,cc=None,None
    return {'UL':UL,'UM':UM,'LL':LL,'piston':(basin,cc)}
