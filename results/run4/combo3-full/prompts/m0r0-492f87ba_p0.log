def run6(T,st,seq,stopidx=None):
    log=[]
    for i,nm in enumerate(seq):
        if stopidx is not None and i>=stopidx: break
        if nm in ('SELT','SELS'):
            (_,_,_,am),_,amode=read6(grid(current_frame))
            tgt='tok' if nm=='SELT' else 'holes'
            if amode==tgt:
                log.append((i,nm,'skip-already',amode)); continue
            if nm=='SELT': act=[{'action':'MOUSE','row':tokpx(*st[2])[0],'col':tokpx(*st[2])[1]}]
            else: act=[{'action':'MOUSE','row':px_cell(*st[0])[0],'col':px_cell(*st[0])[1]}]
        else: act=[nm]
        res=action(act)
        (aL,aR),atk,amode=read6(grid(current_frame))
        exp=step6b(T,st,nm)
        if exp is None:
            log.append((i,nm,'SIM-NONE',(aL,aR),atk,amode,res.get('game_over'),res.get('level_completed'))); return log,'STOP',st
        if exp[0]=='WIN':
            log.append((i,nm,'WIN',(aL,aR),atk,amode,res.get('game_over'),res.get('level_completed'))); return log,'WIN',st
        nL,nR,ntk,nmode=exp[0]
        ok=(aL==nL) and (aR==nR) and (atk==ntk) and (amode==nmode)
        log.append((i,nm,(nL,nR,ntk,nmode),(aL,aR,atk,amode),'OK' if ok else 'MISMATCH',res.get('game_over'),res.get('level_completed')))
        if not ok or res.get('game_over') or res.get('level_completed'): return log,'STOP',exp[0]
        st=exp[0]
    return log,'DONE',st
