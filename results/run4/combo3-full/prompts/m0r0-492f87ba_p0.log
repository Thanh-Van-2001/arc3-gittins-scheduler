def step6d(T,s,nm):
    DOORS={'N':[(7,3),(7,4),(7,5)],'O':[(7,9),(7,10),(7,11)]}
    PLATES={'N':[(3,10),(10,4)],'O':[(3,4)]}
    L,R,tok,mode=s
    if nm=='SELT': return ((L,R,tok,'tok'),None)
    if nm=='SELS': return ((L,R,tok,'holes'),None)
    def openc(l,r,t):
        o=set()
        for p in (l,r,t):
            for col,ps in PLATES.items():
                if p in ps: o.add(col)
        return o
    def passable(p,oc,blocked,allow_plate=True):
        ch=T.get(p,'X')
        if ch in 'XMP': return False
        for col,cells in DOORS.items():
            if p in cells: return col in oc
        if not allow_plate:
            for col,ps in PLATES.items():
                if p in ps: return False
        return p not in blocked
    oc=openc(L,R,tok)
    if mode=='holes':
        dL=mvL6(nm); dR=mvR6(nm)
        tL=(L[0]+dL[0],L[1]+dL[1]); tR=(R[0]+dR[0],R[1]+dR[1])
        if tL==tR: return ('WIN',tL) if passable(tL,oc,{tok}) else None
        okL=passable(tL,oc,{tok,R}); okR=passable(tR,oc,{tok,L})
        nL=tL if okL else L; nR=tR if okR else R
        if nL==nR: return None
        return ((nL,nR,tok,mode),None)
    d=mvL6(nm); t=(tok[0]+d[0],tok[1]+d[1])
    return ((L,R,t,mode),None) if passable(t,oc,{L,R},False) else ((L,R,tok,mode),None)
