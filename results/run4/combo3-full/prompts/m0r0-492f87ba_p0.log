def step6e(T,s,nm):
    DOORS={'N':[(7,3),(7,4),(7,5)],'O':[(7,9),(7,10),(7,11)]}
    PLATES={'N':[(3,10),(10,4)],'O':[(3,4)]}
    L,R,tok,mode=s
    if nm=='SELT': return ((L,R,tok,'tok'),None)
    if nm=='SELS': return ((L,R,tok,'holes'),None)
    def openc(l,r,t):
        o=set()
        for p in (l,r,t):
            for col,ps in PLATES.items():
                if p in ps: o.add(col)
        return o
    def kind(p):
        ch=T.get(p,'X')
        if ch in 'XMP': return ch
        for col,cells in DOORS.items():
            if p in cells: return 'D'+col
        for col,ps in PLATES.items():
            if p in ps: return 'P'+col
        return 'B'
    def passable(p,oc,blocked):
        k=kind(p)
        if k in ('X','M','P'): return False
        if k.startswith('D'): return k[1:] in oc
        return p not in blocked
    oc=openc(L,R,tok)
    if mode=='holes':
        dL=mvL6(nm); dR=mvR6(nm)
        tL=(L[0]+dL[0],L[1]+dL[1]); tR=(R[0]+dR[0],R[1]+dR[1])
        if kind(tL)=='X' or kind(tR)=='X': return None
        if tL==tR: return ('WIN',tL) if passable(tL,oc,{tok}) else None
        okL=passable(tL,oc,{tok,R}); okR=passable(tR,oc,{tok,L})
        nL=tL if okL else L; nR=tR if okR else R
        if nL==nR: return None
        return ((nL,nR,tok,mode),None)
    d=mvL6(nm); t=(tok[0]+d[0],tok[1]+d[1])
    if kind(t)=='X': return ((L,R,tok,mode),None)
    if kind(t).startswith('P'): return ((L,R,tok,mode),None)
    return ((L,R,t,mode),None) if passable(t,oc,{L,R}) else ((L,R,tok,mode),None)
T6=build6()
sol,cell=bfs6c(T6,((5,4),(5,10),(10,7),'holes'),44,step6e)
print('len',len(sol) if sol else None,sol,cell)
</parameter>
</function>
