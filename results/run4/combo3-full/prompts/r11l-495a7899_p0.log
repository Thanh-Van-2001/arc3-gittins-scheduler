import itertools
def stage(cells,tgt,DOK,KOK,othercells):
    n=len(cells); lo=(n*tgt[0],n*tgt[1]); Ts=[(lo[0]+a,lo[1]+b) for a in range(n) for b in range(n)]
    S=(sum(c[0] for c in cells),sum(c[1] for c in cells))
    def kok(sr,sc): return KOK(sr//n,sc//n)
    def farall(d,cs): return all(far6(d,tuple(x)) for x in cs)
    for i in range(n):
        for T in Ts:
            d=(T[0]-(S[0]-cells[i][0]), T[1]-(S[1]-cells[i][1]))
            if not(2<=d[0]<=61 and 2<=d[1]<=61) or not DOK(*d): continue
            if not farall(d,[cells[j] for j in range(n) if j!=i]+list(othercells)): continue
            if not kok(T[0],T[1]): continue
            return [(i,d)]
    for (i,j) in itertools.permutations(range(n),2):
        rest=[cells[m] for m in range(n) if m!=i and m!=j]
        base=(sum(x[0] for x in rest),sum(x[1] for x in rest))
        for r1 in range(2,62):
            for c1 in range(2,62):
                if not DOK(r1,c1): continue
                if not farall((r1,c1),rest+list(othercells)+[cells[j]]): continue
                sr=base[0]+r1; sc=base[1]+c1
                if not kok(sr,sc): continue
                for T in Ts:
                    d2=(T[0]-sr,T[1]-sc)
                    if not(2<=d2[0]<=61 and 2<=d2[1]<=61) or not DOK(*d2): continue
                    if not farall(d2,rest+[cells[i]]+list(othercells)+[(r1,c1)]): continue
                    if not kok(T[0],T[1]): continue
                    return [(i,(r1,c1)),(j,d2)]
    if n==3:
        for (i,j,m) in itertools.permutations(range(3),3):
            for r1 in range(2,62,2):
                for c1 in range(2,62,2):
                    if not DOK(r1,c1) or not farall((r1,c1),[cells[j],cells[m]]+list(othercells)): continue
                    s1=(S[0]-cells[i][0]+r1,S[1]-cells[i][1]+c1)
                    if not kok(*s1): continue
                    for dr in range(-12,13,2):
                        for dc in range(-12,13,2):
                            if abs(dr)+abs(dc)<6: continue
                            r2,c2=r1+dr,c1+dc
                            if not(2<=r2<=61 and 2<=c2<=61) or not DOK(r2,c2): continue
                            if not farall((r2,c2),[cells[j],cells[m],(r1,c1)]+list(othercells)): continue
                            s2=(s1[0]-cells[j][0]+r2,s1[1]-cells[j][1]+c2)
                            if not kok(*s2): continue
                            rem=(s2[0]-cells[m][0],s2[1]-cells[m][1])
                            for T in Ts:
                                d3=(T[0]-rem[0],T[1]-rem[1])
                                if not(2<=d3[0]<=61 and 2<=d3[1]<=61) or not DOK(*d3): continue
                                if not farall(d3,[(r1,c1),(r2,c2)]+list(othercells)): continue
                                if not kok(*T): continue
                                return [(i,(r1,c1)),(j,(r2,c2)),(m,d3)]
    return None
def check_plan(cells,steps,ring):
    n=len(cells); cur=list(cells)
    for i,d in steps:
        cur=list(cur); cur[i]=d
        k=(sum(c[0] for c in cur)//n,sum(c[1] for c in cur)//n)
    return k,cur
