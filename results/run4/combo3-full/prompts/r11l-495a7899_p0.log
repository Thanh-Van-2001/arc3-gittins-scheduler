            if seen[r][c] or g[r][c]=='B': continue
            st=[(r,c)]; seen[r][c]=True; comp=[]
            while st:
                y,x=st.pop(); comp.append((y,x,g[y][x]))
                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):
                    ny,nx=y+dy,x+dx
                    if 0<=ny<R and 0<=nx<C and not seen[ny][nx] and g[ny][nx]!='B':
