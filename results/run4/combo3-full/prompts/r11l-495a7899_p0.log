def terrain7(fr):
    a=fr.ascii.split('\n')
    return {(r,c):a[r][c] for r in range(len(a)) for c in range(len(a[0]))}
def make_checks(T):
    def ps(r,c): return 0<=r<64 and 0<=c<64 and T[(r,c)]!='g'
    def DOK(r,c): return 2<=r<=61 and 2<=c<=61 and all(ps(r+dr,c+dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2)
    def KOK(r,c): return all(ps(r+dr,c+dc) for dr in (-2,-1,0,1,2) for dc in range(-2,3) if abs(dc)<=(2 if abs(dr)<2 else 1))
    return ps,DOK,KOK
import itertools
def stage(cells,tgt,DOK,KOK,othercells):
    n=len(cells); lo=(n*tgt[0],n*tgt[1]); Ts=[(lo[0]+a,lo[1]+b) for a in range(n) for b in range(n)]
    S=(sum(c[0] for c in cells),sum(c[1] for c in cells))
    def kok(sr,sc): return KOK(sr//n,sc//n)
    def farall(d,cs): return all(far6(d,tuple(x)) for x in cs)
