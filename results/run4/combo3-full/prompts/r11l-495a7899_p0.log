    for i in range(n):
        for T in Ts:
            d=(T[0]-(S[0]-cells[i][0]), T[1]-(S[1]-cells[i][1]))
            if not(2<=d[0]<=61 and 2<=d[1]<=61) or not DOK(*d): continue
            if not farall(d,[cells[j] for j in range(n) if j!=i]+list(othercells)): continue
            if not kok(T[0],T[1]): continue
            return [(i,d)]
    # 2 relocations
