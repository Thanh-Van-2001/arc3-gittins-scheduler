def stage_solve(cells,tgt,budget=200000):
    T6=build_terrain6()
    def ps(r,c): return 0<=r<64 and 0<=c<64 and T6[(r,c)] in ('B','U')
    def DOK(r,c): return 2<=r<=61 and 2<=c<=61 and all(ps(r+dr,c+dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2)
    def KOK(r,c): return all(ps(r+dr,c+dc) for dr in (-2,-1,0,1,2) for dc in range(-2,3) if abs(dc)<=(2 if abs(dr)<2 else 1))
    n=len(cells); lo=(n*tgt[0],n*tgt[1]); hi=(lo[0]+n-1,lo[1]+n-1)
    S=(sum(c[0] for c in cells),sum(c[1] for c in cells))
    def kok_k(sr,sc): return KOK(sr//n,sc//n)
    # try relocating exactly 2 cells (keep k)
    for keep in range(n):
        rest=[i for i in range(n) if i!=keep]
        a,b=rest
        for r1 in range(2,62):
            for c1 in range(2,62):
                if not DOK(r1,c1): continue
                d1=(r1,c1)
                if not far6(d1,tuple(cells[keep])): continue
                if not far6(d1,tuple(cells[b])): continue
                sr=S[0]-cells[a][0]+r1; sc=S[1]-cells[a][1]+c1
                if not kok_k(sr,sc): continue
                # now relocate b
                for dr in range(lo[0]-sr,hi[0]-sr+1):
                    for dc in range(lo[1]-sc,hi[1]-sc+1):
                        d2=(cells[b][0]+dr,cells[b][1]+dc)
                        if not (2<=d2[0]<=61 and 2<=d2[1]<=61): continue
                        if not DOK(*d2): continue
                        if not far6(d2,tuple(cells[keep])) or not far6(d2,d1): continue
                        return [(a,d1),(b,d2)]
    return None
C2=[(47,41),(55,34),(55,52)]
