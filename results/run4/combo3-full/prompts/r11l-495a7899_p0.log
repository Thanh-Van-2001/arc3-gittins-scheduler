def stage_solve2(cells,tgt):
    T6=build_terrain6()
    def ps(r,c): return 0<=r<64 and 0<=c<64 and T6[(r,c)] in ('B','U')
    def DOK(r,c): return 2<=r<=61 and 2<=c<=61 and all(ps(r+dr,c+dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2)
    def KOK(r,c): return all(ps(r+dr,c+dc) for dr in (-2,-1,0,1,2) for dc in range(-2,3) if abs(dc)<=(2 if abs(dr)<2 else 1))
    n=len(cells); lo=(n*tgt[0],n*tgt[1]); hi=(lo[0]+n-1,lo[1]+n-1)
    S=(sum(c[0] for c in cells),sum(c[1] for c in cells))
    import itertools
    # try 2 relocations keeping cell 'keep'
    for keep in range(n):
        a,b=[i for i in range(n) if i!=keep]
        for r1 in range(2,62):
            for c1 in range(2,62):
                if not DOK(r1,c1) or not far6((r1,c1),tuple(cells[keep])) or not far6((r1,c1),tuple(cells[b])): continue
                sr=S[0]-cells[a][0]+r1; sc=S[1]-cells[a][1]+c1
                if not KOK(sr//n,sc//n): continue
                for dr in range(lo[0]-sr,hi[0]-sr+1):
                    for dc in range(lo[1]-sc,hi[1]-sc+1):
                        d2=(cells[b][0]+dr,cells[b][1]+dc)
                        if not(2<=d2[0]<=61 and 2<=d2[1]<=61) or not DOK(*d2): continue
                        if not far6(d2,tuple(cells[keep])) or not far6(d2,(r1,c1)): continue
                        return [(a,(r1,c1)),(b,d2)]
    # try 3 relocations: enumerate final config
    for r1 in range(2,62,1):
        for c1 in range(2,62,1):
            if not DOK(r1,c1): continue
            for dr2 in range(-10,11):
                for dc2 in range(-10,11):
                    r2,c2=r1+dr2,c1+dc2
                    if not(2<=r2<=61 and 2<=c2<=61) or not DOK(r2,c2): continue
                    if not far6((r2,c2),(r1,c1)): continue
                    for sr in range(lo[0],hi[0]+1):
                        r3=sr-r1-r2
                        if not(2<=r3<=61): continue
                        for sc in range(lo[1],hi[1]+1):
                            c3=sc-c1-c2
                            if not(2<=c3<=61) or not DOK(r3,c3): continue
                            if not far6((r3,c3),(r1,c1)) or not far6((r3,c3),(r2,c2)): continue
                            F=[(r1,c1),(r2,c2),(r3,c3)]
                            for perm in itertools.permutations(range(3)):
                                cur=list(cells); ss=list(S); ok=True
                                steps=[]
                                for t,idx in enumerate(perm):
                                    o=cur[idx]; cur[idx]=F[idx]
                                    ss[0]+=F[idx][0]-o[0]; ss[1]+=F[idx][1]-o[1]
                                    if t<2 and not KOK(ss[0]//n,ss[1]//n): ok=False; break
                                    steps.append((idx,F[idx]))
                                if ok: return steps
    return None
