D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
def hstep(st, blk, extra, a):
    (hr,hc,face,carry,off)=st
    if a=='SPACE':
        if carry:
            C=(hr+off[0],hc+off[1]); return (hr,hc,face,False,None), blk|{C}, False
        f=D[face]; fr_=hr+f[0]; fc=hc+f[1]
        if (fr_,fc) in blk:
            b=(hr-f[0],hc-f[1])
            if (fr_,fc) not in extra and b not in blk and b not in extra and 0<=b[0]<16 and 0<=b[1]<13:
                return (hr,hc,face,True,f), blk-{(fr_,fc)}, False
        return st, blk, True
    d=D[a]; nhr,nhc=hr+d[0],hc+d[1]; nf=a
    C=(hr+off[0],hc+off[1]) if carry else None
    if (nhr,nhc) in extra or not(0<=nhr<16 and 0<=nhc<13): return (hr,hc,nf,carry,off), blk, True
    if carry:
        if (nhr,nhc)==C: return (hr,hc,nf,carry,off), blk, True
        nb=(blk|{C})-{(hr,hc)}
        return (nhr,nhc,nf,True,off), nb, False
    if (nhr,nhc) in blk: return (hr,hc,nf,carry,off), blk, True
    return (nhr,nhc,nf,False,None), blk, True if False else False

INK=[(7,3),(7,4),(8,3),(8,4),(9,3),(9,4)]
def run(seq, st0, blk0, tag=''):
    st=st0; blk=set(blk0)
    for a in seq:
        # real orange cell as obstacle
        h,o,cr,ca=full(previous_frame if False else current_frame)
        extra={o} if o else set()
        ns,nb,noop=hstep(st,blk,extra,a)
        r=action([a]); res=r if isinstance(r,dict) else {}
        if res.get('game_over'): print('DEAD',a); return None
        h,o,cr,ca=full(current_frame)
        real_h=h; real_carry=ca; real_blk=set(c[0] for c in cr)
        if real_carry: real_blk.add((h[0]+ns[4][0],h[1]+ns[4][1])) if ns[4] else None
        exp_blk = nb | ({(ns[0]+ns[4][0],ns[1]+ns[4][1])} if ns[3] else set())
        ok = (real_h==(ns[0],ns[1])) and (real_carry==ns[3]) and (real_blk==exp_blk)
        if not ok:
            print('MISMATCH at',a,'step',current_frame.step,'real head',real_h,'exp',(ns[0],ns[1]),'carry',real_carry,ns[3])
            print('  real blk',sorted(real_blk)); print('  exp blk',sorted(exp_blk)); print('  orange',o)
            return False
        st,blk=ns,nb
        on=sorted(c for c in blk if c in INK)
        print(current_frame.step,a,'head',st[:2],'carry',st[3],'orange',o,'onInk',on,'pink',pink(current_frame))
        if res.get('level_completed'): print('LEVEL COMPLETE'); return True
    return st

