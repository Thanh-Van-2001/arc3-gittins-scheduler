def full(fr):
    seg=fr.segmentation; head=None; orange=None; crates=[]; carry=False
    for n in seg['nodes']:
        c=n['color']; b=bbox4(n)
        if b[2]>=15: continue
        if c=='N': head=(b[0],b[1])
        elif c=='O': orange=(b[0],b[1])
        elif c=='W' and n['pixels']>4: carry=True
        elif c in ('c','G','B') and n['pixels']>=12:
            for r in range(b[0],b[2]+1):
                for cc in range(b[1],b[3]+1): crates.append(((r,cc),c))
    return head, orange, sorted(crates), carry
INK=[(7,3),(7,4),(8,3),(8,4),(9,3),(9,4)]
for a in ['RIGHT','LEFT','RIGHT','LEFT','RIGHT','LEFT','RIGHT','LEFT','RIGHT','LEFT']:
    r=action([a]); res=r if isinstance(r,dict) else {}
    if res.get('game_over') or res.get('level_completed'): print('SPECIAL',a,res.get('state'),'lc',res.get('level_completed')); break
    h,o,cr,ca=full(current_frame)
    on=[c for c in cr if c[0] in INK]; free=[c for c in cr if c[0] not in INK]
    print(current_frame.step,a,'head',h,'orange',o,'onInk',sorted(set(x[0] for x in on)),'free',sorted(set(x[0] for x in free)),'carry',ca)
