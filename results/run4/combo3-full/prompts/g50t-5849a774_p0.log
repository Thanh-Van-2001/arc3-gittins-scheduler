def walk(path, gates=None, burns=None, maxburn=14, verbose=True):
    gates=gates or {}; burns=burns or {}
    def gate_ok(g):
        d=info3(current_frame)
        if g=='Y': return (2,6) in d['yhead']
        if g=='B': return (6,5) in d['rhead']
        if g=='A': return (5,2) in d['rhead']
        return True
    log=[]
    for (a,tgt) in path:
        if tgt in gates:
            g=gates[tgt]
            n=0
            while not gate_ok(g) and n<maxburn:
                back,fwd=burns[tgt]
                action([back]); n+=1
                if gate_ok(g):
                    action([fwd]); n+=1; break
            log.append('wait%d@%s'%(n,tgt))
        res=action([a]); d=info3(current_frame)
        ok=res.get('gameplay_changed')
        log.append('%s->%s%s'%(a,tgt,'' if ok else ' NOOP'))
        if not ok: return log+['ABORT'], d
        if res.get('level_completed') or res.get('game_over') or res.get('done') or res.get('run_complete'):
            return log+['END'], d
    return log, info3(current_frame)

