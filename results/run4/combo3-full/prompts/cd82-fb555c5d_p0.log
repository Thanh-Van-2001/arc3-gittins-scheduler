def solve(tgt, OPS, maxdepth=8):
    fixed=frozenset((x,y) for x in range(10) for y in range(10))
    best=None
    seen={}
    def dfs(fixed, path):
        nonlocal best
        if not fixed:
            if best is None or len(path)<len(best): best=list(path)
            return
        if len(path)>= (len(best) if best else maxdepth): return
        for name,S in OPS.items():
            inter = S & fixed
            if not inter: continue
            cols={tgt[x][y] for x,y in inter}
            if len(cols)!=1: continue
            c=cols.pop()
            dfs(fixed-inter, path+[(name,c)])
    dfs(fixed,[])
    return best
tgt=[[rows[3+x][3+y] for y in range(10)] for x in range(10)]
sol=solve(tgt,OPS)
print('solution (reverse order):', sol)
