                                if nt[x]==1: ok=False; break
                                nt[x]=1; anym=True
                            else:
                                nt[x]=0
                        if not ok or not anym: continue
                        placed[k]=(ri,d)
                        rec(placed,body|cells,nt)
                        del placed[k]
        rec({first:(fi,(0,0))},body,tstate)
    return sols
