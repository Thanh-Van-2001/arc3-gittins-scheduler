def solve6(R6, first='D', maxsol=400):
    keys=[k for k in R6 if k!=first]
    sols=[]
    for fi,fp in enumerate(R6[first]):
        B0=fp['b']; T0=fp['t']
        body=set(B0); tstate={t:0 for t in T0}   # 0 unmatched,1 matched
        def rec(placed,body,tstate):
            if len(sols)>=maxsol: return
            rem=[k for k in keys if k not in placed]
            if not rem:
                if all(v==1 for v in tstate.values()):
                    sols.append(dict(placed))
                return
            # prune: unmatched tips count must be even? and each remaining piece must be attachable
            k=rem[0] if len(rem)==1 else min(rem,key=lambda kk: len(R6[kk]))
            for ri,pose in enumerate(R6[k]):
                B=pose['b']; T=pose['t']
                for t in T:
                    for (u,matched) in list(tstate.items()):
                        if matched: continue
                        d=(u[0]-t[0],u[1]-t[1])
                        cells=set((r+d[0],c+d[1]) for r,c in B)
                        if cells & body: continue
                        if cells & set(tstate): continue
                        newtips=[(r+d[0],c+d[1]) for r,c in T]
                        if len(set(newtips))!=len(newtips): continue
                        nt=dict(tstate); ok=True; anym=False
                        for x in newtips:
