def alltr2(g):
    out=set(); c=g
    for i in range(4):
        out.add(tuple(''.join(r) for r in c)); out.add(tuple(''.join(r) for r in c)[::-1])
        m=[tuple(reversed(r)) for r in c]
        out.add(tuple(''.join(r) for r in m))
        c=list(map(list,zip(*c[::-1])))
        c=[list(r) for r in c]
    return out
def canon(g):
    return min(alltr2([list(r) for r in g]))
def blackglyphs(fr,r0,r1,c0,c1):
    rows=fr.ascii.split('\n')
    cols={}
    for c in range(c0,c1+1):
        pat=''.join(rows[r][c] for r in range(r0,r1+1))
        if 'B' in pat: cols[c]=pat
    if not cols: return []
    ks=sorted(cols); groups=[]; cur=[ks[0]]
    for k in ks[1:]:
        if k-cur[-1]<=1: cur.append(k)
        else: groups.append(cur); cur=[k]
    groups.append(cur)
