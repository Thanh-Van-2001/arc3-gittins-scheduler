        sub=[ ''.join(cols[c][i] for c in gp) for i in range(len(cols[ks[0]])) ]
        rr=[i for i,s in enumerate(sub) if 'B' in s]
        sub=[s for i,s in enumerate(sub) if i in rr]
        out.append(tuple(s.strip() for s in sub))
    return out
def tilebb(fr,color,minw=6,minh=4):
    res=[]
    for n in fr.segmentation['nodes']:
        if n['color']!=color: continue
        b=n['boundary']
        r0=min(p[0] for p in b); r1=max(p[0] for p in b); c0=min(p[1] for p in b); c1=max(p[1] for p in b)
        if (r1-r0+1)>=minh and (c1-c0+1)>=minw: res.append((r0,r1,c0,c1))
    return sorted(res)
