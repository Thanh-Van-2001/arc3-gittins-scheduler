def split2(fr,r0,r1,c0,c1):
    rows=fr.ascii.split('\n')
    colpat={}
    for c in range(c0,c1+1):
        p=''.join(rows[r][c] for r in range(r0,r1+1))
        if 'B' in p: colpat[c]=p
    ks=sorted(colpat)
    if not ks: return []
    runs=[]; cur=[ks[0]]
    for k in ks[1:]:
        if k-cur[-1]<=1: cur.append(k)
        else: runs.append(cur); cur=[k]
    runs.append(cur)
    if len(runs)==1: runs=[runs[0]]
    elif len(runs)==2: runs=[runs[0]+runs[1]] if False else [runs[0],runs[1]]
    else:
        # merge into 2 groups at largest gap
        gaps=[(runs[i+1][0]-runs[i][-1],i) for i in range(len(runs)-1)]
        g,i=max(gaps)
        runs=[sum(runs[:i+1],[]),sum(runs[i+1:],[])]
    out=[]
    for gp in runs:
        sub=[''.join(colpat[c][i] for c in gp) for i in range(len(colpat[ks[0]]))]
