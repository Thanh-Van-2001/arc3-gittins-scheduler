    out['sky']=sky
    pairs=[t for t in pink if t[3]-t[2]>8]; singles=[t for t in pink if t[3]-t[2]<=8]
    ys=[t for t in yel if t[3]-t[2]>8]; ysingle=[t for t in yel if t[3]-t[2]<=8]
    def G(bb): return [canon(x) for x in blackglyphs(fr,bb[0]+1,bb[1]-1,bb[2]+1,bb[3]-1)]
    out['P2']=[G(t) for t in sorted(pairs)]
    out['Pr']=[G(t) for t in sorted(singles)]
    out['Yr']=[G(t) for t in sorted(ysingle)]
    bigS=[t for t in sky if t[3]-t[2]>8]; smallS=[t for t in sky if t[3]-t[2]<=8]
    out['Sbox']=[G(t) for t in sorted(bigS)][0] if bigS else []
    out['S']=[G(t) for t in sorted(smallS)]
    bigY=[t for t in yel if t[3]-t[2]>8]
    out['Ybox']=[G(t) for t in sorted(bigY)][0] if bigY else []
    return out
