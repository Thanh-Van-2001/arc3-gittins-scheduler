def flash_parts():
    fr = last_animation_frames
    # find peak frame index: max count of cells differing from the following frame
    best=None
    for i in range(len(fr)-1):
        a=fr[i].ascii.split('\n'); b=fr[i+1].ascii.split('\n')
        pts=[(r,c) for r in range(64) for c in range(64) if a[r][c]!=b[r][c]]
        if len(pts)>20:
            best=(i,pts); break
    if not best: return None
    i,pts = best
    # cluster into components by row band
    top=[p for p in pts if p[0]<10]; bot=[p for p in pts if p[0]>=10]
