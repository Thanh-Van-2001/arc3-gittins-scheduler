def blocks_in(f):
    a=f.ascii.split('\n'); s=set()
    for r in range(64):
        row=a[r]
        for c in range(64):
            if row[c]=='M': s.add((r,c))
    # group into 4x4 blocks by top-left anchors
    out=set()
    for (r,c) in s:
        if (r-1,c) not in s and (r,c-1) not in s and (r-1,c-1) not in s:
            out.add((r,c))
    return sorted(out), len(s)
