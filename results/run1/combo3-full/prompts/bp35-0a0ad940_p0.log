def cellchar(fr, gr, gc, r0=1, c0=13, pitch=6):
    a = fr.ascii.split('\n')
    from collections import Counter
    cnt=Counter()
    for rr in range(r0+pitch*gr, min(64, r0+pitch*gr+pitch-1)):
        for cc in range(c0+pitch*gc, min(63, c0+pitch*gc+pitch-1)):
            cnt[a[rr][cc]]+=1
    return cnt.most_common(1)[0][0]
def dcell(fr):
    p = dpos(fr)
    if not p: return None
    return ((p[0]-1)//6, (p[2]-13)//6)
def block_above_center(fr):
    d = dcell(fr)
    if d is None: return None
    gr, gc = d
    ch = cellchar(fr, gr-1, gc)
    return (gr-1, gc, ch)
