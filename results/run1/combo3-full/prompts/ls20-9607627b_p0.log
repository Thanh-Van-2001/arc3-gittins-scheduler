def plan5(F,start,fans,rings,plus,obj,box,bar_full=42,bar_now=36,cost=2,need_p=1,need_o=3):
    import collections
    d={'UP':(-5,0),'DOWN':(5,0),'LEFT':(0,-5),'RIGHT':(0,5)}
    MO={m for m,_ in fans}
    FD=dict(fans)
    def step(p,act):
        n=(p[0]+d[act][0],p[1]+d[act][1])
        if n not in F: return None
        if n in FD:
            dd=FD[n]
            while True:
                nx=(n[0]+dd[0],n[1]+dd[1])
                if nx in F: n=nx
                else: break
        return n
    start=(tuple(start),0,0,bar_now,frozenset(rings))
    dq=collections.deque([(start,[])]); seen={start}
    while dq:
        (p,pp,oo,bar,rs),acts=dq.popleft()
        if p==tuple(box) and pp==need_p and oo==need_o: return acts
        for act in ['UP','DOWN','LEFT','RIGHT']:
            q=step(p,act)
            if q is None: continue
            npp,noo=pp,oo
            if q==tuple(plus): npp=pp+1
            if q==tuple(obj): noo=oo+1
            if noo>need_o or npp>need_p: continue
            nb=bar-cost; nrs=rs
            if q in rs: nb=bar_full; nrs=frozenset(set(rs)-{q})
            if nb<0: continue
            st=(q,npp,noo,nb,nrs)
            if st in seen: continue
            seen.add(st); dq.append((st,acts+[act]))
    return None
