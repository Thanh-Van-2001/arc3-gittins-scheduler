def mkfree(fr,extra=()):
    F=set()
    for r in range(0,60,5):
        for c in range(4,59,5):
            cnt={}
            for rr in range(r,r+5):
                for cc in range(c,c+5):
                    ch=fr[rr][cc]; cnt[ch]=cnt.get(ch,0)+1
            if cnt.get('G',0)>=16: F.add((r,c))
    for e in extra: F.add(tuple(e))
    return F
def bfs2(F,start,goal,fans,rings=(),bar_now=99,bar_full=42,cost=1,avoid=()):
    import collections
    AVOID=set(avoid)
    def step(p,act):
        d={'UP':(-5,0),'DOWN':(5,0),'LEFT':(0,-5),'RIGHT':(0,5)}[act]
        n=(p[0]+d[0],p[1]+d[1])
        if n not in F: return None
        for (m,dd) in fans:
            if n==m:
                while True:
                    nx=(n[0]+dd[0],n[1]+dd[1])
                    if nx in F and nx not in AVOID: n=nx
                    else: break
        return n
    R=frozenset(rings)
    st0=(tuple(start),bar_now,R)
    dq=collections.deque([(st0,[])]); seen={st0}
    while dq:
        (p,bar,rs),acts=dq.popleft()
        if tuple(p)==tuple(goal): return acts
        for act in ['UP','DOWN','LEFT','RIGHT']:
            q=step(p,act)
            if q is None: continue
            nb=bar-cost; nr=rs
            if q in rs: nb=bar_full; nr=frozenset(set(rs)-{q})
            if nb<0: continue
            st=(q,nb,nr)
            if st in seen: continue
            seen.add(st); dq.append((st,acts+[act]))
    return None
