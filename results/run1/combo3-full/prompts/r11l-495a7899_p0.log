def planP(G,toks,ci,T,forbid,SQ=((-2,-1),(-2,0),(-2,1),(-1,-2),(-1,-1),(-1,0),(-1,1),(-1,2),(0,-2),(0,-1),(0,1),(0,2),(1,-2),(1,-1),(1,0),(1,1),(1,2),(2,-1),(2,0),(2,1))):
    n=len(toks); S=(n*T[0],n*T[1])
    def vc(p):
        r,c=p
        if r<2 or r>61 or c<2 or c>61: return False
        for dr,dc in SQ:
            if G[r+dr][c+dc]=='g': return False
        return True
    def vs(p):
        r,c=p
        if p in forbid: return False
        return vc(p)
    def mean(ts): return (sum(t[0] for t in ts)//n, sum(t[1] for t in ts)//n)
    best=[None,99]
    def consider(mv,newpos):
        ts=list(toks); L=len(mv)
        for k in range(L):
            i=mv[k]; ts2=list(ts); ts2[i]=newpos[i]
            if not (vc if k==L-1 else vs)(mean(ts2)): return
            ts=ts2
        cur=ci; cost=0; acts=[]
        for i in mv:
            if cur!=i: acts.append(('s',toks[i])); cost+=1; cur=i
            acts.append(('w',newpos[i])); cost+=1
        if cost<best[1]: best[0]=acts; best[1]=cost
    for i in range(n):
        others=[t for j,t in enumerate(toks) if j!=i]
        x=(S[0]-sum(o[0] for o in others), S[1]-sum(o[1] for o in others))
        if vc(x) and x not in others: consider([i],{i:x})
    if n>=2 and best[1]>2:
        for pair in [(a,b) for a in range(n) for b in range(n) if a<b]:
            fixed=[t for j,t in enumerate(toks) if j not in pair]
            R=(S[0]-sum(o[0] for o in fixed), S[1]-sum(o[1] for o in fixed))
            for r1 in range(2,62):
                for c1 in range(2,62):
                    p1=(r1,c1)
                    if not vc(p1): continue
                    p2=(R[0]-r1,R[1]-c1)
                    if not vc(p2) or p2==p1 or p2 in fixed: continue
                    for mv in [pair,(pair[1],pair[0])]:
                        consider(list(mv),{mv[0]:p1,mv[1]:p2})
    return best[0],best[1]
