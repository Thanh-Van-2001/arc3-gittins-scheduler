import math
def chk():
    N=cells('N')
    if not N: return []
    # cluster N cells into 2 checkers by proximity
    groups=[]
    for (r,c) in N:
        placed=False
        for g in groups:
            if any(abs(r-a)+abs(c-b)<=2 for (a,b) in g):
                g.append((r,c)); placed=True; break
        if not placed: groups.append([(r,c)])
    return [(sum(p[0] for p in g)/len(g), sum(p[1] for p in g)/len(g), len(g)) for g in groups]
