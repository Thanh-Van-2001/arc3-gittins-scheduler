def ppos(f):
    for o in f.segmentation['nodes']:
        if o['color']=='b':
            pr=min(p[0] for p in o['pixels']) if isinstance(o['pixels'][0],(list,tuple)) else None
            return o.get('bbox') or (o.get('at'))
    return None
# use tilef-based scan instead: find 'b' cell
def player_tile(f):
    ls=f.ascii.split('\n')
    rs=[r for r in range(64) if 'b' in ls[r]]
    if not rs: return None
    r0=min(rs); r1=max(rs)
    cs=[c for r in range(r0,r1+1) for c in range(64) if ls[r][c]=='b']
    return ((r0+r1)//2)//3, (min(cs)+max(cs))//2//3
