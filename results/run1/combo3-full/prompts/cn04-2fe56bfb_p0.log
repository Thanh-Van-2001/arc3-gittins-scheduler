def solve3(P, aidx=0, want_socket=True):
    # grow connected structure from A; allow plug-on-body overlap; forbid >2 plugs per cell;
    # a 2-plug cell must be different pieces (match). socket may take 1 plug (from other piece).
    A=P['A'][aidx]
    Ab=set(A[0]); Ap=set(A[1]); Aw=set(A[2])
    order=['B','C','D']
    best=[]
    def key(st):
        nm,pi,t,matches,sock=st
        return (-matches, -sock)
    def cells_of(nm,pi,t):
        b,p=P[nm][pi]
        return set((r+t[0],c+t[1]) for r,c in b), set((r+t[0],c+t[1]) for r,c in p)
    def run(placed, occ_plug, occ_all, sock_cell, matches, sock_used):
        # placed: dict nm -> (pi,t)
        if len(placed)==4:
            best.append((matches,sock_used,dict(placed)))
            return
        nxt=order[len(placed)-1]
        for pi in range(len(P[nxt])):
            b,p=cells_of(nxt,pi,(0,0))
            p=sorted(p)
            # anchor: one plug on an existing plug cell (empty of plug? or match) or on socket
            anchors=[]
            for pc in p:
                for cell,v in occ_plug.items():
                    if v<2: anchors.append((pc,cell))
                if sock_cell is not None: anchors.append((pc,sock_cell))
            seen=set()
            for pc,cell in anchors:
                t=(cell[0]-pc[0], cell[1]-pc[1])
                if t in seen: continue
                seen.add(t)
                b2,p2=cells_of(nxt,pi,t)
                # validate
                ok=True; newm=0; newsock=0
                plugcells={}
                for q in p2:
                    if q in sock_cell_set and q not in occ_plug:
                        newsock+=1
                    elif q in occ_plug:
                        if occ_plug[q]>=2: ok=False; break
                        # must be a different piece's plug -> match
                        newm+=1
                    plugcells[q]=plugcells.get(q,0)+1
                if not ok: continue
                if any(v>1 for v in plugcells.values()): continue
                # two plugs of same piece on same existing plug cell? handled by plugcells
                # also two of this piece's plugs could both land on same occ cell -> would create 3? check
                for q in p2:
                    if q in occ_plug and occ_plug[q]==1:
                        # count how many of this piece's plugs land there
                        if sum(1 for x in p2 if x==q)>1: ok=False
                if not ok: continue
                op2=dict(occ_plug)
                for q in p2: op2[q]=op2.get(q,0)+1
                # check no cell now has >2 plugs
                if any(v>2 for v in op2.values()): continue
                sc2=sock_cell_set
                run(dict(placed,**{nxt:(pi,t)}), op2, None, sc2, matches+newm, sock_used+newsock)
    sock0=sorted(Aw)[0]
    sock_cell_set=frozenset([sock0])
    occ0={}
    for q in sorted(Ap): occ0[q]=1
    run({'A':(0,(0,0))}, occ0, None, sock0, 0, 0)
    best.sort(key=lambda x:(-x[0],-x[1]))
    return best
