def fullmatch2(P, aidx=0, wcap=2):
    from collections import deque
    sols=[]
    for bp in range(len(P['B'])):
     for cp in range(len(P['C'])):
      for dp in range(len(P['D'])):
        pl={'A':sorted(P['A'][aidx][1]),'B':sorted(P['B'][bp][1]),'C':sorted(P['C'][cp][1]),'D':sorted(P['D'][dp][1])}
        sock=sorted(P['A'][aidx][2])[0] if len(P['A'][aidx])>2 else None
        ids=[(nm,i) for nm in 'ABCD' for i in range(len(pl[nm]))]
        slots=[('S',k) for k in range(wcap)]
        allpts=ids+slots
        def gen(rem):
            if not rem: yield []
            else:
                a=rem[0]
                for j in range(1,len(rem)):
                    b=rem[j]; r2=[rem[k] for k in range(len(rem)) if k not in (0,j)]
                    for tail in gen(r2): yield [(a,b)]+tail
        for m in gen(allpts):
            pairs=[]
            ok=True
            for x,y in m:
                if x[0]=='S' and y[0]=='S': ok=False; break
                pairs.append((x,y) if x[0]!='S' else (y,x))
            if not ok: continue
            if any(x[0]==y[0] for x,y in pairs): continue
            adj={nm:[] for nm in 'ABCD'}
            for (x,xi),(y,yi) in pairs:
                if y[0]=='S':
                    # plug x must land on A's socket cell (abs) : off_A + sock = off_x + pl_x[xi]
                    d=(sock[0]-pl[x][xi][0], sock[1]-pl[x][xi][1])   # off_A - off_x
                    adj[x].append(('A',(-d[0],-d[1]))); adj['A'].append((x,(d[0],d[1])))
                else:
                    d=(pl[x][xi][0]-pl[y][yi][0], pl[x][xi][1]-pl[y][yi][1])
                    adj[x].append((y,d)); adj[y].append((x,(-d[0],-d[1])))
            off={}; ok=True
            for st in 'ABCD':
                if st in off: continue
                off[st]=(0,0); q=deque([st])
                while q and ok:
                    u=q.popleft()
                    for v,d in adj[u]:
                        nd=(off[u][0]+d[0],off[u][1]+d[1])
                        if v not in off: off[v]=nd; q.append(v)
                        elif off[v]!=nd: ok=False; break
                if not ok: break
            if not ok: continue
            sols.append((bp,cp,dp,m,dict(off)))
    return sols
