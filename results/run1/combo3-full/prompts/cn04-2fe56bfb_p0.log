    three=[ (q,v) for q,v in allp.items() if len(v)>2]
    sockplug = sock and any(q in sock for q,v in allp.items())
    return dict(matches=len(matches),conn=conn,free=len(free),three=len(three),sockplug=bool(sockplug),edges=sorted(tuple(sorted(e)) for e in graph))
