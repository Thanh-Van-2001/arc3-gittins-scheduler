        b,p,w=P[nm][pi]
        cells[nm]=set((r+t[0],c+t[1]) for r,c in b)
        plugs[nm]=set((r+t[0],c+t[1]) for r,c in p)
        if w: sock=set((r+t[0],c+t[1]) for r,c in w)
    allp={}
    for nm in sol:
        for q in plugs[nm]: allp.setdefault(q,[]).append(nm)
    matches={q:v for q,v in allp.items() if len(v)==2}
    graph=set()
    for q,v in matches.items(): graph.add(frozenset(v))
    # connectivity
    import collections
    adj=collections.defaultdict(set)
    for e in graph: a,b=tuple(e); adj[a].add(b); adj[b].add(a)
    seen={'A'}; q=collections.deque(['A'])
    while q:
        u=q.popleft()
        for v in adj[u]:
            if v not in seen: seen.add(v); q.append(v)
