def lvl5(fr):
    g=build(fr)
    floor=0; objs={}
    for n in fr.segmentation['nodes']:
        col=n['color']
        if col=='B':
            m=0
            for (r,c) in [(r,c) for r in range(64) for c in range(64)]:
                pass
    # simpler: build masks from ascii grid
    for r in range(64):
        for c in range(64):
            ch=g[r][c]; b=1<<(r*64+c)
            if ch=='B': floor|=b
    objs=[]
    for n in fr.segmentation['nodes']:
        if n['color']=='B' or n['color'] in 'MP' and n['pixels']>100: continue
        if n['color'] in 'S': continue
        m=0; cells=[]
        bl=n['boundary']
        r0=min(p[0] for p in bl); r1=max(p[0] for p in bl); c0=min(p[1] for p in bl); c1=max(p[1] for p in bl)
        for r in range(r0,r1+1):
            for c in range(c0,c1+1):
                if g[r][c]==n['color']: m|=1<<(r*64+c); cells.append((r,c))
        objs.append((n['color'],(r0,c0),m,len(cells)))
    return floor,objs
def cells4m(p):
    m=0
    for dr in range(4):
        for dc in range(4): m|=1<<((p[0]+dr)*64+p[1]+dc)
    return m
fl,ob=lvl5(current_frame)
print('floor',bin(fl).count('1'))
for o in ob: print(o[0],o[1],o[3])
