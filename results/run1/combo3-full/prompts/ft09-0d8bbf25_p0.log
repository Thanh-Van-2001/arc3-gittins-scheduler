def solve6():
    cells,keys,req=parse6()
    tgt={p:req[p] for p in cells}
    # chains: consecutive vertical runs
    cols={}
    for (r,c) in cells: cols.setdefault(c,[]).append(r)
    chains=[]
    for c,rs in cols.items():
        rs=sorted(rs); run=[rs[0]]
        for r in rs[1:]:
            if r==run[-1]+1: run.append(r)
            else: chains.append([(x,c) for x in run]); run=[r]
        chains.append([(x,c) for x in run])
    clicks=set()
    for ch in chains:
        prev=0  # click of the child (below)
        for p in reversed(ch):
            need = 1 if cells[p]!=tgt[p] else 0
            cl = need ^ prev
            if cl: clicks.add(p)
            prev = cl
    # simulate
    sim=dict(cells)
    def above(p):
        q=(p[0]-1,p[1])
        return q if q in cells else None
    for p in sorted(clicks):
        for q in [p]+([above(p)] if above(p) else []):
            sim[q]='N' if sim[q]=='Y' else 'Y'
    ok = all(sim[p]==tgt[p] for p in cells)
    return sorted(clicks), ok, len(chains)
clicks, ok, nch = solve6()
print('chains',nch,'clicks',len(clicks),'sim solves?',ok)
print(clicks)
acts=[{'action':'MOUSE','row':6+8*p[0]+3,'col':4+8*p[1]+3} for p in clicks]
res=action(acts)
print({k:res.get(k) for k in ['executed','level_completed','game_over','stop_reason']})
