def images(S, hb, vb):
    return set(S) | {(2*hb-r,c) for r,c in S} | {(r,2*vb-c) for r,c in S} | {(2*hb-r,2*vb-c) for r,c in S}
def solve(hb, vb):
    res={}
    for name,(O,o) in {'A':(A,oA),'B':(B,oB)}.items():
        lst=[]
        for dR in range(-20,21):
            for dC in range(-25,26):
                S = {(r+dR,c+dC) for r,c in O}
                I = images(S,hb,vb)
                cov = frozenset(I & YB)
                if not cov: continue
                lst.append((abs(dR)+abs(dC), dR, dC, cov))
        res[name]=lst
    best=[None,10**9]
    la, lb = res['A'], res['B']
    la.sort(); lb.sort()
    for ca,dRa,dCa,sa in la:
        if ca >= best[1]: break
        need = YB - sa
        if not need:
            if ca < best[1]: best[1]=ca; best[0]=((dRa,dCa),(0,0))
            continue
        for cb,dRb,dCb,sb in lb:
            if ca+cb >= best[1]: break
            if need <= sb:
                best[1]=ca+cb; best[0]=((dRa,dCa),(dRb,dCb)); break
    return best, len(la), len(lb)
