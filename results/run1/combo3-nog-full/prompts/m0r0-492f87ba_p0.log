W=set()
for i in range(15):
    for j in range(15):
        if i in (1,13) or j in (1,13): W.add((i,j))
for i in list(range(2,7))+list(range(8,13)): W.add((i,7))
for j in (2,6,7,8,12): W.add((7,j))
FLOOR={(i,j) for i in range(2,13) for j in range(2,13)}-W
ND={(7,3),(7,4),(7,5)}; OD={(7,9),(7,10),(7,11)}
OP={(3,4)}; NP={(3,10),(10,4)}
def passable(c,L,R):
    if c in ND: return any(p in NP for p in (L,R))
    if c in OD: return any(p in OP for p in (L,R))
    return c in FLOOR
MIR={'LEFT':'RIGHT','RIGHT':'LEFT','UP':'UP','DOWN':'DOWN'}
D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
def step(st,act):
    L,R,dot,sel=st
    if act=='SEL_PAIR': return (L,R,dot,'P') if True else st
    if act=='SEL_DOT': return (L,R,dot,'D')
    if sel=='D':
        t=(dot[0]+D[act][0],dot[1]+D[act][1])
        if t in W or t in OP|NP or t==L or t==R: return st
        if not passable(t,L,R): return st
        return (L,R,t,sel)
    dl=D[act]; dr=D[MIR[act]]
    tL=(L[0]+dl[0],L[1]+dl[1]); tR=(R[0]+dr[0],R[1]+dr[1])
