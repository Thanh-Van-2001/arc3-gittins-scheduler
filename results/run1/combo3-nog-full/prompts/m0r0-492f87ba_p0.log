def cmap(f):
    a=f.ascii.split('\n'); out=[]
    for i in range(15):
        line=''
        for j in range(15):
            cnt={}
            for r in range(4*i+2,4*i+6):
                for c in range(4*j+2,4*j+6):
                    ch=a[r][c]; cnt[ch]=cnt.get(ch,0)+1
            if len(cnt)==1: line+='.' if 'B' in cnt else list(cnt)[0].lower()
            else:
                nb=sum(v for k,v in cnt.items() if k!='B')
                if cnt.get('R',0)>=6 and nb>=6: line+='#'
                elif nb>=4: line+=max((k for k in cnt if k!='B'),key=lambda k:cnt[k]).lower()
                else: line+='.'
        out.append(line)
    return out
