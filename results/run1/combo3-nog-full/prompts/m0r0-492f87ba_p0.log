from collections import deque
def bfs6(start,goals,maxn=500000):
    acts=['UP','DOWN','LEFT','RIGHT','SEL_PAIR','SEL_DOT']
    seen={start:None}; q=deque([start]); found={}
    while q and len(seen)<maxn:
        s=q.popleft()
        for a in acts:
            n=step6(s,a)
            if n==s or n in seen: continue
            seen[n]=(s,a)
            for g,f in goals.items():
                if g not in found and f(n): found[g]=n
            q.append(n)
    def plan_to(t):
        p=[]; x=t
        while seen[x] is not None:
            pp,a=seen[x]; p.append(a); x=pp
        return p[::-1]
    return seen,found,plan_to
