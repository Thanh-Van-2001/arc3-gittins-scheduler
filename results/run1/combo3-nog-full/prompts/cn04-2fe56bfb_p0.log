def objcells(sh,F):
    return {'body':set((F[0]+a,F[1]+b) for a,b in sh['body']),'bud':set((F[0]+a,F[1]+b) for a,b in sh['bud']),'tips':set((F[0]+a,F[1]+b) for a,b in sh['tips'])}
def obst_for(key,state,vines,pieces):
    obs=set()
    for k,(ri,F) in state.items():
        if k==key: continue
        sh=(pieces[k] if k in pieces else vines[k])[ri]
        d=objcells(sh,F)
        obs|=d['body']|d['bud']|d['tips']
    return obs
def plan_move(key,rot_t,F_t,state,vines,pieces,allow=()):
    sh=(pieces[key] if key in pieces else vines[key])[rot_t]
    obs=obst_for(key,state,vines,pieces)
    for p in allow: obs.discard(p)
    # also exclude current own cells
    curri,curF=state[key]
    shc=(pieces[key] if key in pieces else vines[key])[curri]
    own=objcells(shc,curF)
    obs-=(own['body']|own['bud']|own['tips'])
    path=bfs6({'x':{}} if False else None,None,None,None,None) if False else None
    # manual BFS with row<=18
    from collections import deque
    def ok(F):
        d=objcells(sh,F)
        for p in d['body']|d['bud']|d['tips']:
            if p[0]<0 or p[0]>18 or p[1]<0 or p[1]>20: return False
            if p in obs: return False
        return True
    if curF==F_t: path=[]
    else:
        q=deque([(curF,[])]); seen={curF}; path=None
        while q:
            F,pth=q.popleft()
            if len(pth)>=40: continue
            for dr,dc,mv in ((-1,0,'UP'),(1,0,'DOWN'),(0,-1,'LEFT'),(0,1,'RIGHT')):
                G=(F[0]+dr,F[1]+dc)
                if G in seen: continue
                if not ok(G): continue
                np_=pth+[mv]
                if G==F_t: path=np_; q.clear(); break
                seen.add(G); q.append((G,np_))
        if path is None: return None
    d=objcells(shc,curF)
    click=max(d['body']) if d['body'] else max(d['tips'])
    seq=[{'action':'MOUSE','row':3*click[0]+2,'col':3*click[1]+2}]+['SPACE']*((rot_t-curri)%4)+path
    return seq,len(path),(rot_t-curri)%4
