def enum_pair(maxsol=3000,cap=2500000):
    vines,pieces=shapes6()
    def cells(sh,F):
        return (set((F[0]+r,F[1]+c) for r,c in sh['body']),set((F[0]+r,F[1]+c) for r,c in sh['bud']),set((F[0]+r,F[1]+c) for r,c in sh['tips']))
    keys=['C','E','A','B','D']
    placed={'C':(cells(vines['C'][0],(0,0)),0)}
    out=[];nodes=[0]
    def valid(B,U,T):
        for p in B|U|T:
            if p[1]<-20 or p[1]>20 or p[0]<-14 or p[0]>20: return False
        for k,(ct,ri) in placed.items():
            PB,PU,PT=ct
            if (B&(PB|PU|PT)) or (U&(PB|PU)) or (T&PB) or (T&PU): return False
        return True
    def full_ok():
        tips=defaultdict(list); buds=defaultdict(list)
        for k,(ct,ri) in placed.items():
            for p in ct[2]: tips[p].append(k)
            for p in ct[1]: buds[p].append(k)
        for p,ks in tips.items():
            if len(ks)>=2: continue
            if p in buds: continue
            return False
        return True
    def rec(rem,choices):
        if len(out)>=maxsol or nodes[0]>cap: return
        if not rem:
            if full_ok(): out.append(list(choices))
            return
        free=set()
        for k,(ct,ri) in placed.items(): free|=ct[2]
        for j in rem:
            opts=pieces[j] if j in pieces else vines[j]
            for ri,sh in enumerate(opts):
                seen=set()
                for t in sh['tips']:
                    for f in free:
                        F=(f[0]-t[0],f[1]-t[1])
                        if F in seen: continue
                        seen.add(F)
                        B,U,T=cells(sh,F)
                        if not valid(B,U,T): continue
                        placed[j]=((B,U,T),ri); nodes[0]+=1
                        rec([x for x in rem if x!=j],choices+[(j,ri,F)])
                        del placed[j]
                        if len(out)>=maxsol or nodes[0]>cap: return
            if len(out)>=maxsol or nodes[0]>cap: return
    rec(['E','A','B','D'],[])
    return out
from collections import defaultdict
sols=enum_pair()
print('pair sols',len(sols))
for s in sols[:3]: print(s)
