def enum7(maxsol=400,cap=800000):
    vines,pieces=shapes6()
    def cells(sh,F):
        return (set((F[0]+r,F[1]+c) for r,c in sh['body']),set((F[0]+r,F[1]+c) for r,c in sh['bud']),set((F[0]+r,F[1]+c) for r,c in sh['tips']))
    placed={'C':(cells(vines['C'][0],(0,0)),0)}
    out=[];nodes=[0]
    def valid(B,U,T):
        for p in B|U|T:
            if p[1]<-20 or p[1]>20 or p[0]<-12 or p[0]>20: return False
        for k,(ct,ri) in placed.items():
            PB,PU,PT=ct
            if (B&(PB|PU|PT)) or (U&(PB|PU)) or (T&PB) or (T&PU): return False
        return True
    def rec(rem,choices):
        if len(out)>=maxsol or nodes[0]>cap: return
        if not rem: out.append(list(choices)); return
        free=set()
        for k,(ct,ri) in placed.items(): free|=ct[2]
        for j in rem:
            opts=pieces[j] if j in pieces else vines[j]
            for ri,sh in enumerate(opts):
                seen=set()
                for t in sh['tips']:
                    for f in free:
                        F=(f[0]-t[0],f[1]-t[1])
                        if F in seen: continue
                        seen.add(F)
                        B,U,T=cells(sh,F)
                        if not valid(B,U,T): continue
                        placed[j]=((B,U,T),ri); nodes[0]+=1
                        rec([x for x in rem if x!=j],choices+[(j,ri,F)])
                        del placed[j]
                        if len(out)>=maxsol or nodes[0]>cap: return
            if len(out)>=maxsol or nodes[0]>cap: return
    rec(['E','A','B','D'],[])
    return out
CUR={'C':(0,(14,5)),'E':(0,(14,9)),'A':(1,(1,1)),'B':(0,(1,15)),'D':(0,(13,1))}
def score(sol):
    layout={k:(r,F) for k,r,F in sol}
    layout['C']=(0,(0,0))
    rows=[F[0]+mn for k,(r,F) in layout.items() for mn in [min(x for x,y in [p for p in [(a,b) for a in range(0)]])]] if False else None
    # compute bbox of all cells
    allc=[]
    vines,pieces=shapes6()
    for k,(ri,F) in layout.items():
        sh=(pieces[k] if k in pieces else vines[k])[ri]
        for grp in ('body','bud','tips'):
            for (a,b) in sh[grp]: allc.append((F[0]+a,F[1]+b))
    r0=min(p[0] for p in allc); r1=max(p[0] for p in allc); c0=min(p[1] for p in allc); c1=max(p[1] for p in allc)
    best=None
    for dr in range(0,19-r1+1):
        if r0+dr<0: continue
        for dc in range(0,21-c1+1):
            if c0+dc<0: continue
            cost=0
            for k,(ri,F) in layout.items():
                ta=(F[0]+dr,F[1]+dc); cr,cf=CUR[k]
                cost+=abs(ta[0]-cf[0])+abs(ta[1]-cf[1])
                if k in ('A','B','D'): cost+=(ri-cr)%4
            if best is None or cost<best[0]: best=(cost,(dr,dc))
    return best
