        for k,(PB,PU,PT),_ in [ (k,v[0],v[1]) for k,v in placed.items()]:
            if (B&(PB|PU|PT)) or (U&(PB|PU)) or (T&PB) or (T&PU): return False
        return True
    def rec(rem,choices):
        if out or nodes[0]>cap: return
        if not rem:
            out.append(list(choices)); return
        free=set()
        for k,(PB,PU,PT),_ in placed.items(): free|=PT
        for j in rem:
            for ri,sh in enumerate(pieces[j] if j in pieces else vines[j]):
                for t in sh['tips']:
