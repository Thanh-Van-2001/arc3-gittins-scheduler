                        placed[j]=((B,U,T),ri); nodes[0]+=1
                        rec([x for x in rem if x!=j],choices+[(j,ri,F)])
                        if out: return
                        del placed[j]
            if out: return
    rec(['E','A','B','D'],[])
    return out
