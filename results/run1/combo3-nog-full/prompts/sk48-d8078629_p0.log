RAIL_TOP=2; RAIL_BOT=29
def locked(p):
    r,c=p; return c==30 and r<=RAIL_BOT-2+1   # block rows r..r+3 overlap rail rows 2..29 -> r+3>=2 and r<=29
def locked2(p):
    r,c=p; return c==30 and r<=RAIL_BOT and r+3>=RAIL_TOP
def step8(st,act):
    H,T,bl=st; bl=dict(bl)
    if act=='LEFT' or act=='RIGHT':
        if act=='LEFT':
            if T<=TMIN: return st,True
            nt=T-6; d=-6
        else:
            if T>=TMAX: return st,True
            nt=T+6; d=6
        band=H+2
        inb=sorted([c for c,p in bl.items() if p[0]==band], key=lambda c: bl[c][1])
        seeds=[c for c in inb if bl[c][1]<=T and not locked2(bl[c])]
        if not seeds: return (H,nt,bl),False
        # group into chains by contiguity (6 apart) in push direction
        pos={c:bl[c][1] for c in inb}; moved={}
        ok=True
        for c0 in seeds:
            if c0 in moved: continue
            # build chain: starting at c0, extend in direction d while next cell occupied
            chain=[c0]; cur=pos[c0]
            while True:
                nxt=cur+d
                occ=[x for x in inb if pos[x]==nxt and x not in chain]
                if not occ: break
                chain.append(occ[0]); cur=nxt
            # all chain members move by d*k? no: each moves by d (they shift as a block)
            for k,ch in enumerate(chain):
                np_=pos[ch]+d
                if np_<12 or np_>48: ok=False; break
                moved[ch]=np_
            if not ok: break
        if not ok: return (H,nt,bl),False
        for c,nc in moved.items(): bl[c]=(bl[c][0],nc)
        return (H,nt,bl),False
    # vertical
    if act=='UP':
        if H<=HSL[0]: return st,True
        nH=H-6; bands={H+2,H-4}; d=-6
    else:
        if H>=HSL[-1]: return st,True
        nH=H+6; bands={H+2,H+8}; d=6
    movers=[c for c,p in bl.items() if p[0] in bands and p[1]<=T]
    if not movers: return (nH,T,bl),False
    mp={c:(bl[c][0]+d,bl[c][1]) for c in movers}
    for c,p in mp.items():
