import collections
def bfs_opt2(start,goalfn,nmax=300000,dcap=30):
    k0=key2(start); par={k0:None}; q=collections.deque([(start,0)]); n=0; maxd=0
    while q:
        st,d=q.popleft(); n+=1
        if goalfn(st):
            path=[];k=key2(st)
            while par[k] is not None:
                a,pk=par[k]; path.append(a); k=pk
            return list(reversed(path)),n,d
        if d>=dcap: continue
        for a in ('UP','DOWN','LEFT','RIGHT'):
            ns,no=step7(st,a)
            if no: continue
            nk=key2(ns)
            if nk in par: continue
            par[nk]=(a,key2(st)); q.append((ns,d+1)); maxd=d+1
            if n>nmax: return None,n,maxd
    return None,n,maxd
