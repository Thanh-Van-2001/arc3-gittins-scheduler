        for p in s: cm[p]=k
    if d<0:
        if abs(tip-cap)<=2: return st,False
        step=1 if sg<0 else -1
        if ax=='V':
            vac={(tip+step*k,c) for k in range(3) for c in range(band,band+3)}; dv=(-3*sg,0)
        else:
            vac={(r,tip+step*k) for k in range(3) for r in range(band,band+3)}; dv=(0,-3*sg)
        seed={cm[n] for p in vac for n in nbrs(p) if n in cm}-{col}
    else:
        strip={(tip+k*sg,band+j) if ax=='V' else (band+j,tip+k*sg) for k in range(1,4) for j in range(3)}
        if not all(p not in P for p in strip): return st,False
        seed={cm[p] for p in strip if p in cm}-{col}
        dv=(3*sg,0) if ax=='V' else (0,3*sg)
