CROSS=[(0,1),(1,1),(2,1),(1,0),(1,2)]
def st(fr):
    a=grid_of(fr); Y=cellset(a,'Y')
    anchors=[(i,j) for i in range(17) for j in range(17) if all((i+dr,j+dc) in Y for dr,dc in CROSS)]
    out=[];used=set()
    for an in anchors:
        cs=set((an[0]+dr,an[1]+dc) for dr,dc in CROSS)
        if cs<=used: continue
        out.append(an); used|=cs
    N=cellset(a,'N'); pl=sorted(N)[0] if N else None
    return out,pl
def path(fr,target):
    anch,pl=st(fr)
    blocked=set()
    for an in anch: blocked|=set((an[0]+dr,an[1]+dc) for dr,dc in CROSS)
    W=walkable(fr)-blocked
    import collections
    D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    q=collections.deque([pl]); prev={pl:None}
    while q:
        x=q.popleft()
        if x==target: break
        for nm,(di,dj) in D.items():
            y=(x[0]+di,x[1]+dj)
            if y in W and y not in prev: prev[y]=x;q.append(y)
    if target not in prev: return None
    p=[];cur=target
    while cur!=pl: p.append(cur);cur=prev[cur]
    p.reverse(); inv={v:k for k,v in D.items()}
    return [inv[(c[0]-q_[0],c[1]-q_[1])] for q_,c in zip([pl]+p[:-1],p)]
