def locs(a):
    out={}
    N=[(r,c) for r in range(64) for c in range(64) if a[r][c]=='N']
    # cluster
    clusters=[]
    for p in N:
        for cl in clusters:
            if any(abs(p[0]-q[0])+abs(p[1]-q[1])<=2 for q in cl): cl.append(p); break
        else: clusters.append([p])
    merged=[]
    for cl in clusters:
        for other in merged:
            if any(abs(p[0]-q[0])+abs(p[1]-q[1])<=2 for p in cl for q in other): other.extend(cl); break
        else: merged.append(cl)
    for k,cl in enumerate(merged):
        r0=min(p[0] for p in cl); c0=min(p[1] for p in cl)
        dot=[ (r,c) for r in range(r0,r0+4) for c in range(c0,c0+4) if a[r][c] in 'WB']
