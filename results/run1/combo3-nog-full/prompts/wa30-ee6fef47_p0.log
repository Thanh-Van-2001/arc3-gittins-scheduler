def carry(f):
    hd = None; bx = None
    for n in f.segmentation['nodes']:
        if n['color'] == 'N': hd = tuple(p//4 for p in n['boundary'][0])
        if n['color'] in ('W','B') and n['pixels'] == 16: bx = tuple(p//4 for p in n['boundary'][0])
    return hd, bx
ev = []
for i, t in enumerate(transitions):
    h0, b0 = carry(t.before_frame)
    h1, b1 = carry(t.after_frame)
    if h0 and b0 and h1 and b1:
        off0 = (b0[0]-h0[0], b0[1]-h0[1])
        off1 = (b1[0]-h1[0], b1[1]-h1[1])
        mv = (h1[0]-h0[0], h1[1]-h0[1])
        ev.append((i, t.action, off0, mv, off1, b0 != b1))
# show cases where the move is opposite the offset (reversal) or perpendicular
from collections import Counter
c = Counter()
for i, a, off, mv, off1, bm in ev:
    key = ('opp' if mv == (-off[0], -off[1]) else 'same' if mv == off else 'perp' if mv != (0,0) else 'stay', off == off1)
    c[key] += 1
print(c)
for e in ev:
    i, a, off, mv, off1, bm = e
