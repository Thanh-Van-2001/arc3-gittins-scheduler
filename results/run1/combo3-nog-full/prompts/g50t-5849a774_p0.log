import collections
a=current_frame.ascii.split('\n')
G=[[a[r][c] for c in range(64)] for r in range(64)]
start=(52,10); goal=(10,28)
def walk(r,c): return G[r][c] in 'Wb'
q=collections.deque([start]); seen={start:0}
while q:
    r,c=q.popleft()
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<64 and 0<=nc<64 and (nr,nc) not in seen and walk(nr,nc):
            seen[(nr,nc)]=seen[(r,c)]+1; q.append((nr,nc))
print('reachable white px', len(seen))
print('goal reachable?', goal in seen, seen.get(goal))
# what colors are adjacent to reachable set (frontier)?
from collections import Counter
fr=Counter()
for (r,c) in seen:
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<64 and 0<=nc<64 and (nr,nc) not in seen: fr[G[nr][nc]]+=1
print('frontier colors',fr.most_common())
# bounding boxes of reachable per row-band to understand shape
rows=sorted(set(r for r,c in seen)); cols=sorted(set(c for r,c in seen))
print('rows',min(rows),max(rows),'cols',min(cols),max(cols))
