first=lv5frames[0]; last=lv5frames[-1]
def dots(f):
    return sorted((n['boundary'][0][0],n['boundary'][0][1]) for n in f.segmentation['nodes'] if n['color']=='Y' and n['pixels']==1)
def t4(f):
    out={}
    for n in f.segmentation['nodes']:
        b=n['boundary']; rs=[p[0] for p in b]; cs=[p[1] for p in b]
        if max(rs)-min(rs)==1 and max(cs)-min(cs)==1 and n['pixels']==4 and min(rs)>=3:
            out[(min(rs),min(cs))]=n['color']
    return out
