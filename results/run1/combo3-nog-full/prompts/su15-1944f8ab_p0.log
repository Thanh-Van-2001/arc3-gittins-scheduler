def ch(x):
    x=abs(x); return 0 if x==0 else (x+4)//5
def cst(P,Q):
    dr=Q[0]-P[0]; dc=Q[1]-P[1]
    if (dr+dc)%2: return 99
    return ch((dr+dc)//2)+ch((dr-dc)//2)
def best_target(P,X,R=5):
    best=None
    for i in range(-R,R+1):
        for j in range(-R,R+1):
            t=(X[0]+i,X[1]+j)
            if 0<=t[0]<61 and 0<=t[1]<62 and ((t[0]+t[1])^(P[0]+P[1]))&1==0:
                c=cst(P,t)
                if best is None or c<best[0]: best=(c,t)
    return best
def path(P,T):
    # build clicks: decompose into u,v chunks of <=5, each click = intermediate anchor
    dr=T[0]-P[0]; dc=T[1]-P[1]
    u=(dr+dc)//2; v=(dr-dc)//2
    clicks=[]; cur=P
    while u!=0 or v!=0:
        du=max(-5,min(5,u)); dv=max(-5,min(5,v))
        nxt=(cur[0]+(du+dv)//2, cur[1]+(du-dv)//2)
        clicks.append(nxt); u-=du; v-=dv; cur=nxt
    return clicks
