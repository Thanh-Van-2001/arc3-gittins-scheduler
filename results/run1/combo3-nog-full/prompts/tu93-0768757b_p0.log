    for n,m in E[k]: INV[(k,n)]=m
R1=(13,9); R1F=(13,11); R2=(15,9); R2F=(13,9)
AP=[(5,9),(5,7),(5,5),(5,3),(5,5),(5,7),(5,9),(5,11)]; BP=[(5,15),(5,13),(5,15),(5,17)]; CP=[(7,15),(9,15),(11,15),(9,15),(7,15),(5,15),(3,15),(5,15)]
def ora(t): return frozenset([AP[t%8],BP[t%4],CP[t%8]])
def dmap(p,blocked):
    d={p:0}; q=deque([p])
    while q:
        u=q.popleft()
        for v in ADJ[u]:
            if v in d or v in blocked: continue
            d[v]=d[u]+1; q.append(v)
    return d
ORD=['UP','DOWN','LEFT','RIGHT']
def retarget(c,f,p,r1,r2):
    blocked=({R1} if r1 else set())|({R2} if r2 else set())
    dd=dmap(p,blocked)
    opts=[x for x in ADJ[c] if x in dd and x not in blocked]
    if not opts: return f
    m=min(dd[x] for x in opts); best=[x for x in opts if dd[x]==m]
    if any(INV[(c,x)]==f for x in best): return f
    for o in ORD:
        if any(INV[(c,x)]==o for x in best): return o
    return f
