from collections import deque
grid,faces,off=parse(current_frame)
E=edges(grid); ADJ={k:[n for n,_ in E[k]] for k in E}
INV={}
for k in E:
    for n,m in E[k]: INV[(k,n)]=m
GOAL=(13,11); R1=(13,9); R1F=(13,11); R2=(15,9); R2F=(13,9)
AP=[(5,9),(5,7),(5,5),(5,3),(5,5),(5,7),(5,9),(5,11)]; BP=[(5,15),(5,13),(5,15),(5,17)]; CP=[(7,15),(9,15),(11,15),(9,15),(7,15),(5,15),(3,15),(5,15)]
def ora(t): return frozenset([AP[t%8],BP[t%4],CP[t%8]])
def dmap(p,blocked):
    d={p:0}; q=deque([p])
    while q:
        u=q.popleft()
        for v in ADJ[u]:
            if v in d or v in blocked: continue
            d[v]=d[u]+1; q.append(v)
    return d
ORD=['UP','DOWN','LEFT','RIGHT']
def retarget(c,f,p,r1,r2):
    blocked=({R1} if r1 else set())|({R2} if r2 else set())
    dd=dmap(p,blocked)
    opts=[x for x in ADJ[c] if x in dd and x not in blocked]
    if not opts: return f
    m=min(dd[x] for x in opts); best=[x for x in opts if dd[x]==m]
    if any(INV[(c,x)]==f for x in best): return f
    for o in ORD:
        if any(INV[(c,x)]==o for x in best): return o
    return f
def solve(mode):
    def expand(st,mv):
        p,c,f,r1,r2,t=st
        n=None
        for q,m in E[p]:
            if m==mv: n=q
        if n is None: return None
        if (r1 and n==R1F) or (r2 and n==R2F): return None
        nr1=0 if n==R1 else r1; nr2=0 if n==R2 else r2
        t2=(t+1)%8
        if n in ora(t2): return None
        if c==n: return None
        c2,f2=c,f
        nxt=[q2 for q2,m2 in E[c] if m2==f]
        if nxt: c2=nxt[0]
        elif mode=='move':
            f2=retarget(c,f,n,nr1,nr2); m2=[q2 for q2,mm in E[c] if mm==f2]
            if m2: c2=m2[0]
        else: f2=retarget(c,f,n,nr1,nr2)
        if c2==n: return None
        f2=retarget(c2,f2,n,nr1,nr2)
        return (n,c2,f2,nr1,nr2,t2)
    st0=((3,11),(5,9),'UP',1,1,20%8)
    q=deque([st0]); seen={st0:None}; found=None
    while q:
        st=q.popleft()
        if st[0]==GOAL and st[3]==0: found=st; break
        for mv in ORD:
            s2=expand(st,mv)
            if s2 is None or s2 in seen: continue
            seen[s2]=(st,mv); q.append(s2)
    if not found: return None,len(seen)
    seq=[]; cur=found
    while seen[cur] is not None:
        par,mv=seen[cur]; seq.append(mv); cur=par
    seq.reverse()
    return seq,len(seen)
for mode in ('move','stay'):
