from collections import deque
grid,faces,off=parse(current_frame)
E=edges(grid); ADJ={k:[n for n,_ in E[k]] for k in E}
INV={}
for k in E:
    for n,m in E[k]: INV[(k,n)]=m
GOAL=(13,11); R1=(13,9); R1F=(13,11); R2=(15,9); R2F=(13,9); C0=(7,9); SIGHT={(9,9),(11,9)}
AP=[(5,9),(5,7),(5,5),(5,3),(5,5),(5,7),(5,9),(5,11)]; BP=[(5,15),(5,13),(5,15),(5,17)]; CP=[(7,15),(9,15),(11,15),(9,15),(7,15),(5,15),(3,15),(5,15)]
def ora(t): return frozenset([AP[t%8],BP[t%4],CP[t%8]])
def dmap(p,blocked):
    d={p:0}; q=deque([p])
    while q:
        u=q.popleft()
        for v in ADJ[u]:
            if v in d or v in blocked: continue
            d[v]=d[u]+1; q.append(v)
    return d
ORD=['UP','DOWN','LEFT','RIGHT']
def retarget(c,f,p,r1,r2):
    blocked=({R1} if r1 else set())|({R2} if r2 else set())
    dd=dmap(p,blocked)
    opts=[x for x in ADJ[c] if x in dd and x not in blocked]
    if not opts: return f
    m=min(dd[x] for x in opts); best=[x for x in opts if dd[x]==m]
    if any(INV[(c,x)]==f for x in best): return f
    for o in ORD:
        if any(INV[(c,x)]==o for x in best): return o
    return f
route=['LEFT','LEFT','UP','UP','RIGHT','DOWN','DOWN','LEFT','UP','UP','RIGHT','UP','UP','RIGHT','RIGHT','RIGHT','DOWN','DOWN','RIGHT','DOWN','LEFT','DOWN','LEFT','DOWN','DOWN','LEFT','LEFT','UP','RIGHT']
p=(11,11); c=C0; f='DOWN'; a=0; r1=1; r2=1
for i,mv in enumerate(route,1):
    n=[q for q,m in E[p] if m==mv][0]
    bad=[]
    if (r1 and n==R1F) or (r2 and n==R2F): bad.append('REDFRONT')
    if n in ora(i): bad.append('ORANGE%s'%str(sorted(ora(i))))
    if c==n: bad.append('ontop-chaser')
    na=1 if (a or n in SIGHT) else 0
    c2,f2=c,f
    if a:
        nxt=[q for q,m in E[c] if m==f]
        inv = not nxt
        if nxt: c2=nxt[0]
        else:
            f2=retarget(c,f,n,r1,r2); m2=[q for q,m in E[c] if m==f2]
            if m2: c2=m2[0]
        if c2==n: bad.append('CAUGHT')
        f2=retarget(c2,f2,n,r1,r2)
    print('t%-2d %-5s p%-8s r%-8s mk%-6s%s%s'%(i,mv,n,c2,f2,' INV-MK' if (a and not [q for q,m in E[c] if m==f]) else '','  BAD:'+','.join(bad) if bad else ''))
    if bad: break
    p,c,f,a=n,c2,f2,na
    if n==GOAL: print('GOAL'); break
