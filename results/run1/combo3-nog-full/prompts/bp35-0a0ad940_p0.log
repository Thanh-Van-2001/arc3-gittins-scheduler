import itertools
def shift_between(b, a, maxs=40):
    B = b.ascii.split('\n'); A = a.ascii.split('\n')
    def clean(ch): return ch if ch not in 'bY' else '.'
    best=(0,-999)
    for d in range(-maxs, maxs+1):
        m=0; tot=0
        for r in range(0,62):
            r2=r+d
            if r2<0 or r2>62: continue
            rowA=A[r]; rowB=B[r2]
            for c in range(1,62,2):
                x=clean(rowA[c]); y=clean(rowB[c])
                if x=='.' or y=='.': continue
                tot+=1
                if x==y: m+=1
        if tot>200 and m/tot>best[1]: best=(d,m/tot)
    return best

# verify on last transition
print('last shift', shift_between(transitions[-1].before_frame, transitions[-1].after_frame))
print('prev shift', shift_between(transitions[-2].before_frame, transitions[-2].after_frame))
