def sprite_box2(fr):
    a = fr.ascii.split('\n')
    cells = set((rr,cc) for rr in range(64) for cc in range(64) if a[rr][cc]=='b')
    if not cells: return None
    # largest 8-connected cluster of b cells
    best=[]; cells=set(cells)
    while cells:
        s=cells.pop(); cl=[s]; stack=[s]
        while stack:
            r,c=stack.pop()
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    q=(r+dr,c+dc)
                    if q in cells: cells.remove(q); stack.append(q)
            cl.append((r,c))
        if len(cl)>len(best): best=cl
    rs=[p[0] for p in best]; cs=[p[1] for p in best]
    return (min(rs),max(rs),min(cs),max(cs))

box = sprite_box2(current_frame)
print('box', box)
print('crosses', cross_groups(current_frame))
print('target', pick_cross(current_frame, box))
</parameter>
</function>
