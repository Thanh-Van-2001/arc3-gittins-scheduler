def sprite_box(fr):
    a = fr.ascii.split('\n')
    cells = [(rr,cc) for rr in range(64) for cc in range(64) if a[rr][cc] in 'bY']
    if not cells: return None
    rs=[c[0] for c in cells]; cs=[c[1] for c in cells]
    return (min(rs),max(rs),min(cs),max(cs))

def pick_cross(fr, box):
