dots={(30,45),(30,54),(57,45),(57,54),(6,12),(9,9),(9,30),(27,12)}
def ybox(fr):
    a=fr.ascii.split('\n')
    p=[(r,c) for r in range(64) for c in range(64) if a[r][c]=='Y' and (r,c) not in dots]
    if not p: return None
    return (min(x[0] for x in p),max(x[0] for x in p),min(x[1] for x in p),max(x[1] for x in p),len(p))
prev=None
for h in history:
