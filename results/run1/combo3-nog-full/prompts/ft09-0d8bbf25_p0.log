                kind[(i,j)]='tile'; state[(i,j)]= a if a in flat else b
                pos=[(r,c) for r in range(3) for c in range(3) if bl[r][c]=='M']
                ndir[(i,j)]=dirs[pos[0]] if len(pos)==1 and pos[0] in dirs else (-1,0)
            elif 'W' in s or ('g' in s and (a in flat or b in flat)) or ('G' in s and (a in flat or b in flat)):
                kind[(i,j)]='map'; maps[(i,j)]=bl
