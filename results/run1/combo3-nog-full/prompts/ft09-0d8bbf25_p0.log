def analyze(lines, R=7, C=7, r0=4, c0=6, step=8):
    def bb(i,j):
        rows=[lines[r0+step*i+k][c0+step*j:c0+step*j+6] for k in range(6)]
        return [[rows[2*r][2*c] for c in range(3)] for r in range(3)]
    state={};kind={};maps={}
    for i in range(R):
        for j in range(C):
            b=bb(i,j); flat=''.join(''.join(x) for x in b); s=set(flat)
            if s=={'N'}: kind[(i,j)]='tile'; state[(i,j)]='N'
            elif s=={'p'}: kind[(i,j)]='tile'; state[(i,j)]='p'
            elif 'M' in s: kind[(i,j)]='flip'; state[(i,j)]=b[1][1]
            elif 'W' in s: kind[(i,j)]='map'; maps[(i,j)]=b
            else: kind[(i,j)]='empty'
    other={'N':'p','p':'N'}; req={}; conf=[]
    for (mi,mj),b in maps.items():
        cen=b[1][1]
        for r in range(3):
            for c in range(3):
                if (r,c)==(1,1): continue
                g=(mi-1+r,mj-1+c)
                if not(0<=g[0]<R and 0<=g[1]<C): continue
                v=b[r][c]
                if v=='G': continue
                want = cen if v=='W' else (other[cen] if v=='g' else None)
                if want is None: conf.append(('odd',g,v)); continue
                if g in req and req[g]!=want: conf.append(('conf',g,req[g],want))
                req[g]=want
    return state,kind,maps,req,conf
import itertools
def solve(state,kind,req,flippers):
    def plus(f):
        i,j=f; out=[f]+[(i+di,j+dj) for di,dj in ((-1,0),(1,0),(0,-1),(0,1))]
        return [x for x in out if kind.get(x) in ('tile','flip')]
    need={g:(state[g]!=req[g]) for g in req}
    best=None
    for combo in itertools.product([0,1],repeat=len(flippers)):
        fset=[f for f,b in zip(flippers,combo) if b]
        fp={}
        for f in fset:
            for x in plus(f): fp[x]=fp.get(x,0)^1
        cost=sum(combo); sol=[('F',f) for f in fset]
        for g in req:
            if (1 if need[g] else 0)^fp.get(g,0): cost+=1; sol.append(('T',g))
        if best is None or cost<best[0]: best=(cost,sol,combo)
    return best
