def parse_solve(lines, R, C, r0, c0, step=8, colors=('Y','N'), dirs={(0,1):(-1,0),(2,1):(1,0),(1,0):(0,-1),(1,2):(0,1)}):
    def bb(i,j):
        rows=[lines[r0+step*i+k][c0+step*j:c0+step*j+6] for k in range(6)]
        return [[rows[2*r][2*c] for c in range(3)] for r in range(3)]
    a,b=colors
    kind={};state={};maps={};ndir={}
    for i in range(R):
        for j in range(C):
            bl=bb(i,j); flat=''.join(''.join(x) for x in bl); s=set(flat)
            if s=={'c'}: kind[(i,j)]='empty'
            elif 'M' in s:
                kind[(i,j)]='tile'; state[(i,j)]= a if a in flat else b
                pos=[(r,c) for r in range(3) for c in range(3) if bl[r][c]=='M']
                ndir[(i,j)]=dirs[pos[0]] if len(pos)==1 and pos[0] in dirs else (-1,0)
            elif 'W' in s or ('g' in s and (a in flat or b in flat)) or ('G' in s and (a in flat or b in flat)):
                kind[(i,j)]='map'; maps[(i,j)]=bl
            else: kind[(i,j)]='unknown'; print('UNK',i,j,flat)
    other={a:b,b:a}
    req={};conf=[]
    for (mi,mj),bl in maps.items():
        cen=bl[1][1]
        for r in range(3):
            for c in range(3):
                if (r,c)==(1,1): continue
                g=(mi-1+r,mj-1+c)
                if not(0<=g[0]<R and 0<=g[1]<C): continue
                v=bl[r][c]
                if v=='G': continue
                want = cen if v=='W' else other.get(cen)
                if g in req and req[g]!=want: conf.append(('conf',g,req[g],want))
                req[g]=want
    tiles=[k for k in kind if kind[k]=='tile']
    idx={t:i for i,t in enumerate(tiles)}
    def eff(y):
        i,j=y; out=[y]
        if ndir[y]==(0,0): return out
        d=ndir[y]; x=(i+d[0],j+d[1])
        if x in idx: out.append(x)
        return out
    need={g:(state[g]!=req[g]) for g in req}
    mat=[]
    for g in req:
        v=[0]*len(tiles)
        for y in tiles:
            if g in eff(y): v[idx[y]]=1
        mat.append([v,1 if need[g] else 0])
    n=len(tiles); piv={}; r_=0
    for c in range(n):
        sel=None
        for rr in range(r_,len(mat)):
            if mat[rr][0][c]: sel=rr;break
        if sel is None: continue
        mat[r_],mat[sel]=mat[sel],mat[r_]
        for rr in range(len(mat)):
            if rr!=r_ and mat[rr][0][c]:
                mat[rr]=[ [x^y for x,y in zip(mat[rr][0],mat[r_][0])], mat[rr][1]^mat[r_][1]]
        piv[c]=r_; r_+=1
    incons=[m for m in mat if not any(m[0]) and m[1]]
    free=[c for c in range(n) if c not in piv]
    import itertools
    best=None
    for bits in itertools.product([0,1],repeat=len(free)):
        x=[0]*n
        for c,v in zip(free,bits): x[c]=v
        for c,rr in sorted(piv.items(),reverse=True):
            s=mat[rr][1]
            for cc in range(c+1,n): s^= x[cc]*mat[rr][0][cc]
            x[c]=s
        cost=sum(x)
        if best is None or cost<best[0]: best=(cost,tuple(x))
    plan=[tiles[i] for i,v in enumerate(best[1]) if v]
    return dict(kind=kind,state=state,maps=maps,req=req,conf=conf,tiles=tiles,ndir=ndir,
                rank=len(piv),free=len(free),incons=len(incons),cost=best[0],plan=sorted(plan))
