def planL(fr, myd, target, others, blobs, passblob=None, active=-1, step=2, beam=120, depth=8):
    Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
