    if passblob is not None:
        Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
        blocked = blocked - set((passblob[0]+dr,passblob[1]+dc) for dr,dc in Bm)
    act=find_active(fr,diams); ai=[i for i,p in enumerate(diams) if p==act][0]
    cl,info=beam_plan2(a, diams, target, blocked, ai, step=2, beam=80, depth=8)
    if cl is None: return None,info
    clicks=[]; pos=list(diams); a2=ai
    for kind,i,p in cl:
        if kind=='act': clicks.append(pos[i])
        else: clicks.append(p); pos[i]=p
    log=[]
    for c in clicks:
        res=action([{'action':'MOUSE','row':c[0],'col':c[1]}])
        if not res['gameplay_changed']: return log,'NOOP at '+str(c)
        A2=analyze2(current_frame)
        mine_now=[d for d in A2['diamonds'] if d in pos or True]
