def L5b(fr, mine_d, mine_b, others, blobs):
    A=analyze2(fr); a=[list(r) for r in fr.ascii.split('\n')]
    Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    def bl(r,c,F): return set((r+dr,c+dc) for dr,dc in F)
    terr=set((r,c) for r in range(64) for c in range(64) if a[r][c]=='g')
    other=set()
    for od,ob in others:
        other |= bl(*ob,Bm)
        for p in od: other |= bl(*p,D)
    for k in blobs: other |= bl(*k,Bm)
    own = bl(*mine_b,Bm)
    for p in mine_d: own |= bl(*p,D)
    seg=set()
    for p in mine_d:
        st=max(abs(p[0]-mine_b[0]),abs(p[1]-mine_b[1]),1)
        for t in range(st+1):
            r=mine_b[0]+(p[0]-mine_b[0])*t//st; c=mine_b[1]+(p[1]-mine_b[1])*t//st
            for dr in range(-2,3):
                for dc in range(-2,3): seg.add((r+dr,c+dc))
    W=set(A['bands']); seen=set(); ownb=set()
    for w in W:
        if w in seen: continue
        st=[w]; seen.add(w); comp=[]
        while st:
            x,y=st.pop(); comp.append((x,y))
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    nx=(x+dr,y+dc)
                    if nx in W and nx not in seen: seen.add(nx); st.append(nx)
        if any(q in seg for q in comp): ownb.update(comp)
    return a, terr | (other-own) | (W-ownb)
def run_leg2(fr, diams, target, blocked, passblob=None, maxsteps=14):
    from collections import deque
