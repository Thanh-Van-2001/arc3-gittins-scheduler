def white_diams(fr):
    a=[list(r) for r in fr.ascii.split('\n')]
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    out=[]
    for r in range(2,62):
        for c in range(2,62):
            nb=[a[r+dr][c+dc] for dr,dc in D if (dr,dc)!=(0,0)]
            if all(v=='W' for v in nb):
                if a[r-2][c-1] in 'Bg' and a[r-2][c+1] in 'Bg' and a[r+2][c-1] in 'Bg' and a[r+2][c+1] in 'Bg':
                    out.append((r,c))
    return out
def run_leg3(fr, myd, target, blocked, passblob=None, verbose=True):
    from collections import deque
    a=[list(r) for r in fr.ascii.split('\n')]
    if passblob is not None:
        Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
        blocked = blocked - set((passblob[0]+dr,passblob[1]+dc) for dr,dc in Bm)
    wd=white_diams(fr)
    act = myd.index(wd[0]) if wd and wd[0] in myd else -1
    cl,info=beam_plan2(a, myd, target, blocked, max(act,0), step=2, beam=80, depth=8)
    if cl is None: return None,info
    clicks=[]; pos=list(myd); a2=act
    for kind,i,p in cl:
        if kind=='act': clicks.append(('A',pos[i]))
        else: clicks.append(('M',p)); pos[i]=p; a2=i
    if act<0 and clicks and clicks[0][0]=='M':
        pass
    log=[]
    pos=list(myd)
    for kind,c in clicks:
        res=action([{'action':'MOUSE','row':c[0],'col':c[1]}])
        if not res['gameplay_changed']:
            log.append((kind,c,'NOOP')); return log,'NOOP at '+str(c)
        gone=[d for d in pos if d not in real_diams2(current_frame,pos)]
        new=[d for d in real_diams2(current_frame,pos) if d not in pos]
        log.append((kind,c,str(gone)+'->'+str(new)))
        if len(gone)==1 and len(new)==1: pos[pos.index(gone[0])]=new[0]
        elif kind=='A': pass
        else: return log,'track fail '+str(gone)+str(new)
        if res['level_completed'] or res['done']: return log,'WIN'
        if res['game_over']: return log,'DEAD'
    return log,'bead '+str(bead_of(pos))+' want '+str(target)
def real_diams2(fr, myd):
    # my diamonds: those in myd that still exist, plus any new diamond adjacent to my band structure
    A=analyze2(fr); a=A['a']
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    cands=[]
    for r in range(2,62):
        for c in range(2,62):
            nb=[a[r+dr][c+dc] for dr,dc in D if (dr,dc)!=(0,0)]
            if all(v in 'GW' for v in nb) and a[r-2][c-1] in 'Bg': cands.append((r,c))
    return cands
print('white diams now', white_diams(current_frame))
