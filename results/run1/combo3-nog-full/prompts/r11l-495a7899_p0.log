def scan2(fr):
    a=[list(r) for r in fr.ascii.split('\n')]
    Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    blobs=[]; diams=[]
    for r in range(3,61):
        for c in range(3,61):
            f=[a[r+dr][c+dc] for dr,dc in Bm]
            if all(v not in 'Bg' for v in f):
                q={'L':{}, 'R':{}}
                for dr,dc in Bm:
                    side='L' if dc<0 else ('R' if dc>0 else None)
                    if side: q[side].setdefault(a[r+dr][c+dc],0); q[side][a[r+dr][c+dc]]+=1
                blobs.append(((r,c),{s:max(v.items(),key=lambda x:x[1])[0] if v else '.' for s,v in q.items()},
                              {s:sorted(v.items(),key=lambda x:-x[1]) for s,v in q.items()}))
                continue
            f2=[a[r+dr][c+dc] for dr,dc in D if (dr,dc)!=(0,0)]
            if all(v in 'GW' for v in f2) and a[r-2][c-1] in 'Bg' and a[r+2][c+1] in 'Bg':
                diams.append(((r,c),'W' if f2.count('W')>=10 else 'G'))
    A=analyze2(fr)
    rings=[rg for rg in A['rings'] if rg['px']==12]
    return diams,blobs,rings
