def scan(fr):
    a=[list(r) for r in fr.ascii.split('\n')]
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
    def col(r,c): return a[r][c]
    diams=[]; beads=[]
    for r in range(3,61):
        for c in range(3,61):
            nb=[col(r+dr,c+dc) for dr,dc in D if (dr,dc)!=(0,0)]
            if all(v in 'GW' for v in nb):
                diams.append(((r,c),col(r,c),'W' if nb.count('W')>=10 else 'G'))
                continue
            if all(v not in 'Bg' for v in nb):
                extra=[col(r-2,c-1),col(r-2,c+1),col(r+2,c-1),col(r+2,c+1)]
                if all(v not in 'Bg' for v in extra):
                    q={}
                    for dr,dc in Bm:
                        k=('T' if dr<0 else ('B' if dr>0 else 'M'))+('L' if dc<0 else ('R' if dc>0 else 'M'))
                        q.setdefault(col(r+dr,c+dc),0); q[col(r+dr,c+dc)]+=1
                    beads.append(((r,c),max(q.items(),key=lambda x:x[1])[0],q))
    A=analyze2(fr)
    rings=[rg for rg in A['rings'] if rg['px']==12]
    return {'diams':diams,'beads':beads,'rings':rings,'bands':A['bands'],'a':a}
