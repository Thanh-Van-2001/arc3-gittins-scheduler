            log.append((c,'NOOP')); return log,'noop at '+str(c)
        # find which diamond moved: compare A2 diamonds to pos
        newd=[d for d in A2['diamonds'] if d not in pos]
        gone=[d for d in pos if d not in A2['diamonds']]
        log.append((c,'moved '+str(gone)+'->'+str(newd)))
        if res['level_completed'] or res['done']: return log,'WIN'
        # update pos
        if len(newd)==1 and len(gone)==1:
            pos[pos.index(gone[0])]=newd[0]
        else:
            return log,'unexpected '+str(gone)+str(newd)
        if res['game_over']: return log,'DEAD'
    b=bead_of(pos)
    return log,('bead '+str(b)+' target '+str(target))
