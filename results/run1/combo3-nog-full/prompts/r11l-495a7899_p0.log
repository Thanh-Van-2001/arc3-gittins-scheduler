        new=[d for d in A2['diamonds'] if d not in pos and abs(d[0]-pos[0])+abs(d[1]-pos[1])<80]
        # identify: exactly one of my diamonds disappeared; find new diamond = the one not in pos but whose partner set matches
        cand=[d for d in A2['diamonds'] if d not in pos]
