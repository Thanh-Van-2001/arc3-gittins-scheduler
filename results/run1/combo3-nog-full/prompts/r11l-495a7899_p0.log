def find_active(fr, diams):
    a=[list(r) for r in fr.ascii.split('\n')]
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    best=None
    for p in diams:
        w=sum(1 for dr,dc in D if (dr,dc)!=(0,0) and a[p[0]+dr][p[1]+dc]=='W')
        if best is None or w>best[1]: best=(p,w)
    return best[0]
def bead_of(diams):
    n=len(diams); return (sum(p[0] for p in diams)//n, sum(p[1] for p in diams)//n)
def run_leg(fr, diams, target, blocked, maxclicks=12, verbose=True):
    act=find_active(fr,diams)
    ai=[i for i,p in enumerate(diams) if p==act][0]
