def beam_plan3(a, mine, ring, blocked, active, step=1, beam=24, depth=14, mindiam=2, minpair=5):
    from collections import deque
    D=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
    Bm=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
    n=len(mine)
    def bad(r,c): return (r,c) in blocked or not (1<=r<=62 and 1<=c<=62)
    FFb=[[False]*64 for _ in range(64)]; FFd=[[False]*64 for _ in range(64)]
    for r in range(3,61):
        for c in range(3,61):
            FFb[r][c]=all(not bad(r+dr,c+dc) for dr,dc in Bm)
            FFd[r][c]=all(not bad(r+dr,c+dc) for dr,dc in D)
    def segok(p,q):
        st=max(abs(p[0]-q[0]),abs(p[1]-q[1]))
        if st==0: return True
        for t in range(st+1):
            r=p[0]+(q[0]-p[0])*t//st; c=p[1]+(q[1]-p[1])*t//st
            if bad(r,c): return False
        return True
    def valid(pos):
        b=(sum(p[0] for p in pos)//n, sum(p[1] for p in pos)//n)
        if not FFb[b[0]][b[1]]: return False
        for p in pos:
            if not FFd[p[0]][p[1]]: return False
        for i in range(n):
            for j in range(i+1,n):
                if abs(pos[i][0]-pos[j][0])+abs(pos[i][1]-pos[j][1])<minpair: return False
        for p in pos:
            if abs(p[0]-b[0])+abs(p[1]-b[1])<mindiam: return False
            if not segok(b,p): return False
        return True
    cand=[(r,c) for r in range(3,61,step) for c in range(3,61,step) if FFd[r][c]]
    start=tuple(mine)
    if not valid(start): return None,'initial invalid'
    def mid(pos): return (sum(p[0] for p in pos)//n, sum(p[1] for p in pos)//n)
    h=lambda pos: abs(mid(pos)[0]-ring[0])+abs(mid(pos)[1]-ring[1])
    seen={(start,active):0}
    frontier=[(h(start),0,start,active,[])]
    best=None
    for it in range(depth):
        nxt=[]
        for hv,g,pos,act,path in frontier:
            for i in range(n):
                for p in cand:
                    if p==pos[i]: continue
                    nm=list(pos); nm[i]=p; nm=tuple(nm)
                    bb=(sum(p2[0] for p2 in nm)//n, sum(p2[1] for p2 in nm)//n)
                    if not (3<=bb[0]<61 and 3<=bb[1]<61 and FFb[bb[0]][bb[1]]): continue
                    nc=g+1+(0 if i==act else 1)
                    k2=(nm,i)
                    if k2 in seen and seen[k2]<=nc: continue
                    if not valid(nm): continue
                    seen[k2]=nc
                    npath=path+[(i,p)]
                    if bb==ring:
                        clicks=[]; pos2=list(start); act2=active
                        for (ii,pp) in npath:
                            if ii!=act2: clicks.append(('act',ii,pos2[ii]))
                            clicks.append(('mv',ii,pp)); pos2[ii]=pp; act2=ii
                        if best is None or len(clicks)<best[0]: best=(len(clicks),clicks,nm)
                        continue
                    nxt.append((nc+h(nm),nc,nm,i,npath))
        if not nxt: break
        nxt.sort(key=lambda x:x[0])
        frontier=nxt[:beam]
    if best: return best[1],'cost '+str(best[0])
    return None,'no goal'
