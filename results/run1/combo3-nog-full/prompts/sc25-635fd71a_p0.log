def press(d,n,stop_early=True):
    """Press direction d up to n times; stop on no-op or terminal event. Returns (count, state, tipbbox)."""
    made=0; st=None
    for i in range(n):
        try: res=action([{'action':d}])
        except Exception as e: st='guard'; break
        made+=1; st=res.get('state')
        if res.get('no_op'): made-=1; st='noop'; break
        if res.get('level_completed') or res.get('run_complete') or res.get('done') or res.get('game_over'):
            st='EVENT:'+str({k:v for k,v in res.items() if k in ('level_completed','run_complete','done','game_over','state')}); break
    return made,st,tiprc(current_frame)
