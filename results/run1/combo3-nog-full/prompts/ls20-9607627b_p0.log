def mkgrid(f):
    a=f.ascii.split('\n')
    from collections import Counter
    G={}
    for r in range(12):
        for c in range(12):
            cnt=Counter(a[rr][cc] for rr in range(5*r,min(5*r+5,64)) for cc in range(5*c,min(5*c+5,64)))
            top=cnt.most_common(1)[0]
            G[(r,c)]=top[0]
    return G
