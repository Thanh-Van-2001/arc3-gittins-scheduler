    r=action([{'action':m} for m in seq])
    print('exec',last_action_call_result.get('executed_count'),'stop',last_action_call_result.get('stop_reason'),'lv',current_frame.level,'comp',last_transition.result.get('level_completed'),'over',last_transition.result.get('game_over'))
