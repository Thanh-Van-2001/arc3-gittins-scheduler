def goto(target, maxsteps=40, blocked=(), allow=()):
    import collections
    blocked=set(blocked); tr=[]
    for it in range(maxsteps):
        f=current_frame
        G=mk(f)
        p=pos(f)[0][0]
        if p==target: return True,tr,sorted(blocked)
        cells={k for k,v in G.items() if v=='G'}|{p,target}|set(allow)
        cells.discard((1,1))
        def nb(q):
            out=[]
            for d in ((-1,0),(1,0),(0,-1),(0,1)):
                n=(q[0]+d[0],q[1]+d[1])
                if n in cells and (q,n) not in blocked: out.append(n)
            return out
        prev={p:None}; dq=collections.deque([p])
        while dq:
            q=dq.popleft()
            if q==target: break
            for n in nb(q):
                if n not in prev: prev[n]=q; dq.append(n)
        if target not in prev: return False,tr+['nopath',p],sorted(blocked)
        path=[];q=target
        while q is not None: path.append(q); q=prev[q]
        path=path[::-1]
        m=mv(path)[0]
        r=action([{'action':m}])
        np_=pos(current_frame)[0][0]
        if np_==p:
            blocked.add((p,path[1]))
            tr.append(m+':X')
            if len(blocked)>60: return False,tr+['toomany'],sorted(blocked)
        else:
            tr.append(m)
    return (pos(current_frame)[0][0]==target),tr,sorted(blocked)
