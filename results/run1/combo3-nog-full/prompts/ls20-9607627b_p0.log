def bfs3(start,goal,avoid=(),tele=((2,1),(1,6))):
    import collections
    cells={k for k,v in G.items() if v=='G'}|{goal}
    cells-=set(avoid)|{(1,1)}
    def nb(q):
        out=[n for n in [(q[0]+d[0],q[1]+d[1]) for d in ((-1,0),(1,0),(0,-1),(0,1))] if n in cells]
        if q==tele[0]: out.append(tele[1])
        return out
    prev={start:None}; dq=collections.deque([start])
    while dq:
        q=dq.popleft()
        if q==goal: break
        for n in nb(q):
            if n not in prev: prev[n]=q; dq.append(n)
    if goal not in prev: return None
    p=[];q=goal
    while q is not None: p.append(q); q=prev[q]
    return p[::-1]
