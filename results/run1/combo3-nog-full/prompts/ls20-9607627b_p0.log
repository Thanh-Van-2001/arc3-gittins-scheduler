def bfsF(G,start,goal,tele=(((2,1),(1,6)),),noentry=((1,1),)):
    import collections
    cells={k for k,v in G.items() if v=='G'}|{start,goal}
    for x in noentry: cells.discard(x)
    tmap=dict(tele)
    def nb(q):
        out=[n for n in [(q[0]+d[0],q[1]+d[1]) for d in ((-1,0),(1,0),(0,-1),(0,1))] if n in cells]
        if q in tmap: out.append(tmap[q])
        return out
    prev={start:None}; dq=collections.deque([start])
    while dq:
        q=dq.popleft()
        if q==goal: break
        for n in nb(q):
            if n not in prev: prev[n]=q; dq.append(n)
    if goal not in prev: return None
    p=[];q=goal
    while q is not None: p.append(q); q=prev[q]
    return p[::-1]
