def plan(f,start,goals,tele=((2,2),(1,7))):
    G=mkgrid(f)
    cells={k for k,v in G.items() if v in 'G'}
    def nb(q):
        out=[n for n in [(q[0]+d[0],q[1]+d[1]) for d in ((-1,0),(1,0),(0,-1),(0,1))] if n in cells]
        if q==tele[0]: out.append(tele[1])
        return out
    import collections
    paths=[]
    cur=start
    for tgt in goals:
        prev={cur:None}; dq=collections.deque([cur])
        while dq:
            q=dq.popleft()
            if q==tgt: break
            for n in nb(q):
                if n not in prev: prev[n]=q; dq.append(n)
        if tgt not in prev: return None,cur
        p=[];q=tgt
        while q is not None: p.append(q); q=prev[q]
        p=p[::-1]; paths.append(p); cur=tgt
    return paths,cur
paths,cur=plan(current_frame,(8,7),[(6,4),(2,10),(10,11)])
