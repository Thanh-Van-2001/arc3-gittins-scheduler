def plus_solve(start, cap=2000000):
    from collections import deque
    def goal(s):
        hr,hc,vc,vr = s
        return hr==9 and 18<=hc<=21 and vc==12 and 15<=vr<=18
    if goal(start): return 0,[]
    dist={start:0}; par={start:None}; q=deque([start]); n=0
    while q:
        s=q.popleft(); n+=1
        if n>cap: return None,'cap'
        for m in ['UP','DOWN','LEFT','RIGHT']:
            t=plus_step(s,m)
            if t==s or t in dist: continue
            dist[t]=dist[s]+1; par[t]=(s,m)
            if goal(t):
                path=[]; cur=t
                while par[cur] is not None:
                    p,mm=par[cur]; path.append(mm); cur=p
                return dist[t], path[::-1]
            q.append(t)
    return None,'exhausted %d'%len(dist)
