def plus_astar(start, cap=400000):
    import heapq, math
    def idist(v, lo, hi): return 0 if lo<=v<=hi else (lo-v if v<lo else v-hi)
    def h(s):
        hr,hc,vc,vr = s
        V = max(math.ceil(abs(hr-9)/3), math.ceil(idist(vr,15,18)/3))
        H = max(math.ceil(idist(hc,18,21)/3), math.ceil(abs(vc-12)/3))
        return V+H
    def goal(s): return h(s)==0
    if goal(start): return 0,[]
    g={start:0}; par={start:None}
    pq=[(h(start),0,start)]; best=10**9; it=0
    while pq:
        f,_,s = heapq.heappop(pq)
        it+=1
        if it>cap: return None,'cap states=%d'%len(g)
        if g.get(s,10**9) < f-h(s): continue
        for m in ['UP','DOWN','LEFT','RIGHT']:
            t=plus_step(s,m)
            if t==s: continue
            ng=g[s]+1
            if ng < g.get(t,10**9):
                g[t]=ng; par[t]=(s,m)
                if goal(t):
                    path=[]; cur=t
                    while par[cur] is not None:
                        p,mm=par[cur]; path.append(mm); cur=p
                    return ng, path[::-1]
                heapq.heappush(pq,(ng+h(t),ng,t))
    return None,'exhausted'
