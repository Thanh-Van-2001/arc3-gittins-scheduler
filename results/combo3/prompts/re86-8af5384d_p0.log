B = [(r,c) for r in range(53,57) for c in range(4,8)]
Rf = [(r,c) for r in range(53,57) for c in range(55,59)]
def shape_pts(kind,h,k):
    pts=set()
    if kind=='X':
        for d in range(-11,12):
            pts.add((h+d,k+d)); pts.add((h+d,k-d))
    elif kind=='D':
        for d in range(-9,10):
            pts.add((h+d,k-abs(d)))
            if d!=0: pts.add((h-d,k+abs(d)))
    else:
        for d in range(-14,15):
            pts.add((h,k+d)); pts.add((h+d,k))
    return pts
def best_path(kind,start,target,fill):
    best=None
    for h in range(0,64):
        if (h-start[0])%3: continue
        for k in range(0,64):
            if (k-start[1])%3: continue
            if not (shape_pts(kind,h,k) & set(fill)): continue
            c1 = (abs(h-start[0])+abs(k-start[1]))//3
            c2 = (abs(target[0]-h)+abs(target[1]-k))//3
            if c1+c2==0: return (0,start,'start already touches')
            if best is None or c1+c2 < best[0]:
                best=(c1+c2,(h,k),c1)
    direct = (abs(target[0]-start[0])+abs(target[1]-start[1]))//3
    return best, direct
print('X ', best_path('X',(42,24),(15,30),B))
print('plus', best_path('+',(39,54),(51,33),B))
print('diam', best_path('D',(18,27),(36,51),Rf))
