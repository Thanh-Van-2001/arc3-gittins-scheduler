from collections import deque
FILLS = {'Y':[(r,c) for r in range(4,8) for c in range(4,8)],
         'S':[(r,c) for r in range(4,8) for c in range(55,59)],
         'N':[(r,c) for r in range(28,32) for c in range(4,8)],
         'b':[(r,c) for r in range(53,57) for c in range(4,8)],
         'R':[(r,c) for r in range(53,57) for c in range(55,59)]}
FSET = {col:set(v) for col,v in FILLS.items()}
def touches(kind,h,k):
    pts = shape_pts(kind,h,k)
    out=[]
    for col,S in FSET.items():
        if pts & S: out.append(col)
    return out
def bfs(kind,start,scolor,target,tcolor):
    st=(start[0],start[1],scolor)
    goal=(target[0],target[1],tcolor)
    if st==goal: return 0,[]
    dist={st:0}; par={st:None}
    q=deque([st])
    moves=[(-3,0,'UP'),(3,0,'DOWN'),(0,-3,'LEFT'),(0,3,'RIGHT')]
    while q:
        h,k,col = q.popleft()
        for dh,dk,nm in moves:
            nh,nk = h+dh,k+dk
            if not (0<=nh<64 and 0<=nk<64): continue
            t = touches(kind,nh,nk)
            ncol = col if len(t)==0 else (t[0] if len(t)==1 else None)
            if ncol is None: continue
            ns=(nh,nk,ncol)
            if ns in dist: continue
            dist[ns]=dist[(h,k,col)]+1; par[ns]=((h,k,col),nm)
            if ns==goal:
                # reconstruct
                path=[]; cur=ns
                while par[cur] is not None:
                    p,nmm = par[cur]; path.append(nmm); cur=p
                return dist[ns], path[::-1]
            q.append(ns)
    return None,None
