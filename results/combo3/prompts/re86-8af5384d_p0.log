def plus6(m,a=12):
    r0,c0=m; return {(r0+dr,c0) for dr in range(-a,a+1)} | {(r0,c0+dc) for dc in range(-a,a+1)}
def ring(m,h=9):
    r0,c0=m; s=set()
    for j in range(-h,h+1): s |= {(r0-h,c0+j),(r0+h,c0+j),(r0+j,c0-h),(r0+j,c0+h)}
    return s
