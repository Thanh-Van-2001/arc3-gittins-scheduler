def bfs_multi(kind,start,scolor,goals):
    from collections import deque
    FSET,_ = slots()
    mv = {'UP':(-3,0),'DOWN':(3,0),'LEFT':(0,-3),'RIGHT':(0,3)}
    gset=set(goals)
    def touch(h,k):
        pts=shape_pts(kind,h,k)
        return [c for c,S in FSET.items() if pts & S]
    st=(start[0],start[1],scolor)
    dist={st:0}; par={st:None}; q=deque([st]); found={}
    if st in gset: found[st]=(0,[])
    while q and len(found)<len(gset):
        h,k,col=q.popleft()
        for nm,(dh,dk) in mv.items():
            nh,nk=h+dh,k+dk
            if not (0<=nh<64 and 0<=nk<64): continue
            t=touch(nh,nk)
            if len(t)>1: continue
            ncol=t[0] if t else col
            ns=(nh,nk,ncol)
            if ns in dist: continue
            dist[ns]=dist[(h,k,col)]+1; par[ns]=((h,k,col),nm)
            if ns in gset:
                path=[]; cur=ns
                while par[cur] is not None:
                    p,nmm=par[cur]; path.append(nmm); cur=p
                found[ns]=(dist[ns],path[::-1])
            q.append(ns)
    return found
