target={cell:('N' if cell in Wcells else 'Y') for cell in cur}
tracked=sorted(cur); idx={c:i for i,c in enumerate(tracked)}
keyset=keys
def effv(c):
    s={c}; up=(c[0]-1,c[1])
    if up in idx and up not in keyset: s.add(up)
    v=0
    for e in s:
        if e in idx: v|=1<<idx[e]
    return v
cols={c:effv(c) for c in tracked}
piv={};colvec={}
