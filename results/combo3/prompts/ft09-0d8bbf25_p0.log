def analyze2(fr, r0=6, c0=4, nr=7, nc=7):
    a=fr.ascii.split('\n')
    occ={}
    for i in range(nr):
        for j in range(nc):
            y,x=r0+8*i, c0+8*j
            if y+6>64 or x+6>64: continue
            blk=[[a[y+di][x+dx] for dx in range(6)] for di in range(6)]
            flat={c for r in blk for c in r}
            if flat=={'c'}: continue
            if len(flat)==1: occ[(i,j)]=('plain',blk[0][0],None)
            else:
                m=[''.join(blk[2*r+1][2*c+1] for c in range(3)) for r in range(3)]
                syms={c for r in m for c in r}
                ctr=m[1][1]
                if syms <= set('WgG')|{ctr}: occ[(i,j)]=('disp',ctr,m)
                else: occ[(i,j)]=('mark',ctr,''.join(m))
    return occ
