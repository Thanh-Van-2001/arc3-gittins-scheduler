def cellblocks(fr):
    a=fr.ascii.split('\n')
    blocks={}
    for r in range(7):
        for c in range(7):
            r0,c0=4+8*r,6+8*c
            px=[a[r0+i][c0+j] for i in range(6) for j in range(6)]
            s=set(px)
            if sum(1 for x in px if x!='c')>20: blocks[(r,c)]=s
    return a,blocks

def classify(fr):
    a,blocks=cellblocks(fr)
    keys={};flips={};reg={}
    for cell,s in blocks.items():
        if 'M' in s: flips[cell]='flip'
        elif 'W' in s or ('G' in s and len(s)>1): keys[cell]=s
        else: reg[cell]=s
    return a,blocks,keys,flips,reg

def keypattern(fr,r,c):
    a,blocks=cellblocks(fr)
    r0,c0=4+8*r,6+8*c
    return [[a[r0+2*i][c0+2*j] for j in range(3)] for i in range(3)]

def state_and_target(fr):
    a,blocks,keys,flips,reg=classify(fr)
    other={'N':'p','p':'N'}
    target={}
    for (r,c) in keys:
        sg=keypattern(fr,r,c); ctr=sg[1][1]
        for i in range(3):
            for j in range(3):
                if (i,j)==(1,1): continue
                nr,nc=r-1+i,c-1+j
                if (nr,nc) not in blocks: continue
                s=sg[i][j]
                if s=='W': v=1
                elif s=='g': v=0
                else: continue
                if (nr,nc) in keys: continue
                col = ctr if s=='W' else other[ctr]
                target[(nr,nc)] = 1 if col=='p' else 0
    cur={}
    for cell in blocks:
        if cell in keys: continue
        s=blocks[cell]
        cur[cell]= 1 if 'p' in s else 0
    return cur,target,keys,flips,blocks

def solve_gf2(tracked,cur,target,flips):
    idx={c:i for i,c in enumerate(tracked)}
    def effv(c):
        s={c} if c not in flips else {c}|{(c[0]+dr,c[1]+dc) for dr,dc in ((-1,0),(1,0),(0,-1),(0,1))}
        v=0
        for e in s:
            if e in idx: v|=1<<idx[e]
        return v
    cols={c:effv(c) for c in tracked}
    piv={}
    for c in tracked:
        x=cols[c]; s={c}
        while x:
            t=1<<(x.bit_length()-1)
            if t in piv:
                bv,bs=piv[t]; x^=bv; s^=bs
            else:
                piv[t]=(x,s); break
    b=0
    for c in tracked:
        if c in target and cur[c]!=target[c]: b|=1<<idx[c]
    x=b; clicks=set()
    for t in sorted(piv,reverse=True):
        if x&t:
            bv,bs=piv[t]; x^=bv; clicks^=bs
    tot=0
    for c in clicks: tot^=cols[c]
    return x==b and tot==b, sorted(clicks), b

cur,target,keys,flips,blocks=state_and_target(current_frame)
tracked=sorted(cur)
ok,clicks,b=solve_gf2(tracked,cur,target,flips)
