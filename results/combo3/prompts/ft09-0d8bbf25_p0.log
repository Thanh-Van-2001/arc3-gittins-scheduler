def analyze(fr):
    a=fr.ascii.split('\n'); ys=[4+8*i for i in range(7)]; xs=[6+8*j for j in range(7)]
    occ={}
    for i,y in enumerate(ys):
        for j,x in enumerate(xs):
            if (i,j)==(0,6): continue
            blk=[[a[y+di][x+dx] for dx in range(6)] for di in range(6)]
            flat={c for r in blk for c in r}
            if flat=={'c'}: continue
            if len(flat)==1: occ[(i,j)]=('plain',blk[0][0])
            else:
                m=[''.join(blk[2*r+1][2*c+1] for c in range(3)) for r in range(3)]
                syms={c for r in m for c in r}
                if syms <= set('WgG')|{m[1][1]}: occ[(i,j)]=('disp',m)
                elif 'M' in syms: occ[(i,j)]=('plus', m[1][1])
                else: occ[(i,j)]=('other',m)
    return occ
def target_of(fr):
    occ=analyze(fr); t={}
    for d,(k,m) in occ.items():
        if k!='disp': continue
        ctr=m[1][1]; other='p' if ctr=='N' else 'N'
        for i in range(3):
            for j in range(3):
                if (i,j)==(1,1): continue
                s=m[i][j]
                if s=='G': continue
                cell=(d[0]-1+i,d[1]-1+j)
                if cell in occ:
                    t[cell]= ctr if s=='W' else other
    return occ,t
