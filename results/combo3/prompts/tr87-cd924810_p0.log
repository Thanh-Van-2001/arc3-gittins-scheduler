def plan3(f):
    C3 = collect3(f)
    pairs = ['P1','P2','P3','P4','P5','P6']
    vocab = [(C3[p+'Y'], C3[p+'S'], p) for p in pairs]
    BY = C3['BY']; BS = C3['BS']
    n=len(BY)
    from functools import lru_cache
    results=[]
    def seg(i, acc, out):
        if i==n:
            results.append(list(out)); return
        for y,s,name in vocab:
            ly=len(y)
            if i+ly<=n and all(BY[i+k]==y[k] for k in range(ly)):
                out.extend(s)
                seg(i+ly, acc, out)
                for _ in range(len(s)): out.pop()
    seg(0,0,[])
    return results, BY, BS

