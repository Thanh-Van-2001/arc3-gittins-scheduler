def cell5(f, r0, c0):
    lines = f.ascii.split('\n')
    return tuple(''.join('#' if lines[r][c]=='B' else '.' for c in range(c0+1,c0+6)) for r in range(r0+1,r0+6))

def rot5(bm):
    return tuple(''.join(bm[r][c] for r in range(5))[::-1] for c in range(5))

def canon5(bm):
    cur=bm; best=None
    for _ in range(4):
        s='\n'.join(cur)
        if best is None or s<best: best=s
        cur=rot5(cur)
    return best

def row5(f, r0, cstart, ncells):
    return [canon5(cell5(f, r0, cstart+7*i)) for i in range(ncells)]

