def tiles5(fr):
    out=[]
    for n in fr.segmentation['nodes']:
        if n['color'] in ('S','P'):
            b=n['boundary']; r0=min(p[0] for p in b); r1=max(p[0] for p in b); c0=min(p[1] for p in b); c1=max(p[1] for p in b)
            if r1-r0==6 and r0<34:
                out.append((r0,c0,(c1-c0+1)//7,n['color']))
    out.sort(); return out
