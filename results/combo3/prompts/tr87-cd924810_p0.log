def get_target(f):
    C = collect(f)
    g = lambda n,i: cs(C[n][i])
    words = {'T1L':[g('T1L_Y',0)],
             'T1R':[g('T1R_Y',0),g('T1R_Y',1),g('T1R_Y',2)],
             'T2L':[g('T2L_Y',0),g('T2L_Y',1)],
             'T2R':[g('T2R_Y',0),g('T2R_Y',1)],
             'T3L':[g('T3L_Y',0),g('T3L_Y',1),g('T3L_Y',2)],
             'T3R':[g('T3R_Y',0)]}
    pinktop = {'T1L':cs(C['T1L_P'][0]),'T1R':cs(C['T1R_P'][0]),'T2L':cs(C['T2L_P'][0]),
               'T2R':cs(C['T2R_P'][0]),'T3L':cs(C['T3L_P'][0]),'T3R':cs(C['T3R_P'][0])}
    inv = {v:k for k,v in pinktop.items()}
    order = [inv[cs(x)] for x in C['B_P']]
    tgt=[]
    for k in order: tgt += words[k]
    return order, tgt

