def brackets(frame):
    pts=[]
    for n in frame.segmentation['nodes']:
        if n['color']=='Y' and n['pixels']<=2:
            b=n['boundary']
            pts += [[p[0],p[1]] for p in b] if len(b)<=2 else []
            if n['pixels']==1: pts.append([min(p[0] for p in b),min(p[1] for p in b)])
    return sorted(set(tuple(p) for p in pts))
