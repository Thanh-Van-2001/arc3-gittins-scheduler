import itertools, collections
target = ['R','b','N','Y','N','b','R']
buttons = collections.Counter(['R','R','b','b','N','N'])
# panels: name -> (nslots, {slotidx: prefilled color})
panels = {'R':(3,{}), 'b':(3,{}), 'N':(3,{1:'Y'})}
ports = {'N':'N', 'b':'b'}  # port color -> referenced panel
master='R'
def expand(p, portmap):
    n,pref = panels[p]
    out=[]
    for i in range(n):
        if i in portmap:
            out.extend(expand(portmap[i], portmap))
        else:
            out.append((p,i,pref.get(i)))
    return out
sols=[]
portcolors=list(ports)
# choose target panel for each port, and slot in that panel
choices=[]
for pc in portcolors:
    for tp in panels:
        if tp==pc: continue  # cycle / self
        for si in range(panels[tp][0]):
            choices.append((pc,tp,si))
for combo in itertools.product(*[ [c for c in choices if c[0]==pc] for pc in portcolors]):
    # map: (panel,slot) -> referenced panel
    pm={}
    ok=True
    used=set()
    for pc,tp,si in combo:
        if (tp,si) in used: ok=False;break
        used.add((tp,si))
        pm[(tp,si)]=ports[pc]
    if not ok: continue
    # referenced panels must be unique (each panel referenced at most once) - only one port of each color so fine
    leaves = expand(master, pm)
    if len(leaves)!=len(target): continue
    if any(l[2] is not None and l[2]!=target[i] for i,l in enumerate(leaves)): continue
    need = collections.Counter(target[i] for i,l in enumerate(leaves) if l[2] is None)
    if need==buttons:
        sols.append((combo, [(l[0],l[1],target[i]) for i,l in enumerate(leaves) if l[2] is None]))
print(len(sols))
for s in sols[:12]: print(s)
