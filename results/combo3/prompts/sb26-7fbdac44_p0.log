sols=[]
for p1,p2 in itertools.combinations([1,2,3,4,5],2):
    # slots: red positions 1..5 minus ports; blue g1,g2,g3 unknown
    free = [i for i in range(1,6) if i not in (p1,p2)]
    # build reading with placeholders
    seq=[]; 
    for i in range(1,6):
        if i==p1 or i==p2: seq.append(('G',))
        else: seq.append(('R',i))
    # flatten: each G expands to 3 unknowns g0,g1,g2 shared
    flat=[]
    gi=0
    for it in seq:
        if it[0]=='G':
            flat += ['g0','g1','g2']
        else:
