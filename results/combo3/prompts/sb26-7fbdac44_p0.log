def tray_items():
    out=[]
    for n in current_frame.segmentation['nodes']:
        r0,c0=n['boundary'][0]
        if r0>=55 and n['color']!='c' and n['pixels'] in (12,16):
            out.append((n['color'], n['pixels'], r0+1, c0+1))
    return out

def grab(color, ring=False):
    for c,px,r,cx in tray_items():
        if c==color and (px==12 if ring else px==16):
            return (r,cx)
    return None

def put(color, slot, ring=False):
    pos = grab(color, ring)
    if not pos: return (color,'missing')
    rr = action([{'action':'MOUSE','row':pos[0],'col':pos[1]},{'action':'MOUSE','row':slot[0],'col':slot[1]}])
    return (color, slot, rr.get('executed_count'), rr.get('gameplay_changed_per_action'))

steps = [('M',(22,19),False), ('b',(22,25),True), ('b',(22,31),True), ('Y',(22,37),False),
         ('p',(22,43),False), ('N',(36,25),False), ('R',(36,31),False), ('R',(36,37),False)]
