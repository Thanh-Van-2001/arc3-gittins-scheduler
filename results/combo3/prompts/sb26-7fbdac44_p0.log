    # match against target
    assign={}
    ok=True
    for slot,val in zip(flat,target):
        if slot in assign:
            if assign[slot]!=val: ok=False;break
        else: assign[slot]=val
    if not ok: continue
    colors=[v for k,v in assign.items() if k.startswith('r')] + [assign.get('g0'),assign.get('g1'),assign.get('g2')]
    if collections.Counter(colors)==buttons and len(assign)==6:
        sols.append((p1,p2,assign))
