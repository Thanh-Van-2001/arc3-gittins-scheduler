    if not state_ok(*start,m0): return None
    h=abs(m0[0]-target_disc[0])+abs(m0[1]-target_disc[1])
    pq=[(h,0,start)]; best={start:(None,None)}; cnt=0
    Dlist=list(D)
    while pq:
        f,g,st=heapq.heappop(pq)
        p0,p1=st
        cnt+=1
        if cnt>maxstates: return None
        if disc(p0,p1)==target_disc if False else (p0[0]+p1[0])//2==target_disc[0] and (p0[1]+p1[1])//2==target_disc[1]:
