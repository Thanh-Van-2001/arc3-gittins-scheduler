def valid_state(diams, discs, F, ringpx):
    cells=[body(p) for p in diams]+[body(d) for d in discs]
    for i in range(len(cells)):
        for j in range(i+1,len(cells)):
            if set(cells[i])&set(cells[j]): return False
    for cb in cells:
        for x in cb:
            if x not in F or x in ringpx: return False
    return True

