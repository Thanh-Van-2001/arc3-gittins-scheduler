def build_free2(frame):
    a = frame.ascii.split('\n')
    blocked=set(); free=set()
    for r in range(64):
        row=a[r]
        for c in range(64):
            ch=row[c]
            if ch in ('S','g'): blocked.add((r,c))
            else: free.add((r,c))
    # remove outer white background: identify via big W node bbox rows/cols? use pip on its boundary
    nodes=frame.segmentation['nodes']
    for n in nodes:
        if n['color']=='W' and n['pixels']>100:
            for r in range(64):
                for c in range(64):
                    if (r,c) in free and pip(r,c,n['boundary']): free.discard((r,c))
    return free
