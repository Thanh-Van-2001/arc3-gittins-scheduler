        for cb in (c0,c1,cm):
            for x in cb:
                if x not in F or x in ringpx: return False
        for fp in fixed_pos:
            cb=body(fp)
            if set(cb)&set(c0) or set(cb)&set(c1) or set(cb)&set(cm): return False
        for fd in fixed_discs:
            cb=body(fd)
            if set(cb)&set(c0) or set(cb)&set(cm) or set(cb)&set(c1): return False
        return True
    m0=disc(P0)
