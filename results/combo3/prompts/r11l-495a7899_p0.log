def gen_quads(ring, n, F, ringpx, maxr=7, maxquads=150):
    offs=[(dr,dc) for dr in range(-maxr,maxr+1) for dc in range(-maxr,maxr+1)
          if 3<=abs(dr)+abs(dc)<=maxr
