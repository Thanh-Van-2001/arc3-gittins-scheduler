a = current_frame.ascii.split('\n')
BLUE=set(); WALL=set()
for r in range(64):
    for c in range(64):
        ch=a[r][c]
        if ch=='S': BLUE.add((r,c))
        elif ch in 'gGWw': WALL.add((r,c))
def inb(p): return 0<=p[0]<64 and 0<=p[1]<64
def body(r,c):
    return [(r+dr,c+dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
def bead_area(r,c):
    return [(r+dr,c+dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
def cell_free(r,c): return inb((r,c)) and a[r][c] in 'Bw'
def node_ok(r,c): return cell_free(r,c) and all(inb(p) and p not in BLUE for p in body(r,c))
def bead_ok(r,c): return all(inb(p) and p not in BLUE for p in bead_area(r,c))
def seg(p,q):
    n=max(abs(p[0]-q[0]),abs(p[1]-q[1]))
    out=set()
    for i in range(n+1):
        t=i/n if n else 0
        out.add((round(p[0]+(q[0]-p[0])*t), round(p[1]+(q[1]-p[1])*t)))
    return out
def seg_ok(p,q): return all(inb(s) and s not in BLUE for s in seg(p,q))
