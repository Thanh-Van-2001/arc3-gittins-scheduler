def ents(fr):
    cells,edges,guards,st,go=parse(fr)
    out={'b':st,'N':go,'G':{}}
    for n in fr.segmentation['nodes']:
        if n['color'] in ('R','O'):
            r0,c0=n['boundary'][0]
            cell=((r0-16)//6,(c0-21)//6)
            eyes=[e for e in fr.segmentation['nodes'] if e['color'] in ('p','Y')]
