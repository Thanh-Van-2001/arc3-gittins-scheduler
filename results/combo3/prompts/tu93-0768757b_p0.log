def probe2(s, origin=(16,21)):
    AM={'D':'DOWN','U':'UP','R':'RIGHT','L':'LEFT'}
    log=[]
    for ch in s:
        r=action([AM[ch]])
        g=grid_of(current_frame,*origin)
        log.append((ch,[k for k,v in g.items() if v=='b'],
                    'R'+str([k for k,v in g.items() if v=='R']),
                    'O'+str([k for k,v in g.items() if v=='O']),
                    bar_len(current_frame),
                    {k:r.get(k) for k in ('game_over','level_completed')}))
        if r.get('game_over') or r.get('level_completed'): break
    return log
