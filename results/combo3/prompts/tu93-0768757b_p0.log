import collections
def grid_of(frame, r0, c0):
    seg=frame.segmentation; g={}
    for n in seg['nodes']:
        b=n['boundary']
        a=min(p[0] for p in b); c=min(p[1] for p in b); e=max(p[0] for p in b); f=max(p[1] for p in b)
        if (e-a)==2 and (f-c)==2 and n['pixels']<=9:
            g[((a-r0)//3,(c-c0)//3)]=n['color']
    return g
def solve(g, start, goal, reds, R=9, C=13):
    floor={k for k,v in g.items() if v in ('W','g','b','N','R')}
    MOV={'D':(1,0),'U':(-1,0),'R':(0,1),'L':(0,-1)}
    def threats(pos, redset):
        for (r,c) in redset:
            for dc in (-1,1):
                if pos==(r,c+2*dc) and (r,c+dc) in floor: return True
        return False
    st=(start, frozenset(reds)); q=collections.deque([st]); par={st:None}
    while q:
        p,rs=q.popleft()
        if p==goal: break
        for name,(dr,dc) in MOV.items():
            mid=(p[0]+dr,p[1]+dc); nxt=(p[0]+2*dr,p[1]+2*dc)
            if mid in floor and nxt in floor:
                nr=set(rs)
                if nxt in nr: nr.remove(nxt)
                if threats(nxt, nr): continue
                s2=(nxt,frozenset(nr))
                if s2 not in par: par[s2]=(st if False else (p,rs), name); q.append(s2)
    # find goal state
    gs=[s for s in par if s[0]==goal]
    if not gs: return None
    gs.sort(key=lambda s: len(s[1]), reverse=True)
    s=gs[0]; seq=[]
    while par[s] is not None:
        prev,name=par[s]; seq.append(name); s=prev
    seq.reverse(); return seq
g=grid_of(current_frame,18,12)
print(' '.join(''.join(g.get((r,c),'.') for c in range(13)) for r in range(9)))
start=[k for k,v in g.items() if v=='b'][0]; goal=[k for k,v in g.items() if v=='N'][0]
reds=[k for k,v in g.items() if v=='R']
print(start, goal, reds)
seq=solve(g,start,goal,reds)
print(len(seq) if seq else None, seq)
