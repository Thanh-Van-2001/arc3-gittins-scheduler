def search5(fr, allow_kill_mover=False):
    cells,edges,guards,st,go=parse(fr)
    FR={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}; OPP={'U':'D','D':'U','L':'R','R':'L'}
    seg=fr.segmentation; R=None; O=None
    for n in seg['nodes']:
        if n['color'] in ('R','O'):
            r0,c0=n['boundary'][0]; cell=((r0-16)//6,(c0-21)//6)
            eyes=[e for e in seg['nodes'] if e['color'] in ('p','Y')]
            e=min(eyes,key=lambda e:abs(e['boundary'][0][0]-r0)+abs(e['boundary'][0][1]-c0))
            er,ec=e['boundary'][0]
            f='U' if er<r0+1 else 'D' if er>r0+1 else 'L' if ec<c0+1 else 'R'
            if n['color']=='R': R=(cell,f)
            else: O=(cell,f)
    def step(o):
        p,f=o; nx=(p[0]+FR[f][0],p[1]+FR[f][1])
        if nx in edges.get(p,{}).values(): return (nx,f)
        f2=OPP[f]; return ((p[0]+FR[f2][0],p[1]+FR[f2][1]),f2)
    import collections
    start=(st,O,True,True); q=collections.deque([(start,())]); seen={start}
    while q:
        (me,o,ra,oa),path=q.popleft()
        if me==go: return path
        on=step(o) if oa else o
        for d,n in edges.get(me,{}).items():
            if oa and n==on[0]: continue
            if oa and n==o[0]:
                if not allow_kill_mover: continue
                if me==(o[0][0]+FR[o[1]][0],o[0][1]+FR[o[1]][1]): continue
            if ra:
                fR=(R[0][0]+FR[R[1]][0],R[0][1]+FR[R[1]][1])
                if n==fR: continue
                if n==R[0] and me==fR: continue
            nr = ra and not (ra and n==R[0])
