            e=min(eyes,key=lambda e:abs(e[0]-r0)+abs(e[1]-c0))
            er,ec=e
            f='U' if er==r0 else 'D' if er==r0+2 else 'L' if ec==c0 else 'R'
            out.append((n['color'],cc(r0,c0),f,(er-r0,ec-c0)))
    return sorted(out)
