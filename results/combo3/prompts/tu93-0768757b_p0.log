def facings(frame, r0, c0):
    seg=frame.segmentation; out={}
    reds=[n for n in seg['nodes'] if n['color']=='R']
    dots=[n for n in seg['nodes'] if n['color']=='p']
    for n in reds:
        b=n['boundary']
        r0_=min(p[0] for p in b); c0_=min(p[1] for p in b); r1_=max(p[0] for p in b); c1_=max(p[1] for p in b)
        cell=((r0_-r0)//3,(c0_-c0)//3)
        for d in dots:
            pr=d['boundary'][0][0]; pc=d['boundary'][0][1]
            if r0_<=pr<=r1_ and c0_<=pc<=c1_:
                if pr==r0_: f=(-1,0)
                elif pr==r1_: f=(1,0)
                elif pc==c0_: f=(0,-1)
                else: f=(0,1)
                out[cell]=f
    return out
f=facings(current_frame,18,12)
print(f)
# M1 solver
import collections
def solve2(g, start, goal, facing):
    floor={k for k,v in g.items() if v in ('W','g','b','N','R')}
    MOV={'D':(1,0),'U':(-1,0),'R':(0,1),'L':(0,-1)}
    def dead(pos, rs):
        for r in rs:
            fv=facing[r]; mid=(r[0]+fv[0], r[1]+fv[1]); tgt=(r[0]+2*fv[0], r[1]+2*fv[1])
            if mid in floor and pos==tgt: return True
        return False
    st=(start, frozenset(facing)); q=collections.deque([st]); par={st:None}
    while q:
        p,rs=q.popleft()
        if p==goal: break
        for name,(dr,dc) in MOV.items():
            mid=(p[0]+dr,p[1]+dc); nxt=(p[0]+2*dr,p[1]+2*dc)
            if mid in floor and nxt in floor:
                nr=set(rs)
                if nxt in nr: nr.remove(nxt)
                if dead(nxt, nr): continue
                s2=(nxt,frozenset(nr))
                if s2 not in par: par[s2]=((p,rs),name); q.append(s2)
    gs=[s for s in par if s[0]==goal]
    if not gs: return None
    gs.sort(key=lambda s: len(s[1]))
    s=gs[0]; seq=[]
    while par[s] is not None:
        prev,name=par[s]; seq.append(name); s=prev
    seq.reverse(); return seq
g=grid_of(current_frame,18,12)
start=[k for k,v in g.items() if v=='b'][0]; goal=[k for k,v in g.items() if v=='N'][0]
seq=solve2(g,start,goal,f)
print(len(seq), seq)
