import collections
G = ["..RgWgW..","..gBgBg..","NgWgWgW..","......g..","......WgW","......g.g","......O.W","......g.g","WgWgWgWgW"]
floor={(r,c) for r in range(9) for c in range(9) if G[r][c] not in '.B'}
P=[2,4,6,8,6,4,2,0]   # orange row at time n (n player moves), col 6
MOV={'D':(1,0),'U':(-1,0),'R':(0,1),'L':(0,-1)}
start=(8,0); goal=(2,0); red=(0,2)
def orow(t): return P[t%8]
def solve3():
    st=(start,0,True)
    q=collections.deque([st]); par={st:None}
    while q:
        p,t,ra=q.popleft()
        if p==goal: break
        for name,(dr,dc) in MOV.items():
            mid=(p[0]+dr,p[1]+dc); nxt=(p[0]+2*dr,p[1]+2*dc)
            if mid in floor and nxt in floor:
                t2=t+1
                o_now=(6,orow(t)); o_new=(6,orow(t2))
                if nxt==o_now: continue      # land on orange now
                if nxt==o_new: continue      # land where orange lands
                if nxt==o_now and p==o_new: continue
                if nxt==o_new and p==o_now: continue  # crossed
                nr=ra
                if nxt==red: nr=False
                if nr and nxt==(red[0]+2,red[1]): continue
                s2=(nxt,t2%8,nr)
                if s2 not in par: par[s2]=((p,t,ra),name); q.append(s2)
    gs=[s for s in par if s[0]==goal]
    if not gs: return None
    gs.sort(key=lambda s:s[1]); s=gs[0]; seq=[]
    while par[s] is not None:
        prev,name=par[s]; seq.append(name); s=prev
    seq.reverse(); return seq
