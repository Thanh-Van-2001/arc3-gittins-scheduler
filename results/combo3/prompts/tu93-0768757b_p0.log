def ents6(fr):
    bg,off=maze(fr); ro,co=off
    def cc(r,c): return ((r-ro)//3)//2,((c-co)//3)//2
    eyes=[cc(n['boundary'][0][0],n['boundary'][0][1]) for n in fr.segmentation['nodes'] if n['color'] in ('p','Y')]
    out=[]
    for n in fr.segmentation['nodes']:
        if n['color'] in ('R','O'):
            r0,c0=n['boundary'][0]; cell=cc(r0,c0)
            e=min(eyes,key=lambda e:abs(e[0]-cell[0])+abs(e[1]-cell[1]))
            rr,ccx=e
            f='U' if rr<cell[0] else 'D' if rr>cell[0] else 'L' if ccx<cell[1] else 'R'
            out.append((n['color'],cell,f))
    return sorted(out)
