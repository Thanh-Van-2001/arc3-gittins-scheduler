def parse(fr):
    bg,off=maze(fr)
    R,C=len(bg),len(bg[0]); ro,co=off
    def cellc(r,c): return ((r-ro)//3)//2, ((c-co)//3)//2
    cells={}
    for i in range(R):
        for j in range(C):
            if i%2==0 and j%2==0 and bg[i][j]!='B':
                cells[(i//2,j//2)]=bg[i][j]
    edges={}
    for (ci,cj) in cells:
        for d,(di,dj) in {'R':(0,2),'L':(0,-2),'D':(2,0),'U':(-2,0)}.items():
            ni,nj=ci*2+di,cj*2+dj
            if 0<=ni<R and 0<=nj<C and bg[ni][nj]!='B' and (ni//2,nj//2) in cells:
                edges.setdefault((ci,cj),{})[d]=(ci+di//2,cj+dj//2)
    guards={}
    seg=fr.segmentation
    rn=[n for n in seg['nodes'] if n['color']=='R']
    eyes=[n for n in seg['nodes'] if n['color'] in ('p','Y')]
    for n in rn:
        r0,c0=n['boundary'][0]; 
        best=min(eyes,key=lambda e:abs(e['boundary'][0][0]-r0)+abs(e['boundary'][0][1]-c0))
        er,ec=best['boundary'][0]
        f='U' if er<r0+1 else 'D' if er>r0+1 else 'L' if ec<c0+1 else 'R'
        guards[cellc(r0,c0)]=f
    start=cellc(*[n['boundary'][0][0],n['boundary'][0][1]] ) if False else None
    pl=[n for n in seg['nodes'] if n['color']=='b'][0]['boundary'][0]
    gl=[n for n in seg['nodes'] if n['color']=='N'][0]['boundary'][0]
    return cells,edges,guards,cellc(pl[0],pl[1]),cellc(gl[0],gl[1])
cells,edges,guards,st,go=parse(current_frame)
print('cells',len(cells),'start',st,'goal',go,'guards',guards)
print('edges of start',edges.get(st))
import collections
FR={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
def solve(st,guards,edges,go):
    g0=frozenset(guards)
    gf=dict(guards)
    q=collections.deque([(st,g0,())]); seen={(st,g0)}
    while q:
        c,g,path=q.popleft()
        if c==go: return path
        for d,n in edges.get(c,()).items():
            if n in g:
                # entering guard cell: forbidden if coming from its front cell
                f=gf[n]; front=(n[0]+FR[f][0], n[1]+FR[f][1])
                if c==front: continue
                ng=frozenset(x for x in g if x!=n)
            else:
                # forbidden if n is front cell of a live guard
                bad=any(gf[x]==FR and False for x in ())
                bad=False
                for x in g:
                    f=gf[x]
                    if (x[0]+FR[f][0],x[1]+FR[f][1])==n: bad=True;break
                if bad: continue
                ng=g
            if (n,ng) not in seen:
                seen.add((n,ng)); q.append((n,ng,path+(d,)))
    return None
p=solve(st,guards,edges,go)
print('path len',len(p) if p is not None else None, ''.join(p) if p else None)
