def tracks():
    # returns list of functions pos(t) -> cell
    def mk(track, start_idx, d):
        # track: list of cells in order (bouncing path list)
        n=len(track)
        if n==1: return lambda t: track[0]
        period=2*(n-1)
        def f(t):
            k=(start_idx + d*t) % (2*period) if False else None
