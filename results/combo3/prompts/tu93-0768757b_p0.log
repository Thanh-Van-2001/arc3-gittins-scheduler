def search4(fr):
    cells,edges,guards,st,go=parse(fr)
    # static guards (R) and movers (O)
    seg=fr.segmentation
    off=None
    R=O=None
    for n in seg['nodes']:
        if n['color'] in ('R','O'):
            r0,c0=n['boundary'][0]
            cell=((r0-16)//6,(c0-21)//6)
            eyes=[e for e in seg['nodes'] if e['color'] in ('p','Y')]
            e=min(eyes,key=lambda e:abs(e['boundary'][0][0]-r0)+abs(e['boundary'][0][1]-c0))
            er,ec=e['boundary'][0]
            f='U' if er<r0+1 else 'D' if er>r0+1 else 'L' if ec<c0+1 else 'R'
            if n['color']=='R': R=(cell,f)
            else: O=(cell,f)
    FR={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
    import collections
    def step_o(o):
        p,f=o; nx=(p[0]+FR[f][0],p[1]+FR[f][1])
        if nx in edges.get(p,{}) : return (nx,f)
        f2={'U':'D','D':'U','L':'R','R':'L'}[f]
        return ((p[0]+FR[f2][0],p[1]+FR[f2][1]),f2)
    start=(st,O,True)
    q=collections.deque([(start,())]); seen={start}
    while q:
        (me,o,ralive),path=q.popleft()
        if me==go: return path
        onext=step_o(o)
        for d,n in edges.get(me,{}).items():
            if n==onext[0]: continue
            if n==o[0]: continue
            if ralive and (n[0]+0,n[1]+0)==(R[0][0]+FR[R[1]][0],R[0][1]+FR[R[1]][1]): continue
            nr=ralive
            if ralive and n==R[0]:
                front=(R[0][0]+FR[R[1]][0],R[0][1]+FR[R[1]][1])
                if me==front: continue
                nr=False
            s2=(n,onext,nr)
            if s2 not in seen:
                seen.add(s2); q.append((s2,path+(d,)))
    return None
p=search4(current_frame)
print('path',len(p) if p else None, ''.join(p) if p else None)
