def ents7(fr):
    bg,off=maze(fr); ro,co=off
    def cc(r,c): return ((r-ro)//3)//2,((c-co)//3)//2
    eyes=[(n['boundary'][0][0],n['boundary'][0][1]) for n in fr.segmentation['nodes'] if n['color'] in ('p','Y')]
