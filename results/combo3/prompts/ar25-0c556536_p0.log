def norm(S):
    mr=min(r for r,c in S); mc=min(c for r,c in S)
    return frozenset((r-mr,c-mc) for r,c in S)
def flips(S):
    S=norm(S)
    out={'id':S}
    out['h']=norm({(-r,c) for r,c in S})
    out['v']=norm({(r,-c) for r,c in S})
    out['r180']=norm({(-r,-c) for r,c in S})
    return out
def place(shape, t):
    return {(r+t[0],c+t[1]) for (r,c) in shape}
for name,P in [('P1',P1),('P2',P2)]:
    for k,sh in flips(P).items():
