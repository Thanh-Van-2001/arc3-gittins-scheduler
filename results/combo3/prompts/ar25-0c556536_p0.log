def active_info():
    wd=[(x[1],x[2]) for x in dots() if x[0]=='W']
    if not wd: return None,'none'
    rs=[p[0] for p in wd]; cs=[p[1] for p in wd]
    bb=(min(rs),max(rs),min(cs),max(cs))
    # classify: on a line?
    S=[x for x in snap().get('S',[])]
    for x in S:
        if x[0]<=min(rs) and max(rs)<=x[1] and x[2]<=min(cs) and max(cs)<=x[3]: return bb,'line'
    B=[x for x in snap().get('B',[]) if x[0]<60]
    for x in B:
        if x[0]<=min(rs) and max(rs)<=x[1] and x[2]<=min(cs) and max(cs)<=x[3]: return bb,'piece',x
    return bb,'?'
