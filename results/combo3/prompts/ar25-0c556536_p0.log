a = current_frame.ascii.split('\n')
def blocks_in(r0,r1,c0,c1):
    out=set()
    for br in range(r0//3, r1//3+1):
        for cb in range(c0//3, c1//3+1):
            cells=[a[br*3+i][cb*3+j] for i in range(3) for j in range(3)]
            y=sum(1 for x in cells if x=='Y')
            if y>=7: out.add((br,cb))
            elif y>0: out.add(('partial',(br,cb),y))
    return sorted(out)
