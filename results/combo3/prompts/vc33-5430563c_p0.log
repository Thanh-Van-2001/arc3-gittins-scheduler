def layout(f):
    a=f.ascii.split('\n')
    # columns classified by their content signature
    cols={}
    for c in range(64):
        col=[a[r][c] for r in range(1,64)]
        cols[c]=''.join(col)
    # group consecutive columns with identical strings
    groups=[]; cur=[0,cols[0]]
    for c in range(1,64):
        if cols[c]==cur[1]: cur[1]=cols[c]; cur.append(c) if len(cur)==2 else cur.__setitem__(2,c)
        else: groups.append((cur[0],c-1,cur[1])); cur=[0 if False else c,cols[c],c]
    groups.append((cur[0],63,cur[1]) if len(cur)==3 else (cur[0],63,cur[1]))
    out=[]
    for g in groups:
        c0,c1,s=g[0],g[1],g[2]
        # compress string
        import re
        comp=''.join(f"{ch}x{len(m.group(0))}" for ch,m in re.groupby_iter(s) for ch in [ch]) if False else None
        runs=[]
        prev=None; st=0
        for i,ch in enumerate(s):
            if ch!=prev:
                if prev is not None: runs.append(f"{prev}{st+i-1}")
                prev=ch; st=i
        runs.append(f"{prev}{st+62}")
        out.append(f"c{c0}-{c1}: {'/'.join(runs[1:])}")
