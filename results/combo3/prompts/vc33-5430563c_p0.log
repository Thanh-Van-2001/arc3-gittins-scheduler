from collections import deque
L=[38,52,52,36,30]
TOP=58
# buttons: (index_left, index_right, sign) L-button: left arm -2 (fill), right arm +2 (drain)
BTNS={'L14':(0,1),'R14':(1,0),'L26':(1,2),'R26':(2,1),'L36':(2,3),'R36':(3,2),'L48':(3,4),'R48':(4,3)}
def succ(s):
    out=[]
    for name,(a,b) in BTNS.items():  # a fills (top -2), b drains (top +2)
        if s[a]-2>=L[a] and s[b]+2<=TOP:
            ns=list(s); ns[a]-=2; ns[b]+=2
            out.append((name,tuple(ns)))
    return out
