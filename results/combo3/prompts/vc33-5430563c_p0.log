def feats(f):
    seg=f.segmentation; a=f.ascii.split('\n')
    d={}
    for n in seg['nodes']:
        c=n['color']
        if c in 'YNp':
            b=n['boundary']; r0=min(p[0] for p in b); c0=min(p[1] for p in b); c1=max(p[1] for p in b)
            role='key' if n['pixels']==3 else ('gate' if n['pixels']==2 else '?'+str(n['pixels']))
            d[c+'_'+role]=(r0,c0,c1)
    # panel tops: for each column, topmost W row; group
    tops={}
    for c in range(64):
        t=next((r for r in range(1,64) if a[r][c]=='W'),64)
        tops[c]=t
    d['tops']={c:tops[c] for c in [10,20,31,42,55]}
    return d
rows=[]
for i in range(28,59):
    f=history[i].frame; d=feats(f)
    rows.append((f.step,history[i].action,d))
for st,act,d in rows:
    print(st,act.replace('MOUSE(row=56, col=','b'), {k:v for k,v in d.items() if k!='tops'}, d['tops'])
