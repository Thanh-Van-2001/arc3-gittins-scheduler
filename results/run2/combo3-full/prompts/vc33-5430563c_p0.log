from collections import deque
MIN=10; MAX=64
SPONGE={0:(40,28,39),1:(52,40,51),2:(37,25,36)}
pumps=[('P1a',(0,1)),('P1b',(1,0)),('P2a',(1,2)),('P2b',(2,1)),('P3a',(2,3)),('P3b',(3,2))]
def barok(L,c0,c1): return (L-2)>=c0 and (L-1)<=c1
def succ(st):
    L=list(st[:4]); pa,pb=st[4],st[5]; out=[]
    for nm,(i,j) in pumps:
        if L[j]<=61 and L[i]-3>=MIN:
            nl=list(L); nl[i]-=3; nl[j]+=3
            out.append(((nl[0],nl[1],nl[2],nl[3],pa,pb),nm))
    for w,(wet,c0,c1) in SPONGE.items():
        if L[w]==wet and L[w+1]==wet:
            npa,npb=pa,pb; moved=[]
            for plug in ('a','b'):
                pc = pa if plug=='a' else pb
                if pc==w and barok(L[w],c0,c1):
                    if plug=='a': npa=w+1
                    else: npb=w+1
                    moved.append(plug)
                elif pc==w+1 and barok(L[w+1],c0,c1):
                    if plug=='a': npa=w
                    else: npb=w
                    moved.append(plug)
            if moved: out.append(((L[0],L[1],L[2],L[3],npa,npb),'S%d'%w))
    return out
def win(st):
    L=st[:4]; pa,pb=st[4],st[5]
    return (pa in (2,3) and L[pa]==16) and (pb in (0,1) and L[pb]==22)
def solve(start):
    q=deque([start]); prev={start:None}; found=None
    while q:
        st=q.popleft()
        if win(st): found=st; break
        for ns,nm in succ(st):
            if ns not in prev: prev[ns]=(st,nm); q.append(ns)
    if not found: return None
    path=[]; s=found
    while prev[s] is not None:
        p,nm=prev[s]; path.append(nm); s=p
    path.reverse(); return path,found
p=solve((28,61,37,37,0,2))
print('cont len',len(p[0]),p[0])
print('final',p[1])
