import itertools, random
g=current_frame.ascii.split('\n')
BLOCK={(r,c) for r in range(64) for c in range(64) if g[r][c] in 'Sg' or c==0}
DIA=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
BLOB=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
def shape(p,sh): return {(p[0]+a,p[1]+b) for a,b in sh}
def okp(p,sh,blk):
    r,c=p
    if not (2<=r<62 and 2<=c<62): return False
    return all((r+dr,c+dc) not in blk for dr,dc in sh)
ringpx=set()
for r in range(1,63):
    for c in range(1,63):
        ch=g[r][c]
        if ch in 'BWGgcw': continue
        nb=[g[r+dr][c+dc] for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))]
        if all(x in 'BW' for x in nb): ringpx.add((r,c))
TR={(r,c) for (r,c) in ringpx if abs(r-9)<=3 and abs(c-48)<=3}
OTHER=ringpx-TR
HB1=shape((53,20),BLOB); HB2=shape((43,56),BLOB)
chainA=shape((10,13),DIA)|shape((46,14),DIA)|shape((28,13),BLOB)|{(r,c) for r in range(25,32) for c in range(10,17) if g[r][c]=='W'}
INIT=[(47,41),(55,34),(55,52)]
X=[(49,8),(55,7),(57,47)]; Y=[(57,47),(23,61),(50,61)]; Z=[(2,44),(7,54),(18,47)]
def blobpos(E):
    n=len(E); return (sum(p[0] for p in E)//n, sum(p[1] for p in E)//n)
def valid_blob(bp, eps, allow):
    s=shape(bp,BLOB)
    if not okp(bp,BLOB,BLOCK): return False
    if s & (chainA|OTHER): return False
    if s & (HB1|HB2) and s not in allow: return False
    for e in eps:
        if s & shape(e,DIA): return False
    return True
# phases: list of (target triple, allow_set_of_final_blob)
phases=[(X,{HB1} if False else HB1), (Y,HB2), (Z,TR)]
cur=list(INIT); clicks=[]; report=[]
for pi,(T,allow) in enumerate(phases):
    # find assignment+order
    found=None
    idxs=[0,1,2]
    for perm in itertools.permutations(idxs):   # which current endpoint goes to T[k]
        dest={perm[k]:T[k] for k in range(3)}
        if all(cur[i]==dest[i] for i in idxs): continue
        for order in itertools.permutations(idxs):
            e=list(cur); ok=True; blobs=[]
            for i in order:
                if e[i]==dest[i]:
                    blobs.append(blobpos(e)); continue
                e[i]=dest[i]
                bp=blobpos(e)
                last = all(e[j]==dest[j] for j in idxs)
                al = allow if last else set()
                if not valid_blob(bp, [x for x in e], al): ok=False; break
                blobs.append(bp)
            if ok:
                found=(order,dest,blobs); break
        if found: break
    if not found:
        print('PHASE FAIL', pi); break
    order,dest,blobs=found
    for i in order:
        if cur[i]==dest[i]: continue
        clicks.append({'action':'MOUSE','row':cur[i][0],'col':cur[i][1]})
        clicks.append({'action':'MOUSE','row':dest[i][0],'col':dest[i][1]})
        cur[i]=dest[i]
    report.append((pi, blobs))
print('clicks', len(clicks))
for pi,b in report: print('phase',pi,'blob path',b)
print('final endpoints', cur, 'blob', blobpos(cur))
print(clicks)
