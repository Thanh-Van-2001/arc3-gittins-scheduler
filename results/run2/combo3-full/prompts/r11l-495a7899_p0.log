                c=(3*T[0]+dr-a[0]-b[0], 3*T[1]+dc-a[1]-b[1])
                if c in VP and sep(c,a) and sep(c,b):
                    out.add(tuple(sorted([a,b,c])))
    return [tuple(t) for t in out]
