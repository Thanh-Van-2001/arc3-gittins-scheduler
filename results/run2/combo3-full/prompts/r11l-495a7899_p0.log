                else: ok=False; break
            if not ok: continue
            s0=sum(p[0] for p in pts); s1=sum(p[1] for p in pts)
            for d0 in range(n):
                for d1 in range(n):
                    c=(n*T[0]+d0-s0, n*T[1]+d1-s1)
                    if c in VP and all(sep(c,q) for q in pts):
                        out.add(tuple(sorted(pts+[c]))); break
                else: continue
                break
        return [list(t) for t in out]
    def vb(bp_,eps,avoid,final,allow):
        s=shape(bp_,BLOB)
        if not okp(bp_,BLOB,BLOCK): return False
        if s & (RB|other_objs): return False
        if final:
            if not (s<=allow): return False
        else:
            if s & avoid: return False
        return all(not (s & shape(e,DIA)) for e in eps)
    def feas(cur,T,avoid,allow):
        for perm in itertools.permutations(range(n)):
            dest={perm[k]:T[k] for k in range(n)}
            if all(cur[i]==dest[i] for i in range(n)): continue
            for order in itertools.permutations(range(n)):
                e=list(cur); ok=True
                for i in order:
                    if e[i]==dest[i]: continue
                    e[i]=dest[i]
                    last=all(e[j]==dest[j] for j in range(n))
                    if not vb(bp(e),e,avoid,last,allow): ok=False; break
                if ok: return (perm,order)
        return None
    cur=list(init); clicks=[]; tot=0; info=[]
    for pi,(T,avoid,allow) in enumerate(phases):
