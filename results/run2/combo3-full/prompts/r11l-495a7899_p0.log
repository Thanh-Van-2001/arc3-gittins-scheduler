import itertools, random
g=current_frame.ascii.split('\n')
BLOB=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if not (abs(dr)==2 and abs(dc)==2)]
DIA=[(dr,dc) for dr in range(-2,3) for dc in range(-2,3) if abs(dr)+abs(dc)<=2]
def shape(p,sh): return {(p[0]+a,p[1]+b) for a,b in sh}
def okp(p,sh,blk):
    r,c=p
    if not (2<=r<62 and 2<=c<62): return False
    return all((r+dr,c+dc) not in blk for dr,dc in sh)
def bp(E):
    n=len(E); return (sum(p[0] for p in E)//n, sum(p[1] for p in E)//n)
BLOCK={(r,c) for r in range(64) for c in range(64) if g[r][c]=='g' or c==0}
ringpx=set()
for r in range(1,63):
    for c in range(1,63):
        ch=g[r][c]
        if ch in 'BWGgcw': continue
        if all(g[r+dr][c+dc] in 'BW' for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))): ringpx.add((r,c))
HALFC={'p':(45,16),'N':(17,34),'b':(33,11)}
HB={k:shape(v,BLOB) for k,v in HALFC.items()}
RINGA=(12,51)
RA={p for p in ringpx if abs(p[0]-12)<=3 and abs(p[1]-51)<=3}
RB=ringpx-RA
chainL=[(11,11),(19,4),(19,22)]
obRfin={(51,16),(59,6)}|shape((55,11),BLOB)
allHB=set().union(*HB.values())
n=3
VP={(r,c) for r in range(2,62) for c in range(2,62) if okp((r,c),DIA,BLOCK) and not (shape((r,c),DIA)&(ringpx|allHB|obRfin))}
rng=random.Random(3)
def gen(T,cap=60,win=15):
    pool=[p for p in VP if abs(p[0]-T[0])<=win and abs(p[1]-T[1])<=win]
    out=set()
    for _ in range(25000):
        if len(out)>=cap: break
        pts=[]; ok=True
        for i in range(2):
            for _a in range(60):
                p=pool[rng.randrange(len(pool))]
                if all(sep(p,q) for q in pts): pts.append(p); break
            else: ok=False; break
        if not ok: continue
        s0=pts[0][0]+pts[1][0]; s1=pts[0][1]+pts[1][1]; done=False
        for d0 in range(3):
            for d1 in range(3):
                c=(3*T[0]+d0-s0, 3*T[1]+d1-s1)
                if c in VP and all(sep(c,q) for q in pts):
                    out.add(tuple(sorted(pts+[c]))); done=True; break
            if done: break
    return [list(t) for t in out]
def feas(cur,T,avoid,allow):
    for perm in itertools.permutations(range(3)):
        dest={perm[k]:T[k] for k in range(3)}
        if all(cur[i]==dest[i] for i in range(3)): continue
        for order in itertools.permutations(range(3)):
            e=list(cur); ok=True
            for i in order:
                if e[i]==dest[i]: continue
                e[i]=dest[i]
                last=all(e[j]==dest[j] for j in range(3))
                s=shape(bp(e),BLOB)
                if not okp(bp(e),BLOB,BLOCK) or (s&(RB|obRfin)): ok=False; break
                if any(s & shape(x,DIA) for x in e): ok=False; break
                if last:
                    if not (s<=allow): ok=False; break
                elif s & avoid: ok=False; break
            if ok: return (perm,order)
    return None
best_overall=None
for perm in itertools.permutations(['p','N','b']):
    phases=[]; rem=set(['p','N','b'])
    for ci in perm:
        rem.discard(ci)
        phases.append((HALFC[ci], set().union(*[HB[x] for x in rem]) if rem else set(), HB[ci]))
    phases.append((RINGA, set(), shape(RINGA,BLOB)|RA))
    cur=list(chainL); moves=[]; tot=0; okall=True
    for pi,(T,avoid,allow) in enumerate(phases):
        bst=None
        for t in gen(T):
            r=feas(cur,t,avoid,allow)
            if not r: continue
            mv=diff(cur,t)
            nxt=phases[pi+1][0] if pi+1<len(phases) else T
            cost=mv*100+sum(max(abs(a[0]-nxt[0]),abs(a[1]-nxt[1])) for a in t)*0.01
            if bst is None or cost<bst[0]: bst=(cost,t,r,mv)
        if not bst: okall=False; break
        _,t,(pm,order),mv=bst
        dest={pm[k]:t[k] for k in range(3)}
        for i in order:
            if cur[i]==dest[i]: continue
            moves.append((cur[i],dest[i])); cur[i]=dest[i]
        tot+=mv
    if okall and (best_overall is None or tot<best_overall[0]): best_overall=(tot,moves,[tuple(x) for x in cur])
print('L moves',best_overall[0],'endpoints',best_overall[2])
active=(59,6); clicks=[]
for frm,to in best_overall[1]:
    if frm!=active: clicks.append({'action':'MOUSE','row':frm[0],'col':frm[1]})
    clicks.append({'action':'MOUSE','row':to[0],'col':to[1]})
    active=to
print('clicks',len(clicks))
res=action(clicks)
print('exec',res['executed'],res.get('stop_reason'),'lvl_done',res['level_completed'],res['state'],res.get('done'))
