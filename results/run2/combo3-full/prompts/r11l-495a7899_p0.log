        best=None
        for t in cands:
            r=feas(cur,t,avoid,allow)
            if not r: continue
            mv=diff(cur,t)
            nxt=phases[pi+1][0] if pi+1<len(phases) else T
            cost=mv*3+max(abs(t[0][0]-nxt[0])+abs(t[0][1]-nxt[1]),0)*0.01
            if best is None or cost<best[0]: best=(cost,t,r,mv)
        if not best: return None
        _,t,(perm,order),mv=best
        dest={perm[k]:t[k] for k in range(n)}
