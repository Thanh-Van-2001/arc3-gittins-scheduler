            clicks.append({'action':'MOUSE','row':dest[i][0],'col':dest[i][1]})
            cur[i]=dest[i]
        tot+=mv
        info.append((pi,T,[tuple(x) for x in t],bp(cur)))
    return clicks,tot,info,cur
