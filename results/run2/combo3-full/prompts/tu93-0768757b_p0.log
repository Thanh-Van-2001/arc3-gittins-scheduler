from collections import deque
def lvl7c(P0,C0,rows,DL=(('UP',-1,0),('DOWN',1,0),('LEFT',0,-1),('RIGHT',0,1))):
    F=set((r,c) for r,cs in rows.items() for c in cs)
    def mv(p):
        o=[]
        for n,dr,dc in DL:
            m=(p[0]+dr,p[1]+dc); l=(p[0]+2*dr,p[1]+2*dc)
            if m in F and l in F: o.append(l)
        return o
    ADJ={p:mv(p) for p in F}
    def dist(t):
        dd={t:0}; q=deque([t])
        while q:
            u=q.popleft()
            for v in ADJ[u]:
                if v not in dd: dd[v]=dd[u]+1; q.append(v)
        return dd
    def mvdir(p):
        o={}
        for n,dr,dc in DL:
            m=(p[0]+dr,p[1]+dc); l=(p[0]+2*dr,p[1]+2*dc)
            if m in F and l in F: o[n]=l
        return o
    AD2={p:mvdir(p) for p in F}
    def ch_bfs(c,p):
        dd=dist(p); b=min(dd[v] for v in ADJ[c])
        return [v for v in ADJ[c] if dd[v]==b] if b<dd[c] else [c]
    def ch_gr(c,p,tie):
        dy=p[0]-c[0]; dx=p[1]-c[1]; A=AD2[c]
        if abs(dy)>=abs(dx):
            order=(['DOWN','UP'] if dy>0 else ['UP','DOWN'])+(['RIGHT','LEFT'] if dx>0 else ['LEFT','RIGHT'])
        else:
            order=(['RIGHT','LEFT'] if dx>0 else ['LEFT','RIGHT'])+(['DOWN','UP'] if dy>0 else ['UP','DOWN'])
        if tie=='h': order=order[2:]+order[:2]
        for n in order:
            if n in A: return [A[n]]
        return [c]
    MODELS={'gv':lambda c,p:ch_gr(c,p,'v'),'gh':lambda c,p:ch_gr(c,p,'h'),'bfsall':ch_bfs}
    G=(10,16); RP=(8,14); RF=(8,12); res={}
    for k,m in MODELS.items():
        st=(P0,C0,True); par={st:None}; q=deque([st]); sol=None
        while q:
            p,c,al=q.popleft()
            if p==G: sol=(p,c,al); break
            for l in ADJ[p]:
                if l==c: continue
                if al and l==RF: continue
                al2=al and (l!=RP)
                resp=m(c,l)
                if any(x==l for x in resp): continue
                for nc in resp:
                    ns=(l,nc,al2)
                    if ns not in par: par[ns]=((p,c,al),l); q.append(ns)
        if not sol: res[k]=False; continue
        cur=sol; out=[]
        while par[cur]: prev,act=par[cur]; out.append((prev[0],cur[0],cur[1])); cur=prev
        out.reverse(); res[k]=out
    return res
