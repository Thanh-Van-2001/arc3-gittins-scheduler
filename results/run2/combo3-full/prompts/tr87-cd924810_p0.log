import itertools
cycP=['D','H','X3','C','K','B','G']; cycY=['E','P','X4','L','I','X5','O']; cycB=['A','X1','N','F','M','J','X2']
def d(i,j,n=7): return min((j-i)%n,(i-j)%n)
cur={'Ab':('A',),'B':0}
blue0={'A':0,'B':3,'C':5}   # row -> blue cycle idx (A,F,J)
k0={'A':5,'B':6,'C':1}      # row -> pink dial idx (p0 glyph)
off={'A':2,'B':5,'C':0}
q0={'A':(0,0),'B':(6,4),'C':(4,3)}  # row -> (pink idx, yellow idx) for D->E, G->I, K->L
# assignment: row C -> word2 (needs off 0). rows A,B -> words 1,3 in one of 2 ways.
res=[]
for way in ['A3','A1']:
    # way A3: rowA handles word3 (P,O), rowB handles word1 (O,P)
    for u_i in range(7):
        for w_i in range(7):
            if way=='A3':
                v_i=(u_i+2)%7
                need={'B':('u',u_i,'O'),'A':('v',v_i,'P'),'C':('w',w_i,'I')}
                # word1=(O,P) rowB -> p0=u,p1=v ; word3=(P,O) rowA -> p0=v,p1=u
            else:
                v_i=(u_i-2)%7
                need={'A':('u',u_i,'O'),'B':('v',v_i,'P'),'C':('w',w_i,'I')}
            if len({u_i,v_i,w_i})<3: continue
            # pink dial costs: row r k must equal idx of its p0
            pc=0
            for r in 'ABC':
                tgt={'B':u_i if way=='A3' else v_i,'A':v_i if way=='A3' else u_i,'C':w_i}[r]
                pc+=d(k0[r],tgt)
            # blue costs: row-> source glyph
            bc=d(blue0['C'],4)  # row C -> M
            if way=='A3': bc+=d(blue0['A'],2)+d(blue0['B'],3)
            else: bc+=d(blue0['A'],3)+d(blue0['B'],2)
            # q costs: assign roles to rows
            roles={'u':(need['A'][1] if way=='A1' else need['B'][1],'O'),'v':(need['B'][1] if way=='A3' else need['A'][1],'P'),'w':(w_i,'I')}
            best_q=None
            for qa in itertools.permutations('ABC'):
                qc=0
                for row,role in zip(qa,'uvw'):
                    pi,yl=roles[role]
                    yi=cycY.index(yl)
                    qc+=d(q0[row][0],pi)+d(q0[row][1],yi)
                if best_q is None or qc<best_q: best_q=qc
            res.append((bc+pc+best_q,way,u_i,v_i,w_i,bc,pc,best_q))
res.sort()
for r in res[:8]: print(r)
print('total solutions',len(res))
