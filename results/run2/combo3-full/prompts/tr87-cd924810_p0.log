def K(g):
    if isinstance(g,str): g=[g[i*5:(i+1)*5] for i in range(5)]
    cells=[(r,c) for r in range(5) for c in range(5) if g[r][c]=='1']
    def canon(cs):
        mr=min(r for r,c in cs); mc=min(c for r,c in cs)
        return str(sorted((r-mr,c-mc) for r,c in cs))
    best=None
    for m in (0,1):
        cs=[(r,-c) if m else (r,c) for r,c in cells]
        for k in range(4):
            for _ in range(k): cs=[(c,-r) for r,c in cs]
            s=canon(cs)
            if best is None or s<best: best=s
            for _ in range(3): cs=[(c,-r) for r,c in cs]
    return best
