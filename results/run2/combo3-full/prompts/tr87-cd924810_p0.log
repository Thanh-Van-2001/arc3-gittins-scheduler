def clusters(fr,r0,r1,c0,c1):
    a=fr.ascii.split('\n')
    cols=[c for c in range(c0,c1+1) if any(a[r][c]=='B' for r in range(r0,r1+1))]
    out=[];cur=[]
    for c in cols:
        if cur and c!=cur[-1]+1: out.append((cur[0],cur[-1])); cur=[]
        cur.append(c)
    if cur: out.append((cur[0],cur[-1]))
    return out
