import collections
LA,LB,LC,LD=16,18,15,14
def m4a(a): return (a+1)%LA
def m4b(a): return (a+1)%LB
def i4a(a): return (a-1)%LA
def i4b(a): return (a-1)%LB
def g2f(a): return (a+1)%6 if a<6 else a
def g2i(a): return (a-1)%6 if a<6 else a
def g3f(d): return (d+1)%7 if d<7 else d
def g3i(d): return (d-1)%7 if d<7 else d
def g1f(c): return 1-c if c<2 else c
GENS={'G4':(m4a,m4b,lambda c:(c+1)%LC,lambda d:(d+1)%LD),
      'R4':(i4a,i4b,lambda c:(c-1)%LC,lambda d:(d-1)%LD),
      'G2':(g2f,g2f,lambda c:c,lambda d:d),
      'R2':(g2i,g2i,lambda c:c,lambda d:d),
      'G3':(lambda a:a,lambda a:a,lambda c:c,g3f),
      'R3':(lambda a:a,lambda a:a,lambda c:c,g3i),
      'G1':(lambda a:a,lambda a:a,g1f,lambda d:d)}
start=(6,6,2,7)
q=collections.deque([(start,[])]); seen={start}; found=None
while q:
    s,w=q.popleft()
    if s[0]==15 and s[1]==15 and s[2]==14 and s[3]==13: found=(s,w); break
    for nm,(fa,fb,fc,fd) in GENS.items():
        ns=(fa(s[0]),fb(s[1]),fc(s[2]),fd(s[3]))
        if ns in seen: continue
        seen.add(ns); q.append((ns,w+[nm]))
print('found',found)
print('states',len(seen))
