GRID=set((r,c) for r in range(6,54,3) for c in range(3,45,3))
def analyze(b,a2):
    def cands(X):
        col=b.get(X)
        if col is None: return []
        out=[]
        for dr,dc in [(3,0),(3,3)]:
            Y=(X[0]+dr,X[1]+dc)
            if Y in GRID and a2.get(Y)==col: out.append(Y)
        return out
    succ={}
    amb={}
    for X in b:
        cs=cands(X)
        if len(cs)==1: succ[X]=cs[0]
        elif len(cs)>1: amb[X]=cs
    inv={}
    for x,y in succ.items(): inv.setdefault(y,[]).append(x)
    chains=[]
    for s in sorted([x for x in succ if not inv.get(x)]):
        cy=[s]; cur=s
        while cur in succ and succ[cur] not in cy:
            cur=succ[cur]; cy.append(cur)
        chains.append(cy)
    return chains,amb,succ
t=[t for t in transitions if t.after_frame.level==8][4]
chains,amb,succ=analyze(bmapN(t.before_frame),bmapN(t.after_frame))
for cy in chains: print(len(cy),cy)
print('ambiguous',amb)
