def comp_summary(fr):
    seg=fr.segmentation
    out=[]
    for n in seg['nodes']:
        bb=n['boundary']
        r0=min(p[0] for p in bb); r1=max(p[0] for p in bb); c0=min(p[1] for p in bb); c1=max(p[1] for p in bb)
        out.append((n['color'],n['pixels'],(r0,c0,r1,c1)))
    out.sort(key=lambda x:(x[2][0],x[2][1]))
    return out
