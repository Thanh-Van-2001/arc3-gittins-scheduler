def crowncells():
    a=current_frame.ascii.split('\n')
    P=[(r,c) for r in range(64) for c in range(64) if a[r][c]=='P']
    g={}
    for r,c in P: g.setdefault(c//20,[]).append((r,c))
    return [bb(v) for k,v in sorted(g.items())]
def push_if_needed(th=8):
    ob=obboxes()
    if not ob: return None
    best=None
    for cb in crowncells():
        d=min(cheb(cb,b) for b,c,p in ob)
        if d<th and (best is None or d<best[0]): best=(d,cb)
    if not best: return None
    cb=best[1]; core=(cb[0]+1,cb[1]+2)
    cands=[]
    for tgt in [(core[0]+7,core[1]),(core[0],core[1])]:
