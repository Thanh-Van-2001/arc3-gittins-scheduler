def push_plus(T,b,d,occ=frozenset()):
    cells=lambda bb: pluscells(bb)
    def clean(bb): return all(T[c]!='P' for c in cells(bb))
    def passable(bb): return all(T[c]!='X' and c not in occ for c in cells(bb))
    k=0
    while True:
        nb=(b[0]+d[0],b[1]+d[1])
        if not passable(nb): break
        b=nb; k+=1
        if k>=5 and clean(b): break
    return b
from collections import deque
D={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
def bfs(T,start,goal,occ=frozenset()):
    q=deque([(start,[])]); seen={start}
    while q:
        b,path=q.popleft()
        if b==goal: return path
        for nm,d in D.items():
            nb=push_plus(T,b,d,occ)
            if nb!=b and nb not in seen:
                seen.add(nb); q.append((nb,path+[nm]))
    return None
print('route yellow (8,5)->(1,10) no occ:',bfs(T,(8,5),(1,10)))
print('route with green at (8,5) occ:',bfs(T,(8,5),(1,10),frozenset({(8,5)})))
