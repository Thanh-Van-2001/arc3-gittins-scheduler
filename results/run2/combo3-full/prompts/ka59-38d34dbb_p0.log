def mkplan(T,Y,g1,g2,pid,macro,finish):
    acts=[]; pos=[g1,g2]; log=[]
    for (kind,i,dn,c) in macro:
        d={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}[dn]
        other=1-i
        yc=set(pluscells(Y))
        if pid!=i:
            px=cellpx(pos[i][0],pos[i][1])[4]
            acts.append({'action':'MOUSE','row':px[0],'col':px[1]}); pid=i
        pth=wpath(T,pos[i],c,set(yc)|{pos[other]})
        if pth is None: return None,'no path %s->%s'%(pos[i],c)
        acts+=pth; pos[i]=c; acts.append(dn)
        nY=pp(T,Y,d,frozenset({pos[other],c}))
        if nY==Y: return None,'noop push %s %s'%(Y,dn)
        Y=nY; log.append((Y,tuple(pos)))
    for (i,target) in finish:
        if pid!=i:
            px=cellpx(pos[i][0],pos[i][1])[4]
            acts.append({'action':'MOUSE','row':px[0],'col':px[1]}); pid=i
        pth=wpath(T,pos[i],target,set(pluscells(Y))|{pos[1-i]})
        if pth is None: return None,'finish no path %s->%s'%(pos[i],target)
        acts+=pth; pos[i]=target; log.append((Y,tuple(pos)))
    return acts,(Y,tuple(pos))
