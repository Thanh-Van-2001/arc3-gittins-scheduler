T0=terrain(current_frame)
def tget(T,i,j):
    if 0<=i<18 and 0<=j<18: return T[(i,j)]
    return 'X'
def pp(T,b,d,occ):
    def clean(bb): return all(tget(T,x,y)!='P' for x,y in pluscells(bb))
    def passable(bb): return all(tget(T,x,y)!='X' and (x,y) not in occ for x,y in pluscells(bb))
    k=0
    while True:
        nb=(b[0]+d[0],b[1]+d[1])
        if not passable(nb): break
        b=nb; k+=1
        if k>=5 and clean(b): break
    return b
DIRS={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
def bfs2(T,start,goal,occ):
    from collections import deque
    q=deque([(start,[])]); seen={start}
    while q:
        b,path=q.popleft()
        if b==goal: return path
        for nm,d in DIRS.items():
            nb=pp(T,b,d,occ)
            if nb!=b and nb not in seen: seen.add(nb); q.append((nb,path+[nm]))
    return None
