def walk(T,f,t,blk):
    from collections import deque
    if f==t: return []
    if t not in blk and t not in blk:
        pass
    q=deque([f]); par={f:None}
    while q:
        p=q.popleft()
        for d,dv in ((-1,0),(1,0),(0,-1),(0,1)):
            n=(p[0]+dv[0],p[1]+dv[1])
            if n in par: continue
            if tget(T,n[0],n[1])!='.': continue
            if n in blk: continue
            par[n]=p
            if n==t:
                out=[]; cur=n
                while cur!=f:
                    dd=(cur[0]-par[cur][0],cur[1]-par[cur][1])
                    out.append({(-1,0):'UP',(1,0):'DOWN',(0,-1):'LEFT',(0,1):'RIGHT'}[dd]); cur=par[cur]
                return out[::-1]
            q.append(n)
    return None
MOV={(-1,0):'UP',(1,0):'DOWN',(0,-1):'LEFT',(0,1):'RIGHT'}
def plan_actions(T,Y,g1,g2,pid,macro,finish):
    acts=[]; pos=[g1,g2]; ok=True
    for (kind,i,dn,c) in macro:
        d={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}[dn]
        other=1-i
        yc=set(pluscells(Y))
        if pid!=i:
