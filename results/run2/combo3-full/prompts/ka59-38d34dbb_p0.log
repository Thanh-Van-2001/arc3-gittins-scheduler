def wpath(T,f,t,blk):
    from collections import deque
    if f==t: return []
    MV={(-1,0):'UP',(1,0):'DOWN',(0,-1):'LEFT',(0,1):'RIGHT'}
    par={f:None}
    q=deque([f])
    while q:
        p=q.popleft()
        for dv in ((-1,0),(1,0),(0,-1),(0,1)):
            n=(p[0]+dv[0],p[1]+dv[1])
            if n in par: continue
            if tget(T,n[0],n[1])!='.': continue
            if n in blk: continue
            par[n]=p
            if n==t:
                out=[]; cur=n
                while cur!=f:
                    pr=par[cur]
                    out.append(MV[(cur[0]-pr[0],cur[1]-pr[1])]); cur=pr
                return out[::-1]
            q.append(n)
    return None
