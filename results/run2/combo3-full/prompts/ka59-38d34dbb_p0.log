        blk=set(pluscells(Y))|{pos[1-i]}
        pth=walk(T,pos[i],target,blk)
        if pth is None: return None,'finish no path %s->%s'%(pos[i],target)
        acts+=pth; pos[i]=target
    return acts,(Y,pos[0],pos[1])
