import heapq, itertools
g0,src=build(2)
base=[list(r) for r in g0]
redA=[(4,2),(4,3),(4,4)]; redB=[(6,7),(6,8),(6,9)]
cav=(4,8,12)
def grid_from(extra, removed):
    g=[list(r) for r in base]
    for (r,c) in removed: g[r][c]='.'
    for (r,c) in extra: g[r][c]='#'
    return g
def simulate(state, br, bc):
    extra, reds, pos, w = state
    g=grid_from(extra, reds)
    bar=[(br,bc+i) for i in range(w)]
    if any(g[r][c]!='.' for r,c in bar): return None
    W,lk=flow2(g,10,bar)
    fills=[c for c in cav if W[2][c]]
    win = (len(fills)==3 and not lk)
    swap=None
    for rc in reds:
        for (r,c) in rc:
            if W[r-1][c]:
                # swap with this red bar group
                swap=(tuple(sorted(rc)), tuple(sorted(bar)))
                break
        if swap: break
    return win, lk, fills, swap
start=(frozenset(), (tuple(redA),tuple(redB)), (4,7), 5)
def placements(w):
    return [(r,c) for r in range(4,15) for c in range(17-w)]
def solve(maxshots=3):
    best={}
    pq=[(0,start,[])]
    best[(start[0],start[2],start[3],start[1])]=0
    results=[]
    while pq:
        cost,st,path=heapq.heappop(pq)
        extra,reds,pos,w=st
        if cost>best.get((extra,reds,pos,w),999): continue
        if len(path)>=maxshots*2: continue
