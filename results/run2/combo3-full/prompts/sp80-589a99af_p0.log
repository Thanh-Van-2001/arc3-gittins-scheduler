import heapq
g0,src=build(2)
base=[list(r) for r in g0]
redA=((4,2),(4,3),(4,4)); redB=((6,7),(6,8),(6,9)); cav=(4,8,12)
def gridf(extra, removed):
    g=[list(r) for r in base]
    for grp in removed:
        for (r,c) in grp: g[r][c]='.'
    for (r,c) in extra: g[r][c]='#'
    return g
def solve(needclean, maxshots=3, maxmove=16, passable=False):
    start=(frozenset(),(),(4,7),5)
    best={start:0}; pq=[(0,start,[])]; out=[]; allreds=(redA,redB)
    while pq:
        cost,st,path=heapq.heappop(pq)
        if cost>best.get(st,999): continue
        extra,removed,pos,w=st
        if len(path)>=maxshots: continue
        g=gridf(extra,removed) if not passable else gridf(frozenset(),removed)
        for br in range(4,15):
            for bc in range(17-w):
                bar=[(br,bc+i) for i in range(w)]
                if any(g[r][c]!='.' for r,c in bar): continue
                mv=abs(br-pos[0])+abs(bc-pos[1])
                if mv>maxmove: continue
                W,lk=flow2(g,10,bar)
                fills=[c for c in cav if W[2][c]]
                nc=cost+mv+1
                if len(fills)==3 and (not needclean or not lk):
                    out.append((nc,path+[(pos,(br,bc),fills,lk)])); continue
                sw=None
                for grp in allreds:
                    if grp in removed: continue
                    if grp[0][0] > br and any(W[r-1][c] for (r,c) in grp):
                        sw=(grp,tuple(bar)); break
                if sw:
                    grp,barc=sw
                    nst=(frozenset(set(extra)|set(barc)), removed+(grp,),(grp[0][0],grp[0][1]),len(grp))
                    if nc<best.get(nst,999):
                        best[nst]=nc; heapq.heappush(pq,(nc,nst,path+[(pos,(br,bc),fills,lk)]))
    return sorted(out)
for clean in (True,False):
    for passable in (False,True):
        r=solve(clean,3,16,passable)
        print('clean',clean,'passable',passable,'->',len(r),(r[0][0] if r else None))
        if r:
            for s in r[0][1]: print('   ',s)
