def flow2(g, srccol, bar, maxrow=16):
    S=[list(r) for r in g]
    for (r,c) in bar: S[r][c]='#'
    W=[[False]*16 for _ in range(16)]
    leak=[False]
    seen=set()
    def solid(r,c): return r<0 or r>=maxrow or c<0 or c>15 or S[r][c]!='.'
    def rise(c,r):
        # rise in column c starting from row r (r is lowest free start), go upward
        while r>=0 and not solid(r,c):
            W[r][c]=True
            if r==1: leak[0]=True
            if solid(r-1,c):
                spread(c,r); return
            r-=1
    def spread(c,r):
        for d in (-1,1):
            cc=c+d
            while True:
                if solid(r,cc): break
                W[r][cc]=True
                if not solid(r-1,cc):
                    key=(cc,r-1,'rise')
                    if key not in seen:
                        seen.add(key); rise(cc,r-1)
                    break
                cc+=d
    key=(srccol,maxrow-1,'rise')
    seen.add(key)
    rise(srccol,maxrow-1)
    return W,leak[0]
g0,src=build(2)
cav=[4,8,12]
def sm(W):
    f=[c for c in cav if W[2][c]]
    return f
best=[]
for br in range(3,15):
    for bc in range(12):
        bar=[(br,bc+i) for i in range(5)]
        if any(g0[r][c]!='.' for r,c in bar): continue
        W,lk=flow2(g0,10,bar)
        f=sm(W)
        best.append((len(f),not lk,br,bc,f,lk))
best.sort(reverse=True)
for x in best[:12]: print(x)
