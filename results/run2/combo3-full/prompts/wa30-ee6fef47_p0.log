def slots_filled(f, SLOTS=((28,12),(28,16),(32,12),(32,16),(36,12),(36,16))):
    occ=set()
    for n in f.segmentation['nodes']:
        if n['color'] in ('c','G','B'):
            b=n['boundary']; rs=[q[0] for q in b]; cs=[q[1] for q in b]
            r0,c0,r1,c1=min(rs),min(cs),max(rs),max(cs)
            for s in SLOTS:
                if r0<=s[0]<=r1 and c0<=s[1]<=c1: occ.add(s)
    return [s for s in SLOTS if s in occ]
def solve(nsteps, AMB=(20,16), SLOTS=((28,12),(32,12),(36,12),(28,16),(32,16),(36,16))):
    import collections
    D={(-4,0):'UP',(4,0):'DOWN',(0,-4):'LEFT',(0,4):'RIGHT'}
    SLOTS=list(SLOTS); log=[]
    for i in range(nsteps):
        P,off,objs,blk=gstate(current_frame)
        filled=slots_filled(current_frame,SLOTS)
        if len(filled)==6: return log+['ALLFILLED']
        if off:
            occ=set(filled)|{P}
            goals=[]
            for s in SLOTS:
                if s in occ: continue
                t=(s[0]-off[0],s[1]-off[1])
                if frame_ok(t,off,blk): goals.append(t)
            pth=bfs2(P,set(goals),blk,off) if goals else None
            if pth is None: log.append(('nodoc',P,off,filled)); break
            if not pth: action(['SPACE']); log.append(('DROP',P,off)); continue
            action([pth[0]]); log.append(('carry',pth[0])); continue
        mv=sorted([p for c,p in objs if c=='B'])
        hit=None
        for pos in mv:
            dr=pos[0]-P[0]; dc=pos[1]-P[1]
            if (abs(dr)==4 and dc==0) or (abs(dc)==4 and dr==0): hit=(D[(dr,dc)],pos); break
        if hit:
            action([hit[0]])
            hasG=any(n['color']=='G' and n['pixels']<=28 for n in current_frame.segmentation['nodes'])
            if hasG: action(['SPACE']); log.append(('ATTACH',hit[1]))
            else: log.append(('bumpfail',hit))
            continue
        # move to ambush cell; if occupied/unreachable, nearest free near it
        if P!=AMB:
            pth=bfs2(P,{AMB},blk)
            if pth: action([pth[0]]); log.append(('toAmb',pth[0],P)); continue
            cand=[c for c in [(AMB[0],AMB[1]-4),(AMB[0],AMB[1]+4),(AMB[0]-4,AMB[1]),(AMB[0]+4,AMB[1])] if frame_ok(c,(0,0),blk)]
            pth=bfs2(P,set(cand),blk)
            if pth: action([pth[0]]); log.append(('toAmb2',pth[0])); continue
        action(['SPACE']); log.append(('wait',P,[p for p in mv]))
    return log
print(solve(8))
