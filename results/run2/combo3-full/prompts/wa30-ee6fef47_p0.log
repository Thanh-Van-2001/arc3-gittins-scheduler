def cstate2(f):
    N=None; cores=[]; objs=[]; blk=set()
    for n in f.segmentation['nodes']:
        b=n['boundary']; rs=[q[0] for q in b]; cs=[q[1] for q in b]
        r0,c0,r1,c1=min(rs),min(cs),max(rs),max(cs); col=n['color']; px=n['pixels']
        if col=='N' and px<=12: N=(r0,c0,r1,c1)
        elif col=='b' and px==4: cores.append((r0,c0))
        elif col in ('c','G','B') and px<=40:
            objs.append((col,(r0,c0)))
            for r in range(r0,r1+1):
                for c in range(c0,c1+1): blk.add((r,c))
        elif col=='O' and px<=16:
            objs.append(('O',(r0,c0)))
            for r in range(r0,r1+1):
                for c in range(c0,c1+1): blk.add((r,c))
    if N is None: return None
    nc=((N[0]+N[2])/2.0,(N[1]+N[3])/2.0)
    near=[c for c in cores if abs(c[0]+1.5-nc[0])<=6 and abs(c[1]+1.5-nc[1])<=6]
    if not near:
        P=(N[0],N[1])
        for r in range(4):
            for c in range(4): blk.discard((P[0]+r,P[1]+c))
        return {'P':P,'off':None,'objs':objs,'blk':blk}
    fc=near[0]; fr=(fc[0]-1,fc[1]-1)
    dr=1 if nc[0]>fr[0]+2 else (-1 if nc[0]<fr[0]+1 else 0)
    dc=1 if nc[1]>fr[1]+2 else (-1 if nc[1]<fr[1]+1 else 0)
    off=(4*dr,0) if dr else (0,4*dc)
    P=(fr[0]-off[0],fr[1]-off[1])
    for r in range(4):
        for c in range(4): blk.discard((P[0]+r,P[1]+c))
    return {'P':P,'off':off,'objs':objs,'blk':blk}
def solve2(nsteps, WAIT=(20,16), AMB=(24,16), SLOTS=((28,16),(32,12),(32,16),(36,12),(36,16),(28,12))):
    D={(-4,0):'UP',(4,0):'DOWN',(0,-4):'LEFT',(0,4):'RIGHT'}
    SLOTS=list(SLOTS); log=[]
    for i in range(nsteps):
        s=cstate2(current_frame)
        if s is None: log.append('noplayer'); break
        P,off,objs,blk=s['P'],s['off'],s['objs'],s['blk']
        filled=slots_filled(current_frame,SLOTS)
        if len(filled)>=6: return log+['ALLFILLED']
        if off:
            occ=set(filled)|{P}
            goals=set()
            for sl in SLOTS:
                if sl in occ: continue
                t=(sl[0]-off[0],sl[1]-off[1])
                if frame_ok(t,off,blk): goals.add(t)
            pth=bfs2(P,goals,blk,off) if goals else None
            if pth is None: log.append(('nodoc',P,off,sorted(goals))); break
            if not pth:
                action(['SPACE']); log.append(('DROP',P,off)); continue
            action([pth[0]]); log.append(('carry',pth[0])); continue
        mv=[p for c,p in objs if c=='B']
        hit=None
        for pos in mv:
            dr=pos[0]-P[0]; dc=pos[1]-P[1]
            if (abs(dr)==4 and dc==0) or (abs(dc)==4 and dr==0): hit=(D[(dr,dc)],pos); break
        if hit:
            action([hit[0]])
            hasG=any(n['color']=='G' and n['pixels']<=28 for n in current_frame.segmentation['nodes'])
            if hasG:
                action(['SPACE']); log.append(('ATTACH',hit[1]))
            else: log.append(('bumpfail',hit,P))
            continue
        nearB=[p for p in mv if abs(p[0]-AMB[0])+abs(p[1]-AMB[1])<=16]
        tgt=AMB if nearB else WAIT
        if P!=tgt:
            pth=bfs2(P,{tgt},blk)
            if pth: action([pth[0]]); log.append(('go',pth[0],tgt,P)); continue
            log.append(('nopath',tgt,P)); 
        action(['SPACE']); log.append(('wait',P,mv))
    return log
