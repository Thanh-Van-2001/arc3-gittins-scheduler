def cstate(f):
    N=None; cores=[]; objs=[]; blk=set()
    for n in f.segmentation['nodes']:
        b=n['boundary']; rs=[q[0] for q in b]; cs=[q[1] for q in b]
        r0,c0,r1,c1=min(rs),min(cs),max(rs),max(cs); col=n['color']; px=n['pixels']
        if col=='N' and px<=12: N=(r0,c0,r1,c1)
        elif col=='b' and px==4: cores.append((r0,c0))
        elif col in ('c','G','B') and px<=40:
            objs.append((col,(r0,c0)))
            for r in range(r0,r1+1):
                for c in range(c0,c1+1): blk.add((r,c))
        elif col=='O' and px<=16:
            objs.append(('O',(r0,c0)))
            for r in range(r0,r1+1):
                for c in range(c0,c1+1): blk.add((r,c))
    if N is None: return None
    nc=((N[0]+N[2])/2.0,(N[1]+N[3])/2.0)
    near=[c for c in cores if abs(c[0]+1-nc[0])<=4 and abs(c[1]+1-nc[1])<=4]
    if not near:
        P=(N[0],N[1])
        for r in range(4):
            for c in range(4): blk.discard((P[0]+r,P[1]+c))
        return {'P':P,'off':None,'objs':objs,'blk':blk,'N':N}
    fc=near[0]
    fr=(fc[0]-1,fc[1]-1)  # frame 4x4 topleft
    dr=0 if abs((fr[0]+1.5)-nc[0])<1 else (1 if nc[0]>fr[0]+1.5 else -1)
    dc=0 if abs((fr[1]+1.5)-nc[1])<1 else (1 if nc[1]>fr[1]+1.5 else -1)
    off=(4*dr,0) if dr else (0,4*dc)
    P=(fr[0]-off[0],fr[1]-off[1])
    for r in range(4):
        for c in range(4): blk.discard((P[0]+r,P[1]+c))
    return {'P':P,'off':off,'objs':objs,'blk':blk,'N':N,'frame':fr}
