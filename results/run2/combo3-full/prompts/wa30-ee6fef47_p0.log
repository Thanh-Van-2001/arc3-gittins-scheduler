def bfs2(start,goals,blk,off=(0,0)):
    import collections
    D={(-4,0):'UP',(4,0):'DOWN',(0,-4):'LEFT',(0,4):'RIGHT'}
    def ok(c): return frame_ok(c,off,blk)
    if start in goals: return []
    q=collections.deque([(start,[])]); seen={start}
    while q:
        cur,path=q.popleft()
        for (dr,dc),a in D.items():
            nx=(cur[0]+dr,cur[1]+dc)
            if nx in seen or not ok(nx): continue
            npath=path+[a]
            if nx in goals: return npath
            seen.add(nx); q.append((nx,npath))
    return None
def ctrl4(nsteps, SLOTS=((28,12),(28,16),(32,12),(32,16),(36,12),(36,16))):
    D={(-4,0):'UP',(4,0):'DOWN',(0,-4):'LEFT',(0,4):'RIGHT'}
    SLOTS=list(SLOTS); log=[]; prev=[]; vel=(0,0)
    for i in range(nsteps):
        P,off,objs,blk=gstate(current_frame)
        filled=[p for c,p in objs if c in ('c','G','B') and p in SLOTS]
        if len(filled)==6: return log+['ALLFILLED']
        if off:
            occ=set(p for c,p in objs if p in SLOTS)|{P}
            goals=set()
            for s in SLOTS:
                if s in occ: continue
                t=(s[0]-off[0],s[1]-off[1])
                if frame_ok(t,off,blk): goals.add(t)
            pth=bfs2(P,goals,blk,off) if goals else None
            if pth is None: log.append(('nodoc',P,off,sorted(goals))); break
            if not pth:
                action(['SPACE']); log.append(('DROP',P,off)); continue
            action([pth[0]]); log.append(('carry',pth[0],len(pth))); continue
        mv=sorted([p for c,p in objs if c=='B'])
        hit=None
        for pos in mv:
            dr=pos[0]-P[0]; dc=pos[1]-P[1]
            if (abs(dr)==4 and dc==0) or (abs(dc)==4 and dr==0): hit=(D[(dr,dc)],pos); break
        if hit:
            action([hit[0]])
            hasG=any(n['color']=='G' and n['pixels']<=28 for n in current_frame.segmentation['nodes'])
            if hasG: action(['SPACE']); log.append(('ATTACH',hit[1]))
            else: log.append(('bumpfail',hit))
            prev=[]; continue
        if mv:
            if prev:
                for p in mv:
                    for q2 in prev:
                        if abs(p[0]-q2[0])+abs(p[1]-q2[1]) in (0,4): vel=((p[0]-q2[0])//4,(p[1]-q2[1])//4)
            prev=list(mv)
            tp=min(mv,key=lambda p:abs(p[0]-P[0])+abs(p[1]-P[1]))
            for tgt in (tp,(tp[0]+4*vel[0],tp[1]+4*vel[1])):
                goals=set(g for g in [(tgt[0]-4,tgt[1]),(tgt[0]+4,tgt[1]),(tgt[0],tgt[1]-4),(tgt[0],tgt[1]+4)] if frame_ok(g,(0,0),blk))
                goals.discard(P)
                pth=bfs2(P,goals,blk) if goals else None
                if pth:
                    action([pth[0]]); log.append(('chaseB',pth[0],tp,vel)); break
            else:
                log.append(('stuckB',P,tp,vel)); break
            continue
        prev=[]
        home=(36,20)
        if P!=home:
            pth=bfs2(P,{home},blk)
            if pth:
                action([pth[0]]); log.append(('goHome',pth[0])); continue
        a='LEFT' if P[1]%8==4 else 'RIGHT'
        action([a]); log.append(('wait',a))
    return log
