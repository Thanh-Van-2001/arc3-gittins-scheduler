def b1_search(greens, purples=((1,2),(1,4)), rows=3, cols=7):
    from collections import deque
    P = set(purples)
    cells = [(r,c) for r in range(rows) for c in range(cols)]
    lines=[]
    for r in range(rows):
        for c in range(cols-2): lines.append(((r,c),(r,c+1),(r,c+2)))
    for c in range(cols):
        for r in range(rows-2): lines.append(((r,c),(r+1,c),(r+2,c)))
    def nbrs(st):
        out=set()
        for a,b,c in lines:
            for x,y,z in ((a,b,c),(c,b,a)):
                if x in st and (y in st or y in P) and z not in st and z not in P:
                    ns = (st-{x})|{z}
                    ns.discard(y)
                    out.add(frozenset(ns))
        return out
    start = frozenset(greens)
    seen={start}; q=deque([start]); best=None
    while q:
        st=q.popleft()
        if len(st)==1: best=st; break
        for ns in nbrs(st):
            if ns not in seen: seen.add(ns); q.append(ns)
    return len(seen), (sorted(best) if best else None)
print('from initial (1,1),(1,6):', b1_search([(1,1),(1,6)]))
print('from current (1,3),(1,6):', b1_search([(1,3),(1,6)]))
