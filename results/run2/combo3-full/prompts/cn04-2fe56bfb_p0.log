        for k in range(4):
            nb,nr=normc(vb),normc(vr)
            if (nb,nr) not in vs: vs.append((nb,nr))
            vb=rot90c(vb); vr=rot90c(vr)
        variants[col]=vs
    return variants
def blocktls(rd):
    return sorted(p for p in rd if (p[0],p[1]+1) in rd and (p[0]+1,p[1]) in rd and (p[0]-1,p[1]) not in rd and (p[0],p[1]-1) not in rd)
def redblocks(rd):
    tls=blocktls(rd)
    return [frozenset((r+dr,c+dc) for dr in range(3) for dc in range(3)) for (r,c) in tls]
def search(variants, ref=('W',0,(11,11)), others=('N','Y','b'), maxsol=6):
    sols=[]
    rbv={col:[redblocks(rd) for (b,rd) in vs] for col,vs in variants.items()}
    def place(col,rot,anchor):
        b,rd=variants[col][rot]
        ar,ac=anchor
        return (col,rot,anchor,frozenset((r+ar,c+ac) for r,c in b),[frozenset((r+ar,c+ac) for r,c in blk) for blk in rbv[col][rot]])
    def valid(p,placed):
        for q in placed:
            if p[3]&q[3]: return False
            if p[3]&set().union(*q[4]): return False
            if q[3]&set().union(*p[4]): return False
            # red-red: blocks must coincide exactly or be disjoint
            for blk in p[4]:
                inter=set().union(*q[4]) & blk
                if inter:
                    if not any(inter==ob for ob in q[4]): return False
            for ob in q[4]:
                inter=set().union(*p[4]) & ob
                if inter and not any(inter==blk for blk in p[4]): return False
        # bounds
        allc=set(p[3])|set().union(*p[4])
        if min(r for r,c in allc)<2 or max(r for r,c in allc)>63 or min(c for r,c in allc)<0 or max(c for r,c in allc)>63: return False
        return True
    def count_pairs(placed):
        # count red blocks that have a partner
        paired=0
        allblocks=[(i,blk) for i,p in enumerate(placed) for blk in p[4]]
        for i,blk in allblocks:
            if any(j!=i and placed[j][4] and any(ob==blk for ob in placed[j][4]) for j in range(len(placed))): paired+=1
        return paired
    def total_blocks(placed): return sum(len(p[4]) for p in placed)
    def bt(remaining,placed):
        if len(sols)>=maxsol: return
        if not remaining:
            if count_pairs(placed)==total_blocks(placed): sols.append([(p[0],p[1],p[2]) for p in placed])
