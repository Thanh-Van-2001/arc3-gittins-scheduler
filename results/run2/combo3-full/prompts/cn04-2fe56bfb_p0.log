from itertools import permutations
def search3(variants, maxsol=50):
    best=[]
    rbv={col:[redblocks(rd) for (b,rd) in vs] for col,vs in variants.items()}
    def place(col,rot,anchor):
        b,rd=variants[col][rot]; ar,ac=anchor
        return (col,rot,anchor,frozenset((r+ar,c+ac) for r,c in b),[frozenset((r+ar,c+ac) for r,c in blk) for blk in rbv[col][rot]])
    def valid(p,placed):
        for q in placed:
            if p[3]&q[3]: return False
            if p[3]&set().union(*q[4]): return False
            if q[3]&set().union(*p[4]): return False
            for blk in p[4]:
                inter=set().union(*q[4]) & blk
                if inter and not any(inter==ob for ob in q[4]): return False
        allc=set(p[3])|set().union(*p[4])
        return min(r for r,c in allc)>=2 and max(r for r,c in allc)<=63 and min(c for r,c in allc)>=0 and max(c for r,c in allc)<=63
    def pairs(placed):
        blocks=[(i,blk) for i,p in enumerate(placed) for blk in p[4]]
        return sum(1 for i,blk in blocks if any(j!=i and any(ob==blk for ob in placed[j][4]) for j in range(len(placed))))
    def bt(remaining,placed):
        if not remaining:
            best.append((pairs(placed),[(p[0],p[1],p[2]) for p in placed])); return
        col=remaining[0]; cands={}
        for rot in range(len(variants[col])):
            for blk in rbv[col][rot]:
                tl=min(blk)
                for q in placed:
                    for ob in q[4]:
                        ot=min(ob)
                        p=place(col,rot,(ot[0]-tl[0],ot[1]-tl[1]))
                        if valid(p,placed): cands[(p[1],p[2])]=p
        for p in cands.values(): bt(remaining[1:],placed+[p])
    for wrot in range(4):
        base=[place('W',wrot,(11,11))]
        for perm in permutations(['N','Y','b']): bt(list(perm),base)
    best.sort(key=lambda t:-t[0])
    return best
