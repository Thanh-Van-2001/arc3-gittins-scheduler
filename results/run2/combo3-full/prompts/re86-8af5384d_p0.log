from collections import Counter
def st2(fr=None):
    fr=fr or current_frame; a=fr.ascii.split('\n'); r,c=Wpos(fr)[0]
    col=Counter(a[rr][c] for rr in range(max(0,r-14),min(64,r+15)) if a[rr][c] not in 'BW').most_common(1)[0][0]
