def simstep(st, act, C='RNOb'):
    h,k = st[0], st[1]
    pos = {c: st[2+i] for i,c in enumerate(C)}
    if act=='RIGHT':
        if k>=7: return st
        occ={pos[c][1]:c for c in C if pos[c] and pos[c][0]==h}
        seeds=[s for s in (k,k+1) if s in occ]
        np=dict(pos); moved=set()
        for s0 in sorted(seeds, reverse=True):
            if s0 in moved: continue
            hi=s0
            while hi+1 in occ and occ[hi+1] not in moved: hi+=1
            lo=s0
            while lo-1 in occ and occ[lo-1] not in moved: lo-=1
            if hi+1>7: return (h,k+1)+tuple(np[c] for c in C)
            for s in range(hi, lo-1, -1):
                c=occ[s]; np[c]=(h,s+1); moved.add(s)
        return (h,k+1)+tuple(np[c] for c in C)
    if act=='LEFT':
        if k<=0: return st
        occ={pos[c][1]:c for c in C if pos[c] and pos[c][0]==h}
        np=dict(pos)
        if k in occ:
            hi=k
            while hi+1 in occ: hi+=1
            lo=k
            while lo-1 in occ: lo-=1
            if lo-1>=1:
                for s in range(lo,hi+1):
                    c=occ[s]; np[c]=(h,s-1)
        return (h,k-1)+tuple(np[c] for c in C)
    d = -1 if act=='UP' else 1
    nh = h+d
    if nh<0 or nh>6: return st
    np=dict(pos)
    for s in range(1,k+1):
        col={pos[c][0]:c for c in C if pos[c] and pos[c][1]==s}
        if h in col or nh in col:
            anchor = h if h in col else nh
            lo=anchor
            while lo-1 in col: lo-=1
            hi=anchor
            while hi+1 in col: hi+=1
            if hi+d>6 or lo+d<0: return st
            for b in range(lo,hi+1):
                c=col[b]; np[c]=(b+d,s)
    return (nh,k)+tuple(np[c] for c in C)

def runplan(plan):
