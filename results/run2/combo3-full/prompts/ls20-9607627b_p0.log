            if 45<=rr<=49 and 9<=cc<=13: continue
            if 46<=rr<=48 and 30<=cc<=32: continue
            return False
    return True
POS=[(r,c) for r in range(0,56,5) for c in range(4,60,5) if passable(r,c)]
MV={'UP':(-5,0),'DOWN':(5,0),'LEFT':(0,-5),'RIGHT':(0,5)}
adj={p:[q for q in POS if abs(p[0]-q[0])+abs(p[1]-q[1])==5] for p in POS}
import collections
def bfs(s,g):
    prev={s:None}; q=collections.deque([s])
    while q:
        c=q.popleft()
        if c==g: break
        for n in adj[c]:
            if n not in prev: prev[n]=c; q.append(n)
    if g not in prev: return None
    out=[]; c=g
    while prev[c] is not None:
        p=prev[c]
        for m,(dr,dc) in MV.items():
            if (p[0]+dr,p[1]+dc)==c: out.append(m); break
        c=p
    return out[::-1]
