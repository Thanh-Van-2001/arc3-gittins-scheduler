import collections
def bfs(s,g):
    prev={s:None}; q=collections.deque([s])
    while q:
        c=q.popleft()
        if c==g: break
        for n in adj[c]:
            if n not in prev: prev[n]=c; q.append(n)
    if g not in prev: return None
    out=[]; c=g
