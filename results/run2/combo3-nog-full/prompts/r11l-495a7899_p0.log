def drive2(ends, handle, targets, keep, others, width=30, depth=9, verbose=True):
    ends=list(ends); rep=[]
    for T in targets:
        asc=current_frame.ascii.replace('S','B')
        cl=plan(asc, ends, handle, T, width=width, depth=depth, W=3.5, blocked=blkset(current_frame.ascii,keep,others))
        if cl is None: return ('FAIL',T,rep)
        for (r,c) in cl:
            hit=None
            for i,p in enumerate(ends):
                if p==(r,c): hit=i
            if hit is not None and handle!=hit: handle=hit
            else:
                if handle is None: return ('NOHANDLE',(r,c),rep)
                ends[handle]=(r,c)
            res=action([{'action':'MOUSE','row':r,'col':c}])
            if res['game_over']: return ('OVER',T,rep)
            if res['level_completed']: return ('DONE',T,rep)
        bead=(sum(p[0] for p in ends)//len(ends), sum(p[1] for p in ends)//len(ends))
        rep.append((T,bead,len(cl)))
        if verbose: print('seg ->',T,'bead',bead,'clicks',len(cl))
    return ('OK',ends,handle,rep)
