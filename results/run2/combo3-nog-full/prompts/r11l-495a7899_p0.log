def cpx(ascii_str):
    A=ascii_str.split('\n')
    return [(r,c) for r in range(64) for c in range(64) if A[r][c]=='c']
def blkset(ascii_str, keep, others):
    blk=set()
    for cen,cols in findblobs(ascii_str):
        if cen in keep: continue
        if any(k not in 'WBg' for k in cols): blk.update(FP(*cen))
    for p in others: blk.update(FP(*p))
    return frozenset(blk)
def drive(ends, handle, targets, keep, others, width=30, depth=9, verbose=True):
    ends=list(ends); rep=[]
    for T in targets:
        cl=plan(current_frame.ascii, ends, handle, T, width=width, depth=depth, W=3.5, blocked=blkset(current_frame.ascii,keep,others))
        if cl is None: return ('FAIL',T,rep)
        for (r,c) in cl:
            hit=None
            for i,p in enumerate(ends):
                if p==(r,c): hit=i
            if hit is not None and handle!=hit:
                handle=hit
            else:
                if handle is None: return ('NOHANDLE',(r,c),rep)
                ends[handle]=(r,c)
            res=action([{'action':'MOUSE','row':r,'col':c}])
            if res['game_over']: return ('OVER',T,rep)
            if res['level_completed']: return ('DONE',T,rep)
        bead=(sum(p[0] for p in ends)//len(ends), sum(p[1] for p in ends)//len(ends))
        rep.append((T,bead,len(cl),cpx(current_frame.ascii)==sorted(set(ends)+ [q for q in cpx(current_frame.ascii) if q not in ends]) ))
        if verbose: print('seg',T,'bead',bead,'clicks',len(cl),'cpx_ok',sorted(cpx(current_frame.ascii))==sorted(set(cpx(current_frame.ascii))))
    return ('OK',ends,handle,rep)
