def pruns(f):
    a=f.ascii.split('\n')
    pts=[(r,c) for r in range(64) for c in range(64) if a[r][c]=='p']
    cols={}
    out=[]
    rows={}
    for r,c in pts: rows.setdefault(r,[]).append(c)
    for r in sorted(rows):
        cs=sorted(rows[r]); s=cs[0]; p=cs[0]; 
        for c in cs[1:]+[None]:
            if c is not None and c==p+1: p=c
            else:
                if p-s>=2: out.append('r%d:%d-%d'%(r,s,p))
                s=c if c is not None else s; p=s
    cc={}
    for r,c in pts: cc.setdefault(c,[]).append(r)
    for c in sorted(cc):
        rs=sorted(cc[c]); s=rs[0]; p=rs[0]
        for r in rs[1:]+[None]:
            if r is not None and r==p+1: p=r
            else:
                if p-s>=2: out.append('c%d:%d-%d'%(c,s,p))
                s=r if r is not None else s; p=s
    return len(pts), out
