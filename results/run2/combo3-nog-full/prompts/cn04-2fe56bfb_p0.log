import itertools
GREEN=( [(0,0),(0,1),(0,2),(0,3),(0,4),(1,0),(1,4),(2,0),(3,0),(4,0),(4,1)], [(2,4),(4,2),(5,0)] )
ORNG=( [(0,0),(0,1),(0,2),(0,3),(1,0),(1,3),(2,3),(3,3)], [(2,0),(3,2)] )
SKY=( [(0,0),(1,0),(2,0),(3,0),(4,0)], [(-1,0),(4,1)] )
def rot(cells,k):
    return [(-c,r) if k==1 else (r,c)][:0] or cells
def rotk(cells,k):
    out=[]
    for (r,c) in cells:
        if k==0: out.append((r,c))
        elif k==1: out.append((c,-r))
        elif k==2: out.append((-r,-c))
        else: out.append((-c,r))
    return out
def normsh(cells):
    mr=min(r for r,c in cells); mc=min(c for r,c in cells)
    return frozenset((r-mr,c-mc) for r,c in cells)
def pose4(body,tips):
    out=[]
    for k in range(4):
        B=normsh(rotk(body,k)); T=rotk(tips,k)
        # normalize tips by same shift
        mr=min(r for r,c in rotk(body,k)); mc=min(c for r,c in rotk(body,k))
        T=frozenset((r-mr,c-mc) for r,c in T)
        out.append((B,T))
    # dedupe
    uniq=[]
    seen=set()
    for B,T in out:
        if (B,T) in seen: continue
        seen.add((B,T)); uniq.append((B,T))
    return uniq
