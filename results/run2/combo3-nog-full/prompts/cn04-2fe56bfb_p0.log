        if x in comp: continue
        comp.add(x); seen.add(x)
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            y=(x[0]+dr,x[1]+dc)
            if y in cells and y not in comp: st.append(y)
    comps.append(sorted(comp))
