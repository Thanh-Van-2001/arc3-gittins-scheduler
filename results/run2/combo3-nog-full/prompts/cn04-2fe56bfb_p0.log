    yv=[('y%d'%k,)+variants(*YEL[k],False)[0] for k in sorted(YEL)]
    pv=[('p%d'%k,)+variants(*PUR[k],False)[0] for k in sorted(PUR)]
    gb,gt=variants(*GREEN)[0]
    gB=frozenset((r+goff[0],c+goff[1]) for r,c in gb); gT=frozenset((r+goff[0],c+goff[1]) for r,c in gt)
    sols=[]; state={'n':0}
    for oi,(OB,OT) in enumerate(ov):
        for si,(SB,ST) in enumerate(sv):
            for yn,YB,YT in yv:
                for pn,PB,PT in pv:
                    items=[('O%d'%oi,OB,OT),('S%d'%si,SB,ST),(yn,YB,YT),(pn,PB,PT)]
                    pB=[gB]; pT=[gT]; res=[('G',goff)]
                    def dfs(rem):
                        state['n']+=1
                        if state['n']>cap: return
                        if not rem:
                            cnt=collections.Counter()
                            for T in pT:
                                for c in T: cnt[c]+=1
                            if all(v==2 for v in cnt.values()): sols.append(list(res))
                            return
                        for i in range(len(rem)):
                            nm,B,T=rem[i]
                            offs=set()
                            for ET in pT:
                                for t in T:
                                    for e in ET: offs.add((e[0]-t[0],e[1]-t[1]))
                            for o in offs:
                                Bs=frozenset((r+o[0],c+o[1]) for r,c in B)
                                Ts=frozenset((r+o[0],c+o[1]) for r,c in T)
                                bad=False
                                for x in pB:
                                    if Bs&x: bad=True;break
                                if bad: continue
                                allT=set()
                                for x in pT: allT|=x
                                if Bs&allT: continue
                                cnt=collections.Counter()
                                for x in pT+[Ts]:
                                    for c in x: cnt[c]+=1
                                unp=sum(1 for v in cnt.values() if v==1)
                                remT=sum(len(x[2]) for x in rem)-len(T)
                                if unp>remT or (remT-unp)%2: continue
                                pB.append(Bs);pT.append(Ts);res.append((nm,o))
                                dfs(rem[:i]+rem[i+1:])
                                pB.pop();pT.pop();res.pop()
                    dfs(items)
                    if state['n']>cap: return sols,state['n'],True
    return sols,state['n'],False
