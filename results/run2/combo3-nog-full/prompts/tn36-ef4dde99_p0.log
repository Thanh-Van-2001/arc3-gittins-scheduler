def cfg6(f):
    a = f.ascii.split('\n')
    s = []
    for k in range(4):
        c = 38+5*k
        col = ('B' if a[33][c]=='B' else '.') + ('s' if a[36][c+1]=='B' else '.') + \
              ('B' if a[39][c]=='B' else '.') + ('s' if a[42][c+1]=='B' else '.') + \
