def leftmarks(f, r0=3,r1=32,c0=1,c1=31):
    out = []
    for n in f.segmentation['nodes']:
        b = n['boundary']
        rr = [p[0] for p in b]; cc = [p[1] for p in b]
        if min(rr)>=r0 and max(rr)<=r1 and min(cc)>=c0 and max(cc)<=c1 and n['pixels']>=6:
            out.append((n['color'], n['pixels'], (min(rr),min(cc),max(rr),max(cc))))
    return out
