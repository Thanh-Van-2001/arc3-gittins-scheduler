def solve3(pos, bar, rotidx, thr=8):
    import heapq
    V=set(mod(current_frame)['valid'])
    PL=(10,49); RA=(15,34); RB=(30,19); DEEP=(50,54)
    V2=set(V); V2.add(DEEP)
    start=(pos,bar,rotidx)
    pq=[(0,start,[])]; seen={start}
    while pq:
        d,st,acts=heapq.heappop(pq)
        p,b_,r_=st
        if p==DEEP and r_==0: return acts,b_
        r,c=p
        for dr,dc,nm in ((-5,0,'UP'),(5,0,'DOWN'),(0,-5,'LEFT'),(0,5,'RIGHT')):
            n=(r+dr,c+dc)
            if n not in V2: continue
            if n==DEEP and r_!=0: continue
            nb=b_-2
            if n in (RA,RB) and nb<=thr: nb=42
            if nb<=0: continue
            nr=(r_+1)%4 if n==PL else r_
            s2=(n,nb,nr)
            if s2 in seen: continue
            seen.add(s2); heapq.heappush(pq,(d+1,s2,acts+[(nm,n)]))
    return None,None
def l3run(n=10, thr=8):
    pos=tuple(blockpos(current_frame)[0]); bar=bar_now(); rot=l3rot(current_frame)
    acts,fb=solve3(pos,bar,rot,thr)
    if acts is None:
        return dict(err='no plan',pos=pos,bar=bar,rot=rot)
    seq=[a for a,_ in acts[:n]]
    r=action(seq)
    out=dict(planned_before=len(acts), batch=seq, pos_after=tuple(blockpos(current_frame)[0]),
             bar_after=bar_now(), rot_after=l3rot(current_frame),
             done={k:r.get(k) for k in ('level_completed','game_over','stop_reason')})
    return out
</parameter>
</function>
