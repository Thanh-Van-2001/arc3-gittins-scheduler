def solve3b(pos, bar, rotidx, thr=8):
    import heapq
    V=set(mod(current_frame)['valid'])
    PL=(10,49); RA=(15,34); RB=(30,19); DEEP=(50,54)
    def slide(n, rot):
        if n==(5,9):
            c=9
            while (5,c+5) in V: c+=5
            return (5,c)
        if n==(5,54):
            r=5
            while True:
                nx=(r+5,54)
                if nx in V or (nx==DEEP and rot==0): r+=5
                else: break
            return (r,54)
        return n
    V2=set(V); V2.add(DEEP)
    def go(st, acts, d, pq, seen):
        p,b_,r_=st
        r,c=p
        for dr,dc,nm in ((-5,0,'UP'),(5,0,'DOWN'),(0,-5,'LEFT'),(0,5,'RIGHT')):
            raw=(r+dr,c+dc)
            if raw not in V2: continue
            n=slide(raw,r_)
            if n==DEEP and r_!=0: continue
            nb=b_-2
            if n in (RA,RB) and nb<=thr: nb=42
            if nb<=0: continue
            nr=(r_+1)%4 if n==PL else r_
            s2=(n,nb,nr)
            if s2 in seen: continue
            seen.add(s2); heapq.heappush(pq,(d+1,s2,acts+[(nm,n)]))
    start=(pos,bar,rotidx)
    pq=[(0,start,[])]; seen={start}
    while pq:
        d,st,acts=heapq.heappop(pq)
        if st[0]==DEEP and st[2]==0: return acts,st[1],d
        go(st,acts,d,pq,seen)
    return None,None,None
def l3runb(n=8, thr=8):
    pos=tuple(blockpos(current_frame)[0]); bar=bar_now(); rot=l3rot(current_frame)
    acts,fb,d=solve3b(pos,bar,rot,thr)
    if acts is None: return dict(err='no plan',pos=pos,bar=bar,rot=rot)
    seq=[a for a,_ in acts[:n]]
    r=action(seq)
    return dict(plan_len=len(acts), endbar_model=fb, batch=seq, rest=[p for _,p in acts[:n]],
                pos_after=tuple(blockpos(current_frame)[0]), bar_after=bar_now(), rot_after=l3rot(current_frame),
                res={k:r.get(k) for k in ('level_completed','game_over','stop_reason')})
