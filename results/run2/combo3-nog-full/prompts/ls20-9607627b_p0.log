import collections
def bfs2(V,a,b,avoid=()):
    q=collections.deque([(a,[a])]); seen={a}
    while q:
        p,pa=q.popleft()
        if p==b: return pa
        r,c=p
        for dr,dc,nm in ((-5,0,'UP'),(5,0,'DOWN'),(0,-5,'LEFT'),(0,5,'RIGHT')):
            n=(r+dr,c+dc)
            if n in V and n not in seen and n not in avoid:
                seen.add(n); q.append((n,pa+[(nm,n)]))
    return None
def plan2(start=(40,29)):
    V=mod(current_frame)['valid']
    P=(45,49); R1=(50,39); Bx=(35,14)
    legs=[bfs2(V,start,P), bfs2(V,P,R1), bfs2(V,R1,P), [('UP',(40,49)),('DOWN',(45,49))], bfs2(V,P,Bx)]
    steps=legs[0][1:]+legs[1][1:]+legs[2][1:]+legs[3]+legs[4][1:]
    return steps
def sim2(steps, bar0, rot0, cov0=0, thr=20):
    P=(45,49); R0=(15,14); R1=(50,39)
    bar=bar0; cov=cov0; rot=rot0; worst=99; out=[]
    for i,(a,(r,c)) in enumerate(steps,1):
        bar-=2
        if (r,c) in (R0,R1) and bar<=thr: bar=42
        if (r,c)==P: cov+=1; rot=(rot+90)%360
        worst=min(worst,bar)
        if bar<=0: out.append(('DEATH',i,a,(r,c))); break
    return dict(n=len(steps), endbar=bar, cov=cov, rot=rot, worst=worst, fail=out[:1])
st=plan2()
print('len',len(st))
print(sim2(st, 42, 90))
print([a for a,_ in st])
