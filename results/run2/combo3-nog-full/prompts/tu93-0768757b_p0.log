    INV={v:k for k,v in dd.items()}
    OPP={'UP':'DOWN','DOWN':'UP','LEFT':'RIGHT','RIGHT':'LEFT'}
    CW={'UP':'RIGHT','RIGHT':'DOWN','DOWN':'LEFT','LEFT':'UP'}
    def order(cd):
        o=[cd]; c=cd
        for _ in range(3): c=CW[c]; o.append(c)
        return o
    RAY={(6,6),(8,6)}; GOAL=(10,8)
    GU={0:((10,6),'RIGHT'),1:((12,6),'UP')}; ATK={0:(10,8),1:(10,6)}
    cycA=[(2,c) for c in [6,4,2,0,2,4,6,8]]; cycB=[(r,12) for r in [4,6,8,6,4,2,0,2]]; cycC=[(2,c) for c in [12,10,12,14]]
    def patnow(tt,pm):
        out={}
        if pm&1: out[1]=cycA[tt%8]
        if pm&2: out[2]=cycB[tt%8]
        if pm&4: out[3]=cycC[tt%4]
        return out
    def facing(k,tt):
        if k==1: a,b=cycA[(tt-1)%8],cycA[tt%8]
        elif k==2: a,b=cycB[(tt-1)%8],cycB[tt%8]
        else: a,b=cycC[(tt-1)%4],cycC[tt%4]
        return INV.get((b[0]-a[0],b[1]-a[1]),'UP')
    def copstep(C,cd,tg):
        dm=D[C][tg]; bydir={}
