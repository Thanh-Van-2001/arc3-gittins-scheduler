def plan9f(maxd=40, order_first=True, cap_pat=True):
    tiles,adDD,adj,D=build9()
    dd={'UP':(-2,0),'DOWN':(2,0),'LEFT':(0,-2),'RIGHT':(0,2)}
    INV={v:k for k,v in dd.items()}
    OPP={'UP':'DOWN','DOWN':'UP','LEFT':'RIGHT','RIGHT':'LEFT'}
    CW={'UP':'RIGHT','RIGHT':'DOWN','DOWN':'LEFT','LEFT':'UP'}
    def order(cd):
        o=[cd]; c=cd
        for _ in range(3): c=CW[c]; o.append(c)
        return o
    RAYCELLS=lambda C,cd: set((C[0]+dd[cd][0]*k,C[1]+dd[cd][1]*k) for k in (1,2,3,4) if (C[0]+dd[cd][0]*k,C[1]+dd[cd][1]*k) in tiles)
    GOAL=(10,8)
    GU={0:((10,6),'RIGHT'),1:((12,6),'UP')}; ATK={0:(10,8),1:(10,6)}
    cycA=[(2,c) for c in [6,4,2,0,2,4,6,8]]; cycB=[(r,12) for r in [4,6,8,6,4,2,0,2]]; cycC=[(2,c) for c in [12,10,12,14]]
    def patnow(tt,pm):
        out={}
        if pm&1: out[1]=cycA[tt%8]
        if pm&2: out[2]=cycB[tt%8]
        if pm&4: out[3]=cycC[tt%4]
        return out
    def facing(k,tt):
        if k==1: a,b=cycA[(tt-1)%8],cycA[tt%8]
        elif k==2: a,b=cycB[(tt-1)%8],cycB[tt%8]
        else: a,b=cycC[(tt-1)%4],cycC[tt%4]
        return INV.get((b[0]-a[0],b[1]-a[1]),'UP')
    def copstep(C,cd,tg):
        dm=D[C][tg]; bydir={a:v for a,v in adj[C] if D[v][tg]==dm-1}
        for k in order(cd):
            if k in bydir: return bydir[k],k
        return C,cd
    st0=((8,8),(4,6),'DOWN',False,0,7,3)
    from collections import deque
    parent={st0:(None,None)}; q=deque([st0]); found=None
    while q and found is None:
        st=q.popleft(); P,C,cd,aw,tt,pm,gm=st
        if tt>=maxd: continue
        # step 1: chaser moves first (toward P) if awake
        if aw and C is not None:
            C1,cd1=copstep(C,cd,P)
        else:
            C1,cd1=C,cd
        if C1==P: continue
        for a,(dr,dc) in dd.items():
            mid=(P[0]+dr//2,P[1]+dc//2); tg=(P[0]+dr,P[1]+dc)
            if mid not in tiles or tg not in tiles: continue
            if tg==C1: continue
            pm2=pm; gm2=gm; okm=True
            for gi,(g,fa) in GU.items():
                if gm2>>gi&1:
                    if tg==ATK[gi]: okm=False
                    if tg==g:
                        if a==OPP[fa]: okm=False
                        else: gm2&=~(1<<gi)
            if not okm: continue
            pn=patnow(tt+1,pm); pnow=patnow(tt,pm)
            if any(p==mid for p in pn.values()) or any(p==mid for p in pnow.values()): continue
            if any(p==tg for p in pn.values()): continue
            onb=[k for k,p in pnow.items() if p==tg]
            if any(a==OPP[facing(k,tt)] for k in onb): continue
            for k in onb: pm2&=~(1<<(k-1))
            aw2=aw or (tg in RAYCELLS(C1,cd1))
            ns=(tg,C1,cd1,aw2,tt+1,pm2,gm2)
            if ns in parent: continue
            parent[ns]=(st,a)
            if tg==GOAL and (gm2&3)==0: found=ns; break
            q.append(ns)
    if found is None: return ('NOPLAN',len(parent))
    path=[]; s=found
    while parent[s][0] is not None: path.append(parent[s][1]); s=parent[s][0]
    path.reverse(); return ('OK',path)
