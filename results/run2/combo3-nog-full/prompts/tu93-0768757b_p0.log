def copface(fr):
    nds=fr.segmentation['nodes']
    rs=[n for n in nds if n['color']=='r']
    ys=[n for n in nds if n['color']=='Y' and n['pixels']==1]
    ps=[n for n in nds if n['color']=='p' and n['pixels']==1]
    out=[]
    for n in rs:
        bb=n['boundary']
        r0=min(p[0] for p in bb); r1=max(p[0] for p in bb); c0=min(p[1] for p in bb); c1=max(p[1] for p in bb)
        cr=(r0+r1)/2; cc=(c0+c1)/2
        for e in ys+ps:
            eb=e['boundary'][0]
            if abs(eb[0]-cr)<=2 and abs(eb[1]-cc)<=2:
                dr=eb[0]-cr; dc=eb[1]-cc
                d='DOWN' if dr>0.5 else ('UP' if dr<-0.5 else ('RIGHT' if dc>0.5 else ('LEFT' if dc<-0.5 else 'CEN')))
                out.append(((r0,c0),e['color'],d,round(dr,1),round(dc,1)))
    return out
for h in history[-14:]:
    fr=h.frame
    if fr.level!=9: continue
    print(fr.step, str(h.action)[:6], p9(fr,'b'), copface(fr))
