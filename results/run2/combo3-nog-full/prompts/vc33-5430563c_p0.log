def lvl8_state(fr):
    L=fr.ascii.split('\n')
    def lvl(r0,r1,c0,c1):
        best=None
        for r in range(r0,r1+1):
            if 'W' in L[r][c0:c1+1]: best=r
        return (best+1) if best is not None else r0
    lv={'TL':lvl(8,29,8,21),'M':lvl(8,55,24,39),'TR':lvl(8,29,42,55),'BL':lvl(32,55,8,21),'BR':lvl(32,55,42,55)}
    plugs={}
    for n in fr.segmentation['nodes']:
        if n['color'] in 'YNp':
            bb=n['boundary']; r0=min(p[0] for p in bb); c0=min(p[1] for p in bb); r1=max(p[0] for p in bb); c1=max(p[1] for p in bb)
            if n['pixels']>=3: plugs[n['color']]=(r0,c0,r1,c1)
    return lv,plugs
def show8():
    lv,pl=lvl8_state(current_frame); print('lv',lv,'plugs',pl)
