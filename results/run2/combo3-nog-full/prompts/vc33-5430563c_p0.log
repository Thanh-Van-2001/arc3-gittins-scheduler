def l8plan(st0, cap=2500000):
    import collections
    IDX={'TL':0,'M':1,'TR':2,'BL':3,'BR':4}
    BOUNDS=[(8,30),(8,56),(8,30),(32,56),(32,56)]
    PUMPS=[((8,20),0,1,1),((8,24),1,0,1),((8,38),1,2,1),((8,42),2,1,1),((32,20),3,1,1),((32,24),1,3,1),((32,38),1,4,1),((32,42),4,1,1)]
    GATES=[((41,40),1,4,38,45),((41,22),0,1,38,45),((20,40),1,2,16,23)]
    def nb(st):
        lv=st[:5]; pos=st[5:]
        out=[]
        for btn,a,b,_ in PUMPS:
            nl=list(lv); nl[a]+=2; nl[b]-=2
            if all(BOUNDS[i][0]<=nl[i]<=BOUNDS[i][1] for i in range(5)):
                out.append((tuple(nl),pos,btn))
        for g,ra,rb,g0,g1 in GATES:
            if lv[ra]!=lv[rb] or lv[ra]>g0: continue
            np_=list(pos); moved=False
            for pi,pc in enumerate(pos):
                if pc==ra or pc==rb:
                    if lv[IDX[pc]]>=g0 and lv[IDX[pc]]+2<=g1:
                        np_[pi]= rb if pc==ra else ra; moved=True
            if moved: out.append((lv,tuple(np_),g))
        return out
    def goal(st):
        lv=st[:5]; pos=st[5:]
        return (pos[0]=='M' and lv[1]==18) and (pos[1]=='TR' and lv[2]==26) and (pos[2]=='BL' and lv[3]==50)
    seen={st0:[]}; q=collections.deque([st0])
    while q:
        st=q.popleft()
        if goal(st): return seen[st],st
        for lv,pos,act in nb(st):
            ns=tuple(lv)+tuple(pos)
            if ns not in seen:
                seen[ns]=seen[st]+[act]
                if len(seen)>cap: return None,None
                q.append(ns)
    return None,None
