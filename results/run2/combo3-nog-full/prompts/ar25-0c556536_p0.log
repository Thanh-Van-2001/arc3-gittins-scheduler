def bm(P,R,C,S,T):
    m=0
    for (a,b) in P:
        for (rr,cc) in [(R+a,C+b),(S-R-a,C+b),(R+a,T-C-b),(S-R-a,T-C-b)]:
            if 0<=rr<21 and 0<=cc<21: m|=1<<(rr*21+cc)
    return m
def placements(P,S,T):
    h=max(a for a,b in P); w=max(b for a,b in P)
    return [((R,C),bm(P,R,C,S,T)) for R in range(21-h) for C in range(21-w)]
def solve_cover(Y,pieces,use_bands=False):
    tm=0
    for (r,c) in Y: tm|=1<<(r*21+c)
    for S in range(0,41,2):
        for T in range(0,41,2):
            tgt=tm
            if use_bands:
                ch,cv=S//2,T//2
                band=0
                for c in range(21): band|=1<<(ch*21+c)
                for r in range(21): band|=1<<(r*21+cv)
                tgt=tm&~band
            L=[placements(P,S,T) for P in pieces]
            if len(L)==1:
                for k,m in L[0]:
                    if (m&tgt)==tgt: return (S,T,k)
            else:
                l2=sorted(L[1],key=lambda x:-bin(x[1]).count('1'))
                maxl=[]
                for k,m in l2:
                    if not any((m&x)==m for x in maxl): maxl.append(m)
                for k1,m1 in L[0]:
                    need=tgt&~m1
                    if need==0: return (S,T,k1,None)
                    for m2 in maxl:
                        if (m2&need)==need: return (S,T,k1,'m2')
    return None
