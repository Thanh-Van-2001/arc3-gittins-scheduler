def walk_to(name,tgt,maxp=11):
    POS=[(7,9),(7,19),(7,32),(7,42),(19,9),(19,26),(19,39),(19,49)]
    ORDER=['A_L','A_R','B_L','B_R','C_L','C_R','D_L','D_R']
    GL={'A_L':[(11,9)],'A_R':[(11,19)],'B_L':[(11,32)],'B_R':[(11,42),(11,49)],
        'C_L':[(23,9),(23,16)],'C_R':[(23,26)],'D_L':[(23,39)],'D_R':[(23,49)]}
    def sig(fr): return tuple(mycls(tile(fr,{'x':rc})['x']) for rc in GL[name])
    def ci(fr):
        t=min(brackets(fr)); return POS.index(t) if t in POS else -1
    i=ORDER.index(name)
    for _ in range(9):
        if ci(current_frame)==i: break
        d=(i-ci(current_frame))%8
        action(['RIGHT' if d<=4 else 'LEFT'])
        if last_action_call_result.get('level_completed'): return 'WON'
    n=0
    while sig(current_frame)!=tgt:
        if n>=maxp: return ('fail',name,sig(current_frame),tgt)
        b=sig(current_frame); action(['UP']); n+=1
        r=last_action_call_result
        if r.get('level_completed'): return 'WON'
        if sig(current_frame)==b: return ('stuck',name)
    return (name,n)
S,P=t5(current_frame)
plan=[('C_R',(P[3],)),('D_L',(S[4],)),('A_L',(S[0],)),('A_R',(P[0],))]
