    ORDER=['S1L','S1R','P1L','P1R','S2L','S2R','P2L','P2R','S3L','S3R','P3L','P3R']
    GL={'S1L':[(6,10)],'S1R':[(6,20),(6,27)],'P1L':[(6,39)],'P1R':[(6,49)],
