def full_cyc(names):
    GL={'S1R':[(6,20),(6,27)],'S2R':[(18,20),(18,27)],'S3R':[(30,20),(30,27)]}
    POS=[(2,10),(2,20),(2,39),(2,49),(14,10),(14,20),(14,39),(14,49),(26,10),(26,20),(26,39),(26,49)]
    ORDER=['S1L','S1R','P1L','P1R','S2L','S2R','P2L','P2R','S3L','S3R','P3L','P3R']
    def sig(fr,nm): return tuple(mycls(tile(fr,{'x':rc})['x']) for rc in GL[nm])
    def ci(fr):
        t=min(brackets(fr)); return POS.index(t) if t in POS else -1
    out={}
    for nm in names:
        i=ORDER.index(nm)
        for _ in range(13):
            if ci(current_frame)==i: break
            d=(i-ci(current_frame))%12
            action(['RIGHT' if d<=6 else 'LEFT'])
            if last_action_call_result.get('level_completed'): return 'WON'
        s0=sig(current_frame,nm); cyc=[s0]; n=0
        while n<14:
            action(['UP']); n+=1
            if last_action_call_result.get('level_completed'): return 'WON'
            s=sig(current_frame,nm)
            if s==s0: break
            cyc.append(s)
        out[nm]=cyc
    return out
CYC=full_cyc(['S1R','S2R','S3R'])
