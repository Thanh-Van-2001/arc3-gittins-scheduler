def R90(m):
    n=len(m); return tuple(''.join(m[n-1-r][c] for r in range(n)) for c in range(n))
def myrots(m):
    cur=m; out=[]
    for _ in range(4):
        out.append(cur); cur=R90(cur)
    return out
def mycls(m): return min(key(r) for r in myrots(m))
POS=[(7,9),(7,19),(7,32),(7,42),(19,9),(19,26),(19,39),(19,49)]
ORDER=['A_L','A_R','B_L','B_R','C_L','C_R','D_L','D_R']
GL={'A_L':[(11,9)],'A_R':[(11,19)],'B_L':[(11,32)],'B_R':[(11,42),(11,49)],
    'C_L':[(23,9),(23,16)],'C_R':[(23,26)],'D_L':[(23,39)],'D_R':[(23,49)]}
def t5(fr):
    S=[tile(fr,{'x':(44,15+i)})['x'] for i in (0,7,14,21,28)]
    P=[tile(fr,{'x':(53,15+i)})['x'] for i in (0,7,14,21,28)]
    return [mycls(m) for m in S],[mycls(m) for m in P]
def TARGET5(fr):
    S,P=t5(fr)
    return {'A_L':(S[4],),'A_R':(P[3],),'B_L':(S[1],),'B_R':(P[1],P[1]),'C_L':(S[2],S[2]),
            'C_R':(P[0],),'D_L':(S[0],),'D_R':(P[4],)}
def sig5(fr,name): return tuple(mycls(m) for m in [tile(fr,{'x':rc})['x'] for rc in GL[name]])
def cidx(fr):
    t=min(brackets(fr))
    return POS.index(t) if t in POS else -1
def walk5(name,maxp=12):
    i=ORDER.index(name); tgt=TARGET5(current_frame)[name]
    for _ in range(9):
        if cidx(current_frame)==i: break
        d=(i-cidx(current_frame))%8
        action(['RIGHT' if d<=4 else 'LEFT'])
        if last_action_call_result.get('level_completed'): return 'WON'
    n=0
    for act in ('UP','DOWN'):
        while sig5(current_frame,name)!=tgt:
            if n>=maxp: return ('fail',name,sig5(current_frame,name),tgt)
            b=sig5(current_frame,name); action([act]); n+=1
            r=last_action_call_result
            if r.get('level_completed'): return 'WON'
            if sig5(current_frame,name)==b: return ('stuck',name)
        if n: break
    return (name,n)
print('targets', {k:v for k,v in TARGET5(current_frame).items()})
