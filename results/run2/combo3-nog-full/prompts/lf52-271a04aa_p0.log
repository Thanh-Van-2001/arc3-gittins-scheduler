def dom(fr,r,c):
    from collections import Counter
    a=fr.ascii.split('\n'); R=6+6*r; C=6+6*c
    if R<0 or C<0 or R+4>len(a) or C+4>len(a[0]): return '?'
    cnt=Counter(a[R+i][C+j] for i in range(4) for j in range(4))
    m=cnt.most_common()
    if m[0][1]<8: return '?'
    return {'w':'.','N':'P','O':'H','B':'#','S':' ','W':',','Y':'y'}.get(m[0][0],m[0][0])
def staticmap(frlist,RR,CC):
    from collections import Counter,defaultdict
    acc=defaultdict(Counter)
    for fr in frlist:
        for r in RR:
            for c in CC:
                ch=dom(fr,r,c)
                if ch!='?': acc[(r,c)][ch]+=1
    g={}
    for k,v in acc.items():
        if '.' in v or 'P' in v: g[k]='.'
        elif 'H' in v or 'y' in v: g[k]='o'
        elif '#' in v: g[k]='#'
        elif 'S' in v: g[k]=' '
        else: g[k]=','
    return g
RR=range(-2,12); CC=range(-2,15)
frs=[h.frame for h in history if h.frame.level==3]
g=staticmap(frs,RR,CC)
print('    '+''.join(str(c%10) for c in CC))
for r in RR: print(f'{r:3d} '+''.join(g.get((r,c),' ') for c in CC))
