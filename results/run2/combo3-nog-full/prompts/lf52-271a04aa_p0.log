def dom2(fr,r,c):
    from collections import Counter
    a=fr.ascii.split('\n'); R=6+6*r; C=6*c
    if R<0 or C<0 or R+4>len(a) or C+4>len(a[0]): return '?'
    cnt=Counter(a[R+i][C+j] for i in range(4) for j in range(4))
    m=cnt.most_common()
    if m[0][1]<8: return '?'
    return {'w':'.','N':'P','O':'H','B':'#','S':' ','W':',','Y':'y'}.get(m[0][0],m[0][0])
