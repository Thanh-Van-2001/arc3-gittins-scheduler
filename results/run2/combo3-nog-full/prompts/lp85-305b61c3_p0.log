import collections
def solve8(f,maxd=24):
    O,CL,(LA,LB,LC)=ops8()
    lanes=[LA,LB,LC]
    g=cells8(f)
    start=[]
    for L in lanes:
        ys=[i for i,c in enumerate(L) if g.get(c)=='Y']
        if len(ys)!=1: return None,'bad Y count '+str(ys)
        start.append(ys[0])
    goal=(len(LA)-1,len(LB)-1,len(LC)-1)
    per={}
    for op,m in O.items():
        t=[]
        for L in lanes:
            p=list(range(len(L)))
            for i,c in enumerate(L):
                if c in m: p[i]=L.index(m[c])
            t.append(p)
        per[op]=t
    if tuple(start)==goal: return [],'already'
    seen={tuple(start)}; q=collections.deque([(start,[])])
    while q:
        st,path=q.popleft()
        if len(path)>=maxd: continue
        for op,t in per.items():
            n=tuple(t[j][st[j]] for j in range(3))
            if n==goal: return path+[op],'found'
            if n not in seen:
                seen.add(n); q.append((n,path+[op]))
    return None,'exhausted'
