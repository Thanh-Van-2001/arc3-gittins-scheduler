    return LA,LB,LC
def ops8():
    LA,LB,LC=lanes8()
    def shift(lanes,d):
        m={}
        for L in lanes:
            n=len(L)
            for i,c in enumerate(L): m[c]=L[(i+d)%n]
        return m
    def rot(L,k,d):   # value at i -> i+d within prefix k (wrap inside prefix)
        m={}
        for i in range(k): m[L[i]]=L[(i+d)%k]
        return m
    all3=[LA,LB,LC]
