L=star_cells(15,14); R=star_cells(15,44); Bm=star_cells(45,29)
ARMS=['N','NE','E','SE','S','SW','W','NW']
def arms_out(S):
    m={}
    for k in ARMS:
        i,m_,o=S[k]
        m[i]=m_; m[m_]=o; m[o]=i   # value at inner moves to mid, etc.
    return m
def rings_cw(S):
    # value at clockwise-index i moves to i-1 (CCW movement) == 'ccw' as observed for A2
    order=['N','NE','E','SE','S','SW','W','NW']
    m={}
    for ring in range(3):
        cells=[S[k][ring] for k in order]
        for j in range(8):
            m[cells[j]]=cells[(j-1)%8]   # value at cells[j] moves to cells[j-1]
    return m
def rings_cw2(S):
    order=['N','NE','E','SE','S','SW','W','NW']
    m={}
    for ring in range(3):
        cells=[S[k][ring] for k in order]
        for j in range(8):
            m[cells[j]]=cells[(j+1)%8]
    return m
def apply_map(g,m):
    n=dict(g)
    for s,d in m.items(): n[d]=g[s]
    return n
def check(tr,m):
    g1=cells6(tr.before_frame); g2=cells6(tr.after_frame)
    return apply_map(g1,m)==g2
