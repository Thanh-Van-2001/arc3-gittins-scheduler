def plus7(col):
    g=pixmap(current_frame)
    pts={p for p,v in g.items() if v==col}
    if not pts: return None
    from collections import Counter
    rc=Counter(p[0] for p in pts); cc=Counter(p[1] for p in pts)
    r=max(rc,key=lambda k:(rc[k],-k)); c=max(cc,key=lambda k:(cc[k],-c if False else -k))
    # center = intersection of the long row and long col
    rows=[k for k,v in rc.items() if v>4]; cols=[k for k,v in cc.items() if v>4]
    if len(rows)==1 and len(cols)==1:
        R,C=rows[0],cols[0]
        def cnt(cells):
            n=0
            for p in cells:
                if p in pts: n+=1
                else: break
            return n
        return dict(ctr=(R,C),arms=(cnt([(R-k,C) for k in range(1,64)]),cnt([(R+k,C) for k in range(1,64)]),cnt([(R,C-k) for k in range(1,64)]),cnt([(R,C+k) for k in range(1,64)])),px=len(pts),rows=(min(p[0] for p in pts),max(p[0] for p in pts)),cols=(min(p[1] for p in pts),max(p[1] for p in pts)))
    return dict(multi=True,rows=rows,cols=cols,px=len(pts),bbox=(min(p[0] for p in pts),max(p[0] for p in pts),min(p[1] for p in pts),max(p[1] for p in pts)))
