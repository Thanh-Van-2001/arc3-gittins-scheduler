def preveal(s,mv):
    row,a,gr,W=s
    if mv in ('L','R'):
        d=-1 if mv=='L' else 1
        na=a+d
        if na<0 or na+W>16: return None
        return (row,na,gr,W)
    dr=-1 if mv=='U' else 1
    nr=row+dr
    if nr<4 or nr>14: return None
    return (nr,a,gr,W)

def covf(row,a,W): return {(row,a+k) for k in range(W)}
amap={'LEFT':'L','RIGHT':'R','UP':'U','DOWN':'D'}
