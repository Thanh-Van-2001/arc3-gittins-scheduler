def comps(g):
    g=set(g); out=[]
    while g:
        s=g.pop(); st=[s]; comp=[s]
        while st:
            r,c=st.pop()
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                q=(r+dr,c+dc)
                if q in g: g.remove(q); st.append(q); comp.append(q)
        out.append(comp)
    return out
def partner(g,rect):
    cs=comps(g)
    if not cs: return None
    def d(comp):
        return min(abs(r-r2)+abs(c-c2) for (r,c) in comp for (r2,c2) in rect)
    return min(cs,key=d)
def launch(s):
    row,a,W,g=s
    rect=covf(row,a,W)
    f,l=sim_free(set(g)|rect)
    if len(f)==3: return ('WIN',)
    p=partner(g,rect)
    if p is None: return None
    rs=[c[0] for c in p]; cs=[c[1] for c in p]
    r0,a0,r1,a1=min(rs),min(cs),max(rs),max(cs)
    if r0!=r1: return None
    ng=frozenset((set(g)|rect)-set(p))
    return (r0,a0,a1-a0+1,ng)
def mstep(s,mv):
    row,a,W,g=s
    if mv in ('L','R'):
        d=-1 if mv=='L' else 1; na=a+d
        if na<0 or na+W>16: return None
        return (row,na,W,g)
    dr=-1 if mv=='U' else 1; nr=row+dr
    if nr<4 or nr>14: return None
    return (nr,a,W,g)
