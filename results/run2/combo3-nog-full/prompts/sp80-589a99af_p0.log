def summarize(fr,maxn=20):
    se=fr.segmentation
    out=[]
    for n in se['nodes']:
        b=n['boundary']
        r0=min(p[0] for p in b)//4; r1=max(p[0] for p in b)//4
        c0=min(p[1] for p in b)//4; c1=max(p[1] for p in b)//4
        out.append((n['color'],n['pixels'],(r0,c0,r1,c1)))
    out.sort(key=lambda x:-x[1])
    return out[:maxn]
