def cstep(s,mv):
    row,a,gr=s
    if mv in ('L','R'):
        d=-1 if mv=='L' else 1
        na=a+d
        if na<0 or na+3>16: return None
        vac=(row,a+2) if mv=='L' else (row,a)
        m=set(gr); m.add(vac)
        return (row,na,frozenset(m))
    dr=-1 if mv=='U' else 1
    nr=row+dr
    if nr<4 or nr>14: return None
    m=set(gr)
    for c in (a,a+1,a+2): m.add((row,c))
    return (nr,a,frozenset(m))
def csolids(s):
    row,a,gr=s
    return set(gr-covf(row,a,3))|covf(row,a,3)
