def leftdiff(f1,f2):
    a=f1.ascii.split('\n'); b=f2.ascii.split('\n')
    ch=[]
    for r in range(64):
        for c in range(38):
            if a[r][c]!=b[r][c]: ch.append((a[r][c]+'>'+b[r][c],r,c))
    return ch
def summ(ch):
    from collections import Counter
    cnt=Counter(t for t,_,_ in ch)
    rs=[r for _,r,_ in ch]; cs=[c for _,_,c in ch]
    return dict(cnt),(min(rs),max(rs),min(cs),max(cs)) if ch else None
