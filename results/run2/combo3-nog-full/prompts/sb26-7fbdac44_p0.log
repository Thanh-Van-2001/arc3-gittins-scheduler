from itertools import permutations
colors = ['R','Y','O','b','N','p']
items = colors + ['portR','portB']
row = ['R','Y','O','b','N','p']

def cyc(box, start, cap=40):
    """cyclic reader: no visited set, expand ports, cap total items"""
    out=[]; stack=[(start,0)]
    # iterative depth-first in order
    def walk(which, depth):
        if depth>30 or len(out)>cap: return
        for it in box[which]:
            if len(out)>cap: return
            if it=='portR': walk(0, depth+1)
            elif it=='portB': walk(1, depth+1)
            else: out.append(it)
    walk(start,0)
    return out

sols={'a':[], 'b':[], 'c':[]}
for perm in permutations(items):
    bxx=[list(perm[:4]), list(perm[4:])]
    rc = cyc(bxx,0)[:14]; bc = cyc(bxx,1)[:14]
    if rc[:12]==row+row: sols['a'].append((perm,tuple(bc[:6])))
    if rc[:6]==row and bc[:6]==row: sols['b'].append(perm)
    if rc[:6]==row: sols['c'].append(perm)
for k,v in sols.items(): print(k, len(v))
for s in sols['a'][:6]: print('a:',s)
for s in sols['b'][:6]: print('b:',s)
