from itertools import permutations
colors = ['R','Y','O','b','N','p']
items = colors + ['portR','portB']
row = ['R','Y','O','b','N','p']

def read(box, which, visited, depth=0):
    # which: 0=red,1=blue ; box: list of 4 items
    if depth > 20: return None
    out=[]
    for it in box[which]:
        if it.startswith('port'):
            nxt = 0 if it=='portR' else 1
            if nxt in visited: continue
            sub = read(box, nxt, visited|{nxt}, depth+1)
            if sub is None: return None
            out += sub
        else:
            out.append(it)
    return out

sols=[]
for perm in permutations(items):
    red = list(perm[:4]); blue=list(perm[4:])
    bxx=[red,blue]
    rc = read(bxx,0,{0}); bc = read(bxx,1,{1})
    goals=[]
    if rc==row: goals.append('red=row')
    if rc==row and bc==row: goals.append('both')
    if rc+bc==row+row: goals.append('concat12')
    if rc==row+row: goals.append('red=12')
    if goals: sols.append((tuple(red),tuple(blue),goals))
print(len(sols))
for s in sols[:12]: print(s)
