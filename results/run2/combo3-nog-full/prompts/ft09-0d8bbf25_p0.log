def cands():
    out=[]
    for fg in [('R','O'),('O','R'),('O','O')]:
        for combo in sorted(itertools.product('bR',repeat=4), key=lambda t:(-t.count('R'),t)):
            d=dict(zip('ACDE',combo)); d['B']='b'; d['F'],d['G']=fg
