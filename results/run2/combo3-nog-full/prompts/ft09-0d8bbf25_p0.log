FREE={'A':((0,0),(14,12)),'B':((0,2),(14,28)),'C':((2,0),(30,12)),'D':((3,1),(38,20)),'E':((3,3),(38,36)),'F':((0,4),(14,44)),'G':((1,4),(22,44))}
