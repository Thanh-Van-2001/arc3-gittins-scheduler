ROWS=(6,14,22,30,38,46); COLS=(4,12,20,28,36,44,52)
def snap2(ROWS=(6,14,22,30,38,46),COLS=(4,12,20,28,36,44,52)):
    a=current_frame.ascii.split('\n'); st={}
    for r in range(6):
        for c in range(7):
            blk=''.join(a[ROWS[r]+x][COLS[c]:COLS[c]+6] for x in range(6)); s=set(blk)
            if s=={'c'}: st[(r,c)]='empty'
            elif 'M' in s: st[(r,c)]='N' if blk.count('N')>blk.count('Y') else 'Y'
            elif 'W' in s or 'g' in s or 'G' in s: st[(r,c)]='icon:'+blk[14]
            else: st[(r,c)]=blk[0]
    return st
st=snap2()
tiles=sorted(k for k,v in st.items() if v in ('Y','N'))
target={(0,0):'Y',(1,0):'N',(1,1):'N',(1,2):'Y',(1,3):'Y',(1,4):'N',(1,5):'Y',(2,1):'Y',(2,2):'N',(2,3):'N',(2,5):'N',(3,1):'N',(3,3):'N',(3,4):'N',(3,5):'Y',(4,1):'Y',(4,2):'N',(4,3):'N',(4,4):'Y',(4,5):'N',(4,6):'N',(5,6):'Y'}
# recompute target from icons to be safe
def target_from_icons(st,ROWS=ROWS,COLS=COLS):
    a=current_frame.ascii.split('\n'); cons={}
    icons={k:v[5:] for k,v in st.items() if isinstance(v,str) and v.startswith('icon:')}
    for (ri,ci),hub in icons.items():
        r,c=ROWS[ri],COLS[ci]
        blocks=[[a[r+br*2][c+bc*2] for bc in range(3)] for br in range(3)]
        for br in range(3):
            for bc in range(3):
                if (br,bc)==(1,1): continue
                cell=(ri+br-1,ci+bc-1); code=blocks[br][bc]
                if code=='G' or not(0<=cell[0]<6 and 0<=cell[1]<7): continue
                cons.setdefault(cell,set()).add(hub if code=='W' else ('Y' if hub=='N' else 'N'))
    return {k:list(v)[0] for k,v in cons.items()}
tgt=target_from_icons(st)
print('tgt matches hand', all(tgt[k]==target[k] for k in tgt), len(tgt))
clicks=[]
for r in range(5,-1,-1):
    for c in range(7):
        x=(r,c)
        if x not in tgt: continue
        below=(r+1,c)
        cb = 1 if (below in tgt and below in clicks) else 0
        need = (st[x]!=tgt[x]) ^ bool(cb)
        if need: clicks.append(x)
print('clicks',len(clicks),sorted(clicks))
acts=[{'action':'MOUSE','row':ROWS[r],'col':COLS[c]} for (r,c) in sorted(clicks)]
res=action(acts)
print({k:v for k,v in res.items() if k in ('executed_count','level_completed','game_over','no_op','stop_reason')})
st2=snap2()
bad=[(k,st2[k],tgt[k]) for k in tgt if st2[k]!=tgt[k]]
print('remaining',bad)
