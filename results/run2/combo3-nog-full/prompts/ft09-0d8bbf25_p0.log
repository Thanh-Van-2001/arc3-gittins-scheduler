def analyze(ROWS=(4,12,20,28,36,44,52),COLS=(6,14,22,30,38,46,54)):
    a=current_frame.ascii.split('\n')
    grid={}
    for ri,r in enumerate(ROWS):
        for ci,c in enumerate(COLS):
            blk=[a[r+br][c:c+6] for br in range(6)]
            flat=''.join(blk)
            un=set(flat)
            if len(un)==1:
                col=flat[0]
                grid[(ri,ci)]=('tile',col) if col!='c' else ('empty',col)
            else:
                hub=flat[14]
                blocks=[[blk[br*2][bc*2] for bc in range(3)] for br in range(3)]
                grid[(ri,ci)]=('icon',hub,blocks)
    return grid
