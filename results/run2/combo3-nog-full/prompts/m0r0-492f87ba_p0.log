import collections
BOT=set((r,c) for r in range(8,13) for c in list(range(2,7))+list(range(8,13)))|{(10,7)}
def stepAB(st,m):
    A,B=st
    if m=='UP': da=db=(-1,0)
    elif m=='DOWN': da=db=(1,0)
    elif m=='LEFT': da,db=(0,-1),(0,1)
    else: da,db=(0,1),(0,-1)
    ta=(A[0]+da[0],A[1]+da[1]); tb=(B[0]+db[0],B[1]+db[1])
    if ta not in BOT or tb not in BOT: return None
    na = ta if ta!=B else A
    nb = tb if tb!=A else B
    if ta==tb: return (ta,tb)
    return (na,nb)
def bfs_merge(start,limit=20):
    q=collections.deque([(start,[])]); seen={start}
    while q:
        st,path=q.popleft()
        if len(path)>=limit: continue
        for m in ['UP','DOWN','LEFT','RIGHT']:
            ns=stepAB(st,m)
            if ns is None or ns in seen: continue
            if ns[0]==ns[1]: return path+[m]
            seen.add(ns); q.append((ns,path+[m]))
    return None
