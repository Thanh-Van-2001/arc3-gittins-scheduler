def mp6(fr):
    a=fr.ascii.split('\n')
    def cell(r_,c_):
        blk=[a[2+4*r_+i][2+4*c_:2+4*c_+4] for i in range(4)]
        f=''.join(blk)
        for ch in 'SONybYw':
            if ch in f: return ch
        return '.' if 'B' in f else '#'
    return cell
def snap6(fr):
    cell=mp6(fr); A=B=None; T=None; gray=[]
    for r_ in range(2,13):
        for c_ in range(2,13):
            ch=cell(r_,c_)
            if ch=='S':
                if A is None: A=(r_,c_)
                else: B=(r_,c_)
            elif ch=='w': gray.append((r_,c_))
            elif ch in 'bY': T=(r_,c_)
    return A,B,T,gray
prev=None
for t in transitions:
    if t.before_frame.level!=6 or t.after_frame.level!=6: continue
    A0,B0,T0,g0=snap6(t.before_frame); A1,B1,T1,g1=snap6(t.after_frame)
    print(t.action, 'A',A0,'->',A1,'B',B0,'->',B1,'T',T0,'->',T1,'gray',g0,'->',g1)
