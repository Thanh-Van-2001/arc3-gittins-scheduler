import time, collections
ROOMS=[(r,c) for r in list(range(2,7))+list(range(8,13)) for c in list(range(2,7))+list(range(8,13))]
GATE={'N':[(7,3),(7,4),(7,5)],'O':[(7,9),(7,10),(7,11)]}
FREE=set(ROOMS)|set(GATE['N'])|set(GATE['O'])|{(10,7)}
PLATES={((3,4),'O'),((3,10),'N'),((10,4),'N')}
PLATECELLS={p for p,_ in PLATES}
def gates_open(A,B):
    occ={A,B}
    return {'N': bool(occ & {(3,10),(10,4)}), 'O': ((3,4) in occ)}
GATECELL={c:'N' for c in GATE['N']}; GATECELL.update({c:'O' for c in GATE['O']})
DIRS={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
def block_move(pos,d,other,tok,op):
    tgt=(pos[0]+d[0],pos[1]+d[1])
    if tgt not in FREE: return None,'wall'
    g=GATECELL.get(tgt)
    if g and not op[g]: return None,'closed'
    if tgt==other or tgt==tok: return None,'block'
    return tgt,'ok'
def step_blocks(st,m):
    A,B,T,mode=st; d=DIRS[m]; op=gates_open(A,B)
    nA,sA=block_move(A,d,B,T,op); nB,sB=block_move(B,d,A,T,op)
    if sA=='wall' or sB=='wall': return None      # would reset both -> forbid
    nA=A if nA is None else nA; nB=B if nB is None else nB
    if nA==nB: return (nA,nA,T,mode),'MERGE'
    return (nA,nB,T,mode),None
def step_tok(st,m):
    A,B,T,mode=st; d=DIRS[m]; tgt=(T[0]+d[0],T[1]+d[1])
    if tgt not in FREE or tgt in PLATECELLS or tgt==A or tgt==B: return None
    return (A,B,tgt,mode)
def neighbors(st):
    A,B,T,mode=st; out=[]
    if mode==0:
        for m in DIRS:
            r=step_blocks(st,m)
            if r: out.append(({'action':'MOUSE','row':2+4*T[0]+2,'col':2+4*T[1]+2},'CLICKTOK',(A,B,T,1)))
            break
        for m in DIRS:
            r=step_blocks(st,m)
            if r and r[1]!='MERGE': out.append((m,m,r[0]))
            elif r and r[1]=='MERGE': out.append((m,m,r[0]))
        out.append(({'action':'MOUSE','row':2+4*T[0]+2,'col':2+4*T[1]+2},'CLICKTOK',(A,B,T,1))) if False else None
    else:
        for m in DIRS:
            r=step_tok(st,m)
            if r: out.append((m,m,r))
        g=2+4*A[0]+2, 2+4*A[1]+2
        out.append(({'action':'MOUSE','row':g[0],'col':g[1]},'UNFREEZE',(A,B,T,0)))
    return out
# fix: build neighbors cleanly
def nbrs(st):
    A,B,T,mode=st; out=[]
    if mode==0:
        for m in DIRS:
            r=step_blocks(st,m)
            if r is None: continue
            ns,tag=r
            out.append((m,m,ns,tag))
        out.append(({'action':'MOUSE','row':2+4*T[0]+2,'col':2+4*T[1]+2},'CLICKTOK',(A,B,T,1),None))
    else:
        for m in DIRS:
            r=step_tok(st,m)
            if r: out.append((m,m,r,None))
        out.append(({'action':'MOUSE','row':2+4*A[0]+2,'col':2+4*A[1]+2},'UNFREEZE',(A,B,T,0),None))
    return out
def bfs6(start,cap=500000,tlimit=25.0):
    t0=time.time(); q=collections.deque([start]); par={start:(None,None,None)}; n=0
    while q:
        st=q.popleft(); n+=1
        if n%20000==0 and time.time()-t0>tlimit: return None,'timeout',n
        A,B,T,mode=st
        if A==B:
            path=[]; cur=st
            while par[cur][0] is not None:
                p,act,tag=par[cur]; path.append((act,tag)); cur=p
            path.reverse(); return cur,path,n
        for act,label,ns,tag in nbrs(st):
            if ns not in par:
                par[ns]=(st,act,tag); q.append(ns)
    return None,'exhausted',n
