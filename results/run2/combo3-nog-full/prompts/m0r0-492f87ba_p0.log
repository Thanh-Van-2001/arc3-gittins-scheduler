import collections
ROOM=[(r,c) for r in range(8,13) for c in range(2,7)]
GATEC=[(7,3),(7,4),(7,5)]
CELLS=set(ROOM)|{(10,7)}|set(GATEC)
PLATE={(10,4)}
def opn(A,B): return {(3,10),(10,4)} & {A,B}
def stepB6(st,m):
    A,B,T,mode=st
    if m=='UP': da=db=(-1,0)
    elif m=='DOWN': da=db=(1,0)
    elif m=='LEFT': da,db=(0,-1),(0,1)
    else: da,db=(0,1),(0,-1)
    ta=(A[0]+da[0],A[1]+da[1]); tb=(B[0]+db[0],B[1]+db[1])
    op=bool(opn(A,B))
    for t in (ta,tb):
        if t in GATEC and not op: return None
        if t not in CELLS: return None
    if ta==tb: return (ta,tb,T,mode),'MERGE'
    na = A if (ta==B or ta==T) else ta
    nb = B if (tb==A or tb==T) else tb
    return (na,nb,T,mode),None
def stepT6(st,m):
    A,B,T,mode=st
    d={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}[m]
    t=(T[0]+d[0],T[1]+d[1])
    if t not in CELLS or t in PLATE or t==A or t==B: return None
    return (A,B,t,mode)
def bfs6b(start,cap=200000):
    q=collections.deque([start]); par={start:None}; n=0
    while q:
        st=q.popleft(); n+=1
        if n>cap: return None,'cap',n
        A,B,T,mode=st
        if A==B:
            path=[]; cur=st
            while par[cur] is not None:
                act,cur=par[cur]; path.append(act)
            path.reverse(); return path,None,n
        if mode==0:
            for m in ['UP','DOWN','LEFT','RIGHT']:
                r=stepB6(st,m)
                if r is None: continue
                ns,tag=r
                if ns not in par: par[ns]=(m,st); q.append(ns)
            nst=(A,B,T,1)
            if nst not in par: par[nst]=('FREEZE',st); q.append(nst)
        else:
            for m in ['UP','DOWN','LEFT','RIGHT']:
                ns=stepT6(st,m)
                if ns and ns not in par: par[ns]=(m,st); q.append(ns)
            nst=(A,B,T,0)
            if nst not in par: par[nst]=('UNFREEZE',st); q.append(nst)
    return None,'exh',n
